<Application x:Class="WPF_Desktop.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 DispatcherUnhandledException="Application_DispatcherUnhandledException"
			 ShutdownMode="OnExplicitShutdown">
	<Application.Resources>
		<ResourceDictionary>
			<!--
				EL ORDEN IMPORTA: un StaticResource sólo encuentra claves ya cargadas. Los
				tokens van primero (color, después tipografía, que usa color), y recién
				después los estilos de control, que usan las dos cosas. Mover una línea hacia
				arriba rompe la app al arrancar, no al compilar.
			-->
			<ResourceDictionary.MergedDictionaries>
				<!-- TOKENS -->
				<ResourceDictionary Source="/Theme/EDUSIS_Converters.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_Brushes.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_Typography.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_Surfaces.xaml"/>

				<!-- CONTROLES -->
				<ResourceDictionary Source="/Theme/EDUSIS_ButtonStyle.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_ButtonWithIcon.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_Labels.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_TextBlock.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_TextBox.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_ComboBox.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_DatePicker.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_DataGrid.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_ListView.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_Icons.xaml"/>
				<ResourceDictionary Source="/Theme/EDUSIS_Forms.xaml"/>

				<!-- VISTA POR VIEWMODEL -->
				<ResourceDictionary Source="/Shared/DataTemplate.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>

<UserControl x:Class="WPF_Desktop.Views.Shared.InformacionPersonalView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Shared"

			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:domainPersonas="clr-namespace:Domain.Personas;assembly=Domain"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		Los ocho RowDefinition sin Height eran OCHO FILAS EN *, para seis campos y con la 4
		salteada: la grilla repartía el sobrante de la pantalla entre las filas y estiraba los
		huecos de forma despareja. De ahí venían los VerticalAlignment="Center" campo por
		campo, que compensaban a mano lo que causaba la propia grilla. Un StackPanel apila en
		el alto que cada campo necesita y el ritmo lo pone Campo.

		Los textos guía quedaron sólo donde el formato NO se deduce del rótulo. "ingresar el
		apellido…" debajo de una etiqueta que dice "Apellido" no agrega nada, y el estilo del
		campo pide textualmente lo contrario: qué se espera acá, no una repetición del rótulo.
	-->
	<UserControl.Resources>
		<ObjectDataProvider x:Key="sexos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainPersonas:Sexo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<GroupBox Header="INFORMACIÓN PERSONAL" Style="{ StaticResource ResourceKey=Seccion }">
		<StackPanel>
			<HeaderedContentControl Header="Apellido" Style="{ StaticResource ResourceKey=Campo }">
				<TextBox Text="{ Binding Path=Apellido, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Header="Nombre" Style="{ StaticResource ResourceKey=Campo }">
				<TextBox Text="{ Binding Path=Nombre, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<!-- Mismo texto guía que la búsqueda de Alumnos: el dato se pide igual en los dos lados. -->
			<HeaderedContentControl Header="Documento" Style="{ StaticResource ResourceKey=Campo }">
				<TextBox Tag="8 dígitos, sin puntos"
						 Text="{ Binding Path=DocumentoNacionalIdentidad, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Header="Fecha de nacimiento" Style="{ StaticResource ResourceKey=Campo }">
				<DatePicker DisplayDate="{ Binding Path=FechaNacimiento, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
							DisplayDateEnd="{ x:Static sys:DateTime.Today }"
							DisplayDateStart="01/01/1900"
							Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Header="Sexo" Style="{ StaticResource ResourceKey=Campo }">
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=sexos } }"
						  SelectedItem="{ Binding Path=Sexo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Header="Nacionalidad" Style="{ StaticResource ResourceKey=Campo }">
				<TextBox Text="{ Binding Path=Nacionalidad, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>
		</StackPanel>
	</GroupBox>
</UserControl>

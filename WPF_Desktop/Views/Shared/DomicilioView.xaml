<UserControl x:Class="WPF_Desktop.Views.Shared.DomicilioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Shared"
			 
			 xmlns:domainDomicilios="clr-namespace:Domain.Personas.Domicilios;assembly=Domain"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<UserControl.Resources>
		<ObjectDataProvider x:Key="viviendas" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainDomicilios:Vivienda"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0"
					Margin="0 0 0 5">
			<Label Style="{ StaticResource ResourceKey=Headline }">
				<Label.Content>
					<WrapPanel HorizontalAlignment="Center"
							   VerticalAlignment="Center">
						<fa:IconBlock Icon="House"
									  Foreground="{ StaticResource ResourceKey=Neutral800 }"
									  Margin="0 0 4 0"/>
						<TextBlock Text="Domicilio"
								   Margin="4 0 0 0"/>
					</WrapPanel>
				</Label.Content>
			</Label>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
					   Height=".8"
					   Width="Auto"/>
		</StackPanel>

		<!--#region Dirección-->
		<Grid Grid.Row="1"
			  Margin="0 0 0 5"
			  HorizontalAlignment="Stretch">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<!--#region CALLE-->
			<StackPanel Grid.Column="0"
						Margin="0 0 5 0"
						VerticalAlignment="Center">
				<Label Content="Calle"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>

				<TextBox Tag="ingresar la calle&#x2026;"
						 Text="{ Binding Path=Calle, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region ALTURA-->
			<StackPanel Grid.Column="1"
						Margin="5 0"
						VerticalAlignment="Center">
				<Label Content="Altura"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Tag="9999"
						 Text="{ Binding Path=Altura, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region VIVIENDA-->
			<StackPanel Grid.Column="2"
						Margin="5 0 0 0">
				<Label Content="Vivienda"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>

				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=viviendas } }"
						  SelectedItem="{ Binding Path=Vivienda, UpdateSourceTrigger=PropertyChanged }"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }"/>
			</StackPanel>
			<!--#endregion-->
		</Grid>
		<!--#endregion Dirección-->

		<!--#region Ubicación-->
		<!--#region LOCALIDAD-->
		<StackPanel Grid.Row="2"
					Margin="0 5"
					VerticalAlignment="Center">
			<Label Content="Localidad"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Tag="ingresar la localidad&#x2026;"
					 Text="{ Binding Path=Localidad, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
					 Style="{StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region PROVINCIA-->
		<StackPanel Grid.Row="3"
					Margin="0 5"
					VerticalAlignment="Center">
			<Label Content="Provincia"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Tag="ingresar la provincia&#x2026;"
					 Text="{ Binding Path=Provincia, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
					 Style="{StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region PAIS-->
		<StackPanel Grid.Row="4"
					Margin="0 5"
					VerticalAlignment="Center">
			<Label Content="País"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Tag="ingresar la país&#x2026;"
					 Text="{ Binding Path=Pais, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
					 Style="{StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->
		<!--#endregion Ubicación-->

		<!--#region OBSERVACIONES-->
		<StackPanel Grid.Row="5"
					Margin="0 5 0 0">
			<Label Content="Observación"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox AcceptsReturn="True"
					 MaxLength="120"
					 Height="94"
					 Tag="observaciones&#x2026;"
					 Text="{ Binding Path=Observaciones, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged }"
					 TextWrapping="Wrap"
					 VerticalContentAlignment="Top"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->
	</Grid>
</UserControl>

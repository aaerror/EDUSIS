<UserControl x:Class="WPF_Desktop.Views.Shared.DomicilioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Shared"

			 xmlns:domainDomicilios="clr-namespace:Domain.Personas.Domicilios;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		Campos de a pares, no uno por fila. El bloque ocupa media pantalla —comparte el ancho
		con Información Personal—, así que apilar seis campos de ancho completo obligaba a
		scrollear para llegar al botón. Calle se queda con el sobrante de su fila porque es el
		único dato de largo imprevisible.
	-->
	<UserControl.Resources>
		<ObjectDataProvider x:Key="viviendas" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainDomicilios:Vivienda"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<GroupBox Header="DOMICILIO" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<HeaderedContentControl Grid.Column="0" Grid.Row="0"
								   Header="Calle"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox Text="{ Binding Path=Calle, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="0"
								   Header="Altura"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<TextBox Tag="1234"
						 Text="{ Binding Path=Altura, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="0" Grid.Row="1"
								   Header="Vivienda"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=viviendas } }"
						  SelectedItem="{ Binding Path=Vivienda, UpdateSourceTrigger=PropertyChanged }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="1"
								   Header="Localidad"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<TextBox Text="{ Binding Path=Localidad, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="0" Grid.Row="2"
								   Header="Provincia"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox Text="{ Binding Path=Provincia, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="2"
								   Header="País"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<TextBox Text="{ Binding Path=Pais, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<!-- El alto y la alineación arriba los pone Txb.Nota, no la vista. -->
			<HeaderedContentControl Grid.ColumnSpan="2" Grid.Row="3"
								   Header="Observación"
								   Style="{ StaticResource ResourceKey=Campo }">
				<TextBox MaxLength="120"
						 Text="{ Binding Path=Observaciones, FallbackValue='Sin datos', UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
			</HeaderedContentControl>
		</Grid>
	</GroupBox>
</UserControl>

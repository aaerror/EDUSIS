<UserControl x:Class="WPF_Desktop.Views.Shared.ContactoView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Shared"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<GroupBox Header="CONTACTO" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<HeaderedContentControl Grid.Column="0"
								   Header="Teléfono"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox Tag="11 5555 5555"
						 Text="{ Binding Path=Telefono, FallbackValue='Sin datos', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<!-- Mismo ejemplo que el campo Usuario del ingreso: es la misma clase de dato. -->
			<HeaderedContentControl Grid.Column="1"
								   Header="Correo electrónico"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<TextBox Tag="nombre@edu.ar"
						 Text="{ Binding Path=Email, FallbackValue='Sin datos', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>
		</Grid>
	</GroupBox>
</UserControl>

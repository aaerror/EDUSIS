<UserControl x:Class="WPF_Desktop.Views.Shared.ContactoView"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Shared"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<StackPanel Grid.ColumnSpan="2"
					Grid.Row="0"
					Margin="0 0 5 0">
			<Label Style="{ StaticResource ResourceKey=Headline }">
				<Label.Content>
					<WrapPanel HorizontalAlignment="Center"
							   VerticalAlignment="Center">
						<fa:IconBlock Icon="MailBulk"
									  Foreground="{ StaticResource ResourceKey=Neutral800 }"
									  Margin="0 0 4 0"/>
						<TextBlock Text="Contacto"
								   Margin="4 0 0 0"/>
					</WrapPanel>
				</Label.Content>
			</Label>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
				   Height=".8"
				   Width="Auto"/>
		</StackPanel>

		<!--#region TELÉFONO-->
		<StackPanel Grid.Column="0"
					Grid.Row="1"
					Margin="0 0 10 0">
			<Label Content="Telefono"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=Telefono, FallbackValue='Sin datos', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True }"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region EMAIL-->
		<StackPanel Grid.Column="1"
					Grid.Row="1"
					Margin="10 0 0 0">
			<Label Content="Email"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=Email, FallbackValue='Sin datos', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Asistencias.AsistenciasView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Asistencias"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		Entrada de la sección: dos campos y un botón. No repite el índice de cursos ni la ficha
		de división de las pantallas de gestión porque acá el curso no es el objeto de trabajo
		sino el filtro para llegar a la planilla, que es la pantalla siguiente.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCursosCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Titulo="Asistencias"
									Subtitulo="Elegí el curso y la división para tomar lista del día"/>
		<!--#endregion-->

		<!--#region CUERPO-->
		<Border Grid.Row="1"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				VerticalAlignment="Top">
			<StackPanel Margin="24">
				<Border Style="{ StaticResource ResourceKey=Superficie.Aviso }"
						Margin="0 0 0 18"
						Visibility="{ Binding Path=Mensaje, Converter={ StaticResource ResourceKey=visibleSiHayTexto }, Mode=OneWay }">
					<TextBlock HorizontalAlignment="Left"
							   MaxWidth="560"
							   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
							   Text="{ Binding Path=Mensaje, Mode=OneWay }"
							   TextWrapping="Wrap"/>
				</Border>

				<GroupBox Header="PLANILLA A ABRIR" Style="{ StaticResource ResourceKey=Seccion }">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<HeaderedContentControl Grid.Column="0" Grid.Row="0"
												Header="Curso"
												Style="{ StaticResource ResourceKey=Campo.Izquierda }">
							<ComboBox ItemsSource="{ Binding Path=Cursos, Mode=OneWay }"
									  SelectedItem="{ Binding Path=Curso, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									  Style="{ StaticResource ResourceKey=Cmb.Campo }">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Margin="0 0 4 0"
													   Text="{ Binding Path=Grado, Converter={ StaticResource ResourceKey=grado }, Mode=OneWay }"/>
											<TextBlock Text="{ Binding Path=NivelEducativo, StringFormat={}({0}) }"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</HeaderedContentControl>

						<HeaderedContentControl Grid.Column="1" Grid.Row="0"
												Header="División"
												Style="{ StaticResource ResourceKey=Campo.Derecha }">
							<ComboBox ItemsSource="{ Binding Path=Divisiones, Mode=OneWay }"
									  SelectedItem="{ Binding Path=Division, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									  Style="{ StaticResource ResourceKey=Cmb.Campo }">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Margin="0 0 8 0"
													   Text="{ Binding Path=Descripcion }"/>
											<TextBlock Style="{ StaticResource ResourceKey=Txt.Detalle }"
													   Text="{ Binding Path=Cursantes, StringFormat={}{0} cursantes }"
													   VerticalAlignment="Center"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</HeaderedContentControl>

						<HeaderedContentControl Grid.Column="0" Grid.Row="1"
												Header="Ciclo lectivo"
												Style="{ StaticResource ResourceKey=Campo.Izquierda }">
							<TextBox IsReadOnly="True"
									 Style="{ StaticResource ResourceKey=Txb.Campo }"
									 Text="{ Binding Path=CicloLectivo, Mode=OneWay }"/>
						</HeaderedContentControl>
					</Grid>
				</GroupBox>

				<Button Command="{ Binding Path=AbrirPlanillaCommand }"
						HorizontalAlignment="Left"
						Margin="0 20 0 0"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Abrir la planilla de asistencia de la división elegida">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="ClipboardCheck"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Tomar lista" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

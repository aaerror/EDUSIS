<UserControl x:Class="WPF_Desktop.Views.Alumnos.GestionAlumnosView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Alumnos"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		ÍNDICE + FICHA, como Docentes y Cursos.

		ACÁ ESTABA ESCRITO QUE ALUMNOS NO PODÍA TENER ÍNDICE, y era cierto: IServicioAlumno sólo
		sabía buscar por documento exacto o por nombre completo exacto, y las dos devolvían UNA
		persona. La limitación era de la capa de aplicación, no de diseño. Ahora
		BuscarAlumnosAsync devuelve colección y el índice existe.

		UN SOLO CAMPO para las dos búsquedas: si son dígitos es el documento y va exacto, si no
		es parte del nombre o del apellido y va parcial. Quien busca ya sabe qué dato tiene a
		mano; obligarlo a declarar primero en qué campo lo va a escribir no decide nada.

		Hay botón y no filtro en vivo, a diferencia de Docentes: acá la búsqueda va contra la
		base porque la matrícula de alumnos es un orden de magnitud más grande que el personal
		docente, y traerla entera en cada entrada a la pantalla crece con cada ciclo lectivo.
	-->
	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Titulo="Alumnos"
									Subtitulo="Búsqueda por documento o nombre, situación académica, perfil e inscripción">
			<components:PaginaComponent.Accion>
				<Button Command="{ Binding Path=NavigationCommand }"
						CommandParameter="Registrar"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Dar de alta un alumno nuevo">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Registrar alumno" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</components:PaginaComponent.Accion>
		</components:PaginaComponent>
		<!--#endregion-->

		<!--#region CUERPO-->
		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="360"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!--#region ÍNDICE-->
				<Grid Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Margin="16 16 16 12">
						<Label Content="Buscar alumno"
							   Style="{ StaticResource ResourceKey=Lbl.Campo }"
							   Target="{ Binding ElementName=CampoTermino }"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<Grid Grid.Column="0">
								<TextBox x:Name="CampoTermino"
										 Tag="DNI, nombre o apellido"
										 Text="{ Binding Path=Termino, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
										 Padding="34 0 11 0"
										 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
								<fa:IconBlock Foreground="{ StaticResource ResourceKey=TintaTenue }"
											  FontSize="12"
											  HorizontalAlignment="Left"
											  Icon="MagnifyingGlass"
											  IsHitTestVisible="False"
											  Margin="12 0 0 0"
											  VerticalAlignment="Center"/>
							</Grid>

							<Button Grid.Column="1"
									Command="{ Binding Path=BuscarCommand }"
									Content="Buscar"
									IsDefault="True"
									Margin="8 0 0 0"
									Style="{ StaticResource ResourceKey=Btn.Secundario }"/>
						</Grid>
						<TextBlock HorizontalAlignment="Left"
								   Margin="2 8 0 0"
								   MaxWidth="320"
								   Style="{ StaticResource ResourceKey=Txt.Detalle }"
								   Text="El documento se busca exacto; el nombre y el apellido, por coincidencia parcial."
								   TextWrapping="Wrap"/>
						<TextBlock Margin="2 10 0 0"
								   Style="{ StaticResource ResourceKey=Txt.Seccion }"
								   Text="{ Binding Path=Conteo }"
								   Visibility="{ Binding Path=Conteo, Converter={ StaticResource ResourceKey=visibleSiHayTexto } }"/>
					</StackPanel>

					<ListView Grid.Row="1"
							  ItemsSource="{ Binding Path=Resultados }"
							  SelectedItem="{ Binding Path=AlumnoSeleccionado, Mode=TwoWay }"
							  Style="{ StaticResource ResourceKey=Lista.Indice }"
							  Tag="Todavía no buscaste ningún alumno.">
						<ListView.View>
							<GridView AllowsColumnReorder="False">
								<GridView.Columns>
									<GridViewColumn Header="DNI" Width="92">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Dato }"
														   Text="{ Binding Path=Documento, TargetNullValue='—' }"/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="ALUMNO" Width="226">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
														   Text="{ Binding Path=NombreCompleto, TargetNullValue='Sin datos' }"
														   TextTrimming="CharacterEllipsis"/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
								</GridView.Columns>
							</GridView>
						</ListView.View>
					</ListView>
				</Grid>
				<!--#endregion-->

				<Rectangle Grid.Column="1" Style="{ StaticResource ResourceKey=Regla.Vertical }"/>

				<!--#region FICHA-->
				<Grid Grid.Column="2">
					<!-- Sin elección: la mitad derecha dice qué hacer, no queda en blanco. -->
					<StackPanel HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Visibility="{ Binding Path=AlumnoSeleccionado, Converter={ StaticResource ResourceKey=visibleSiHay }, ConverterParameter=inverso }">
						<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
								   HorizontalAlignment="Center"
								   Style="{ StaticResource ResourceKey=Txt.Subtitulo }"
								   Text="Elegí un alumno"/>
						<TextBlock HorizontalAlignment="Center"
								   Margin="0 6 0 0"
								   MaxWidth="340"
								   Style="{ StaticResource ResourceKey=Txt.Detalle }"
								   Text="{ Binding Path=Message }"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>

					<Grid Margin="28 22"
						  Visibility="{ Binding Path=AlumnoSeleccionado, Converter={ StaticResource ResourceKey=visibleSiHay } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!--
							LA FICHA: regla verde, identificador tabular y nombre. El mismo gesto
							encabeza cada registro del sistema, sea docente, alumno o curso.
						-->
						<StackPanel Grid.Row="0" Orientation="Horizontal">
							<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
									   Margin="0 2 14 2"
									   VerticalAlignment="Stretch"
									   Width="3"/>
							<StackPanel>
								<TextBlock Style="{ StaticResource ResourceKey=Txt.Identificador }"
										   Text="{ Binding Path=AlumnoSeleccionado.Documento, StringFormat='DNI {0}', TargetNullValue='SIN DNI' }"/>
								<TextBlock Margin="0 2 0 0"
										   Style="{ StaticResource ResourceKey=Txt.Titulo }"
										   Text="{ Binding Path=AlumnoSeleccionado.NombreCompleto }"
										   TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</StackPanel>

						<ScrollViewer Grid.Row="1"
									  Margin="0 20 0 0"
									  VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<!--#region SITUACIÓN ACADÉMICA
									VA PRIMERO, ANTES DE LOS DATOS PERSONALES, y el orden no es
									decorativo: la pregunta que trae a alguien a esta pantalla es
									qué cursa el alumno y cómo le va, no cuál es su nacionalidad.
									La ficha anterior mostraba nacimiento, sexo y nacionalidad, y
									nada más.

									Las tres cifras llevan el ciclo lectivo en el rótulo —"PROMEDIO
									2026"— porque las tres son de un solo período. Un "PROMEDIO" a
									secas obliga a adivinar si son las notas de este año o el
									acumulado de la escolaridad entera.
								-->
								<Border Style="{ StaticResource ResourceKey=Superficie.Seccion }"
										Visibility="{ Binding Path=Resumen, Converter={ StaticResource ResourceKey=visibleSiHay } }">
									<StackPanel>
										<!-- Qué cursa -->
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<StackPanel Grid.Column="0">
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
														   Text="CURSANDO"/>
												<TextBlock Margin="0 4 0 0"
														   Style="{ StaticResource ResourceKey=Txt.Subtitulo }"
														   Text="{ Binding Path=Resumen.Cursada }"
														   TextWrapping="Wrap"/>
											</StackPanel>

											<Border Grid.Column="1"
													Style="{ StaticResource ResourceKey=Insignia.Alerta }"
													VerticalAlignment="Center"
													Visibility="{ Binding Path=Resumen.EsRecursante, Converter={ StaticResource ResourceKey=visibilidad } }">
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
														   Text="RECURSANTE"/>
											</Border>
										</Grid>

										<!-- Promedio y asistencia, lado a lado -->
										<Grid Margin="0 18 0 0"
											  Visibility="{ Binding Path=Resumen.TieneTrayectoria, Converter={ StaticResource ResourceKey=visibilidad } }">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>

											<StackPanel Grid.Column="0" Margin="0 0 12 0">
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
														   Text="{ Binding Path=Resumen.CicloLectivo, StringFormat='PROMEDIO {0}' }"/>
												<TextBlock Margin="0 2 0 0"
														   Style="{ StaticResource ResourceKey=Txt.Titulo }"
														   Text="{ Binding Path=Resumen.Promedio }"/>
												<TextBlock HorizontalAlignment="Left"
														   Margin="0 4 0 0"
														   MaxWidth="260"
														   Style="{ StaticResource ResourceKey=Txt.Detalle }"
														   Text="{ Binding Path=Resumen.DetalleCalificaciones }"
														   TextWrapping="Wrap"/>
											</StackPanel>

											<StackPanel Grid.Column="1">
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
														   Text="{ Binding Path=Resumen.CicloLectivo, StringFormat='ASISTENCIA {0}' }"/>
												<TextBlock Margin="0 2 0 0"
														   Style="{ StaticResource ResourceKey=Txt.Titulo }"
														   Text="{ Binding Path=Resumen.PorcentajeAsistencia }"/>
												<TextBlock HorizontalAlignment="Left"
														   Margin="0 4 0 0"
														   MaxWidth="260"
														   Style="{ StaticResource ResourceKey=Txt.Detalle }"
														   Text="{ Binding Path=Resumen.DetalleAsistencia }"
														   TextWrapping="Wrap"/>
											</StackPanel>
										</Grid>
									</StackPanel>
								</Border>
								<!--#endregion-->

								<!--#region DATOS PERSONALES-->
								<Border Margin="0 12 0 0"
										Style="{ StaticResource ResourceKey=Superficie.Seccion }">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<TextBlock Grid.Column="0" Grid.Row="0"
												   Margin="0 0 24 10"
												   Style="{ StaticResource ResourceKey=Txt.Seccion }"
												   Text="NACIMIENTO"/>
										<TextBlock Grid.Column="1" Grid.Row="0"
												   Margin="0 0 0 10"
												   Style="{ StaticResource ResourceKey=Txt.Dato }"
												   Text="{ Binding Path=AlumnoSeleccionado.FechaNacimiento, TargetNullValue='—' }"/>

										<TextBlock Grid.Column="0" Grid.Row="1"
												   Margin="0 0 24 10"
												   Style="{ StaticResource ResourceKey=Txt.Seccion }"
												   Text="SEXO"/>
										<TextBlock Grid.Column="1" Grid.Row="1"
												   Margin="0 0 0 10"
												   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
												   Text="{ Binding Path=AlumnoSeleccionado.Sexo, TargetNullValue='—' }"/>

										<TextBlock Grid.Column="0" Grid.Row="2"
												   Margin="0 0 24 0"
												   Style="{ StaticResource ResourceKey=Txt.Seccion }"
												   Text="NACIONALIDAD"/>
										<TextBlock Grid.Column="1" Grid.Row="2"
												   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
												   Text="{ Binding Path=AlumnoSeleccionado.Nacionalidad, TargetNullValue='—' }"/>
									</Grid>
								</Border>
								<!--#endregion-->
							</StackPanel>
						</ScrollViewer>

						<!--#region ACCIONES-->
						<Grid Grid.Row="2" Margin="0 20 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0"
									Command="{ Binding Path=EliminarCommand }"
									Content="Eliminar"
									Style="{ StaticResource ResourceKey=Btn.Peligro }"
									ToolTip="Eliminar este alumno"/>

							<StackPanel Grid.Column="1"
										HorizontalAlignment="Right"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Perfil"
										Content="Perfil"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Datos personales, materias, asistencia y trayectoria"/>
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Asignar"
										Content="Inscribir"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Inscribir el alumno en una división"/>
							</StackPanel>
						</Grid>
						<!--#endregion-->
					</Grid>
				</Grid>
				<!--#endregion-->

				<components:CargandoComponent Grid.Column="0"
											  Grid.ColumnSpan="3"
											  EstaCargando="{ Binding Path=BuscarCommand.IsRunning }"
											  Leyenda="BUSCANDO ALUMNOS"/>
			</Grid>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

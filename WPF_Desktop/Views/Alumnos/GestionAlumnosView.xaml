<UserControl x:Class="WPF_Desktop.Views.Alumnos.GestionAlumnosView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Alumnos"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		ALUMNOS NO TIENE ÍNDICE, Y ES UNA LIMITACIÓN DE LA CAPA DE APLICACIÓN, NO DE DISEÑO.

		IServicioAlumno no expone ningún "listar alumnos": BuscarPorDNIAsync y
		BuscarPorNombreCompletoAsync devuelven UNA PersonaResponse, no una colección. Mientras
		eso sea así, la pantalla no puede mostrar el listado que sí muestran Docentes y
		Cursos, y la búsqueda por documento exacto es el único camino.

		Lo que sí se arregla: la pantalla ahora DICE que funciona por documento exacto, en vez
		de presentar un campo vacío y un "Debe buscar un alumno para proceder" que no explica
		con qué dato buscar ni por qué no hay lista.
	-->
	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="Alumnos"
							   Subtitle="Búsqueda por documento, perfil e inscripción a una división"/>

			<Button Grid.Column="1"
					Command="{ Binding Path=NavigationCommand }"
					CommandParameter="Registrar"
					Style="{ StaticResource ResourceKey=Btn.Primario }"
					ToolTip="Dar de alta un alumno nuevo"
					VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<fa:IconBlock FontSize="11"
								  Icon="Plus"
								  Margin="0 0 8 0"
								  VerticalAlignment="Center"/>
					<TextBlock Text="Registrar alumno" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>
		<!--#endregion-->

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid Margin="28 24">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!--#region BÚSQUEDA-->
				<StackPanel Grid.Row="0" MaxWidth="520" HorizontalAlignment="Left">
					<Label Content="Documento del alumno"
						   Style="{ StaticResource ResourceKey=Lbl.Campo }"
						   Target="{ Binding ElementName=CampoDocumento }"/>
					<StackPanel Orientation="Horizontal">
						<TextBox x:Name="CampoDocumento"
								 Tag="8 dígitos, sin puntos"
								 Text="{ Binding Path=Documento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
								 Style="{ StaticResource ResourceKey=Txb.Campo }"
								 Width="220"/>
						<Button Command="{ Binding Path=BuscarCommand }"
								Content="Buscar"
								IsDefault="True"
								Margin="8 0 0 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"/>
					</StackPanel>
					<TextBlock Margin="0 8 0 0"
							   Style="{ StaticResource ResourceKey=Txt.Detalle }"
							   Text="El documento tiene que coincidir exacto: por ahora no hay listado ni búsqueda parcial de alumnos."
							   TextWrapping="Wrap"/>
				</StackPanel>
				<!--#endregion-->

				<!--#region RESULTADO-->
				<Grid Grid.Row="1" Margin="0 24 0 0">
					<!-- Sin resultado: el mensaje del ViewModel, con el mismo peso que una ficha vacía. -->
					<Border HorizontalAlignment="Left"
							Style="{ StaticResource ResourceKey=Superficie.Aviso }"
							VerticalAlignment="Top"
							Visibility="{ Binding Path=ExisteAlumno, Converter={ StaticResource ResourceKey=visibilidadInversa } }">
						<TextBlock MaxWidth="460"
								   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
								   Text="{ Binding Path=Message }"
								   TextWrapping="Wrap"/>
					</Border>

					<Grid Visibility="{ Binding Path=ExisteAlumno, Converter={ StaticResource ResourceKey=visibilidad } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!--#region FICHA-->
						<StackPanel Grid.Row="0" Orientation="Horizontal">
							<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
									   Margin="0 2 14 2"
									   VerticalAlignment="Stretch"
									   Width="3"/>
							<StackPanel>
								<TextBlock Style="{ StaticResource ResourceKey=Txt.Identificador }"
										   Text="{ Binding Path=PersonaResponse.Documento, StringFormat='DNI {0}' }"/>
								<TextBlock Margin="0 2 0 0"
										   Style="{ StaticResource ResourceKey=Txt.Titulo }">
									<Run Text="{ Binding Path=PersonaResponse.Apellido, Mode=OneWay }"/><Run Text=","/>
									<Run Text="{ Binding Path=PersonaResponse.Nombre, Mode=OneWay }"/>
								</TextBlock>
							</StackPanel>
						</StackPanel>
						<!--#endregion-->

						<!--#region DATOS-->
						<Border Grid.Row="1"
								Margin="0 20 0 0"
								Style="{ StaticResource ResourceKey=Superficie.Seccion }"
								VerticalAlignment="Top">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Column="0" Grid.Row="0"
										   Margin="0 0 24 10"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="NACIMIENTO"/>
								<TextBlock Grid.Column="1" Grid.Row="0"
										   Margin="0 0 0 10"
										   Style="{ StaticResource ResourceKey=Txt.Dato }"
										   Text="{ Binding Path=PersonaResponse.FechaNacimiento, TargetNullValue='—' }"/>

								<TextBlock Grid.Column="0" Grid.Row="1"
										   Margin="0 0 24 10"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="SEXO"/>
								<TextBlock Grid.Column="1" Grid.Row="1"
										   Margin="0 0 0 10"
										   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
										   Text="{ Binding Path=PersonaResponse.Sexo, TargetNullValue='—' }"/>

								<TextBlock Grid.Column="0" Grid.Row="2"
										   Margin="0 0 24 0"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="NACIONALIDAD"/>
								<TextBlock Grid.Column="1" Grid.Row="2"
										   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
										   Text="{ Binding Path=PersonaResponse.Nacionalidad, TargetNullValue='—' }"/>
							</Grid>
						</Border>
						<!--#endregion-->

						<!--#region ACCIONES-->
						<Grid Grid.Row="2" Margin="0 20 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0"
									Command="{ Binding Path=EliminarCommand }"
									Content="Eliminar"
									Style="{ StaticResource ResourceKey=Btn.Peligro }"
									ToolTip="Eliminar este alumno"/>

							<StackPanel Grid.Column="1"
										HorizontalAlignment="Right"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Perfil"
										Content="Perfil"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Datos personales, domicilio y contacto"/>
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Asignar"
										Content="Inscribir"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Inscribir el alumno en una división"/>
							</StackPanel>
						</Grid>
						<!--#endregion-->
					</Grid>
				</Grid>
				<!--#endregion-->
			</Grid>
		</Border>
	</Grid>
</UserControl>

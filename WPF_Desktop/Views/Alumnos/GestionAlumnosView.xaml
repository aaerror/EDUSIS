<UserControl x:Class="WPF_Desktop.Views.Alumnos.GestionAlumnosView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Alumnos"
			 
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:viewModel="clr-namespace:WPF_Desktop.ViewModels.Alumnos"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region RESOURCES-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
		<converters:InvertBooleanConverter x:Key="invertBooleanConverter"/>
	</UserControl.Resources>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<!--#region TITTLE AND SUBTITLE-->
		<components:Header Grid.Row="0"
						   Title="Alumnos"
						   Subtitle="Altas, Bajas y Modificaciones"/>
		<!--#endregion-->

		<!--#region COMMANDs-->
		<Grid Grid.Row="1"
			  Margin="25 10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!--#region COMMANDs-->
			<WrapPanel Grid.Column="0"
					   HorizontalAlignment="Left">
				<!--#region NavigationCommand: Registrar-->
				<Button Command="{ Binding Path=NavigationCommand }"
						CommandParameter="Registrar"
						Margin="0 0 5 0"
						ToolTip="Registrar Alumno"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="Plus"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="0 0 2 0"/>
							<TextBlock Text="Registrar"
									   Margin="2 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
				<!--#region NavigationCommand: AsignarCurso-->
				<Button Command="{ Binding Path=NavigationCommand }"
						CommandParameter="Asignar"
						Margin="5 0 5 0"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="PeopleGroup"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="0 0 2 0"/>
							<TextBlock Text="Asignar Curso"
									   Margin="2 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
			<WrapPanel Grid.Column="1"
					   HorizontalAlignment="Right">
				<!--#region ReporteCommand-->
				<Button Command="{ Binding Path=ReporteCommand }"
						Margin="5 0 0 0"
						ToolTip="Reporte"
						Style="{ StaticResource Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="AreaChart"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="0 0 2 0"/>
							<TextBlock Text="Reporte"
									   Margin="2 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->

		<!-- DETAILS -->
		<Border Grid.Row="2"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				Margin="20 10"
				Padding="10">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>
			<!-- SEARCH PANEL -->
			<Grid Margin="20 10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<!--#region Buscar-->
				<Grid Grid.Row="0"
					  HorizontalAlignment="Center"
					  Margin="0 0 0 5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<WrapPanel>
						<!--#region TextBox: Documento-->
						<TextBox Text="{ Binding Path=Documento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
								 Margin="0 0 5 0"
								 Tag="ingresar dni de alumno..."
								 Width="200"
								 Style="{ StaticResource ResourceKey=TextBox }"/>
						<!--#endregion-->
						<!--#region BuscarCommand-->
						<Button Command="{ Binding Path=BuscarCommand }"
								Margin="5 0 0 0"
								Style="{ StaticResource ResourceKey=Primary }">
							<Button.Content>
								<WrapPanel>
									<fa:IconBlock Icon="Search"/>
								</WrapPanel>
							</Button.Content>
						</Button>
						<!--#endregion-->
					</WrapPanel>
				</Grid>
				<!--#endregion-->

				<!--#region DatosPersonales-->
				<StackPanel Grid.Row="1"
							Margin="0 5 0 10">
					<!--#region Title-->
					<StackPanel Margin="0 0 0 2">
						<Label Style="{ StaticResource ResourceKey=Headline }">
							<Label.Content>
								<WrapPanel HorizontalAlignment="Center">
									<fa:IconBlock Icon="UserAlt"
												  Foreground="{ StaticResource ResourceKey=Neutral800 }"
												  Margin="0 0 2 0"/>
									<TextBlock Text="Datos Personales del Alumno"
											   Margin="2 0 0 2"/>
								</WrapPanel>
							</Label.Content>
						</Label>
						<Separator Background="{ StaticResource ResourceKey=Gray400 }"
								   Height=".8"
								   Width="Auto"/>
					</StackPanel>
					<!--#endregion-->

					<!--#region Message-->
					<StackPanel IsEnabled="{ Binding Path=ExisteAlumno, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=invertBooleanConverter } }"
								Margin="0 2 0 0"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }">
						<TextBlock Text="{ Binding Path=Message, UpdateSourceTrigger=PropertyChanged }"
								   Style="{ StaticResource ResourceKey=TextBlock_Body }"/>
					</StackPanel>
					<!--#endregion-->

					<!--#region DatosPersonales-->
					<StackPanel IsEnabled="{ Binding Path=ExisteAlumno, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
								Margin="0 2 0 0"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }">
						<components:InfoPersonalComponent PersonaID="{ Binding Path=PersonaResponse.PersonaID }"
														  Apellido="{ Binding Path=PersonaResponse.Apellido }"
														  Nombre="{ Binding Path=PersonaResponse.Nombre }"
														  Documento="{ Binding Path=PersonaResponse.Documento }"
														  Sexo="{ Binding Path=PersonaResponse.Sexo }"
														  FechaNacimiento="{ Binding Path=PersonaResponse.FechaNacimiento }"
														  Nacionalidad="{ Binding Path=PersonaResponse.Nacionalidad }"/>


						<!--#region Commands-->
						<Grid Grid.Row="2"
								Margin="0 10 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<WrapPanel Grid.Column="0"
										HorizontalAlignment="Left">
								<!--#region EliminarCommand-->
								<Button Command="{ Binding Path=EliminarCommand }"
										Background="{ StaticResource ResourceKey=Red500 }"
										Margin="0 0 0 0"
										ToolTip="Eliminar alumno"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
										Style="{ StaticResource ResourceKey=Tertiary }">
									<Button.Content>
										<fa:IconBlock Icon="Trash"
													Foreground="White"/>
									</Button.Content>
								</Button>
								<!--#endregion-->
							</WrapPanel>
							<WrapPanel Grid.Column="1"
										HorizontalAlignment="Right">
								<!--#region NavigationCommand: Perfil-->
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Perfil"
										Content="Perfil"
										Margin="0 0 0 0"
										ToolTip="Ir a peril"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
										Style="{ StaticResource Primary }"/>
								<!--#endregion-->
							</WrapPanel>
						</Grid>
						<!--#endregion-->
					</StackPanel>
					<!--#endregion-->
				</StackPanel>
				<!--#endregion-->
			</Grid>
		</Border>
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Alumnos.PerfilAlumnoView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Alumnos"

			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Tres bloques que se editan por separado, cada uno con su propio par cancelar/guardar.

		Antes cada bloque era un GroupBox con la plantilla de Windows y un Label de 17px por
		título, dentro de una tarjeta con sombra. Ahora el GroupBox es el recurso Seccion: una
		regla de 1px y el rótulo en versalita, el mismo corte que separa secciones en las
		pantallas de gestión.

		Los botones de cada bloque NO llevan regla propia: la de la sección ya marca el corte,
		y una regla por cada fila de botones deja la pantalla rayada de arriba a abajo.

		Se usa el converter visibilidad del tema en lugar de declarar un
		BooleanToVisibilityConverter por vista.
	-->
	<!--
		La carga se dispara con el mismo idioma que el perfil del docente: un comando, no un
		CallMethodAction contra un método suelto. Las dos pantallas son la misma sobre otra
		entidad y no tenían motivo para arrancar de dos maneras distintas.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarPerfilCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Perfil del alumno"
									Subtitulo="Situación académica, datos personales, contacto y domicilio. Cada bloque de datos se edita por separado."/>

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28 4 28 24">
					<!--#region SITUACIÓN ACADÉMICA
						VA PRIMERO Y NO SE EDITA. El perfil tenía tres bloques —personales,
						contacto y domicilio— y ninguno decía si el alumno estaba cursando: se
						podía abrir el perfil completo de alguien y no enterarse de que tenía
						seis materias y ochenta faltas.

						Es el único bloque sin par cancelar/guardar, y eso es lo que dice qué es:
						nada de acá se escribe desde esta pantalla. El promedio sale de las
						calificaciones que se cargan en la división y la asistencia de las
						planillas que toma el preceptor; acá se leen.

						Las dos cifras llevan el ciclo lectivo en el rótulo porque las dos son de
						un solo período, el de la inscripción vigente. Un "PROMEDIO" a secas
						obliga a adivinar si son las notas de este año o el acumulado de la
						escolaridad entera.
					-->
					<GroupBox Header="SITUACIÓN ACADÉMICA" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel Visibility="{ Binding Path=Resumen, Converter={ StaticResource ResourceKey=visibleSiHay } }">
							<!--#region QUÉ CURSA-->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">
									<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="CURSANDO"/>
									<TextBlock Margin="0 4 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Subtitulo }"
											   Text="{ Binding Path=Resumen.Cursada }"
											   TextWrapping="Wrap"/>
								</StackPanel>

								<Border Grid.Column="1"
										Style="{ StaticResource ResourceKey=Insignia.Alerta }"
										VerticalAlignment="Center"
										Visibility="{ Binding Path=Resumen.EsRecursante, Converter={ StaticResource ResourceKey=visibilidad } }">
									<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
											   Text="RECURSANTE"/>
								</Border>
							</Grid>
							<!--#endregion-->

							<!--#region PROMEDIO Y ASISTENCIA-->
							<Grid Margin="0 18 0 0"
								  Visibility="{ Binding Path=Resumen.TieneTrayectoria, Converter={ StaticResource ResourceKey=visibilidad } }">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0 0 16 0">
									<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="{ Binding Path=Resumen.CicloLectivo, StringFormat='PROMEDIO {0}' }"/>
									<TextBlock Margin="0 2 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Display }"
											   Text="{ Binding Path=Resumen.Promedio }"/>
									<TextBlock HorizontalAlignment="Left"
											   Margin="0 4 0 0"
											   MaxWidth="320"
											   Style="{ StaticResource ResourceKey=Txt.Detalle }"
											   Text="{ Binding Path=Resumen.DetalleCalificaciones }"
											   TextWrapping="Wrap"/>
								</StackPanel>

								<StackPanel Grid.Column="1">
									<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="{ Binding Path=Resumen.CicloLectivo, StringFormat='ASISTENCIA {0}' }"/>
									<TextBlock Margin="0 2 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Display }"
											   Text="{ Binding Path=Resumen.PorcentajeAsistencia }"/>
									<TextBlock HorizontalAlignment="Left"
											   Margin="0 4 0 0"
											   MaxWidth="320"
											   Style="{ StaticResource ResourceKey=Txt.Detalle }"
											   Text="{ Binding Path=Resumen.DetalleAsistencia }"
											   TextWrapping="Wrap"/>
								</StackPanel>
							</Grid>
							<!--#endregion-->

							<!--#region MATERIAS
								Una fila por materia y no por calificación: una materia tiene
								varias instancias —primera nota, recuperatorio, final— y la
								pregunta es cómo le va en Matemática, no qué sacó en el
								recuperatorio de agosto. El detalle instancia por instancia es
								el boletín, que ya se emite desde Documentación.
							-->
							<TextBlock Margin="0 20 0 8"
									   Style="{ StaticResource ResourceKey=Txt.Seccion }"
									   Text="MATERIAS DEL CICLO"
									   Visibility="{ Binding Path=Resumen.TieneTrayectoria, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							<ListView ItemsSource="{ Binding Path=Resumen.Materias }"
									  MaxHeight="260"
									  Style="{ StaticResource ResourceKey=Lista.Indice }"
									  Tag="Todavía no se le cargó ninguna calificación en este ciclo."
									  Visibility="{ Binding Path=Resumen.TieneTrayectoria, Converter={ StaticResource ResourceKey=visibilidad } }">
								<ListView.View>
									<GridView AllowsColumnReorder="False">
										<GridView.Columns>
											<!--
												El recuento de instancias rendidas y ausencias está
												en el ToolTip de la materia y no en su propia
												columna: las cinco columnas de nota ya ocupan el
												ancho que esa tenía, y es un dato de apoyo, no el
												que trae a nadie a esta tabla.
											-->
											<GridViewColumn Header="MATERIA" Width="190">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=Materia, TargetNullValue='Sin datos' }"
																   TextTrimming="CharacterEllipsis"
																   ToolTip="{ Binding Path=Instancias }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<!--
												Una columna por período, con la nota VIGENTE de cada
												uno: si hubo recuperatorio es la del recuperatorio,
												porque reemplaza a la original. Las dos
												recuperaciones comparten columna —a la segunda se
												llega sólo después de no aprobar la primera—.
											-->
											<GridViewColumn Header="1° CUAT." Width="64">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=PrimerCuatrimestre }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="2° CUAT." Width="64">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=SegundoCuatrimestre }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="FINAL" Width="64">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=Final }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="RECUP." Width="72">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=Recuperacion }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<!-- La que decide la condición, y por eso la única destacada. -->
											<GridViewColumn Header="CIERRE" Width="72">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.DatoFuerte }"
																   Text="{ Binding Path=NotaDeCierre }"
																   ToolTip="La nota con la que cierra la materia"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="ESTADO" Width="130">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<!--
															Dos insignias excluyentes y no una con el
															brush bindeado: el color ES el estado, y
															un converter de bool a brush lo escondería
															detrás de una clave de recurso. Las dos
															leen el mismo Estado, así que el texto se
															decide en un solo lugar.
														-->
														<Grid>
															<Border Style="{ StaticResource ResourceKey=Insignia.Activa }"
																	Visibility="{ Binding Path=Aprobada, Converter={ StaticResource ResourceKey=visibilidad } }">
																<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
																		   Text="{ Binding Path=Estado }"/>
															</Border>
															<Border Style="{ StaticResource ResourceKey=Insignia.Alerta }"
																	Visibility="{ Binding Path=Aprobada, Converter={ StaticResource ResourceKey=visibilidadInversa } }">
																<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
																		   Text="{ Binding Path=Estado }"/>
															</Border>
														</Grid>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
										</GridView.Columns>
									</GridView>
								</ListView.View>
							</ListView>
							<!--#endregion-->

							<!--#region TRAYECTORIA
								Todas las inscripciones, de la más reciente a la más vieja. El
								traslado de división se modela como cerrar la inscripción actual
								y abrir otra, así que un alumno trasladado tiene más de una fila
								en el mismo ciclo: la vigente y la cerrada.
							-->
							<TextBlock Margin="0 20 0 8"
									   Style="{ StaticResource ResourceKey=Txt.Seccion }"
									   Text="TRAYECTORIA"/>
							<ListView ItemsSource="{ Binding Path=Resumen.Trayectoria }"
									  MaxHeight="220"
									  Style="{ StaticResource ResourceKey=Lista.Indice }"
									  Tag="Todavía no está inscripto en ninguna división.">
								<ListView.View>
									<GridView AllowsColumnReorder="False">
										<GridView.Columns>
											<GridViewColumn Header="CICLO" Width="86">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Dato }"
																   Text="{ Binding Path=CicloLectivo }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="CURSO" Width="150">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=Grado, Converter={ StaticResource ResourceKey=grado } }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="DIVISIÓN" Width="100">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
																   Text="{ Binding Path=Division }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="DESDE" Width="110">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Dato }"
																   Text="{ Binding Path=FechaInicio, StringFormat=d }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="HASTA" Width="110">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<TextBlock Style="{ StaticResource ResourceKey=Txt.Dato }"
																   Text="{ Binding Path=FechaFin, StringFormat=d, TargetNullValue='—' }"/>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
											<GridViewColumn Header="ESTADO" Width="120">
												<GridViewColumn.CellTemplate>
													<DataTemplate>
														<Grid>
															<Border Style="{ StaticResource ResourceKey=Insignia.Activa }"
																	Visibility="{ Binding Path=EstaActiva, Converter={ StaticResource ResourceKey=visibilidad } }">
																<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
																		   Text="{ Binding Path=Estado }"/>
															</Border>
															<Border Style="{ StaticResource ResourceKey=Insignia }"
																	Visibility="{ Binding Path=EstaActiva, Converter={ StaticResource ResourceKey=visibilidadInversa } }">
																<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
																		   Text="{ Binding Path=Estado }"/>
															</Border>
														</Grid>
													</DataTemplate>
												</GridViewColumn.CellTemplate>
											</GridViewColumn>
										</GridView.Columns>
									</GridView>
								</ListView.View>
							</ListView>
							<!--#endregion-->
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region INFORMACIÓN PERSONAL-->
					<GroupBox Header="INFORMACIÓN PERSONAL" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel>
							<components:InfoPersonalComponent Apellido="{ Binding Path=Alumno.Apellido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  Documento="{ Binding Path=Alumno.Documento }"
															  EstaHabilitado="{ Binding Path=HabilitarEditarSexo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  FechaNacimiento="{ Binding Path=Alumno.FechaNacimiento }"
															  Nacionalidad="{ Binding Path=Alumno.Nacionalidad }"
															  Nombre="{ Binding Path=Alumno.Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  Sexo="{ Binding Path=Alumno.Sexo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 4 0 0"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=EditarCommand }"
										CommandParameter="Sexo"
										Content="Editar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Editar los datos personales"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Sexo"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										Visibility="{ Binding Path=HabilitarEditarSexo, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Sexo"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										Visibility="{ Binding Path=HabilitarEditarSexo, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region CONTACTO-->
					<GroupBox Header="CONTACTO" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel>
							<components:InfoContactoComponent Email="{ Binding Path=Alumno.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  EstaHabilitado="{ Binding Path=HabilitarEditarContacto, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  Telefono="{ Binding Path=Alumno.Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 4 0 0"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=EditarCommand }"
										CommandParameter="Contacto"
										Content="Editar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Editar el teléfono y el correo"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Contacto"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										Visibility="{ Binding Path=HabilitarEditarContacto, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Contacto"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										Visibility="{ Binding Path=HabilitarEditarContacto, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region DOMICILIO-->
					<GroupBox Header="DOMICILIO" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel>
							<components:InfoDireccionDomicilioComponent Altura="{ Binding Path=Alumno.Altura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Calle="{ Binding Path=Alumno.Calle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		EstaHabilitado="{ Binding Path=HabilitarEditarDomicilio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																		Observacion="{ Binding Path=Alumno.Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Vivienda="{ Binding Path=Alumno.Vivienda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<components:InfoUbicacionDomicilioComponent EstaHabilitado="{ Binding Path=HabilitarEditarDomicilio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																		Localidad="{ Binding Path=Alumno.Localidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Pais="{ Binding Path=Alumno.Pais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Provincia="{ Binding Path=Alumno.Provincia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 4 0 0"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=EditarCommand }"
										CommandParameter="Domicilio"
										Content="Editar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Editar el domicilio"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Domicilio"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										Visibility="{ Binding Path=HabilitarEditarDomicilio, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Domicilio"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										Visibility="{ Binding Path=HabilitarEditarDomicilio, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->
				</StackPanel>
			</ScrollViewer>

			<components:CargandoComponent EstaCargando="{ Binding Path=CargarPerfilCommandAsync.IsRunning }"
										  Leyenda="CARGANDO EL PERFIL"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>

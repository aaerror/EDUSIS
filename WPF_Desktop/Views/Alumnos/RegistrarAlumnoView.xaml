<UserControl x:Class="WPF_Desktop.Views.Alumnos.RegistrarAlumnoView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Alumnos"

			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:cursoViews="clr-namespace:WPF_Desktop.Views.Cursos"
			 xmlns:divisionViews="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:shared="clr-namespace:WPF_Desktop.Views.Shared"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		ALTA EN DOS PASOS.

		El TabControl no son pestañas: es un recorrido donde el ViewModel manda el índice y
		deshabilita los encabezados, así que no se puede saltar de uno a otro con el mouse. Acá
		el orden carga información —no se inscribe a alguien que todavía no existe como
		persona—, y por eso el paso va numerado.

		La tarjeta llevaba una DropShadowEffect y su propio borde gris. Se va la sombra, como
		en el resto de la app: la jerarquía la dan el fondo y las reglas de 1px, y cada
		DropShadowEffect es un pase de render extra.
	-->
	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<components:Header Grid.Row="0"
						   Margin="0 0 0 20"
						   Title="Alumnos"
						   Subtitle="Alta de un alumno nuevo, en dos pasos"/>

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<TabControl Margin="28 20 28 24"
						SelectedIndex="{ Binding Path=Tab, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						Style="{ StaticResource ResourceKey=Pestanas }">
				<!--#region PASO 01: DATOS PERSONALES-->
				<TabItem Header="DATOS PERSONALES"
						 IsEnabled="False"
						 Tag="01">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<!-- La separación entre columnas es una columna, no un margen por vista. -->
								<ColumnDefinition Width="28"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<shared:InformacionPersonalView Grid.Column="0" Grid.Row="0"
															DataContext="{ Binding Path=InformacionPersonal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															Validation.ErrorTemplate="{ x:Null }"
															VerticalAlignment="Top"/>

							<shared:DomicilioView Grid.Column="2" Grid.Row="0"
												  DataContext="{ Binding Path=Domicilio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												  Validation.ErrorTemplate="{ x:Null }"
												  VerticalAlignment="Top"/>

							<shared:ContactoView Grid.ColumnSpan="3" Grid.Row="1"
												 DataContext="{ Binding Path=Contacto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												 Validation.ErrorTemplate="{ x:Null }"/>

							<!--#region ACCIONES-->
							<Border Grid.ColumnSpan="3" Grid.Row="2"
									Style="{ StaticResource ResourceKey=Superficie.Seccion }">
								<Button Command="{ Binding Path=ContinuarCommand }"
										Content="Continuar"
										HorizontalAlignment="Right"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										ToolTip="Guardar los datos personales y pasar a la inscripción"/>
							</Border>
							<!--#endregion-->
						</Grid>
					</ScrollViewer>
				</TabItem>
				<!--#endregion-->

				<!--#region PASO 02: INSTITUCIÓN-->
				<TabItem Header="INSTITUCIÓN"
						 IsEnabled="True"
						 Tag="02">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<GroupBox Header="INSCRIPCIÓN EN EL CURSO" Style="{ StaticResource ResourceKey=Seccion }">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="28"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!--#region CURSO-->
									<HeaderedContentControl Grid.Column="0" Grid.Row="0"
														   Header="Curso"
														   Style="{ StaticResource ResourceKey=Campo }">
										<ComboBox x:Name="ComboBox_Cursos"
												  ItemsSource="{ Binding Path=Cursos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
												  SelectedItem="{ Binding Path=Curso, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												  Style="{ StaticResource ResourceKey=Cmb.Campo }">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal">
														<TextBlock Margin="0 0 4 0"
																   Text="{ Binding Path=Grado, StringFormat={}{0}° Año }"/>
														<TextBlock Text="{ Binding Path=NivelEducativo, StringFormat={}({0}) }"/>
													</StackPanel>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</HeaderedContentControl>

									<Expander Grid.Column="0" Grid.Row="1"
											  Header="DETALLE DEL CURSO"
											  Margin="0 0 0 16"
											  Style="{ StaticResource ResourceKey=Desplegable }">
										<cursoViews:CursoView DataContext="{ Binding Path=SelectedItem, ElementName=ComboBox_Cursos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  IsEnabled="False"/>
									</Expander>
									<!--#endregion-->

									<!--#region DIVISIÓN-->
									<HeaderedContentControl Grid.Column="2" Grid.Row="0"
														   Header="División"
														   Style="{ StaticResource ResourceKey=Campo }">
										<ComboBox x:Name="ComboBox_Divisiones"
												  ItemsSource="{ Binding Path=Divisiones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
												  SelectedItem="{ Binding Path=Division, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												  Style="{ StaticResource ResourceKey=Cmb.Campo }">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{ Binding Path=Descripcion }"/>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</HeaderedContentControl>

									<Expander Grid.Column="2" Grid.Row="1"
											  Header="DETALLE DE LA DIVISIÓN"
											  Margin="0 0 0 16"
											  Style="{ StaticResource ResourceKey=Desplegable }">
										<divisionViews:DivisionView DataContext="{ Binding Path=SelectedItem, ElementName=ComboBox_Divisiones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																	IsEnabled="False"/>
									</Expander>
									<!--#endregion-->

									<HeaderedContentControl Grid.Column="0" Grid.Row="2"
														   Header="Ciclo lectivo"
														   Style="{ StaticResource ResourceKey=Campo }">
										<TextBox MaxLength="4"
												 Tag="2026"
												 Text="{ Binding Path=Periodo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
									</HeaderedContentControl>
								</Grid>
							</GroupBox>

							<!--#region ACCIONES
								Volver a la izquierda y confirmar a la derecha, como en las
								pantallas de gestión. Antes los dos botones iban juntos contra
								el margen derecho con medio margen cada uno, así que "Atras"
								quedaba al lado de "Guardar" como si fueran alternativas del
								mismo peso.
							-->
							<Border Style="{ StaticResource ResourceKey=Superficie.Seccion }">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Button Grid.Column="0"
											Command="{ Binding Path=AtrasCommand }"
											Content="Atrás"
											Style="{ StaticResource ResourceKey=Btn.Terciario }"
											ToolTip="Volver a los datos personales"/>

									<Button Grid.Column="1"
											Command="{ Binding Path=GuardarCommand }"
											Content="Guardar"
											HorizontalAlignment="Right"
											Style="{ StaticResource ResourceKey=Btn.Primario }"
											ToolTip="Dar de alta el alumno con esta inscripción"/>
								</Grid>
							</Border>
							<!--#endregion-->
						</StackPanel>
					</ScrollViewer>
				</TabItem>
				<!--#endregion-->
			</TabControl>
		</Border>
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Alumnos.InscripcionAlumnoView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Alumnos"

			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:viewModel="clr-namespace:WPF_Desktop.ViewModels.Alumnos"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		EL MENSAJE DEJA DE SER UNA TARJETA.

		Venía en una tarjeta propia, con sombra, borde, y un encabezado centrado con ícono que
		decía "Notificaciones": una caja del tamaño de la del formulario para mostrar una línea
		de texto, y un rótulo que nombra el continente en lugar de decir qué pasó. Ahora es el
		aviso en línea del sistema —Superficie.Aviso, la barra de 3px al margen—, el mismo que
		usa la búsqueda de alumnos cuando no encuentra a nadie.
	-->
	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<components:Header Grid.Row="0"
						   Margin="0 0 0 20"
						   Title="Inscribir alumno"
						   Subtitle="Inscribir al alumno seleccionado en una división"/>

		<Border Grid.Row="1"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				VerticalAlignment="Top">
			<StackPanel Margin="28 24">
				<Border Margin="0 0 0 20"
						Style="{ StaticResource ResourceKey=Superficie.Aviso }"
						Visibility="{ Binding Path=HabilitarMessage, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
					<TextBlock MaxWidth="560"
							   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
							   Text="{ Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							   TextWrapping="Wrap"/>
				</Border>

				<GroupBox Header="INSCRIPCIÓN EN EL CURSO" Style="{ StaticResource ResourceKey=Seccion }">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<HeaderedContentControl Grid.Column="0" Grid.Row="0"
											   Header="Curso"
											   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
							<ComboBox ItemsSource="{ Binding Path=Cursos, Mode=OneWay }"
									  SelectedItem="{ Binding Path=Curso, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									  Style="{ StaticResource ResourceKey=Cmb.Campo }">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Margin="0 0 4 0"
													   Text="{ Binding Path=Grado, StringFormat={}{0}° Año }"/>
											<TextBlock Text="{ Binding Path=NivelEducativo, StringFormat={}({0}) }"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</HeaderedContentControl>

						<HeaderedContentControl Grid.Column="1" Grid.Row="0"
											   Header="División"
											   Style="{ StaticResource ResourceKey=Campo.Derecha }">
							<ComboBox ItemsSource="{ Binding Path=Divisiones, Mode=OneWay }"
									  SelectedItem="{ Binding Path=Division, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									  Style="{ StaticResource ResourceKey=Cmb.Campo }">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{ Binding Path=Descripcion }"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</HeaderedContentControl>

						<HeaderedContentControl Grid.Column="0" Grid.Row="1"
											   Header="Ciclo lectivo"
											   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
							<TextBox IsReadOnly="True"
									 Text="{ Binding Path=Periodo, Mode=OneWay }"
									 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
						</HeaderedContentControl>

						<!-- Chk.Campo.Alineada baja la casilla hasta la línea de los campos de la fila. -->
						<!-- "Recursante" es el término de la institución: no se reemplaza por una paráfrasis. -->
						<CheckBox Grid.Column="1" Grid.Row="1"
								  Content="Recursante"
								  IsChecked="{ Binding Path=EsRecursante, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
								  Margin="10 0 0 16"
								  Style="{ StaticResource ResourceKey=Chk.Campo.Alineada }"/>
					</Grid>
				</GroupBox>

				<Border Style="{ StaticResource ResourceKey=Superficie.Seccion }">
					<Button Command="{ Binding Path=InscribirCommand }"
							Content="Inscribir"
							HorizontalAlignment="Right"
							Style="{ StaticResource ResourceKey=Btn.Primario }"
							ToolTip="Inscribir el alumno en esta división"/>
				</Border>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>

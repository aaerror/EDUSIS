<UserControl x:Class="WPF_Desktop.Views.Cursos.RegistrarCursoView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos"

			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

			 xmlns:cursoDomain="clr-namespace:Domain.Cursos;assembly=Domain"
			 xmlns:domainShared="clr-namespace:Domain.Shared;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Un curso son DOS datos. La pantalla usaba el ancho completo con los rótulos alineados a
		la derecha en su propia columna —el único lugar de la app que lo hacía— y gastaba una
		fila entera arriba en un botón de navegación. Ahora los dos campos van en un bloque
		angosto, como la búsqueda de alumnos, y la navegación sube al lado del encabezado,
		donde está en las pantallas de gestión.
	-->
	<UserControl.Resources>
		<converters:GradoConverter x:Key="gradoConverter"/>
		<converters:NivelEducativoConverter x:Key="nivelEducativoConverter"/>

		<ObjectDataProvider x:Key="grados" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="cursoDomain:Grado"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>

		<ObjectDataProvider x:Key="nivelEducativo" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainShared:NivelEducativo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="Cursos"
							   Subtitle="Alta de un curso nuevo"/>

			<Button Grid.Column="1"
					Command="{ Binding Path=NavigationCommand }"
					CommandParameter="Curso"
					Style="{ StaticResource ResourceKey=Btn.Terciario }"
					ToolTip="Volver al listado de cursos"
					VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Ir a cursos" VerticalAlignment="Center"/>
					<fa:IconBlock FontSize="11"
								  Icon="ArrowRightLong"
								  Margin="8 0 0 0"
								  VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>

		<Border Grid.Row="1"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				VerticalAlignment="Top">
			<StackPanel HorizontalAlignment="Left"
						Margin="28 24"
						MaxWidth="420">
				<HeaderedContentControl Header="Grado" Style="{ StaticResource ResourceKey=Campo }">
					<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=grados } }"
							  SelectedItem="{ Binding Path=Grado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=gradoConverter } }"
							  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
				</HeaderedContentControl>

				<HeaderedContentControl Header="Nivel educativo" Style="{ StaticResource ResourceKey=Campo }">
					<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=nivelEducativo } }"
							  SelectedItem="{ Binding Path=NivelEducativo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=nivelEducativoConverter } }"
							  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
				</HeaderedContentControl>

				<Border Style="{ StaticResource ResourceKey=Superficie.Seccion }">
					<Button Command="{ Binding Path=RegistrarCommand }"
							Content="Guardar"
							HorizontalAlignment="Right"
							Style="{ StaticResource ResourceKey=Btn.Primario }"
							ToolTip="Dar de alta el curso"/>
				</Border>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>

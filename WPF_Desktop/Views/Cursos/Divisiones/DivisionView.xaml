<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.DivisionView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		FICHA DE LA DIVISIÓN — se lee, no se edita. Los tres enlaces son Mode=OneWay.

		Se sacó el bloque "División ID": Visibility="Collapsed" fija, como el PersonaID de la
		ficha personal y el PuestoID del puesto docente. La propiedad sigue en el ViewModel.

		"Cantidad de Alumnos" mostraba la propiedad Cursantes con dos textos distintos para la
		falta de dato ("Listado de alumnos sin detalles" y "Sin datos del listado de alumnos").
		Queda uno solo, y el rótulo dice qué se cuenta.
	-->
	<GroupBox Header="DIVISIÓN" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<HeaderedContentControl Grid.Column="0" Grid.Row="0"
									Content="{ Binding Path=Descripcion, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
									Header="División"
									Style="{ StaticResource ResourceKey=Dato.Izquierda }"/>

			<HeaderedContentControl Grid.Column="1" Grid.Row="0"
									Content="{ Binding Path=Preceptor, Mode=OneWay, FallbackValue='Sin asignar', TargetNullValue='Sin asignar' }"
									Header="Preceptor"
									Style="{ StaticResource ResourceKey=Dato.Derecha }"/>

			<HeaderedContentControl Grid.Column="0" Grid.Row="1"
									Header="Alumnos inscriptos"
									Style="{ StaticResource ResourceKey=Dato.Izquierda }">
				<TextBlock Style="{ StaticResource ResourceKey=Txt.Dato }"
						   Text="{ Binding Path=Cursantes, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"/>
			</HeaderedContentControl>
		</Grid>
	</GroupBox>
</UserControl>

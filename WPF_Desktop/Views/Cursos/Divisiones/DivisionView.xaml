<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.DivisionView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"

			 xmlns:divisiones="clr-namespace:WPF_Desktop.ViewModels.Cursos.Divisiones"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0"
					Margin="0 0 0 10"
					Visibility="Collapsed">
			<!--#region DIVISION ID-->
			<Label Content="División ID"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=DivisionID, FallbackValue='Sin información', TargetNullValue='Sin información', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					 IsReadOnly="True"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
			<!--#endregion-->
		</StackPanel>

		<Grid Grid.Row="1"
			  Margin="0 0 0 5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!--#region DIVISIÓN-->
			<StackPanel Grid.Column="0"
						Margin="0 0 10 0">
				<Label Content="División"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=Descripcion, FallbackValue='Sin información', TargetNullValue='Sin información', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region PRECEPTOR-->
			<StackPanel Grid.Column="1"
						Margin="10 0 0 0">
				<Label Content="Preceptor"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=Docente, FallbackValue='Preceptor sin asignar', TargetNullValue='Preceptor sin asignar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->
		</Grid>

		<Grid Grid.Row="2"
			  Margin="0 5 0 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!--#region CANT. DE ALUMNOS-->
			<StackPanel Grid.Column="0"
						Margin="0 0 10 0">
				<Label Content="Cantidad de Alumnos"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=Alumnos, FallbackValue='Listado de alumnos sin detalles', TargetNullValue='Sin datos del listado de alumnos', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->
		</Grid>
	</Grid>
</UserControl>
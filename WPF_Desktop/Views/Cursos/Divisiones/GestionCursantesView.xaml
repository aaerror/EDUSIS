<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.GestionCursantesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:domainCalificaciones="clr-namespace:Domain.Cursantes.Calificaciones;assembly=Domain"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		ALUMNOS DE LA DIVISIÓN.

		ÍNDICE + DETALLE, el esqueleto de GestionCursosView y GestionDocentesView: la tarjeta
		llena el alto disponible y no hay scroll de página, así que cada panel scrollea lo suyo
		y la rueda del mouse funciona en los dos lados. Antes era una columna de 1520px dentro
		de un viewport de 620, con tres grillas de alto fijo que se comían la rueda.

		EL DETALLE SON CUATRO VISTAS DEL MISMO ALUMNO, no cuatro secciones apiladas. El
		conmutador de arriba enlaza su Tag contra VistaDelAlumno con el converter esIgualA, el
		mismo mecanismo con el que el rail marca la sección abierta.

		Eso arregla dos cosas. Una: el historial se pedía con un botón y después NO HABÍA FORMA
		DE VOLVER —la sección aparecía y se quedaba—; ahora abrir la vista ES pedirla, y cerrarla
		es elegir otra. Dos: apiladas, las cuatro peleaban por el alto, y la que perdía siempre
		era la grilla de calificaciones, que es el trabajo diario. Cada vista se queda ahora con
		la fila * entera.

		INSCRIPCIÓN ES UNA VISTA Y NO UNA FRANJA porque mezclaba dos naturalezas en una fila.
		La condición de recursante es una CORRECCIÓN —lo único que el dominio deja editar de una
		inscripción—; la baja y el traslado son operaciones de CICLO DE VIDA que cierran y abren
		inscripciones. Estaban una al lado de la otra, sin nada que las distinguiera. Separadas
		por una regla y con su propio rótulo, se ve de qué clase es cada una.

		ASISTENCIAS CUENTA Y NO LISTA, y no es una decisión de diseño: ContarFaltasAsync es la
		única consulta de asistencias que acepta un cursante, porque el agregado es la planilla
		—división y fecha—. Listar por alumno necesita una consulta nueva en Core; está anotado
		en docs/ui-ux.md.
	-->
	<UserControl.Resources>
		<!--
			Los tramos del ciclo lectivo. Son los NOMBRES de los miembros porque es lo que viaja en
			el request; el texto que se lee lo pone el converter "periodo" en la plantilla de la
			lista. El recuperatorio no está acá: es una casilla aparte, porque es el segundo intento
			DENTRO de un período y hay cuatro posibles en un mismo ciclo.
		-->
		<ObjectDataProvider x:Key="periodos" MethodName="GetNames" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainCalificaciones:Periodo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>

		<!-- El número de un contador de asistencias: grande, y en cifras de ancho fijo para que los cuatro se comparen. -->
		<Style x:Key="Contador" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Display }">
			<Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
		</Style>
	</UserControl.Resources>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Alumnos de la división"
									Subtitulo="Inscripción, asistencias y calificaciones de cada alumno">
			<components:PaginaComponent.Accion>
				<Button Command="{ Binding Path=NuevaCalificacionCommand }"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Cargar una calificación al alumno elegido">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Cargar nota" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</components:PaginaComponent.Accion>
		</components:PaginaComponent>
		<!--#endregion-->

		<!--#region ALUMNOS-->
		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="280"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!--#region ÍNDICE
					Todo el bloque cuelga del margen de 12, que es el relleno que ya tienen las
					celdas de la grilla: rótulo, campo y nombres arrancan en la misma vertical.
				-->
				<Grid Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="12 18 12 0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<HeaderedContentControl Grid.Column="0"
												Header="Ciclo lectivo"
												Style="{ StaticResource ResourceKey=Campo.Izquierda }">
							<!--
								Enter busca. Es un campo de un solo dato con su botón al lado: el
								gesto esperado es tipear el año y apretar Enter, no salir a buscar
								el botón con el mouse.
							-->
							<TextBox MaxLength="4"
									 Tag="2026"
									 Text="{ Binding Path=CicloLectivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									 Style="{ StaticResource ResourceKey=Txb.Campo }">
								<TextBox.InputBindings>
									<KeyBinding Key="Enter" Command="{ Binding Path=BuscarCommandAsync }"/>
								</TextBox.InputBindings>
							</TextBox>
						</HeaderedContentControl>

						<Button Grid.Column="1"
								Command="{ Binding Path=BuscarCommandAsync }"
								Margin="10 0 0 16"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Listar los alumnos del ciclo"
								VerticalAlignment="Bottom">
							<StackPanel Orientation="Horizontal">
								<fa:IconBlock FontSize="11"
											  Icon="MagnifyingGlass"
											  Margin="0 0 8 0"
											  VerticalAlignment="Center"/>
								<TextBlock Text="Buscar" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>

					<TextBlock Grid.Row="1"
							   Margin="12 0 12 10"
							   Style="{ StaticResource ResourceKey=Txt.Seccion }"
							   Text="ALUMNOS CURSANDO"/>

					<DataGrid x:Name="DataGrid_Cursantes"
							  Grid.Row="2"
							  AutomationProperties.Name="Alumnos cursando"
							  ItemsSource="{ Binding Path=Cursantes, Mode=OneWay }"
							  SelectedItem="{ Binding Path=Cursante, Mode=TwoWay }"
							  Style="{ StaticResource ResourceKey=Grilla }"
							  Tag="Ningún alumno cursa este ciclo lectivo en esta división. Probá otro ciclo, o inscribilo desde Alumnos.">
						<DataGrid.Columns>
							<!--
								El documento y la edad se fueron a la ficha del detalle, que es
								donde se leen enteros. Acá la columna ancha es el nombre, que es
								por lo que se busca a alguien en una lista.
							-->
							<DataGridTextColumn Binding="{ Binding Path=NombreCompleto, Mode=OneTime }"
												ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
												Header="ALUMNO"
												Width="*"/>
							<DataGridTextColumn Binding="{ Binding Path=Documento, Mode=OneTime }"
												ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
												Header="DOCUMENTO"
												Width="Auto"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
				<!--#endregion-->

				<Rectangle Grid.Column="1" Style="{ StaticResource ResourceKey=Regla.Vertical }"/>

				<!--#region DETALLE DEL ALUMNO-->
				<Grid Grid.Column="2">
					<StackPanel HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay }, ConverterParameter=inverso }">
						<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
								   HorizontalAlignment="Center"
								   Style="{ StaticResource ResourceKey=Txt.Subtitulo }"
								   Text="Elegí un alumno"/>
						<TextBlock HorizontalAlignment="Center"
								   Margin="0 6 0 0"
								   MaxWidth="320"
								   Style="{ StaticResource ResourceKey=Txt.Detalle }"
								   Text="Acá se cargan sus calificaciones, se ve su asistencia y su historial, y se corrige su inscripción."
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>

					<Grid Margin="28 22"
						  Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<local:CursanteView Grid.Row="0"
											DataContext="{ Binding Path=Cursante, Mode=OneWay }"/>

						<!--#region CONMUTADOR DE VISTAS
							Cada pestaña enlaza su Tag contra VistaDelAlumno con esIgualA y
							Btn.Pestana lee ese booleano para pintarse el subrayado. La regla de
							abajo corre a lo ancho del panel, así que las pestañas se leen como
							el borde de una carpeta y no como cuatro botones sueltos.
						-->
						<Border Grid.Row="1"
								BorderBrush="{ StaticResource ResourceKey=Linea }"
								BorderThickness="0 0 0 1"
								Margin="0 20 0 16"
								SnapsToDevicePixels="True">
							<StackPanel Orientation="Horizontal">
								<Button Command="{ Binding Path=VerCommand }"
										CommandParameter="Calificaciones"
										Content="Calificaciones"
										Style="{ StaticResource ResourceKey=Btn.Pestana }"
										Tag="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Calificaciones }"
										ToolTip="Notas del alumno en este ciclo lectivo"/>
								<Button Command="{ Binding Path=VerCommand }"
										CommandParameter="Asistencias"
										Content="Asistencias"
										Style="{ StaticResource ResourceKey=Btn.Pestana }"
										Tag="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Asistencias }"
										ToolTip="Resumen de presentes, ausencias, inasistencias y tardanzas"/>
								<Button Command="{ Binding Path=VerCommand }"
										CommandParameter="Historial"
										Content="Historial"
										Style="{ StaticResource ResourceKey=Btn.Pestana }"
										Tag="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Historial }"
										ToolTip="Todas las inscripciones del alumno, de cualquier ciclo lectivo"/>
								<Button Command="{ Binding Path=VerCommand }"
										CommandParameter="Inscripcion"
										Content="Inscripción"
										Style="{ StaticResource ResourceKey=Btn.Pestana }"
										Tag="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Inscripcion }"
										ToolTip="Condición de recursante, baja y traslado de división"/>
							</StackPanel>
						</Border>
						<!--#endregion-->

						<!--#region VISTA: CALIFICACIONES
							Sin rótulo de sección: lo dice la pestaña, y esos 28px le hacen falta
							a la grilla. Las columnas llevan MinWidth para que, en una ventana
							angosta, scrollee en horizontal en vez de apretar siete columnas hasta
							volverlas ilegibles.
						-->
						<Grid Grid.Row="2"
							  Visibility="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Calificaciones }">
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<DataGrid x:Name="DataGrid_Calificaciones"
									  Grid.Row="0"
									  AutomationProperties.Name="Calificaciones del alumno"
									  ItemsSource="{ Binding Path=Calificaciones, Mode=OneWay }"
									  SelectedItem="{ Binding Path=CalificacionSeleccionada, Mode=TwoWay }"
									  MinHeight="120"
									  Style="{ StaticResource ResourceKey=Grilla }"
									  Tag="El alumno elegido todavía no tiene calificaciones cargadas. Empezá con &#x201C;Cargar nota&#x201D;.">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{ Binding Path=Materia, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="MATERIA"
														MinWidth="140"
														Width="2*"/>
									<DataGridTextColumn Binding="{ Binding Path=Fecha, Mode=OneTime, StringFormat=d }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="FECHA"
														Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Instancia, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="INSTANCIA"
														Width="Auto"/>
									<DataGridTemplateColumn Header="RINDIÓ" Width="Auto">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<fa:IconBlock Style="{ StaticResource ResourceKey=Celda.Booleana }"
															  Tag="{ Binding Path=Rindio, Mode=OneWay }"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Binding="{ Binding Path=Nota, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="NOTA"
														Width="Auto"/>
									<DataGridTemplateColumn Header="APROBADO" Width="Auto">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<fa:IconBlock Style="{ StaticResource ResourceKey=Celda.Booleana }"
															  Tag="{ Binding Path=Aprobado, Mode=OneWay }"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Binding="{ Binding Path=Observacion, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="OBSERVACIÓN"
														MinWidth="160"
														Width="2*"/>
								</DataGrid.Columns>
							</DataGrid>

							<!-- La nota no se corrige: se quita y se vuelve a cargar. Sólo la observación es editable. -->
							<HeaderedContentControl Grid.Row="1"
													Header="Observación de la calificación elegida"
													Margin="0 16 0 0"
													Style="{ StaticResource ResourceKey=Campo }">
								<TextBox Tag="recuperatorio pendiente, ausente con certificado&#x2026;"
										 Text="{ Binding Path=ObservacionEdicion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
										 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
							</HeaderedContentControl>

							<HeaderedContentControl Grid.Row="2" Style="{ StaticResource ResourceKey=Acciones }">
								<HeaderedContentControl.Header>
									<Button Command="{ Binding Path=QuitarCalificacionCommandAsync }"
											Content="Quitar calificación"
											Style="{ StaticResource ResourceKey=Btn.Peligro }"
											ToolTip="Quitar la calificación elegida"/>
								</HeaderedContentControl.Header>

								<!--
									"Editar observación" lo exige una guarda estática: distingue
									la única corrección que el dominio permite de corregir la
									nota, que no se puede. El rótulo no se cambia sin tocar esa
									guarda.
								-->
								<Button Command="{ Binding Path=ModificarObservacionCommandAsync }"
										Content="Editar observación"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Guardar la observación de la calificación elegida"/>
							</HeaderedContentControl>
						</Grid>
						<!--#endregion-->

						<!--#region VISTA: ASISTENCIAS-->
						<Grid Grid.Row="2"
							  Visibility="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Asistencias }">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<Grid Grid.Row="0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">
									<TextBlock Style="{ StaticResource ResourceKey=Contador }"
											   Text="{ Binding Path=Presentes, Mode=OneWay }"/>
									<TextBlock Margin="0 2 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="PRESENTES"/>
								</StackPanel>

								<StackPanel Grid.Column="1">
									<TextBlock Style="{ StaticResource ResourceKey=Contador }"
											   Text="{ Binding Path=Ausencias, Mode=OneWay }"/>
									<TextBlock Margin="0 2 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="AUSENCIAS"/>
								</StackPanel>

								<StackPanel Grid.Column="2">
									<TextBlock Style="{ StaticResource ResourceKey=Contador }"
											   Text="{ Binding Path=Inasistencias, Mode=OneWay }"/>
									<TextBlock Margin="0 2 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="INASISTENCIAS"/>
								</StackPanel>

								<StackPanel Grid.Column="3">
									<TextBlock Style="{ StaticResource ResourceKey=Contador }"
											   Text="{ Binding Path=Tardanzas, Mode=OneWay }"/>
									<TextBlock Margin="0 2 0 0"
											   Style="{ StaticResource ResourceKey=Txt.Seccion }"
											   Text="TARDANZAS"/>
								</StackPanel>
							</Grid>

							<!--
								El aviso dice QUÉ es este número y DÓNDE está el detalle, porque
								un contador sin período se lee como "este ciclo" y no lo es.
							-->
							<Border Grid.Row="1"
									Margin="0 24 0 0"
									Style="{ StaticResource ResourceKey=Superficie.Aviso }">
								<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
										   Text="Es el total del alumno en todas sus planillas, sin separar por ciclo lectivo. El detalle por fecha se toma y se consulta en la planilla de asistencia de la división."
										   TextWrapping="Wrap"/>
							</Border>

							<components:CargandoComponent Grid.Row="0"
														  Grid.RowSpan="3"
														  EstaCargando="{ Binding Path=CargarAsistenciasCommandAsync.IsRunning }"
														  Leyenda="CONTANDO LAS ASISTENCIAS"/>
						</Grid>
						<!--#endregion-->

						<!--#region VISTA: HISTORIAL-->
						<Grid Grid.Row="2"
							  Visibility="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Historial }">
							<DataGrid x:Name="DataGrid_Historial"
									  AutomationProperties.Name="Historial de divisiones del alumno"
									  ItemsSource="{ Binding Path=Historial, Mode=OneWay }"
									  MinHeight="120"
									  Style="{ StaticResource ResourceKey=Grilla }"
									  Tag="Este alumno no tiene inscripciones registradas.">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{ Binding Path=CicloLectivo, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="CICLO"
														Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Division, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="DIVISIÓN"
														Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Grado, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="AÑO"
														Width="*"/>
									<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneTime, StringFormat=d }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="DESDE"
														Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneTime, StringFormat=d }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="HASTA"
														Width="Auto"/>
									<DataGridTemplateColumn Header="RECURSANTE" Width="Auto">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<fa:IconBlock Style="{ StaticResource ResourceKey=Celda.Booleana }"
															  Tag="{ Binding Path=EsRecursante, Mode=OneWay }"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTemplateColumn Header="ESTADO" Width="Auto">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<!--
													LA INSIGNIA SEGUÍA EL ESTADO MAL. Estaba fija
													en Insignia.Alerta para toda fila, así que la
													inscripción VIGENTE —la sana, la que el alumno
													está cursando— se señalaba con el color de
													alerta igual que las cerradas. El rótulo decía
													"Vigente" y el color decía lo contrario.
												-->
												<Border>
													<Border.Style>
														<Style TargetType="{ x:Type Border }" BasedOn="{ StaticResource ResourceKey=Insignia.Alerta }">
															<Style.Triggers>
																<DataTrigger Binding="{ Binding Path=EstaActiva, Mode=OneTime }" Value="True">
																	<Setter Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>

													<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
															   Text="{ Binding Path=Estado, Mode=OneTime }"/>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>

							<components:CargandoComponent EstaCargando="{ Binding Path=CargarHistorialCommandAsync.IsRunning }"
														  Leyenda="CARGANDO EL HISTORIAL"/>
						</Grid>
						<!--#endregion-->

						<!--#region VISTA: INSCRIPCIÓN
							DOS NATURALEZAS, DOS BLOQUES. Antes compartían una fila: la casilla de
							recursante al lado de la fecha de baja, sin nada que dijera que una
							corrige un dato y la otra cierra la inscripción.
						-->
						<Grid Grid.Row="2"
							  Visibility="{ Binding Path=VistaDelAlumno, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Inscripcion }">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<StackPanel Grid.Row="0">
								<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="CONDICIÓN DEL ALUMNO"/>
								<TextBlock Margin="0 4 0 14"
										   MaxWidth="520"
										   HorizontalAlignment="Left"
										   Style="{ StaticResource ResourceKey=Txt.Detalle }"
										   Text="Lo único que el dominio deja corregir de una inscripción. Tildar la casilla no escribe nada hasta que se guarda."
										   TextWrapping="Wrap"/>

								<StackPanel Orientation="Horizontal">
									<CheckBox Content="Recursante"
											  IsChecked="{ Binding Path=EsRecursante, Mode=TwoWay }"
											  Margin="0 0 16 16"
											  Style="{ StaticResource ResourceKey=Chk.Campo.Alineada }"
											  ToolTip="El alumno vuelve a cursar el año"/>

									<Button Command="{ Binding Path=ModificarRecursanteCommandAsync }"
											Content="Guardar condición"
											Margin="0 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Terciario }"
											ToolTip="Guardar la condición de recursante del alumno elegido"
											VerticalAlignment="Bottom"/>
								</StackPanel>
							</StackPanel>

							<StackPanel Grid.Row="1">
								<Rectangle Margin="0 4 0 20" Style="{ StaticResource ResourceKey=Regla }"/>

								<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="CICLO DE VIDA DE LA INSCRIPCIÓN"/>
								<TextBlock Margin="0 4 0 14"
										   MaxWidth="520"
										   HorizontalAlignment="Left"
										   Style="{ StaticResource ResourceKey=Txt.Detalle }"
										   Text="No son ediciones: la baja cierra la inscripción, y el traslado la cierra y abre otra en la división de destino."
										   TextWrapping="Wrap"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<HeaderedContentControl Grid.Column="0"
															Header="Fecha de baja"
															Style="{ StaticResource ResourceKey=Campo.Izquierda }">
										<DatePicker SelectedDate="{ Binding Path=FechaBaja, Mode=TwoWay }"
													Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
									</HeaderedContentControl>

									<Button Grid.Column="1"
											Command="{ Binding Path=RegistrarBajaCommandAsync }"
											Content="Dar de baja"
											Margin="10 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Peligro }"
											ToolTip="Cerrar la inscripción del alumno elegido"
											VerticalAlignment="Bottom"/>
								</Grid>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<HeaderedContentControl Grid.Column="0"
															Header="División de destino"
															Style="{ StaticResource ResourceKey=Campo.Izquierda }">
										<ComboBox DisplayMemberPath="Descripcion"
												  ItemsSource="{ Binding Path=DivisionesDestino, Mode=OneWay }"
												  SelectedItem="{ Binding Path=DivisionDestino, Mode=TwoWay }"
												  Style="{ StaticResource ResourceKey=Cmb.Campo }"
												  Width="160"/>
									</HeaderedContentControl>

									<HeaderedContentControl Grid.Column="1"
															Header="Fecha del traslado"
															Margin="10 0 0 0"
															Style="{ StaticResource ResourceKey=Campo }">
										<DatePicker SelectedDate="{ Binding Path=FechaCambio, Mode=TwoWay }"
													Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
									</HeaderedContentControl>

									<Button Grid.Column="2"
											Command="{ Binding Path=CambiarDivisionCommandAsync }"
											Content="Cambiar de división"
											Margin="10 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Secundario }"
											ToolTip="Cerrar la inscripción actual y abrir una nueva en la división de destino"
											VerticalAlignment="Bottom"/>
								</Grid>
							</StackPanel>
						</Grid>
						<!--#endregion-->
					</Grid>
				</Grid>
				<!--#endregion-->

				<!--
					Un velo por panel y no uno sobre la tarjeta entera: elegir un alumno no deja
					de saber quiénes son los demás, así que el índice se queda a la vista mientras
					el detalle espera. Los de historial y asistencias viven dentro de su propia
					vista, que es lo único que esa consulta hace esperar.
				-->
				<components:CargandoComponent Grid.Column="0"
											  EstaCargando="{ Binding Path=BuscarCommandAsync.IsRunning }"
											  Leyenda="BUSCANDO"/>

				<components:CargandoComponent Grid.Column="2"
											  EstaCargando="{ Binding Path=CargarCalificacionesCommandAsync.IsRunning }"
											  Leyenda="CARGANDO LAS CALIFICACIONES"/>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region CARGAR CALIFICACIÓN
			Fila Auto DEBAJO de la tarjeta principal, que es fila *: cuando esta tarjeta aparece,
			la de arriba cede el alto y el formulario nace dentro de la pantalla. Antes vivía al
			final de un ScrollViewer de página y se abría fuera de la vista.
		-->
		<Border Grid.Row="2"
				Margin="0 16 0 0"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=MostrarCalificacionView, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="0 0 0 16">
					<TextBlock Style="{ StaticResource ResourceKey=Txt.Titulo }"
							   Text="Cargar una calificación"/>
					<TextBlock Margin="0 4 0 0"
							   Style="{ StaticResource ResourceKey=Txt.Detalle }"
							   Text="{ Binding Path=Cursante.NombreCompleto, Mode=OneWay, StringFormat=Nota de {0}, FallbackValue='Elegí primero un alumno', TargetNullValue='Elegí primero un alumno' }"/>
				</StackPanel>

				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<HeaderedContentControl Grid.Column="0"
											Header="Materia"
											Style="{ StaticResource ResourceKey=Campo.Izquierda }">
						<ComboBox DisplayMemberPath="Descripcion"
								  ItemsSource="{ Binding Path=Materias, Mode=OneWay }"
								  SelectedItem="{ Binding Path=Materia, Mode=TwoWay }"
								  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="1"
											Header="Período"
											Style="{ StaticResource ResourceKey=Campo.Centro }">
						<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=periodos } }"
								  SelectedItem="{ Binding Path=Calificacion.Periodo, Mode=TwoWay }"
								  Style="{ StaticResource ResourceKey=Cmb.Campo }">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{ Binding Converter={ StaticResource ResourceKey=periodo } }"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="2"
											Header="Intento"
											Style="{ StaticResource ResourceKey=Campo.Centro }">
						<CheckBox Content="Recuperatorio"
								  IsChecked="{ Binding Path=Calificacion.EsRecuperatorio, Mode=TwoWay }"
								  Style="{ StaticResource ResourceKey=Chk.Campo.Alineada }"
								  ToolTip="Es el segundo intento del período elegido y reemplaza a su nota"/>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="3"
											Header="Fecha"
											Style="{ StaticResource ResourceKey=Campo.Centro }">
						<DatePicker DisplayDateEnd="{ x:Static sys:DateTime.Today }"
									DisplayDateStart="01/01/2000"
									SelectedDate="{ Binding Path=Calificacion.Fecha, Mode=TwoWay }"
									Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="4"
											Header="Nota"
											Style="{ StaticResource ResourceKey=Campo.Derecha }">
						<TextBox MaxLength="2"
								 Tag="8"
								 Text="{ Binding Path=Calificacion.Nota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='' }"
								 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
					</HeaderedContentControl>
				</Grid>

				<HeaderedContentControl Grid.Row="2"
										Header="Observación"
										Style="{ StaticResource ResourceKey=Campo }">
					<TextBox Tag="tema evaluado, condiciones de la mesa&#x2026;"
							 Text="{ Binding Path=Calificacion.Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
				</HeaderedContentControl>

				<HeaderedContentControl Grid.Row="3" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<Button Command="{ Binding Path=CancelarCalificacionCommand }"
								Content="Cancelar"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Descartar la calificación"/>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<Button Command="{ Binding Path=RegistrarInasistenciaCommandAsync }"
								Content="Registrar inasistencia"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="El alumno no se presentó a la instancia"/>
						<Button Command="{ Binding Path=GuardarCalificacionCommandAsync }"
								Content="Guardar nota"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Guardar la calificación"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

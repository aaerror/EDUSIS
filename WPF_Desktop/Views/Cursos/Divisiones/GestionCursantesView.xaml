<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.GestionCursantesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:domainCalificaciones="clr-namespace:Domain.Cursantes.Calificaciones;assembly=Domain"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		ALUMNOS DE LA DIVISIÓN Y SUS CALIFICACIONES.

		Dos listas en cadena: se elige un alumno y abajo aparecen sus notas. Esa dependencia
		ahora se ve —la ficha del alumno elegido va entre las dos listas, así que la segunda
		lista siempre tiene a quién se refiere—. Antes había dos grillas pegadas y nada decía
		de quién eran las calificaciones de abajo.

		CursanteView se monta acá por primera vez: estaba mapeada en DataTemplate.xaml y era
		un Grid vacío, y el ViewModel ya expone Cursante como CursanteViewModel.

		El campo de observación y sus botones estaban sueltos al pie de la tarjeta, con tres
		botones secundarios en fila (uno de ellos destructivo). Quitar una calificación pasa
		al lado izquierdo del pie, separado de lo que guarda.
	-->
	<UserControl.Resources>
		<ObjectDataProvider x:Key="instancias" MethodName="GetNames" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainCalificaciones:Instancia"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<components:Header Grid.Row="0"
						   Margin="0 0 0 20"
						   Title="Alumnos de la división"
						   Subtitle="Alumnos cursando y las calificaciones de cada uno"/>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<!--#region ALUMNOS Y CALIFICACIONES-->
				<Border Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
					<Grid Margin="20 18">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<!-- 4 y 5 son la sección de inscripción y el historial (UI-CUR-1). -->
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!--#region BÚSQUEDA POR CICLO-->
						<Grid Grid.Row="0" Margin="0 0 0 4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<HeaderedContentControl Grid.Column="0"
													Header="Ciclo lectivo"
													Style="{ StaticResource ResourceKey=Campo.Izquierda }">
								<TextBox MaxLength="4"
										 Tag="2026"
										 Text="{ Binding Path=CicloLectivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
										 Width="120"
										 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
							</HeaderedContentControl>

							<Button Grid.Column="1"
									Command="{ Binding Path=BuscarCommandAsync }"
									Margin="10 0 0 16"
									Style="{ StaticResource ResourceKey=Btn.Secundario }"
									ToolTip="Listar los alumnos del ciclo"
									VerticalAlignment="Bottom">
								<StackPanel Orientation="Horizontal">
									<fa:IconBlock FontSize="11"
												  Icon="MagnifyingGlass"
												  Margin="0 0 8 0"
												  VerticalAlignment="Center"/>
									<TextBlock Text="Buscar" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</Grid>
						<!--#endregion-->

						<TextBlock Grid.Row="1"
								   Margin="0 0 0 12"
								   Style="{ StaticResource ResourceKey=Txt.Seccion }"
								   Text="ALUMNOS CURSANDO"/>

						<DataGrid x:Name="DataGrid_Cursantes"
								  Grid.Row="2"
								  ItemsSource="{ Binding Path=Cursantes, Mode=OneWay }"
								  SelectedItem="{ Binding Path=Cursante, Mode=TwoWay }"
								  MaxHeight="260"
								  MinHeight="120"
								  Style="{ StaticResource ResourceKey=Grilla }"
								  Tag="No hay alumnos cursando en este ciclo lectivo.">
							<DataGrid.Columns>
								<DataGridTextColumn Binding="{ Binding Path=NombreCompleto, Mode=OneTime }"
													Header="ALUMNO"
													Width="2*"/>
								<DataGridTextColumn Binding="{ Binding Path=Documento, Mode=OneTime }"
													Header="DOCUMENTO"
													Width="*"/>
								<DataGridTextColumn Binding="{ Binding Path=Edad, Mode=OneTime }"
													Header="EDAD"
													Width="*"/>
							</DataGrid.Columns>
						</DataGrid>

						<!-- La ficha del alumno elegido: es de quién son las notas de abajo. -->
						<local:CursanteView Grid.Row="3"
											DataContext="{ Binding Path=Cursante, Mode=OneWay }"
											Margin="0 16 0 0"
											Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay } }"/>

						<!--#region INSCRIPCIÓN-->
						<!--
							Las tres operaciones sobre la inscripción del alumno elegido. La
							condición de recursante es lo único que el dominio deja corregir: la
							baja y el traslado son operaciones de ciclo de vida, no ediciones.
							Tildar el checkbox no escribe nada hasta que se guarda.
						-->
						<Border Grid.Row="4"
								Margin="0 16 0 0"
								Style="{ StaticResource ResourceKey=Superficie.Seccion }"
								Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay } }">
							<StackPanel>
								<TextBlock Margin="0 0 0 12"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="INSCRIPCIÓN"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<CheckBox Grid.Column="0"
											  Content="Recursante"
											  IsChecked="{ Binding Path=EsRecursante, Mode=TwoWay }"
											  Margin="0 0 10 16"
											  Style="{ StaticResource ResourceKey=Chk.Campo }"
											  ToolTip="El alumno vuelve a cursar el año"
											  VerticalAlignment="Bottom"/>

									<Button Grid.Column="1"
											Command="{ Binding Path=ModificarRecursanteCommandAsync }"
											Content="Guardar condición"
											Margin="0 0 24 16"
											Style="{ StaticResource ResourceKey=Btn.Terciario }"
											ToolTip="Guardar la condición de recursante del alumno elegido"
											VerticalAlignment="Bottom"/>

									<HeaderedContentControl Grid.Column="2"
															Header="Fecha de baja"
															Style="{ StaticResource ResourceKey=Campo }">
										<DatePicker SelectedDate="{ Binding Path=FechaBaja, Mode=TwoWay }"
													Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
									</HeaderedContentControl>

									<Button Grid.Column="3"
											Command="{ Binding Path=RegistrarBajaCommandAsync }"
											Content="Dar de baja"
											Margin="10 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Peligro }"
											ToolTip="Cerrar la inscripción del alumno elegido"
											VerticalAlignment="Bottom"/>
								</Grid>

								<Rectangle Margin="0 4 0 12" Style="{ StaticResource ResourceKey=Regla }"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<HeaderedContentControl Grid.Column="0"
															Header="División de destino"
															Style="{ StaticResource ResourceKey=Campo.Izquierda }">
										<ComboBox DisplayMemberPath="Descripcion"
												  ItemsSource="{ Binding Path=DivisionesDestino, Mode=OneWay }"
												  SelectedItem="{ Binding Path=DivisionDestino, Mode=TwoWay }"
												  Style="{ StaticResource ResourceKey=Cmb.Campo }"
												  Width="160"/>
									</HeaderedContentControl>

									<HeaderedContentControl Grid.Column="1"
															Header="Fecha del traslado"
															Margin="10 0 0 0"
															Style="{ StaticResource ResourceKey=Campo }">
										<DatePicker SelectedDate="{ Binding Path=FechaCambio, Mode=TwoWay }"
													Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
									</HeaderedContentControl>

									<Button Grid.Column="2"
											Command="{ Binding Path=CambiarDivisionCommandAsync }"
											Content="Cambiar de división"
											Margin="10 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Secundario }"
											ToolTip="Cerrar la inscripción actual y abrir una nueva en la división de destino"
											VerticalAlignment="Bottom"/>
								</Grid>
							</StackPanel>
						</Border>
						<!--#endregion-->

						<!--#region HISTORIAL DE DIVISIONES-->
						<Grid Grid.Row="5"
							  Margin="0 16 0 0"
							  Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay } }">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<Grid Grid.Row="0" Margin="0 0 0 12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<TextBlock Grid.Column="0"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="HISTORIAL DE DIVISIONES"
										   VerticalAlignment="Center"/>

								<Button Grid.Column="1"
										Command="{ Binding Path=CargarHistorialCommandAsync }"
										Content="Ver historial"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Todas las inscripciones del alumno, de cualquier ciclo lectivo"/>
							</Grid>

							<DataGrid x:Name="DataGrid_Historial"
									  Grid.Row="1"
									  ItemsSource="{ Binding Path=Historial, Mode=OneWay }"
									  MaxHeight="200"
									  Style="{ StaticResource ResourceKey=Grilla }"
									  Tag="Sin inscripciones para mostrar. Use &quot;Ver historial&quot;.">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{ Binding Path=CicloLectivo, Mode=OneTime }"
														Header="CICLO"
														Width="*"/>
									<DataGridTextColumn Binding="{ Binding Path=Division, Mode=OneTime }"
														Header="DIVISIÓN"
														Width="*"/>
									<DataGridTextColumn Binding="{ Binding Path=Grado, Mode=OneTime }"
														Header="AÑO"
														Width="*"/>
									<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneTime, StringFormat=d }"
														Header="DESDE"
														Width="*"/>
									<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneTime, StringFormat=d }"
														Header="HASTA"
														Width="*"/>
									<DataGridCheckBoxColumn Binding="{ Binding Path=EsRecursante, Mode=OneWay }"
															Header="RECURSANTE"
															IsReadOnly="True"
															Width="*"/>
									<DataGridTemplateColumn Header="ESTADO" Width="*">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<!--
													La inscripción cerrada se marca con la insignia de
													alerta: es registro histórico y no la vigente.
												-->
												<Border Style="{ StaticResource ResourceKey=Insignia.Alerta }">
													<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
															   Text="{ Binding Path=Estado, Mode=OneTime }"/>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Grid>
						<!--#endregion-->

						<!--#region CALIFICACIONES-->
						<Grid Grid.Row="6" Margin="0 8 0 0">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0"
									   Margin="0 0 0 12"
									   Style="{ StaticResource ResourceKey=Txt.Seccion }"
									   Text="CALIFICACIONES"/>

							<DataGrid x:Name="DataGrid_Calificaciones"
									  Grid.Row="1"
									  ItemsSource="{ Binding Path=Calificaciones, Mode=OneWay }"
									  SelectedItem="{ Binding Path=CalificacionSeleccionada, Mode=TwoWay }"
									  MaxHeight="300"
									  MinHeight="120"
									  Style="{ StaticResource ResourceKey=Grilla }"
									  Tag="El alumno elegido todavía no tiene calificaciones cargadas.">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{ Binding Path=Materia, Mode=OneTime }"
														Header="MATERIA"
														Width="2*"/>
									<DataGridTextColumn Binding="{ Binding Path=Fecha, Mode=OneTime, StringFormat=d }"
														Header="FECHA"
														Width="*"/>
									<DataGridTextColumn Binding="{ Binding Path=Instancia, Mode=OneTime }"
														Header="INSTANCIA"
														Width="*"/>
									<DataGridCheckBoxColumn Binding="{ Binding Path=Rindio, Mode=OneWay }"
															Header="RINDIÓ"
															IsReadOnly="True"
															Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Nota, Mode=OneTime }"
														Header="NOTA"
														Width="Auto"/>
									<DataGridCheckBoxColumn Binding="{ Binding Path=Aprobado, Mode=OneWay }"
															Header="APROBADO"
															IsReadOnly="True"
															Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Observacion, Mode=OneTime }"
														Header="OBSERVACIÓN"
														Width="2*"/>
								</DataGrid.Columns>
							</DataGrid>

							<!-- La nota no se corrige: se quita y se vuelve a cargar. Sólo la observación es editable. -->
							<HeaderedContentControl Grid.Row="2"
													Header="Observación de la calificación elegida"
													Margin="0 16 0 0"
													Style="{ StaticResource ResourceKey=Campo }">
								<TextBox Tag="recuperatorio pendiente, ausente con certificado&#x2026;"
										 Text="{ Binding Path=ObservacionEdicion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
										 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
							</HeaderedContentControl>
						</Grid>
						<!--#endregion-->

						<HeaderedContentControl Grid.Row="7" Style="{ StaticResource ResourceKey=Acciones }">
							<HeaderedContentControl.Header>
								<Button Command="{ Binding Path=QuitarCalificacionCommandAsync }"
										Content="Quitar calificación"
										Style="{ StaticResource ResourceKey=Btn.Peligro }"
										ToolTip="Quitar la calificación elegida"/>
							</HeaderedContentControl.Header>

							<StackPanel Orientation="Horizontal">
								<!--
									"Editar observación" lo exige una guarda estática: distingue
									la única corrección que el dominio permite de corregir la
									nota, que no se puede. El rótulo no se cambia sin tocar esa
									guarda.
								-->
								<Button Command="{ Binding Path=ModificarObservacionCommandAsync }"
										Content="Editar observación"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Guardar la observación de la calificación elegida"/>
								<Button Command="{ Binding Path=NuevaCalificacionCommand }"
										Content="Cargar nota"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										ToolTip="Cargar una calificación nueva"/>
							</StackPanel>
						</HeaderedContentControl>
					</Grid>
				</Border>
				<!--#endregion-->

				<!--#region CARGAR CALIFICACIÓN-->
				<Border Margin="0 16 0 0"
						Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
						Visibility="{ Binding Path=MostrarCalificacionView, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
					<Grid Margin="20 18">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0"
								   Margin="0 0 0 16"
								   Style="{ StaticResource ResourceKey=Txt.Titulo }"
								   Text="Cargar una calificación"/>

						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<HeaderedContentControl Grid.Column="0"
													Header="Materia"
													Style="{ StaticResource ResourceKey=Campo.Izquierda }">
								<ComboBox DisplayMemberPath="Descripcion"
										  ItemsSource="{ Binding Path=Materias, Mode=OneWay }"
										  SelectedItem="{ Binding Path=Materia, Mode=TwoWay }"
										  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
							</HeaderedContentControl>

							<HeaderedContentControl Grid.Column="1"
													Header="Instancia"
													Style="{ StaticResource ResourceKey=Campo.Centro }">
								<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=instancias } }"
										  SelectedItem="{ Binding Path=Calificacion.Instancia, Mode=TwoWay }"
										  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
							</HeaderedContentControl>

							<HeaderedContentControl Grid.Column="2"
													Header="Fecha"
													Style="{ StaticResource ResourceKey=Campo.Centro }">
								<DatePicker DisplayDateEnd="{ x:Static sys:DateTime.Today }"
											DisplayDateStart="01/01/2000"
											SelectedDate="{ Binding Path=Calificacion.Fecha, Mode=TwoWay }"
											Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
							</HeaderedContentControl>

							<HeaderedContentControl Grid.Column="3"
													Header="Nota"
													Style="{ StaticResource ResourceKey=Campo.Derecha }">
								<TextBox MaxLength="2"
										 Tag="8"
										 Text="{ Binding Path=Calificacion.Nota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='' }"
										 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
							</HeaderedContentControl>
						</Grid>

						<HeaderedContentControl Grid.Row="2"
												Header="Observación"
												Style="{ StaticResource ResourceKey=Campo }">
							<TextBox Tag="tema evaluado, condiciones de la mesa&#x2026;"
									 Text="{ Binding Path=Calificacion.Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
						</HeaderedContentControl>

						<HeaderedContentControl Grid.Row="3" Style="{ StaticResource ResourceKey=Acciones }">
							<HeaderedContentControl.Header>
								<Button Command="{ Binding Path=CancelarCalificacionCommand }"
										Content="Cancelar"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Descartar la calificación"/>
							</HeaderedContentControl.Header>

							<StackPanel Orientation="Horizontal">
								<Button Command="{ Binding Path=RegistrarInasistenciaCommandAsync }"
										Content="Registrar inasistencia"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="El alumno no se presentó a la instancia"/>
								<Button Command="{ Binding Path=GuardarCalificacionCommandAsync }"
										Content="Guardar nota"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										ToolTip="Guardar la calificación"/>
							</StackPanel>
						</HeaderedContentControl>
					</Grid>
				</Border>
				<!--#endregion-->
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>

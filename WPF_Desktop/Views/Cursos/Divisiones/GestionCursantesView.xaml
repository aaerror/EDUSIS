<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.GestionCursantesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:domainCalificaciones="clr-namespace:Domain.Cursantes.Calificaciones;assembly=Domain"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		ALUMNOS DE LA DIVISIÓN Y SUS CALIFICACIONES.

		ERA UNA COLUMNA DE 1520px DENTRO DE UN VIEWPORT DE 620. Ocho bloques apilados —búsqueda,
		grilla de alumnos, ficha, inscripción, historial, calificaciones, observación, pie— en
		un ScrollViewer de página, con las tres grillas limitadas a 260, 200 y 300px de alto.
		Eso producía tres defectos que eran el mismo:

		1. LA RUEDA DEL MOUSE MORÍA sobre la mitad de la pantalla. El ScrollViewer de WPF marca
		   el evento como manejado aunque no tenga nada que scrollear, y las tres grillas
		   sumaban 760 de los 1520px de contenido.
		2. "CARGAR NOTA" ABRÍA UN FORMULARIO FUERA DE PANTALLA, debajo de una página que ya no
		   entraba. Apretabas el botón y no pasaba nada visible.
		3. EL ANCHO NO SE USABA. La fila del ciclo lectivo dejaba 750px vacíos y la columna EDAD
		   recibía 243px para decir "15 años", mientras se scrolleaba 2,5 pantallas de alto.

		Ahora es ÍNDICE + DETALLE, el mismo esqueleto de GestionCursosView, GestionDocentesView
		y GestionPuestosView: la tarjeta llena el alto disponible y no hay scroll de página, así
		que cada panel scrollea lo suyo y la rueda funciona en los dos lados. La grilla de
		calificaciones toma la fila * del detalle: a 1320x800 muestra lo mismo que antes, y
		maximizada muestra el doble, porque ya no está clavada en 300px.

		El listado de alumnos DEJA DE IRSE DE PANTALLA. Antes, para llegar al pie donde se
		cargaba una nota había que scrollear hasta perder de vista a quién se le estaba poniendo
		esa nota.

		"Cargar nota" sube al hueco de acción principal del encabezado, que es donde el sistema
		la pone. El alta sigue siendo una tarjeta aparte, pero como fila Auto DEBAJO de la
		tarjeta principal —igual que "Asignar preceptor" en GestionDivisionesView—: al abrirse,
		la de arriba cede alto y el formulario nace a la vista.

		PENDIENTE: DÓNDE VIVE EL HISTORIAL. Por ahora es una sección del detalle que sólo existe
		cuando tiene filas, así que no cuesta alto hasta que se pide con "Ver historial". Las
		dos salidas que quedaron sobre la mesa son dos solapas junto a CALIFICACIONES, o una
		pantalla propia del alumno. No se decidió.
	-->
	<UserControl.Resources>
		<ObjectDataProvider x:Key="instancias" MethodName="GetNames" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainCalificaciones:Instancia"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Alumnos de la división"
									Subtitulo="Inscripción, traslados y calificaciones de cada alumno">
			<components:PaginaComponent.Accion>
				<Button Command="{ Binding Path=NuevaCalificacionCommand }"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Cargar una calificación al alumno elegido">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Cargar nota" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</components:PaginaComponent.Accion>
		</components:PaginaComponent>
		<!--#endregion-->

		<!--#region ALUMNOS Y CALIFICACIONES-->
		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="280"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!--#region ÍNDICE
					Todo el bloque cuelga del margen de 12, que es el relleno que ya tienen las
					celdas de la grilla: rótulo, campo y nombres arrancan en la misma vertical.
				-->
				<Grid Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="12 18 12 0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<HeaderedContentControl Grid.Column="0"
												Header="Ciclo lectivo"
												Style="{ StaticResource ResourceKey=Campo.Izquierda }">
							<!--
								Enter busca. Es un campo de un solo dato con su botón al lado: el
								gesto esperado es tipear el año y apretar Enter, no salir a buscar
								el botón con el mouse.
							-->
							<TextBox MaxLength="4"
									 Tag="2026"
									 Text="{ Binding Path=CicloLectivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									 Style="{ StaticResource ResourceKey=Txb.Campo }">
								<TextBox.InputBindings>
									<KeyBinding Key="Enter" Command="{ Binding Path=BuscarCommandAsync }"/>
								</TextBox.InputBindings>
							</TextBox>
						</HeaderedContentControl>

						<Button Grid.Column="1"
								Command="{ Binding Path=BuscarCommandAsync }"
								Margin="10 0 0 16"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Listar los alumnos del ciclo"
								VerticalAlignment="Bottom">
							<StackPanel Orientation="Horizontal">
								<fa:IconBlock FontSize="11"
											  Icon="MagnifyingGlass"
											  Margin="0 0 8 0"
											  VerticalAlignment="Center"/>
								<TextBlock Text="Buscar" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>

					<TextBlock Grid.Row="1"
							   Margin="12 0 12 10"
							   Style="{ StaticResource ResourceKey=Txt.Seccion }"
							   Text="ALUMNOS CURSANDO"/>

					<DataGrid x:Name="DataGrid_Cursantes"
							  Grid.Row="2"
							  AutomationProperties.Name="Alumnos cursando"
							  ItemsSource="{ Binding Path=Cursantes, Mode=OneWay }"
							  SelectedItem="{ Binding Path=Cursante, Mode=TwoWay }"
							  Style="{ StaticResource ResourceKey=Grilla }"
							  Tag="Ningún alumno cursa este ciclo lectivo en esta división. Probá otro ciclo, o inscribilo desde Alumnos.">
						<DataGrid.Columns>
							<!--
								El documento y la edad se fueron a la ficha del detalle, que es
								donde se leen enteros. Acá la columna ancha es el nombre, que es
								por lo que se busca a alguien en una lista.
							-->
							<DataGridTextColumn Binding="{ Binding Path=NombreCompleto, Mode=OneTime }"
												ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
												Header="ALUMNO"
												Width="*"/>
							<DataGridTextColumn Binding="{ Binding Path=Documento, Mode=OneTime }"
												ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
												Header="DOCUMENTO"
												Width="Auto"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
				<!--#endregion-->

				<Rectangle Grid.Column="1" Style="{ StaticResource ResourceKey=Regla.Vertical }"/>

				<!--#region DETALLE DEL ALUMNO-->
				<Grid Grid.Column="2">
					<StackPanel HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay }, ConverterParameter=inverso }">
						<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
								   HorizontalAlignment="Center"
								   Style="{ StaticResource ResourceKey=Txt.Subtitulo }"
								   Text="Elegí un alumno"/>
						<TextBlock HorizontalAlignment="Center"
								   Margin="0 6 0 0"
								   MaxWidth="300"
								   Style="{ StaticResource ResourceKey=Txt.Detalle }"
								   Text="Acá se cargan sus calificaciones y se corrige su inscripción: condición de recursante, baja y traslado de división."
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>

					<Grid Margin="28 22"
						  Visibility="{ Binding Path=Cursante, Converter={ StaticResource ResourceKey=visibleSiHay } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!--#region FICHA DEL ALUMNO ELEGIDO-->
						<Grid Grid.Row="0" Margin="0 0 0 20">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<local:CursanteView Grid.Column="0"
												DataContext="{ Binding Path=Cursante, Mode=OneWay }"/>

							<!--
								"Ver historial" vive acá y no sobre su sección porque la sección
								no existe hasta que esta consulta la trae. Es una acción sobre el
								alumno elegido, así que su lugar es la ficha del alumno elegido.
							-->
							<Button Grid.Column="1"
									Command="{ Binding Path=CargarHistorialCommandAsync }"
									Content="Ver historial"
									Margin="16 0 0 0"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Todas las inscripciones del alumno, de cualquier ciclo lectivo"
									VerticalAlignment="Center"/>
						</Grid>
						<!--#endregion-->

						<!--#region INSCRIPCIÓN
							Las tres operaciones sobre la inscripción del alumno elegido. La
							condición de recursante es lo único que el dominio deja corregir: la
							baja y el traslado son operaciones de ciclo de vida, no ediciones.
							Tildar el checkbox no escribe nada hasta que se guarda.
						-->
						<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Seccion }">
							<StackPanel>
								<TextBlock Margin="0 0 0 12"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="INSCRIPCIÓN"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<CheckBox Grid.Column="0"
											  Content="Recursante"
											  IsChecked="{ Binding Path=EsRecursante, Mode=TwoWay }"
											  Margin="0 0 10 16"
											  Style="{ StaticResource ResourceKey=Chk.Campo }"
											  ToolTip="El alumno vuelve a cursar el año"
											  VerticalAlignment="Bottom"/>

									<Button Grid.Column="1"
											Command="{ Binding Path=ModificarRecursanteCommandAsync }"
											Content="Guardar condición"
											Margin="0 0 24 16"
											Style="{ StaticResource ResourceKey=Btn.Terciario }"
											ToolTip="Guardar la condición de recursante del alumno elegido"
											VerticalAlignment="Bottom"/>

									<HeaderedContentControl Grid.Column="2"
															Header="Fecha de baja"
															Style="{ StaticResource ResourceKey=Campo }">
										<DatePicker SelectedDate="{ Binding Path=FechaBaja, Mode=TwoWay }"
													Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
									</HeaderedContentControl>

									<Button Grid.Column="3"
											Command="{ Binding Path=RegistrarBajaCommandAsync }"
											Content="Dar de baja"
											Margin="10 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Peligro }"
											ToolTip="Cerrar la inscripción del alumno elegido"
											VerticalAlignment="Bottom"/>
								</Grid>

								<Rectangle Margin="0 4 0 12" Style="{ StaticResource ResourceKey=Regla }"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<HeaderedContentControl Grid.Column="0"
															Header="División de destino"
															Style="{ StaticResource ResourceKey=Campo.Izquierda }">
										<ComboBox DisplayMemberPath="Descripcion"
												  ItemsSource="{ Binding Path=DivisionesDestino, Mode=OneWay }"
												  SelectedItem="{ Binding Path=DivisionDestino, Mode=TwoWay }"
												  Style="{ StaticResource ResourceKey=Cmb.Campo }"
												  Width="160"/>
									</HeaderedContentControl>

									<HeaderedContentControl Grid.Column="1"
															Header="Fecha del traslado"
															Margin="10 0 0 0"
															Style="{ StaticResource ResourceKey=Campo }">
										<DatePicker SelectedDate="{ Binding Path=FechaCambio, Mode=TwoWay }"
													Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
									</HeaderedContentControl>

									<Button Grid.Column="2"
											Command="{ Binding Path=CambiarDivisionCommandAsync }"
											Content="Cambiar de división"
											Margin="10 0 0 16"
											Style="{ StaticResource ResourceKey=Btn.Secundario }"
											ToolTip="Cerrar la inscripción actual y abrir una nueva en la división de destino"
											VerticalAlignment="Bottom"/>
								</Grid>
							</StackPanel>
						</Border>
						<!--#endregion-->

						<!--#region HISTORIAL DE DIVISIONES
							PENDIENTE de ubicación definitiva. Mientras tanto no ocupa alto hasta
							que la consulta trae filas: con el disparador sobre Count, la sección
							entera se colapsa y la grilla de calificaciones se queda con todo el
							espacio, que es el reparto correcto mientras nadie pidió el historial.
						-->
						<Border Grid.Row="2">
							<Border.Style>
								<Style TargetType="{ x:Type Border }" BasedOn="{ StaticResource ResourceKey=Superficie.Seccion }">
									<Style.Triggers>
										<DataTrigger Binding="{ Binding Path=Historial.Count }" Value="0">
											<Setter Property="Visibility" Value="Collapsed"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>

							<StackPanel>
								<TextBlock Margin="0 0 0 12"
										   Style="{ StaticResource ResourceKey=Txt.Seccion }"
										   Text="HISTORIAL DE DIVISIONES"/>

								<DataGrid x:Name="DataGrid_Historial"
										  AutomationProperties.Name="Historial de divisiones del alumno"
										  ItemsSource="{ Binding Path=Historial, Mode=OneWay }"
										  Margin="0 0 0 16"
										  MaxHeight="180"
										  Style="{ StaticResource ResourceKey=Grilla }"
										  Tag="Todavía no pediste el historial. Traelo con &#x201C;Ver historial&#x201D;.">
									<DataGrid.Columns>
										<DataGridTextColumn Binding="{ Binding Path=CicloLectivo, Mode=OneTime }"
															ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
															Header="CICLO"
															Width="Auto"/>
										<DataGridTextColumn Binding="{ Binding Path=Division, Mode=OneTime }"
															ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
															Header="DIVISIÓN"
															Width="Auto"/>
										<DataGridTextColumn Binding="{ Binding Path=Grado, Mode=OneTime }"
															ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
															Header="AÑO"
															Width="*"/>
										<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneTime, StringFormat=d }"
															ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
															Header="DESDE"
															Width="Auto"/>
										<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneTime, StringFormat=d }"
															ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
															Header="HASTA"
															Width="Auto"/>
										<DataGridCheckBoxColumn Binding="{ Binding Path=EsRecursante, Mode=OneWay }"
																Header="RECURSANTE"
																IsReadOnly="True"
																Width="Auto"/>
										<DataGridTemplateColumn Header="ESTADO" Width="Auto">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<!--
														LA INSIGNIA SEGUÍA EL ESTADO MAL. Estaba
														fija en Insignia.Alerta para toda fila, así
														que la inscripción VIGENTE —la sana, la que
														el alumno está cursando— se señalaba con el
														color de alerta igual que las cerradas. El
														rótulo decía "Vigente" y el color decía lo
														contrario.

														Ahora la vigente lleva la insignia activa y
														la cerrada la de alerta. El texto sigue
														nombrando el estado: el color sólo lo
														refuerza.
													-->
													<Border>
														<Border.Style>
															<Style TargetType="{ x:Type Border }" BasedOn="{ StaticResource ResourceKey=Insignia.Alerta }">
																<Style.Triggers>
																	<DataTrigger Binding="{ Binding Path=EstaActiva, Mode=OneTime }" Value="True">
																		<Setter Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Border.Style>

														<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
																   Text="{ Binding Path=Estado, Mode=OneTime }"/>
													</Border>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
									</DataGrid.Columns>
								</DataGrid>
							</StackPanel>
						</Border>
						<!--#endregion-->

						<!--#region CALIFICACIONES
							La fila * del detalle: la grilla llena lo que sobra en lugar de estar
							clavada en 300px. Las columnas llevan MinWidth para que, en una
							ventana angosta, la grilla scrollee en horizontal en vez de apretar
							siete columnas hasta volverlas ilegibles.
						-->
						<Grid Grid.Row="3" Margin="0 4 0 0">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0"
									   Margin="0 0 0 12"
									   Style="{ StaticResource ResourceKey=Txt.Seccion }"
									   Text="CALIFICACIONES"/>

							<DataGrid x:Name="DataGrid_Calificaciones"
									  Grid.Row="1"
									  AutomationProperties.Name="Calificaciones del alumno"
									  ItemsSource="{ Binding Path=Calificaciones, Mode=OneWay }"
									  SelectedItem="{ Binding Path=CalificacionSeleccionada, Mode=TwoWay }"
									  MinHeight="120"
									  Style="{ StaticResource ResourceKey=Grilla }"
									  Tag="El alumno elegido todavía no tiene calificaciones cargadas. Empezá con &#x201C;Cargar nota&#x201D;.">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{ Binding Path=Materia, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="MATERIA"
														MinWidth="140"
														Width="2*"/>
									<DataGridTextColumn Binding="{ Binding Path=Fecha, Mode=OneTime, StringFormat=d }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="FECHA"
														Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Instancia, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="INSTANCIA"
														Width="Auto"/>
									<DataGridCheckBoxColumn Binding="{ Binding Path=Rindio, Mode=OneWay }"
															Header="RINDIÓ"
															IsReadOnly="True"
															Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Nota, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
														Header="NOTA"
														Width="Auto"/>
									<DataGridCheckBoxColumn Binding="{ Binding Path=Aprobado, Mode=OneWay }"
															Header="APROBADO"
															IsReadOnly="True"
															Width="Auto"/>
									<DataGridTextColumn Binding="{ Binding Path=Observacion, Mode=OneTime }"
														ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
														Header="OBSERVACIÓN"
														MinWidth="160"
														Width="2*"/>
								</DataGrid.Columns>
							</DataGrid>
						</Grid>
						<!--#endregion-->

						<!--#region PIE-->
						<StackPanel Grid.Row="4">
							<!-- La nota no se corrige: se quita y se vuelve a cargar. Sólo la observación es editable. -->
							<HeaderedContentControl Header="Observación de la calificación elegida"
													Margin="0 16 0 0"
													Style="{ StaticResource ResourceKey=Campo }">
								<TextBox Tag="recuperatorio pendiente, ausente con certificado&#x2026;"
										 Text="{ Binding Path=ObservacionEdicion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
										 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
							</HeaderedContentControl>

							<HeaderedContentControl Style="{ StaticResource ResourceKey=Acciones }">
								<HeaderedContentControl.Header>
									<Button Command="{ Binding Path=QuitarCalificacionCommandAsync }"
											Content="Quitar calificación"
											Style="{ StaticResource ResourceKey=Btn.Peligro }"
											ToolTip="Quitar la calificación elegida"/>
								</HeaderedContentControl.Header>

								<!--
									"Editar observación" lo exige una guarda estática: distingue
									la única corrección que el dominio permite de corregir la
									nota, que no se puede. El rótulo no se cambia sin tocar esa
									guarda.

									"Cargar nota" se fue al encabezado de la pantalla, que es el
									hueco que el sistema reserva para la acción principal. Acá
									abajo quedaba sepultada al final de una página de 1520px.
								-->
								<Button Command="{ Binding Path=ModificarObservacionCommandAsync }"
										Content="Editar observación"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Guardar la observación de la calificación elegida"/>
							</HeaderedContentControl>
						</StackPanel>
						<!--#endregion-->
					</Grid>
				</Grid>
				<!--#endregion-->

				<!--
					EL VELO DE CARGA FALTABA, y era la única de las seis pantallas hermanas sin
					él. Importa especialmente acá: al elegir un alumno, OnCursanteChanged vacía
					Calificaciones de forma sincrónica y recién después dispara la consulta, así
					que entre un paso y el otro la grilla AFIRMABA que el alumno no tenía notas.
					Un estado vacío que miente es peor que no tener estado vacío.

					Uno por panel y no uno sobre la tarjeta entera: elegir un alumno no deja de
					saber quiénes son los demás, así que el índice se queda a la vista mientras
					el detalle espera. Cada velo cubre la columna que efectivamente está
					esperando.
				-->
				<components:CargandoComponent Grid.Column="0"
											  EstaCargando="{ Binding Path=BuscarCommandAsync.IsRunning }"
											  Leyenda="BUSCANDO"/>

				<components:CargandoComponent Grid.Column="2"
											  EstaCargando="{ Binding Path=CargarCalificacionesCommandAsync.IsRunning }"
											  Leyenda="CARGANDO LAS CALIFICACIONES"/>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region CARGAR CALIFICACIÓN
			Fila Auto DEBAJO de la tarjeta principal, que es fila *: cuando esta tarjeta aparece,
			la de arriba cede el alto y el formulario nace dentro de la pantalla. Antes vivía al
			final de un ScrollViewer de página y se abría fuera de la vista.
		-->
		<Border Grid.Row="2"
				Margin="0 16 0 0"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=MostrarCalificacionView, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="0 0 0 16">
					<TextBlock Style="{ StaticResource ResourceKey=Txt.Titulo }"
							   Text="Cargar una calificación"/>
					<TextBlock Margin="0 4 0 0"
							   Style="{ StaticResource ResourceKey=Txt.Detalle }"
							   Text="{ Binding Path=Cursante.NombreCompleto, Mode=OneWay, StringFormat=Nota de {0}, FallbackValue='Elegí primero un alumno', TargetNullValue='Elegí primero un alumno' }"/>
				</StackPanel>

				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<HeaderedContentControl Grid.Column="0"
											Header="Materia"
											Style="{ StaticResource ResourceKey=Campo.Izquierda }">
						<ComboBox DisplayMemberPath="Descripcion"
								  ItemsSource="{ Binding Path=Materias, Mode=OneWay }"
								  SelectedItem="{ Binding Path=Materia, Mode=TwoWay }"
								  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="1"
											Header="Instancia"
											Style="{ StaticResource ResourceKey=Campo.Centro }">
						<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=instancias } }"
								  SelectedItem="{ Binding Path=Calificacion.Instancia, Mode=TwoWay }"
								  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="2"
											Header="Fecha"
											Style="{ StaticResource ResourceKey=Campo.Centro }">
						<DatePicker DisplayDateEnd="{ x:Static sys:DateTime.Today }"
									DisplayDateStart="01/01/2000"
									SelectedDate="{ Binding Path=Calificacion.Fecha, Mode=TwoWay }"
									Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
					</HeaderedContentControl>

					<HeaderedContentControl Grid.Column="3"
											Header="Nota"
											Style="{ StaticResource ResourceKey=Campo.Derecha }">
						<TextBox MaxLength="2"
								 Tag="8"
								 Text="{ Binding Path=Calificacion.Nota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='' }"
								 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
					</HeaderedContentControl>
				</Grid>

				<HeaderedContentControl Grid.Row="2"
										Header="Observación"
										Style="{ StaticResource ResourceKey=Campo }">
					<TextBox Tag="tema evaluado, condiciones de la mesa&#x2026;"
							 Text="{ Binding Path=Calificacion.Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
				</HeaderedContentControl>

				<HeaderedContentControl Grid.Row="3" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<Button Command="{ Binding Path=CancelarCalificacionCommand }"
								Content="Cancelar"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Descartar la calificación"/>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<Button Command="{ Binding Path=RegistrarInasistenciaCommandAsync }"
								Content="Registrar inasistencia"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="El alumno no se presentó a la instancia"/>
						<Button Command="{ Binding Path=GuardarCalificacionCommandAsync }"
								Content="Guardar nota"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Guardar la calificación"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

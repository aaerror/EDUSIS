<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.GestionDivisionesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		DIVISIONES DEL CURSO.

		La tarjeta de notificación tenía su propio título "Notificaciones" con un ícono de
		información centrado. El aviso no necesita presentarse: pasa a ser una nota en línea
		con la marca ámbar del sistema.

		SE FUE LA TARJETA "ASIGNAR PRECEPTOR" que vivía en la cuarta fila, al pie.

		El recorrido era: elegir la división, apretar "Asignar preceptor" en el pie —que prendía
		la tarjeta y, en la misma línea, abría el modal encima—, buscar, elegir, y recién
		entonces aparecía abajo una tarjeta con el nombre del docente recién elegido y un botón
		para confirmarlo. Tres problemas en uno:

		La tarjeta nacía tapada. Se prendía y el modal se abría al mismo tiempo, así que nadie
		la veía aparecer; cuando el modal cerraba, el ojo estaba en el centro de la pantalla y
		la región nueva al pie.

		No agregaba información. El docente es el único dato de esta operación, así que la
		tarjeta mostraba lo que el usuario acababa de elegir y le pedía apretar otro botón. El
		patrón está copiado de Situación de Revista, donde sí se gana el lugar: ahí el docente
		es el primer dato de varios —cargo, período, a quién reemplaza—.

		Y cancelar el modal la dejaba huérfana: el buscador no conoce a sus llamadores, así que
		cerraba sin apagar HabilitarRegistrarDocente y quedaba al pie una tarjeta que decía
		"Ningún docente elegido" y que nadie había pedido.

		Ahora la transacción entera ocurre en el modal, que ya es modal: se titula con la
		división de destino, dice cómo está el cargo y su botón primario asigna. Ver
		BuscarContexto.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarDivisionesCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO
			El botón "Volver a cursos" se fue: la ruta de arriba lleva a Cursos, y era uno de los
			siete botones de volver con siete redacciones distintas.

			La letra se queda al lado de su botón, y es a propósito: es el único dato que la
			acción principal necesita, así que el campo y el botón son UN grupo de acción. Las
			pantallas cuya alta necesita un formulario entero —cátedras, horarios— lo tienen en
			su propia tarjeta y dejan el encabezado sin acción que compita.
		-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Divisiones"
									Subtitulo="Divisiones del curso, con su preceptor y sus alumnos">
			<components:PaginaComponent.Accion>
				<StackPanel Orientation="Horizontal">
					<!--
						La letra viene precargada con la que propone el dominio y el usuario la
						puede cambiar (DIV-1). El campo es angosto a propósito: entra una sola
						letra, y la validación de ObservableValidator deshabilita el botón si no
						es así.
					-->
					<HeaderedContentControl Header="Letra"
											Margin="0 0 8 0"
											Style="{ StaticResource ResourceKey=Campo }"
											ToolTip="Letra de la división nueva. El sistema propone la siguiente libre.">
						<TextBox MaxLength="1"
								 Style="{ StaticResource ResourceKey=Txb.Campo }"
								 Text="{ Binding Path=Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
								 Width="56"/>
					</HeaderedContentControl>

					<Button Command="{ Binding Path=RegistrarCommandAsync, IsAsync=True }"
							CommandParameter="Division"
							Style="{ StaticResource ResourceKey=Btn.Primario }"
							ToolTip="Crear una división nueva en el curso"
							VerticalAlignment="Bottom">
						<StackPanel Orientation="Horizontal">
							<fa:IconBlock FontSize="11"
										  Icon="Plus"
										  Margin="0 0 8 0"
										  VerticalAlignment="Center"/>
							<TextBlock Text="Nueva división" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</components:PaginaComponent.Accion>
		</components:PaginaComponent>
		<!--#endregion-->

		<!--#region AVISO-->
		<Border Grid.Row="1"
				IsEnabled="{ Binding Path=HabilitarNotificacion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					   TextWrapping="Wrap"/>
		</Border>
		<!--#endregion-->

		<!--#region DIVISIONES-->
		<Border Grid.Row="2"
				IsEnabled="{ Binding Path=HabilitarDivisiones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--#region FICHA DEL CURSO-->
				<Grid Grid.Row="0" Margin="0 0 0 16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Orientation="Horizontal">
						<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
								   Margin="0 2 14 2"
								   VerticalAlignment="Stretch"
								   Width="3"/>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Identificador }"
									   Text="{ Binding Path=NivelEducativo, Mode=OneWay, FallbackValue='SIN NIVEL', TargetNullValue='SIN NIVEL' }"/>
							<TextBlock Margin="0 2 0 0"
									   Style="{ StaticResource ResourceKey=Txt.Titulo }"
									   Text="{ Binding Path=Curso, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"/>
						</StackPanel>
					</StackPanel>

					<TextBlock Grid.Column="1"
							   Style="{ StaticResource ResourceKey=Txt.Dato }"
							   Text="{ Binding Path=TotalDivisiones, Mode=OneWay, StringFormat={}{0} divisiones, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
							   VerticalAlignment="Center"/>
				</Grid>
				<!--#endregion-->

				<DataGrid x:Name="DataGrid_Divisiones"
						  Grid.Row="1"
						  ItemsSource="{ Binding Path=ListCollectionDocentes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  SelectedItem="{ Binding Path=Division, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged }"
						  IsReadOnly="True"
						  IsSynchronizedWithCurrentItem="True"
						  Loaded="DataGrid_Divisiones_Loaded"
						  MinHeight="160"
						  Style="{ StaticResource ResourceKey=Grilla }"
						  Tag="Este curso todavía no tiene divisiones. Empezá con &#x201C;Nueva división&#x201D;."
						  d:ItemsSource="{ d:SampleData ItemCount=5 }">
					<DataGrid.Columns>
						<DataGridTextColumn Binding="{ Binding Path=Descripcion, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
											ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
											Header="DIVISIÓN"
											Width="*"/>
						<!--
							LA VACANTE ES UN ESTADO, NO UN NOMBRE QUE FALTA. La columna resolvía el
							cargo vacío con TargetNullValue='Sin asignar': un texto gris con el
							mismo peso que el nombre de un preceptor, en la misma tipografía, en la
							misma columna. Pero "Sin asignar" no es quién está a cargo: es que no
							hay nadie, y de eso depende que la división pueda tomar asistencia.

							Pasa a la insignia de alerta, que es como esta aplicación nombra el
							estado de un registro. El texto dice el estado y el color sólo lo
							refuerza, nunca al revés: ver INSIGNIAS en EDUSIS_Surfaces.

							Las dos piezas se apilan en la misma celda y se excluyen por PreceptorID
							con visibleSiHay —el par directo e inverso del mismo conversor—, que es
							el patrón de índice + ficha que ya usa la aplicación.
						-->
						<DataGridTemplateColumn Header="PRECEPTOR" Width="2*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<TextBlock Style="{ StaticResource ResourceKey=Celda.Texto }"
												   Text="{ Binding Path=Preceptor, Mode=OneWay, FallbackValue='Sin datos' }"
												   Visibility="{ Binding Path=PreceptorID, Mode=OneWay, Converter={ StaticResource ResourceKey=visibleSiHay } }"/>

										<Border HorizontalAlignment="Left"
												Style="{ StaticResource ResourceKey=Insignia.Alerta }"
												ToolTip="La división no puede tomar asistencia hasta que tenga preceptor"
												Visibility="{ Binding Path=PreceptorID, Mode=OneWay, Converter={ StaticResource ResourceKey=visibleSiHay }, ConverterParameter=inverso }">
											<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
													   Text="SIN PRECEPTOR"/>
										</Border>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Binding="{ Binding Path=Cursantes, FallbackValue='Sin datos', TargetNullValue='Sin datos', StringFormat={}{0} alumnos }"
											ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
											Header="INSCRIPTOS"
											Width="*"/>
						<!--
							ACÁ ESTABA UN BOTÓN QUE BORRABA LA FILA EQUIVOCADA.

							La columna traía un tachito que llamaba al comando del ViewModel con
							CommandParameter="Division" y sin pasar la fila: el comando opera sobre
							Division, que es el SelectedItem de la grilla. Clickear el tachito de
							una fila no seleccionada eliminaba la división seleccionada, que es
							otra. Y además era el segundo idioma visual para borrar en la misma
							pantalla: un ícono sin etiqueta arriba y un Btn.Peligro con texto en
							el pie.

							Ahora eliminar vive una sola vez, en el pie, con etiqueta y sobre la
							división elegida, que es la que la ficha de arriba está mostrando.
						-->
					</DataGrid.Columns>
				</DataGrid>

				<HeaderedContentControl Grid.Row="2" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<StackPanel Orientation="Horizontal">
							<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
									CommandParameter="Division"
									Content="Eliminar división"
									Margin="0 0 8 0"
									Style="{ StaticResource ResourceKey=Btn.Peligro }"
									ToolTip="Eliminar la división elegida, con sus planillas de asistencia"/>
							<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
									CommandParameter="Preceptor"
									Content="Quitar preceptor"
									Style="{ StaticResource ResourceKey=Btn.Peligro }"
									ToolTip="Quitar el preceptor de la división elegida"/>
						</StackPanel>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<Button Command="{ Binding Path=NavigationCommand }"
								CommandParameter="Cursantes"
								Content="Ver alumnos"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Alumnos y calificaciones de la división"/>
						<Button Command="{ Binding Path=NavigationCommand }"
								CommandParameter="Asistencias"
								Content="Tomar asistencia"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Planilla de asistencia diaria de la división"/>
						<!--
							UN SOLO BOTÓN DE PRECEPTOR, que se renombra.

							Eran dos, "Cambiar preceptor" y "Asignar preceptor", uno al lado del
							otro y excluyentes: el primero se habilitaba con el cargo ocupado y el
							segundo con el cargo vacante, así que siempre había uno muerto a la
							vista y la regla se aprendía mirando cuál se encendía. Son dos casos de
							uso en Core pero una sola intención del usuario —poner a alguien al
							frente de esta división—, y el estado del cargo ya lo dice la fila.

							Sigue siendo secundario: la acción primaria de la pantalla es crear una
							división, y está arriba.
						-->
						<Button Command="{ Binding Path=AsignarPreceptorCommand }"
								Content="{ Binding Path=VerboPreceptor, Mode=OneWay }"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Buscar un docente para ponerlo al frente de la división elegida"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->

		<components:CargandoComponent Grid.Row="0"
									  Grid.RowSpan="3"
									  EstaCargando="{ Binding Path=CargarDivisionesCommandAsync.IsRunning }"
									  Leyenda="CARGANDO LAS DIVISIONES"/>
	</Grid>
</UserControl>

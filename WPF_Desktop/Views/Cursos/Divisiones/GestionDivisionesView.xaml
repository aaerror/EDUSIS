<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.GestionDivisionesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		DIVISIONES DEL CURSO.

		La tarjeta de notificación tenía su propio título "Notificaciones" con un ícono de
		información centrado. El aviso no necesita presentarse: pasa a ser una nota en línea
		con la marca ámbar del sistema.

		El bloque de búsqueda de docente —campo, lupa, "Ver docentes" y una grilla de
		resultados— está escrito acá y otra vez en GestionSituacionRevista. Es exactamente el
		trabajo de BuscarView, el modal: cuando el modal esté cableado, estas dos copias se
		reemplazan por una llamada al ModalNavigationService.

		Los resultados venían dentro de un Expander, pero su visibilidad ya cuelga de
		HabilitarListaDocentes: no existen hasta que hay búsqueda, así que el Expander
		escondía algo que recién había aparecido. Queda la sección con su rótulo.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarDivisionesCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="Divisiones"
							   Subtitle="Divisiones del curso, con su preceptor y sus alumnos"/>

			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						VerticalAlignment="Center">
				<Button Command="{ Binding Path=NavigationCommand }"
						CommandParameter="Curso"
						Margin="0 0 8 0"
						Style="{ StaticResource ResourceKey=Btn.Terciario }"
						ToolTip="Volver a cursos">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="ArrowLeft"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Volver a cursos" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Button Command="{ Binding Path=RegistrarCommandAsync, IsAsync=True }"
						CommandParameter="Division"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Crear una división nueva en el curso">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Nueva división" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
		<!--#endregion-->

		<!--#region AVISO-->
		<Border Grid.Row="1"
				IsEnabled="{ Binding Path=HabilitarNotificacion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					   TextWrapping="Wrap"/>
		</Border>
		<!--#endregion-->

		<!--#region DIVISIONES-->
		<Border Grid.Row="2"
				IsEnabled="{ Binding Path=HabilitarDivisiones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--#region FICHA DEL CURSO-->
				<Grid Grid.Row="0" Margin="0 0 0 16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Orientation="Horizontal">
						<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
								   Margin="0 2 14 2"
								   VerticalAlignment="Stretch"
								   Width="3"/>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Identificador }"
									   Text="{ Binding Path=NivelEducativo, Mode=OneWay, FallbackValue='SIN NIVEL', TargetNullValue='SIN NIVEL' }"/>
							<TextBlock Margin="0 2 0 0"
									   Style="{ StaticResource ResourceKey=Txt.Titulo }"
									   Text="{ Binding Path=Curso, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"/>
						</StackPanel>
					</StackPanel>

					<TextBlock Grid.Column="1"
							   Style="{ StaticResource ResourceKey=Txt.Dato }"
							   Text="{ Binding Path=TotalDivisiones, Mode=OneWay, StringFormat={}{0} divisiones, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
							   VerticalAlignment="Center"/>
				</Grid>
				<!--#endregion-->

				<DataGrid x:Name="DataGrid_Divisiones"
						  Grid.Row="1"
						  ItemsSource="{ Binding Path=ListCollectionDocentes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  SelectedItem="{ Binding Path=Division, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged }"
						  IsReadOnly="True"
						  IsSynchronizedWithCurrentItem="True"
						  Loaded="DataGrid_Divisiones_Loaded"
						  MinHeight="160"
						  Style="{ StaticResource ResourceKey=Grilla }"
						  Tag="Este curso todavía no tiene divisiones. Empezá con &#x201C;Nueva división&#x201D;."
						  d:ItemsSource="{ d:SampleData ItemCount=5 }">
					<DataGrid.Columns>
						<DataGridTextColumn Binding="{ Binding Path=Descripcion, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
											Header="DIVISIÓN"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=Preceptor, FallbackValue='Sin datos', TargetNullValue='Sin asignar' }"
											Header="PRECEPTOR"
											Width="2*"/>
						<DataGridTextColumn Binding="{ Binding Path=Cursantes, FallbackValue='Sin datos', TargetNullValue='Sin datos', StringFormat={}{0} alumnos }"
											Header="INSCRIPTOS"
											Width="*"/>
						<DataGridTemplateColumn Header="" Width="Auto">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Command="{ Binding Path=DataContext.EliminarCommandAsync, IsAsync=True, RelativeSource={ RelativeSource Mode=FindAncestor, AncestorType={ x:Type TypeName=UserControl } } }"
											CommandParameter="Division"
											Style="{ StaticResource ResourceKey=Btn.Icono }"
											ToolTip="Eliminar esta división">
										<fa:IconBlock FontSize="11" Icon="Trash"/>
									</Button>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<HeaderedContentControl Grid.Row="2" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
								CommandParameter="Preceptor"
								Content="Quitar preceptor"
								Style="{ StaticResource ResourceKey=Btn.Peligro }"
								ToolTip="Quitar el preceptor de la división elegida"/>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<Button Command="{ Binding Path=NavigationCommand }"
								CommandParameter="Cursantes"
								Content="Ver alumnos"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Alumnos y calificaciones de la división"/>
						<Button Command="{ Binding Path=RegistrarCommandAsync, IsAsync=True }"
								CommandParameter="Docente"
								Content="Asignar preceptor"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Buscar un docente y asignarlo como preceptor"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region ASIGNAR PRECEPTOR-->
		<Border Grid.Row="3"
				IsEnabled="{ Binding Path=HabilitarRegistrarDocente, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 16 0 0"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="0 0 0 16">
					<TextBlock Style="{ StaticResource ResourceKey=Txt.Titulo }"
							   Text="Asignar preceptor"/>
					<TextBlock Margin="0 4 0 0"
							   Style="{ StaticResource ResourceKey=Txt.Detalle }"
							   Text="{ Binding Path=Division.Descripcion, Mode=OneWay, StringFormat=Preceptor de la división {0}, FallbackValue='Elegí primero una división', TargetNullValue='Elegí primero una división' }"/>
				</StackPanel>

				<!--
					El buscador de docentes estaba acá, escrito a mano: campo con Query validado,
					lupa, "Ver docentes" y un Expander con la grilla de resultados. Ahora lo abre
					el modal (BuscarView), que es la misma pieza que usa Situación de Revista, y
					el elegido vuelve por DocenteElegidoMessage.
				-->
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<HeaderedContentControl Grid.Column="0"
											Content="{ Binding Path=Docente.NombreCompleto, Mode=OneWay, FallbackValue='Ningún docente elegido', TargetNullValue='Ningún docente elegido' }"
											Header="Docente"
											Style="{ StaticResource ResourceKey=Dato.Izquierda }"/>

					<Button Grid.Column="1"
							Command="{ Binding Path=BuscarDocenteCommand }"
							Margin="10 0 0 16"
							Style="{ StaticResource ResourceKey=Btn.Secundario }"
							ToolTip="Abrir el buscador de docentes"
							VerticalAlignment="Bottom">
						<StackPanel Orientation="Horizontal">
							<fa:IconBlock FontSize="11"
										  Icon="MagnifyingGlass"
										  Margin="0 0 8 0"
										  VerticalAlignment="Center"/>
							<TextBlock Text="Buscar docente" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</Grid>

				<HeaderedContentControl Grid.Row="2" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<Button Command="{ Binding Path=CancelarCommand }"
								Content="Cancelar"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Dejar la división sin cambios"/>
					</HeaderedContentControl.Header>

					<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
							CommandParameter="Insert"
							Content="Asignar preceptor"
							Style="{ StaticResource ResourceKey=Btn.Primario }"
							ToolTip="Asignar el docente elegido como preceptor"/>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Cursos.Divisiones.CalificacionView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Divisiones"
			 xmlns:domainClasificaciones="clr-namespace:Domain.Cursantes.Calificaciones;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		CALIFICACIÓN — subformulario de carga de una nota.

		Las cuatro RowDefinition no declaraban Height, así que eran * y no Auto: el sobrante
		de la pantalla se repartía entre las filas y los campos quedaban desparejos. Es el
		mismo defecto que tenían la ficha personal y el domicilio.

		Se sacó el Background="white" de la grilla raíz —el fondo lo pone la tarjeta que la
		contiene— y el rótulo "Rindió" que estaba encima de la casilla "¿Rindió el alumno?":
		la casilla ya se nombra sola.

		La nota sólo aparece si rindió; eso lo decide MostrarNota en el ViewModel.
	-->
	<UserControl.Resources>
		<ObjectDataProvider x:Key="instancias" MethodName="GetNames" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainClasificaciones:Instancia"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<GroupBox Header="CALIFICACIÓN" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<HeaderedContentControl Grid.Column="0" Grid.Row="0"
									Header="Materia"
									Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox Tag="Lengua y Literatura"
						 Text="{ Binding Path=Materia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="0"
									Header="Instancia"
									Style="{ StaticResource ResourceKey=Campo.Centro }">
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=instancias } }"
						  SelectedItem="{ Binding Path=Instancia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="2" Grid.Row="0"
									Header="Fecha"
									Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<DatePicker DisplayDateEnd="{ x:Static sys:DateTime.Today }"
							DisplayDateStart="01/01/2000"
							SelectedDate="{ Binding Path=Fecha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
			</HeaderedContentControl>

			<CheckBox Grid.Column="0" Grid.Row="1"
					  Content="El alumno rindió"
					  IsChecked="{ Binding Path=Rindio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
					  Style="{ StaticResource ResourceKey=Chk.Campo.Alineada }"/>

			<HeaderedContentControl Grid.Column="1" Grid.Row="1"
									Header="Nota"
									Style="{ StaticResource ResourceKey=Campo.Centro }"
									Visibility="{ Binding Path=MostrarNota, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }">
				<TextBox MaxLength="2"
						 Tag="8"
						 Text="{ Binding Path=Nota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>
		</Grid>
	</GroupBox>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Cursos.GestionCursosView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		Mismo patrón índice + ficha que Docentes. Acá el índice ya venía agrupado por nivel
		educativo desde el ViewModel (ListCollectionView con PropertyGroupDescription), así
		que el encabezado de grupo se aprovecha como rótulo de sección: Inicial, Primario,
		Secundario. Es estructura que sale del contenido, no decoración.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCursosCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="Cursos"
							   Subtitle="Cursos por nivel, con sus divisiones y su diseño curricular"/>

			<Button Grid.Column="1"
					Command="{ Binding Path=NavigationCommand }"
					CommandParameter="Curso"
					Style="{ StaticResource ResourceKey=Btn.Primario }"
					ToolTip="Crear un curso nuevo"
					VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<fa:IconBlock FontSize="11"
								  Icon="Plus"
								  Margin="0 0 8 0"
								  VerticalAlignment="Center"/>
					<TextBlock Text="Registrar curso" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>
		<!--#endregion-->

		<!--#region CUERPO-->
		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="360"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!--#region ÍNDICE-->
				<Grid Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
							   Margin="18 18 18 10"
							   Style="{ StaticResource ResourceKey=Txt.Seccion }"
							   Text="CURSOS POR NIVEL"/>

					<ListView Grid.Row="1"
							  ItemsSource="{ Binding Path=ListCollection }"
							  SelectedItem="{ Binding Path=Curso, Mode=TwoWay }"
							  Style="{ StaticResource ResourceKey=Lista.Indice }"
							  Tag="Todavía no hay cursos. Empezá con &#x201C;Registrar curso&#x201D;.">
						<ListView.GroupStyle>
							<GroupStyle>
								<GroupStyle.HeaderTemplate>
									<DataTemplate>
										<Border Background="{ StaticResource ResourceKey=Tiza }"
												BorderBrush="{ StaticResource ResourceKey=Linea }"
												BorderThickness="0 1 0 1"
												Padding="18 6">
											<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
													   Text="{ Binding Path=Name }"/>
										</Border>
									</DataTemplate>
								</GroupStyle.HeaderTemplate>
							</GroupStyle>
						</ListView.GroupStyle>
						<ListView.View>
							<GridView AllowsColumnReorder="False">
								<GridView.Columns>
									<GridViewColumn Header="GRADO" Width="320">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
														   Text="{ Binding Path=Grado, TargetNullValue='Sin datos' }"/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
								</GridView.Columns>
							</GridView>
						</ListView.View>
					</ListView>
				</Grid>
				<!--#endregion-->

				<Rectangle Grid.Column="1" Style="{ StaticResource ResourceKey=Regla.Vertical }"/>

				<!--#region FICHA-->
				<Grid Grid.Column="2">
					<StackPanel HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Visibility="{ Binding Path=Curso, Converter={ StaticResource ResourceKey=visibleSiHay }, ConverterParameter=inverso }">
						<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
								   HorizontalAlignment="Center"
								   Style="{ StaticResource ResourceKey=Txt.Subtitulo }"
								   Text="Elegí un curso"/>
						<TextBlock HorizontalAlignment="Center"
								   Margin="0 6 0 0"
								   MaxWidth="300"
								   Style="{ StaticResource ResourceKey=Txt.Detalle }"
								   Text="Desde acá se abren sus divisiones y el diseño curricular del curso."
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>

					<Grid Margin="28 22"
						  Visibility="{ Binding Path=Curso, Converter={ StaticResource ResourceKey=visibleSiHay } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0" Orientation="Horizontal">
							<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
									   Margin="0 2 14 2"
									   VerticalAlignment="Stretch"
									   Width="3"/>
							<StackPanel>
								<TextBlock Style="{ StaticResource ResourceKey=Txt.Identificador }"
										   Text="{ Binding Path=Curso.NivelEducativo }"/>
								<TextBlock Margin="0 2 0 0"
										   Style="{ StaticResource ResourceKey=Txt.Titulo }"
										   Text="{ Binding Path=Curso.Grado }"/>
							</StackPanel>
						</StackPanel>

						<Border Grid.Row="1"
								Margin="0 20 0 0"
								Style="{ StaticResource ResourceKey=Superficie.Seccion }"
								VerticalAlignment="Top">
							<TextBlock MaxWidth="420"
									   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
									   Text="Las divisiones agrupan a los alumnos del curso y le asignan preceptor. El diseño curricular define las materias y su carga horaria."
									   TextWrapping="Wrap"/>
						</Border>

						<Grid Grid.Row="2" Margin="0 20 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0"
									Command="{ Binding Path=EliminarCommandAsync }"
									CommandParameter="Curso"
									Content="Eliminar"
									Style="{ StaticResource ResourceKey=Btn.Peligro }"
									ToolTip="Eliminar este curso"/>

							<StackPanel Grid.Column="1"
										HorizontalAlignment="Right"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Division"
										Content="Divisiones"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Divisiones, preceptores y cursantes"/>
								<Button Command="{ Binding Path=NavigationCommand }"
										CommandParameter="Materia"
										Content="Diseño curricular"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Materias y carga horaria del curso"/>
							</StackPanel>
						</Grid>
					</Grid>
				</Grid>
				<!--#endregion-->
			</Grid>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

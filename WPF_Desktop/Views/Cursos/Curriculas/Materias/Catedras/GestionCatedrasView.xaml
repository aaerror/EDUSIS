<UserControl x:Class="WPF_Desktop.Views.Cursos.Curriculas.Materias.Catedras.GestionCatedrasView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Curriculas.Materias.Catedras"

			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region EVENTS-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCommand }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<!--#region TITLE & SUBTITLE-->
		<components:Header Grid.Row="0"
						   Title="{ Binding Path=Materia.Descripcion, Mode=OneWay }"
						   Subtitle="Cátedras de la materia (materia y división)"
						   VerticalContentAlignment="Top"/>
		<!--#endregion-->

		<!--#region COMMANDs-->
		<Grid Grid.Row="1"
			  Margin="25 10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<WrapPanel Grid.Column="0"
					   HorizontalAlignment="Left">
				<!--#region División sin cátedra + CrearCatedraCommand-->
				<ComboBox ItemsSource="{ Binding Path=DivisionesSinCatedra, Mode=OneWay }"
						  SelectedItem="{ Binding Path=DivisionSeleccionada, Mode=TwoWay }"
						  DisplayMemberPath="Descripcion"
						  ToolTip="División que todavía no tiene cátedra de esta materia"
						  MinWidth="120"
						  Margin="0 0 5 0"/>
				<Button Command="{ Binding Path=CrearCatedraCommand }"
						ToolTip="Crear cátedra"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="Plus"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="0 0 2 0"/>
							<TextBlock Text="Crear Cátedra"
									   Margin="2 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
			<WrapPanel Grid.Column="1"
					   HorizontalAlignment="Right">
				<!--#region VolverCommand: Materias-->
				<Button Command="{ Binding Path=VolverCommand }"
						HorizontalAlignment="Right"
						ToolTip="Ir a Materias"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<TextBlock Text="Ir a Materias"
									   Margin="0 0 2 2"/>
							<fa:IconBlock Icon="ArrowRight"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="2 0 0 0"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
		</Grid>
		<!--#endregion-->

		<!--#region CÁTEDRAS-->
		<Label Grid.Row="2"
			   Style="{ StaticResource ResourceKey=Headline }"
			   Content="Cátedras"
			   Margin="25 10 25 0"/>
		<ScrollViewer Grid.Row="3"
					  VerticalScrollBarVisibility="Auto"
					  Margin="25 5">
			<ItemsControl ItemsSource="{ Binding Path=Catedras, Mode=OneWay }">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border BorderBrush="{ StaticResource ResourceKey=Gray200 }"
								BorderThickness="1"
								CornerRadius="4"
								Margin="0 5"
								Padding="10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<Label Style="{ StaticResource ResourceKey=Headline }"
										   Content="{ Binding Path=Division }"
										   ContentStringFormat="División {0}"/>
									<TextBlock Style="{ StaticResource ResourceKey=Body }">
										<Run Text="Carga horaria: "/><Run Text="{ Binding Path=CargaHoraria, Mode=OneWay }"/>
										<Run Text=" | Asignadas: "/><Run Text="{ Binding Path=HorasAsignadas, Mode=OneWay }"/>
										<Run Text=" | Sin asignar: "/><Run Text="{ Binding Path=HorasSinAsignar, Mode=OneWay }"/>
									</TextBlock>
								</StackPanel>
								<Button Grid.Column="1"
										Command="{ Binding Path=DataContext.SeleccionarCatedraCommand, RelativeSource={ RelativeSource AncestorType=UserControl } }"
										CommandParameter="{ Binding }"
										ToolTip="Ir a Situación de Revista"
										Style="{ StaticResource ResourceKey=Secondary }">
									<Button.Content>
										<WrapPanel>
											<TextBlock Text="Situación de Revista"
													   Margin="0 0 2 2"/>
											<fa:IconBlock Icon="ArrowRight"
														  Foreground="{ StaticResource ResourceKey=Neutral800 }"
														  Margin="2 0 0 0"/>
										</WrapPanel>
									</Button.Content>
								</Button>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		<!--#endregion-->
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Cursos.Curriculas.Materias.Catedras.GestionCatedrasView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Curriculas.Materias.Catedras"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		CÁTEDRAS DE LA MATERIA — una por división.

		El ComboBox de divisiones sin cátedra era el único control de la pantalla sin estilo:
		se dibujaba con el combo de Windows, gradiente celeste incluido.

		Cada cátedra mostraba su carga horaria en un renglón de Runs separados por barras
		("Carga horaria: 4 | Asignadas: 2 | Sin asignar: 2"). Son tres números que se comparan
		entre cátedras, así que van tabulados en monoespaciada con su rótulo: lo que importa
		es si queda algo sin asignar.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCommand }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="{ Binding Path=Materia.Descripcion, Mode=OneWay }"
							   Subtitle="Cátedras de la materia: una por división"
							   VerticalContentAlignment="Top"/>

			<Button Grid.Column="1"
					Command="{ Binding Path=VolverCommand }"
					Style="{ StaticResource ResourceKey=Btn.Terciario }"
					ToolTip="Volver al diseño curricular"
					VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<fa:IconBlock FontSize="11"
								  Icon="ArrowLeft"
								  Margin="0 0 8 0"
								  VerticalAlignment="Center"/>
					<TextBlock Text="Volver a materias" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>
		<!--#endregion-->

		<!--#region CREAR CÁTEDRA-->
		<Border Grid.Row="1"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid Margin="20 18">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<HeaderedContentControl Grid.Column="0"
										Header="División sin cátedra de esta materia"
										Margin="0 0 12 0"
										Style="{ StaticResource ResourceKey=Campo }">
					<ComboBox DisplayMemberPath="Descripcion"
							  HorizontalAlignment="Left"
							  ItemsSource="{ Binding Path=DivisionesSinCatedra, Mode=OneWay }"
							  MinWidth="220"
							  SelectedItem="{ Binding Path=DivisionSeleccionada, Mode=TwoWay }"
							  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
				</HeaderedContentControl>

				<Button Grid.Column="1"
						Command="{ Binding Path=CrearCatedraCommand }"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Crear la cátedra de la división elegida"
						VerticalAlignment="Bottom"
						Margin="0 0 0 16">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Crear cátedra" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region CÁTEDRAS-->
		<Border Grid.Row="2" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
						   Margin="0 0 0 12"
						   Style="{ StaticResource ResourceKey=Txt.Seccion }"
						   Text="CÁTEDRAS ABIERTAS"/>

				<!--
					Un ItemsControl no tiene estado vacío propio como Grilla o Lista.Indice:
					el aviso cuelga de su HasItems.
				-->
				<TextBlock Grid.Row="1"
						   Foreground="{ StaticResource ResourceKey=TintaSuave }"
						   HorizontalAlignment="Center"
						   Margin="32 36"
						   MaxWidth="320"
						   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
						   Text="Esta materia todavía no tiene cátedras. Elegí una división y creá la primera."
						   TextAlignment="Center"
						   TextWrapping="Wrap"
						   VerticalAlignment="Top"
						   Visibility="{ Binding Path=HasItems, ElementName=ListaCatedras, Converter={ StaticResource ResourceKey=visibilidadInversa } }"/>

				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="ListaCatedras"
								  ItemsSource="{ Binding Path=Catedras, Mode=OneWay }">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="{ StaticResource ResourceKey=Linea }"
										BorderThickness="0 0 0 1"
										Padding="0 14"
										SnapsToDevicePixels="True">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<StackPanel Grid.Column="0" VerticalAlignment="Center">
											<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
													   Text="DIVISIÓN"/>
											<TextBlock Margin="0 2 0 0"
													   Style="{ StaticResource ResourceKey=Txt.CuerpoFuerte }"
													   Text="{ Binding Path=Division }"/>
										</StackPanel>

										<StackPanel Grid.Column="1"
													Margin="0 0 24 0"
													Orientation="Horizontal"
													VerticalAlignment="Center">
											<StackPanel Margin="0 0 20 0">
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
														   Text="CARGA"/>
												<TextBlock Margin="0 2 0 0"
														   Style="{ StaticResource ResourceKey=Txt.Dato }"
														   Text="{ Binding Path=CargaHoraria, Mode=OneWay }"/>
											</StackPanel>
											<StackPanel Margin="0 0 20 0">
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
														   Text="ASIGNADAS"/>
												<TextBlock Margin="0 2 0 0"
														   Style="{ StaticResource ResourceKey=Txt.Dato }"
														   Text="{ Binding Path=HorasAsignadas, Mode=OneWay }"/>
											</StackPanel>
											<StackPanel>
												<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
														   Text="SIN ASIGNAR"/>
												<TextBlock Margin="0 2 0 0"
														   Style="{ StaticResource ResourceKey=Txt.DatoFuerte }"
														   Text="{ Binding Path=HorasSinAsignar, Mode=OneWay }"/>
											</StackPanel>
										</StackPanel>

										<Button Grid.Column="2"
												Command="{ Binding Path=DataContext.SeleccionarCatedraCommand, RelativeSource={ RelativeSource AncestorType=UserControl } }"
												CommandParameter="{ Binding }"
												Content="Designar docentes"
												Style="{ StaticResource ResourceKey=Btn.Secundario }"
												ToolTip="Situación de revista de la cátedra"
												VerticalAlignment="Center"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

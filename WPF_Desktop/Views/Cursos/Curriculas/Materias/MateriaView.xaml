<UserControl x:Class="WPF_Desktop.Views.Cursos.Curriculas.Materias.MateriaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Curriculas.Materias"

			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240*"/>
			<ColumnDefinition Width="121*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region CURSO ID-->
		<StackPanel Grid.ColumnSpan="2"
					Grid.Row="0"
					Margin="0 0 0 5"
					Visibility="Collapsed">
			<!--#region LABEL: CURSO ID-->
			<Label Content="CursoID"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<!--#endregion-->
			<!--#region INPUT: CURSO ID-->
			<TextBox Text="{ Binding Path=CurriculaID, FallbackValue='Sin especificar', TargetNullValue='Sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					 IsReadOnly="True"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
			<!--#endregion-->
		</StackPanel>
		<!--#endregion-->

		<!--#region CURRICULA ID-->
		<StackPanel Grid.ColumnSpan="2"
					Grid.Row="1"
					Margin="0 5"
					Visibility="Collapsed">
			<!--#region LABEL: CURRICULA ID-->
			<Label Content="Curricula ID"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<!--#endregion-->
			<!--#region INPUT: CURRICULA ID-->
			<TextBox Text="{ Binding Path=CurriculaID, FallbackValue='Sin especificar', TargetNullValue='Sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					 IsReadOnly="True"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
			<!--#endregion-->
		</StackPanel>
		<!--#endregion-->

		<!--#region MATERIA ID-->
		<StackPanel Grid.ColumnSpan="2"
					Grid.Row="2"
					Margin="0 5 0 10"
					Visibility="Collapsed">
			<!--#region LABEL: MATERIA ID-->
			<Label Content="Materia ID"
				   Margin="4 0 0 0"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<!--#endregion-->
			<!--#region INPUT: MATERIA ID-->
			<TextBox Text="{ Binding Path=MateriaID, FallbackValue='Sin especificar', TargetNullValue='Sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					 IsReadOnly="True"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
			<!--#endregion-->
		</StackPanel>
		<!--#endregion-->

		<Grid Grid.ColumnSpan="2"
			  Grid.Row="3"
			  Margin="0 0 0 5" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!--#region MATERIA-->
			<StackPanel Grid.Column="0"
						Margin="0 0 10 0">
				<!--#region LABEL: MATERIA-->
				<Label Content="Materia"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: MATERIA-->
				<TextBox Text="{ Binding Path=Descripcion, FallbackValue='Sin especificar', TargetNullValue='Sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->
			<!--#region HORAS CATEDRA-->
			<StackPanel Grid.Column="1"
						Margin="10 0 0 0">
				<!--#region LABEL: HORAS CÁTEDRA-->
				<Label Content="Horas Cátedra"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: HORAS CÁTEDRA-->
				<ComboBox SelectedIndex="{ Binding Path=HorasCatedra, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }">
					<ComboBoxItem Content="1" IsSelected="True"/>
					<ComboBoxItem Content="2"/>
					<ComboBoxItem Content="3"/>
					<ComboBoxItem Content="4"/>
					<ComboBoxItem Content="5"/>
				</ComboBox>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->
		</Grid>

		<Grid Grid.ColumnSpan="2"
			  Grid.Row="4"
			  Margin="0 5 0 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!--#region PROFESOR-->
			<StackPanel Grid.Column="0"
						Margin="0 0 10 0">
				<!--#region LABEL: PROFESOR-->
				<Label Content="Profesor a Cargo"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: PROFESOR-->
				<TextBox Text="{ Binding Path=SituacionRevista.Docente, FallbackValue='Profesor sin asignar', TargetNullValue='Profesor sin asignar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						 IsReadOnly="True"
						 Style="{ StaticResource ResourceKey=TextBox}"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->
			<!--#region CARGOS OCUPADOS-->
			<StackPanel Grid.Column="1"
						Margin="10 0 0 0">
				<!--#region LABEL: CARGOS OCUPADOS-->
				<Label Content="Docentes con Cargos Ocupados"
					   Margin="4 0 0 0" 
					   Style="{ StaticResource Form }"/>
				<!--#endregion-->
				<!--#region INPUT: CARGOS OCUPADOS-->
				<TextBox Text="{ Binding Path=CargosOcupados, FallbackValue='Sin datos de los docentes', TargetNullValue='Sin datos', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						 IsReadOnly="True"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->
			<!--#endregion-->
		</Grid>
	</Grid>
</UserControl>
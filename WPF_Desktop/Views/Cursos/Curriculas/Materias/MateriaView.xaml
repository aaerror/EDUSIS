<UserControl x:Class="WPF_Desktop.Views.Cursos.Curriculas.Materias.MateriaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Curriculas.Materias"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		MATERIA DEL DISEÑO CURRICULAR — subformulario de edición.

		Se sacaron tres bloques con Visibility="Collapsed" fija (CursoID, CurriculaID,
		MateriaID). Dos de ellos enlazaban la MISMA propiedad: el rotulado "CursoID" mostraba
		CurriculaID. Al estar ocultos nadie lo veía, pero el enlace estaba mal escrito.

		Las columnas de la grilla raíz eran 240*/121* y después una grilla interna las volvía a
		partir en mitades, así que la proporción declarada no se aplicaba a nada.
	-->
	<!--
		EL COMBO DE HORAS SALE DE LA MATERIA Y YA NO DE UNA LISTA FIJA. Era un x:Array de 1 a 5 con
		el SelectedItem en TwoWay, así que una materia con una carga fuera de esa lista no encontraba
		su ítem y WPF le escribía null de vuelta: la materia quedaba inválida sola al abrir el editor
		y "Guardar materia" —que cuelga su visibilidad del IsEnabled— desaparecía sin explicación.
		OpcionesCargaHoraria incluye siempre el valor actual.
	-->
	<GroupBox Header="MATERIA" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<HeaderedContentControl Grid.Column="0"
									Header="Materia"
									Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox MaxLength="30"
						 Tag="Lengua y Literatura"
						 Text="{ Binding Path=Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1"
									Header="Horas cátedra"
									Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<ComboBox AutomationProperties.Name="Horas cátedra de la materia"
						  ItemsSource="{ Binding Path=OpcionesCargaHoraria, Mode=OneWay }"
						  SelectedItem="{ Binding Path=HorasCatedra, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>
		</Grid>
	</GroupBox>
</UserControl>

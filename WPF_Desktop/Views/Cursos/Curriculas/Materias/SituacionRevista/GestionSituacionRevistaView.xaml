<UserControl x:Class="WPF_Desktop.Views.Cursos.Curriculas.Materias.SituacionRevista.GestionSituacionRevistaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Curriculas.Materias.SituacionRevista"

			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainCargosDocentes="clr-namespace:Domain.Curriculas.Materias.CargosDocentes;assembly=Domain"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region RESOURCES-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="booleanConverter"/>

		<converters:EnumConverter x:Key="enumConverter"/>
		<converters:CargoConverter x:Key="cargoConverter"/>

		<ObjectDataProvider x:Key="cargos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type Type="domainCargosDocentes:Cargo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>
	<!--#endregion-->
	<!--#region EVENTS-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger x:Name="Loaded">
			<behaviors:CallMethodAction MethodName="CargarSituacionRevistas"
										TargetObject="{Binding}"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<!--#region TITLE & SUBTITLE-->
		<components:Header Grid.Row="0"
						   Title="{ Binding Path=Materia.Descripcion, Mode=OneWay }"
						   Subtitle="Situación de Revista de los docentes"
						   VerticalContentAlignment="Top"/>
		<!--#endregion-->

		<!--#region COMMANDs-->
		<Grid Grid.Row="1"
			  Margin="25 10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<WrapPanel Grid.Column="0"
					   HorizontalAlignment="Left">
				<!--#region RegistrarCommand: SituacionRevista-->
				<Button Command="{ Binding Path=RegistrarCommand }"
						CommandParameter="SituacionRevista"
						ToolTip="Asignar Cargo Docente"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="Plus"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="0 0 2 0"/>
							<TextBlock Text="Asignar Cargo"
									   Margin="2 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
			<WrapPanel Grid.Column="1"
					   HorizontalAlignment="Right">
				<!--#region NavigationCommand: Materia-->
				<Button Command="{ Binding Path=NavigationCommand }"
						CommandParameter="Materias"
						HorizontalAlignment="Right"
						ToolTip="Ir a Materias"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<TextBlock Text="Ir a Materias"
									   Margin="0 0 2 2"/>
							<fa:IconBlock Icon="ArrowRight"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="2 0 0 0"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
		</Grid>
		<!--#endregion-->

		<!--#region NOTIFICATIONs-->
		<Border Grid.Row="2"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarNotificacion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
				Margin="20 10"
				Padding="10">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
						  Color="#373737"
						  ShadowDepth="5"
						  Opacity=".3"/>
			</Border.Effect>
			<Grid Margin="20 10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<!--#region TITLE-->
				<StackPanel Grid.Row="0"
							Margin="0 0 0 5">
					<Label Style="{ StaticResource ResourceKey=Headline }">
						<WrapPanel HorizontalAlignment="Center">
							<fa:IconBlock Icon="CircleInfo"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  Margin="0 0 2 0"/>
							<TextBlock Text="Notificaciones"
									   Margin="2 0 0 2"/>
						</WrapPanel>
					</Label>
					<Separator Background="{ StaticResource ResourceKey=Gray400 }"
							   Height=".8"
							   Width="Auto"/>
				</StackPanel>
				<!--#endregion-->
				<!--#region MESSAGE-->
				<StackPanel Grid.Row="1"
							Margin="0 5 0 0">
					<Label Content="{ Binding Path=Mensaje, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						   Style="{ StaticResource ResourceKey=Body }"/>
				</StackPanel>
				<!--#endregion-->
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region DOCENTE EN FUNCIONES-->
		<Border Grid.Row="3"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarDocenteEnFunciones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Padding="20"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<!--#region Title-->
				<StackPanel Grid.Row="0"
							Margin="0 0 0 2">
					<Label Style="{ StaticResource ResourceKey=Headline }">
						<Label.Content>
							<WrapPanel HorizontalAlignment="Center">
								<fa:IconBlock Icon="ChalkboardTeacher"
											  Foreground="{ StaticResource ResourceKey=Neutral800 }"
											  Margin="0 0 2 0"/>
								<TextBlock Text="Docente en Aula"
										   Margin="2 0 0 2"/>
							</WrapPanel>
						</Label.Content>
					</Label>
					<Separator Background="{ StaticResource ResourceKey=Gray400 }"
							   Height=".8"
							   Width="Auto"/>
				</StackPanel>
				<!--#endregion-->
				<StackPanel Grid.Row="1"
							Margin="0 2 0 0">
					<!--#region Situación Revista-->
					<local:SituacionRevistaView DataContext="{ Binding Path=Materia.SituacionRevista, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
												IsEnabled="False"/>
					<!--#endregion-->
				</StackPanel>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region GESTIÓN CARGOS DOCENTES-->
		<Border Grid.Row="4"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				Margin="20 10"
				IsEnabled="{ Binding Path=HabilitarGestionSituacionRevista, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				VerticalAlignment="Top"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>
			<ScrollViewer Padding="10 20"
						  VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="20 0">
					<!--#region GESTIÓN-->
					<Grid IsEnabled="{ Binding Path=HabilitarInfoSituacionRevista, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<!--#region Title-->
						<StackPanel Grid.Row="0"
									Margin="0 0 0 2">
							<Label Style="{ StaticResource ResourceKey=Headline }">
								<Label.Content>
									<WrapPanel HorizontalAlignment="Center">
										<fa:IconBlock Icon="Users"
													  Foreground="{ StaticResource ResourceKey=Neutral800 }"
													  Margin="0 0 2 0"/>
										<TextBlock Text="Docentes registrados en la materia"
												   Margin="2 0 0 2"/>
									</WrapPanel>
								</Label.Content>
							</Label>

							<Separator Background="{ StaticResource ResourceKey=Gray400 }"
									   Height=".8"
									   Width="Auto"/>
						</StackPanel>
						<!--#endregion-->
						<!--#region DataGrid_Docentes-->
						<Grid Grid.Row="1"
							  Margin="0 2 0 0">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<!--#region DataGrid-->
							<DataGrid x:Name="DataGrid_Docentes"
									  Grid.Row="0"
									  ItemsSource="{ Binding Path=DocentesEnMateria, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
									  SelectedItem="{ Binding Path=SituacionRevistaUPDATE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									  IsSynchronizedWithCurrentItem="True"
									  IsReadOnly="True"
									  Margin="0 0 0 5"
									  d:ItemsSource="{ d:SampleData ItemCount=4 }"
									  Style="{ StaticResource ResourceKey=DataGrid }">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Cargo"
														Binding="{ Binding Path=Cargo, FallbackValue='Sin datos', TargetNullValue='Sin datos', Converter={ StaticResource ResourceKey=cargoConverter } }"
														Width="*"/>
									<DataGridTextColumn Header="Estado"
														Binding="{ Binding Path=Estado, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
														Width="*"/>
									<DataGridTextColumn Header="Docente"
														Binding="{ Binding Path=Docente, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
														Width="2*"/>
									<DataGridCheckBoxColumn Header="¿Docente de Aula?"
															Binding="{ Binding Path=EnFunciones }"
															Width="*"/>
									<DataGridTemplateColumn Header="Acciones">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<WrapPanel Orientation="Horizontal">
													<!--#region EditarCommand: Docente-->
													<Button Command="{ Binding Path=DataContext.EditarCommand, RelativeSource={ RelativeSource AncestorType=UserControl } }"
															CommandParameter="Docente"
															Background="White"
															Foreground="{ StaticResource ResourceKey=Neutral800 }"
															Margin="0 0 2 0"
															ToolTip="Quitar de Funciones"
															Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
															Style="{ StaticResource ResourceKey=Icon }">
														<Button.Content>
															<WrapPanel>
																<fa:IconBlock Icon="UserAltSlash"
																			  Foreground="{ Binding Path=Foreground, RelativeSource={ RelativeSource AncestorType=Button } }"/>
															</WrapPanel>
														</Button.Content>
													</Button>
													<!--#endregion-->
													<!--#region EditarCommand: Recsindir-->
													<Button Command="{ Binding Path=DataContext.EditarCommand, RelativeSource={ RelativeSource AncestorType=UserControl } }"
															CommandParameter="Rescindir"
															Background="White"
															Foreground="{ StaticResource ResourceKey=Neutral800 }"
															Margin="2 0 0 0"
															ToolTip="Rescindir Cargo Docente"
															Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
															Style="{ StaticResource ResourceKey=Icon }">
														<Button.Content>
															<WrapPanel>
																<fa:IconBlock Icon="Ban"
																			  Foreground="{ Binding Path=Foreground, RelativeSource={ RelativeSource AncestorType=Button } }"/>
															</WrapPanel>
														</Button.Content>
													</Button>
													<!--#endregion-->
												</WrapPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
							<!--#endregion-->

							<GroupBox Grid.Row="1"
									  Header="Detalles de la situación de revista"
									  Margin="0 5 0 0"
									  Padding="20 5">
								<Grid Margin="0 5">
									<Grid.ColumnDefinitions>
										<ColumnDefinition/>
										<ColumnDefinition/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition/>
										<RowDefinition/>
									</Grid.RowDefinitions>
									<!--#region SituacionRevista-->
									<local:SituacionRevistaView Grid.ColumnSpan="2"
																Grid.Row="0"
																DataContext="{ Binding Path=SelectedItem, ElementName=DataGrid_Docentes }"
																IsEnabled="False"/>
									<!--#endregion-->
									<!--#region COMMANDs-->
									<WrapPanel Grid.Column="0"
											   Grid.Row="1"
											   Margin="0 10 0 0"
											   HorizontalAlignment="Left">
										<!--#region EliminarCommand: Docente-->
										<Button Command="{ Binding Path=EliminarCommand }"
												CommandParameter="Docente"
												Background="{ StaticResource ResourceKey=Red500 }"
												ToolTip="Eliminar Cargo Docente"
												Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
												Style="{ StaticResource ResourceKey=Tertiary }">
											<Button.Content>
												<WrapPanel>
													<fa:IconBlock Icon="Trash"
																  Foreground="White"/>
												</WrapPanel>
											</Button.Content>
										</Button>
										<!--#endregion-->
									</WrapPanel>
									<WrapPanel Grid.Column="1"
											   Grid.Row="1"
											   Margin="0 10 0 0"
											   HorizontalAlignment="Right">
										<!--#region GuardarCommand: Docente-->
										<Button Command="{ Binding Path=GuardarCommand }"
												CommandParameter="Docente"
												Content="Establecer En Funciones"
												Margin="0 0 0 0"
												ToolTip="Establecer en funciones"
												Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
												Style="{ StaticResource ResourceKey=Secondary }"/>
										<!--#endregion-->
									</WrapPanel>
									<!--#endregion-->
								</Grid>
							</GroupBox>
						</Grid>
						<!--#endregion-->
					</Grid>
					<!--#endregion-->

					<!--#region REGISTRAR-->
					<Grid IsEnabled="{ Binding Path=HabilitarInsert, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<!--#region Title-->
						<StackPanel Grid.Row="0"
									Margin="0 0 0 2">
							<Label Content="Nueva Situación de Revista"
								   Style="{ StaticResource ResourceKey=Headline }"/>
							<Separator Background="{ StaticResource ResourceKey=Gray400 }"
									   Height=".8"
									   Width="Auto"/>
						</StackPanel>
						<!--#endregion-->

						<StackPanel Grid.Row="1"
									Margin="0 2 0 0">
							<!--#region Searcher-->
							<GroupBox Header="Buscar Docente"
									  Padding="20 10">
								<Grid>
									<!--
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									-->
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>

									<!--#region Search-->
									<WrapPanel Grid.Row="0"
											   Margin="0 0 0 5"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center">
										<!--#region Query-->
										<TextBox Text="{ Binding Path=Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
												 Tag="ingresar apellido y nombre del docente&#x2026;"
												 HorizontalContentAlignment="Stretch"
												 Margin="0 0 5 0"
												 Width="Auto"
												 Style="{ StaticResource ResourceKey=TextBox }"/>
										<!--#endregion-->
										<!--#region ListarCommand: Query-->
										<Button Command="{ Binding Path=ListarCommand }"
												CommandParameter="Query"
												Margin="5 0 0 0"
												ToolTip="Buscar"
												Style="{ StaticResource ResourceKey=Primary }">
											<Button.Content>
												<WrapPanel>
													<fa:IconBlock Icon="Search"
																  Foreground="White"/>
												</WrapPanel>
											</Button.Content>
										</Button>
										<!--#endregion-->
									</WrapPanel>
									<!--#endregion-->

									<!--
									<WrapPanel Grid.Column="1"
											   Grid.Row="0"
											   Margin="0 0 0 5"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Center">
										<Button Command="{ Binding Path=ListarCommand }"
												CommandParameter="Listar"
												Content="Ver docentes"
												ToolTip="Ver todos los docentes"
												Style="{ StaticResource ResourceKey=Tertiary }"/>
									</WrapPanel>
									-->
									<Expander Grid.Row="1"
											  Header="Docentes"
											  ExpandDirection="Down"
											  Margin="0 5 0 0"
											  IsEnabled="{ Binding Path=HabilitarResultadoBuscar, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
											  Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
										<!--#region DataGrid_LegajosDocentes-->
										<StackPanel Margin="10 10 10 0">
											<!--#region DataGrid-->
											<DataGrid x:Name="DataGrid_LegajosDocentes"
													  ItemsSource="{ Binding Path=Docentes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
													  SelectedItem="{ Binding Path=LegajoDocente, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged }"
													  IsReadOnly="True"
													  Margin="0 0 0 5"
													  d:ItemsSource="{ d:SampleData ItemCount=4 }"
													  Style="{ StaticResource ResourceKey=DataGrid }">
												<DataGrid.Columns>
													<DataGridTextColumn Header="Fecha Alta"
																		Binding="{ Binding Path=FechaAlta, StringFormat='D', ConverterCulture='es_ES', FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
																		Width="*"/>
													<DataGridTextColumn Header="Docente"
																		Binding="{ Binding Path=NombreCompleto, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
																		Width="2*"/>
													<DataGridCheckBoxColumn Header="¿En funciones?"
																			Binding="{ Binding Path=EstaActivo }"
																			Width="*"/>
												</DataGrid.Columns>
											</DataGrid>
											<!--#endregion-->
											<WrapPanel Margin="0 5 0 0"
													   HorizontalAlignment="Right">
												<!--#region SeleccionarCommand: Seleccionar-->
												<Button Command="{ Binding Path=SeleccionarCommand }"
														Content="Seleccionar"
														Style="{ StaticResource ResourceKey=Secondary }"/>
												<!--#endregion-->
											</WrapPanel>
										</StackPanel>
										<!--#endregion-->
									</Expander>
								</Grid>
							</GroupBox>
							<!--#endregion-->

							<!--#region Situación Revista-->
							<GroupBox Header="Agregar Situación de Revista"
									  Margin="0 5 0 0"
									  Padding="20 10"
									  IsEnabled="{ Binding Path=HabilitarNuevaSituacionRevista, TargetNullValue='false', UpdateSourceTrigger=PropertyChanged }"
									  Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
								<StackPanel>
									<local:SituacionRevistaView DataContext="{ Binding Path=SituacionRevistaINSERT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

									<!--#region COMMANDs-->
									<WrapPanel Margin="0 5 0 0"
											   HorizontalAlignment="Right">
										<!--#region CancelarCommand: Insert-->
										<Button Command="{ Binding Path=CancelarCommand }"
												CommandParameter="Insert"
												Content="Cancelar"
												Margin="0 0 5 0"
												ToolTip="Cancelar"
												Style="{ StaticResource ResourceKey=Tertiary }"/>
										<!--#endregion-->
										<!--#region GuardarCommand: Insert-->
										<Button Command="{ Binding Path=GuardarCommand }"
												CommandParameter="Insert"
												Content="Guardar"
												Margin="5 0 0 0"
												ToolTip="Guardar"
												Style="{ StaticResource ResourceKey=Primary }"/>
										<!--#endregion-->
									</WrapPanel>
									<!--#endregion-->
								</StackPanel>
							</GroupBox>
							<!--#endregion-->
						</StackPanel>
					</Grid>
					<!-- #endregion -->
				</StackPanel>
			</ScrollViewer>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>
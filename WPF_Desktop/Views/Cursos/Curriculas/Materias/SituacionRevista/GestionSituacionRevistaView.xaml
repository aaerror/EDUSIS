<UserControl x:Class="WPF_Desktop.Views.Cursos.Curriculas.Materias.SituacionRevista.GestionSituacionRevistaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos.Curriculas.Materias.SituacionRevista"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		SITUACIÓN DE REVISTA DE LA CÁTEDRA — qué docente está designado y con qué cargo.

		Eran cuatro tarjetas apiladas con la misma sombra, tres de ellas con el título
		centrado y un ícono al lado (CircleInfo, ChalkboardTeacher, Users). Un título centrado
		con ícono en una app que alinea todo a la izquierda es el idioma de otra pantalla.

		Las dos partes de abajo son dos MODOS, no dos secciones: o se mira quién está
		designado, o se designa a alguien nuevo. Van en tarjetas distintas, cada una con su
		pie de acciones.

		El bloque "Buscar Docente" es el mismo que está escrito en GestionDivisiones y el que
		BuscarView —el modal— tiene que reemplazar cuando se cablee.

		Se sacó el EnumConverter de los recursos locales: estaba declarado y sin usar, y un
		bloque comentado con un botón "Ver docentes".
	-->
	<UserControl.Resources>
		<converters:CargoConverter x:Key="cargoConverter"/>
	</UserControl.Resources>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarSituacionRevistasCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="{ Binding Path=Materia.Descripcion, Mode=OneWay }"
							   Subtitle="Docentes designados en la cátedra, con su cargo y su período"
							   VerticalContentAlignment="Top"/>

			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						VerticalAlignment="Center">
				<Button Command="{ Binding Path=NavigationCommand }"
						CommandParameter="Materias"
						Margin="0 0 8 0"
						Style="{ StaticResource ResourceKey=Btn.Terciario }"
						ToolTip="Volver al diseño curricular">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="ArrowLeft"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Volver a materias" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Button Command="{ Binding Path=RegistrarCommand }"
						CommandParameter="SituacionRevista"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Designar un docente en esta cátedra">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Designar docente" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
		<!--#endregion-->

		<!--#region AVISO-->
		<Border Grid.Row="1"
				IsEnabled="{ Binding Path=HabilitarNotificacion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=Mensaje, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					   TextWrapping="Wrap"/>
		</Border>
		<!--#endregion-->

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<!--
					El nombre de esta región lo usa de ancla la guarda estática
					GuardasEstaticasW6Tests: comprueba que el bloque siga enlazado a
					SituacionRevistaEnFunciones y no a SituacionRevistaUPDATE. El título que ve
					el usuario es "Docente de aula"; el marcador del código, el de siempre.
				-->
				<!--#region DOCENTE EN FUNCIONES-->
				<Border IsEnabled="{ Binding Path=HabilitarDocenteEnFunciones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
						Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
					<Grid Margin="20 18">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0" Margin="0 0 0 4">
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Titulo }"
									   Text="Docente de aula"/>
							<TextBlock Margin="0 4 0 0"
									   Style="{ StaticResource ResourceKey=Txt.Detalle }"
									   Text="El que está dando clase en esta cátedra ahora mismo."/>
						</StackPanel>

						<!-- DataContext primero: es donde lo busca la guarda estática. -->
						<local:SituacionRevistaView DataContext="{ Binding Path=SituacionRevistaEnFunciones, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
													Grid.Row="1"
													IsEnabled="False"/>
					</Grid>
				</Border>
				<!--#endregion-->

				<!--#region DESIGNACIONES-->
				<Border IsEnabled="{ Binding Path=HabilitarInfoSituacionRevista, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						Margin="0 16 0 0"
						Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
						Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
					<Grid Margin="20 18">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0"
								   Margin="0 0 0 12"
								   Style="{ StaticResource ResourceKey=Txt.Seccion }"
								   Text="DOCENTES DESIGNADOS EN LA MATERIA"/>

						<DataGrid x:Name="DataGrid_Docentes"
								  Grid.Row="1"
								  ItemsSource="{ Binding Path=DocentesEnMateria, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
								  SelectedItem="{ Binding Path=SituacionRevistaUPDATE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
								  IsReadOnly="True"
								  IsSynchronizedWithCurrentItem="True"
								  MaxHeight="260"
								  MinHeight="120"
								  Style="{ StaticResource ResourceKey=Grilla }"
								  Tag="Esta cátedra todavía no tiene docentes designados. Empezá con &#x201C;Designar docente&#x201D;."
								  d:ItemsSource="{ d:SampleData ItemCount=4 }">
							<DataGrid.Columns>
								<!-- El orden de estas columnas lo fija la guarda estática W6. -->
								<DataGridTextColumn Binding="{ Binding Path=Cargo, FallbackValue='Sin datos', TargetNullValue='Sin datos', Converter={ StaticResource ResourceKey=cargoConverter } }"
													Header="CARGO"
													Width="*"/>
								<DataGridTextColumn Binding="{ Binding Path=Estado, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
													Header="ESTADO"
													Width="*"/>
								<DataGridTextColumn Binding="{ Binding Path=Docente, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
													Header="DOCENTE"
													Width="2*"/>
								<DataGridCheckBoxColumn Binding="{ Binding Path=EnFunciones }"
														Header="EN AULA"
														Width="Auto"/>
								<DataGridTemplateColumn Header="" Width="Auto">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal">
												<Button Command="{ Binding Path=DataContext.EditarCommand, RelativeSource={ RelativeSource AncestorType=UserControl } }"
														CommandParameter="Docente"
														Margin="0 0 4 0"
														Style="{ StaticResource ResourceKey=Btn.Icono }"
														ToolTip="Quitar de funciones">
													<fa:IconBlock FontSize="11" Icon="UserAltSlash"/>
												</Button>
												<Button Command="{ Binding Path=DataContext.EditarCommand, RelativeSource={ RelativeSource AncestorType=UserControl } }"
														CommandParameter="Rescindir"
														Style="{ StaticResource ResourceKey=Btn.Icono }"
														ToolTip="Establecer el fin de la designación">
													<fa:IconBlock FontSize="11" Icon="Ban"/>
												</Button>
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>

						<!-- Detalle de la designación elegida en la grilla. -->
						<local:SituacionRevistaView Grid.Row="2"
													DataContext="{ Binding Path=SelectedItem, ElementName=DataGrid_Docentes }"
													IsEnabled="False"
													Margin="0 16 0 0"/>

						<HeaderedContentControl Grid.Row="3" Style="{ StaticResource ResourceKey=Acciones }">
							<HeaderedContentControl.Header>
								<Button Command="{ Binding Path=EliminarCommand }"
										CommandParameter="Docente"
										Content="Finalizar designación"
										Style="{ StaticResource ResourceKey=Btn.Peligro }"
										ToolTip="Dar de baja la designación elegida"/>
							</HeaderedContentControl.Header>

							<Button Command="{ Binding Path=GuardarCommand }"
									CommandParameter="Docente"
									Content="Poner en aula"
									Style="{ StaticResource ResourceKey=Btn.Primario }"
									ToolTip="Establecer al docente elegido como docente de aula"/>
						</HeaderedContentControl>
					</Grid>
				</Border>
				<!--#endregion-->

				<!--#region DESIGNAR-->
				<Border IsEnabled="{ Binding Path=HabilitarInsert, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						Margin="0 16 0 0"
						Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
						Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
					<Grid Margin="20 18">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0" Margin="0 0 0 16">
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Titulo }"
									   Text="Designar un docente"/>
							<TextBlock Margin="0 4 0 0"
									   Style="{ StaticResource ResourceKey=Txt.Detalle }"
									   Text="Buscá al docente, elegilo de la lista y cargá su cargo y su período."/>
						</StackPanel>

						<!--
							El buscador de docentes estaba acá: campo con Query validado, lupa,
							un Expander con la grilla de resultados y un botón "Seleccionar".
							Era la misma pieza que tenía GestionDivisiones escrita aparte. Las dos
							se reemplazaron por el modal (BuscarView); el docente elegido vuelve
							por DocenteElegidoMessage y dispara el mismo SeleccionarCommand.
						-->
						<!--#region BUSCAR-->
						<Button Grid.Row="1"
								Command="{ Binding Path=BuscarDocenteCommand }"
								HorizontalAlignment="Left"
								Margin="0 0 0 16"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Abrir el buscador de docentes">
							<StackPanel Orientation="Horizontal">
								<fa:IconBlock FontSize="11"
											  Icon="MagnifyingGlass"
											  Margin="0 0 8 0"
											  VerticalAlignment="Center"/>
								<TextBlock Text="Buscar docente" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<!--#endregion-->

						<!--#region DESIGNACIÓN-->
						<ContentControl Grid.Row="2"
										IsEnabled="{ Binding Path=HabilitarNuevaSituacionRevista, TargetNullValue='false', UpdateSourceTrigger=PropertyChanged }"
										Margin="0 16 0 0"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
							<local:SituacionRevistaView DataContext="{ Binding Path=SituacionRevistaINSERT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>
						</ContentControl>

						<!-- Sólo para el cargo Suplente: a quién reemplaza. -->
						<HeaderedContentControl Grid.Row="3"
												Header="¿A quién reemplaza?"
												Style="{ StaticResource ResourceKey=Campo }"
												Visibility="{ Binding Path=HabilitarReemplazaA, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
							<ComboBox ItemsSource="{ Binding Path=SituacionesReemplazables, Mode=OneWay }"
									  SelectedValue="{ Binding Path=SituacionRevistaINSERT.ReemplazaA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
									  SelectedValuePath="SituacionRevistaID"
									  Style="{ StaticResource ResourceKey=Cmb.Campo }">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
													   Text="{ Binding Path=Docente }"/>
											<TextBlock Margin="8 0"
													   Style="{ StaticResource ResourceKey=Txt.Detalle }"
													   Text="·"/>
											<TextBlock Style="{ StaticResource ResourceKey=Txt.Detalle }"
													   Text="{ Binding Path=Cargo }"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</HeaderedContentControl>
						<!--#endregion-->

						<HeaderedContentControl Grid.Row="4" Style="{ StaticResource ResourceKey=Acciones }">
							<HeaderedContentControl.Header>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Insert"
										Content="Cancelar"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Descartar la designación"/>
							</HeaderedContentControl.Header>

							<Button Command="{ Binding Path=GuardarCommand }"
									CommandParameter="Insert"
									Content="Designar docente"
									Style="{ StaticResource ResourceKey=Btn.Primario }"
									ToolTip="Guardar la designación"/>
						</HeaderedContentControl>
					</Grid>
				</Border>
				<!--#endregion-->
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>

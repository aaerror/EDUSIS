<UserControl x:Class="WPF_Desktop.Views.Cursos.CursoView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Cursos"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		FICHA DEL CURSO — se lee, no se edita.

		Los dos enlaces son Mode=OneWay y venían dentro de un TextBox: se podía hacer clic,
		escribir, y lo escrito no iba a ninguna parte. Pasan a Dato, que no tiene caja, así
		que se ve que son datos y no campos.

		Se sacó el NivelEducativoConverter de los recursos locales: estaba declarado y no lo
		usaba ningún enlace del archivo.
	-->
	<GroupBox Header="DETALLE DEL CURSO" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<HeaderedContentControl Grid.Column="0"
									Header="Curso"
									Style="{ StaticResource ResourceKey=Dato.Izquierda }">
				<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
						   Text="{ Binding Path=Grado, Mode=OneWay, StringFormat={}{0}° año, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1"
									Content="{ Binding Path=NivelEducativo, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"
									Header="Nivel educativo"
									Style="{ StaticResource ResourceKey=Dato.Derecha }"/>
		</Grid>
	</GroupBox>
</UserControl>

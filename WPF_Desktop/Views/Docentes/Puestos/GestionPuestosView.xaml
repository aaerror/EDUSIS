<UserControl x:Class="WPF_Desktop.Views.Docentes.Puestos.GestionPuestosView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Puestos"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainPuestos="clr-namespace:Domain.Docentes.Puestos;assembly=Domain"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region RESOURCES-->
	<UserControl.Resources>
		<ObjectDataProvider x:Key="posiciones"
							MethodName="GetValues"
							ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type Type="domainPuestos:Posicion"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>

		<!--#region CONVERTER-->
		<converters:PosicionConverter x:Key="posicionConverter"/>
		<local:BooleanToStringConverter x:Key="booleanConverter" TrueValue="Si" FalseValue="No"/>
		<!-- <converters:BooleanConverter x:Key="booleanConverter"/> -->
		<!-- <local:BooleanToStringConverter x:Key="booleanConverter" TrueValue="Si" FalseValue="No"/> -->
		<BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
		<!--#endregion-->
	</UserControl.Resources>
	<!--#endregion-->
	<!--#region EVENTS: Loaded-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarPuestosCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<!--#region TITTLE AND SUBTITLE-->
		<components:Header Grid.Row="0"
						   Title="Gestión de Docentes"
						   Subtitle="Administración de Puestos Docentes"/>
		<!--#endregion-->

		<!--#region COMMANDs-->
		<Grid Grid.Row="1"
			  Margin="20 10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<WrapPanel Grid.Column="0"
					   HorizontalAlignment="Left">
				<!--#region RegistrarCommand: Nuevo-->
				<Button Command="{ Binding Path=RegistrarCommand }"
						Margin="5 0 0 0"
						Visibility="{ Binding Path=IsEnabled,RelativeSource={ RelativeSource Mode=Self }, FallbackValue='False', Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
						ToolTip="Agregar Puesto Docente"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="Plus"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  FontSize="12"
										  Margin="0 0 1 0"/>
							<Label Content="Agregar puesto"
								   Margin="1 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
		</Grid>
		<!--#endregion-->

		<!--#region NOTIFICATIONs-->
		<Border Grid.Row="2"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarMensaje, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Padding="10"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>
			<Grid Margin="20 10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0"
							Margin="0 0 0 5">
					<Label Content="Puestos docente"
						   Style="{ StaticResource ResourceKey=Headline }"/>
					<Separator Background="{ StaticResource ResourceKey=Gray400 }"
							   Height=".8"
							   Width="Auto"/>
				</StackPanel>

				<!--#region MESSAGE-->
				<StackPanel Grid.Row="1"
							Margin="0 5 0 0">
					<Label Content="{ Binding Path=Mensaje, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						   Style="{ StaticResource ResourceKey=Body }"/>
				</StackPanel>
				<!--#endregion-->
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region LISTADO-->
		<Border Grid.Row="3"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarListadoPuestos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>

			<ScrollViewer Padding="20"
						  VerticalScrollBarVisibility="Auto">
				<Grid Margin="20 10">
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
					</Grid.RowDefinitions>

					<!--#region DataGrid_Title-->
					<Grid Grid.Row="0"
						  Margin="0 0 0 5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="1*"/>
							<RowDefinition Height="1*"/>
						</Grid.RowDefinitions>

						<!--#region NombreCompleto-->
						<StackPanel Grid.Column="0"
									Grid.Row="0"
									HorizontalAlignment="Left"
									VerticalAlignment="Center">
							<!--
							<Label Content="{ Binding Path=NombreCompleto, Mode=OneWay }"
								   Style="{ StaticResource ResourceKey=Headline }"/>
							-->
							<TextBlock Foreground="{ StaticResource ResourceKey=Neutral800 }"
									   FontFamily="Segoe UI"
									   FontSize="20"
									   FontWeight="Regular"
									   HorizontalAlignment="Left"
									   Padding="0"
									   VerticalAlignment="Center">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}Puestos docentes de {0}">
										<Binding Path="NombreCompleto"/>
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
						<!--#endregion-->

						<StackPanel Grid.Column="1"
								    Grid.Row="0"
								    HorizontalAlignment="Right"
								    VerticalAlignment="Center">
							<!--#region Legajo-->
							<TextBlock Text="{ Binding Path=Legajo, Mode=OneWay, StringFormat={}Legajo: {0} }"
									   Foreground="{ StaticResource ResourceKey=Neutral800 }"
									   FontFamily="Segoe UI"
									   FontSize="12"
									   FontStyle="Italic"
									   FontWeight="Regular"/>
							<!--#endregion-->

							<!--#region Documento-->
							<TextBlock Text="{ Binding Path=Documento, Mode=OneWay, StringFormat={}D.N.I.: {0} }"
									   Foreground="{ StaticResource ResourceKey=Neutral800 }"
									   FontFamily="Segoe UI"
									   FontSize="12"
									   FontStyle="Italic"
									   FontWeight="Regular"/>
							<!--#endregion-->
						</StackPanel>

						<Separator Grid.ColumnSpan="2"
								   Grid.Row="1"
								   Background="{ StaticResource ResourceKey=Gray600 }"
								   Height=".8"/>
					</Grid>
					<!--#endregion-->

					<!--#region DataGrid_Puestos-->
					<StackPanel Grid.Row="1"
								Margin="0 5 0 10">
						<DataGrid x:Name="DataGrid_Puestos"
								  ItemsSource="{ Binding Path=PuestosDocente, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
								  SelectedItem="{ Binding Path=PuestoDocente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
								  AutoGenerateColumns="False"
								  HorizontalContentAlignment="Center"
								  Loaded="DataGrid_Puestos_Loaded"
								  Style="{ StaticResource ResourceKey=DataGrid }">
							<DataGrid.Columns>
								<DataGridTextColumn Binding="{ Binding Path=PuestoID, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
													Header="PuestoID"
													Visibility="Collapsed"
													Width="1*"/>
								<DataGridTextColumn Binding="{ Binding Path=Posicion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=posicionConverter } }"
													Header="Posicion"
													Width="*"/>
								<!--
								<DataGridTextColumn Binding="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
													Header="Estado"
													Width="*"/>
								-->
								<DataGridTextColumn Binding="{ Binding Path=EsEventual, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=booleanConverter } }"
													Header="¿Es eventual?"
													Width="*"/>
								<DataGridTextColumn Binding="{ Binding Path=FechaInicio, FallbackValue='Sin datos', TargetNullValue='Fecha de inicio sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}, ConverterCulture='es-ES' }"
													Header="Fecha de Inicio"
													Width="2*"/>
								<DataGridTextColumn Binding="{ Binding Path=FechaFin, FallbackValue='Sin datos', TargetNullValue='Fecha de finalización sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}, ConverterCulture='es-ES' }"
													Header="Fecha de Finalización"
													Width="2*"/>
							</DataGrid.Columns>
							<DataGrid.GroupStyle>
								<GroupStyle>
									<GroupStyle.ContainerStyle>
										<Style TargetType="{ x:Type GroupItem }">
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="{ x:Type GroupItem }">
														<Expander>
															<Expander.Header>
																<WrapPanel>
																	<TextBlock Text="{ Binding Path=Items[0].Estado }"/>
																	<TextBlock Text="{ Binding Path=Items.Count, StringFormat='{} {0}' }"/>
																</WrapPanel>
															</Expander.Header>
															<ItemsPresenter/>
														</Expander>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</GroupStyle.ContainerStyle>
									<GroupStyle.Panel>
										<ItemsPanelTemplate>
											<DataGridRowsPresenter/>
										</ItemsPanelTemplate>
									</GroupStyle.Panel>
								</GroupStyle>
							</DataGrid.GroupStyle>
						</DataGrid>
					</StackPanel>
					<!--#endregion-->

					<!--#region COMMANDs-->
					<StackPanel Grid.Row="3"
								Margin="0 10 0 0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>

							<WrapPanel Grid.Column="0"
									   HorizontalAlignment="Left">
								<!--#region EliminarCommand: Eliminar-->
								<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
										CommandParameter="Eliminar"
										Background="{ StaticResource ResourceKey=Red500 }"
										Content="{ fa:Icon Trash, Foreground=White }"
										ToolTip="Eliminar Puesto"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, FallbackValue='False', Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
										Style="{ StaticResource ResourceKey=Tertiary }"/>
								<!--#endregion-->
								
								<!--#region EliminarCommand: Revocar-->
								<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
										CommandParameter="Revocar"
										Background="{ StaticResource ResourceKey=Red500 }"
										ToolTip="Revocar Puesto"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, FallbackValue='False', Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
										Style="{ StaticResource ResourceKey=Tertiary }">
									<Button.Content>
										<WrapPanel>
											<fa:IconBlock Icon="Ban"
														  Foreground="White"
														  FontSize="14"
														  Margin="0 0 1 0"/>
											<Label Content="Revocar puesto"
												   Foreground="White"
												   Margin="1 0 0 2"/>
										</WrapPanel>
									</Button.Content>
								</Button>
								<!--#endregion-->
							</WrapPanel>

							<WrapPanel Grid.Column="1"
									   HorizontalAlignment="Right">
								<!--#region EditarCommand-->
								<Button Command="{ Binding Path=EditarCommandAsync, IsAsync=True }"
										Margin="0 0 0 0"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
										ToolTip="Editar Puesto"
										Style="{ StaticResource ResourceKey=Secondary }">
									<Button.Content>
										<WrapPanel>
											<fa:IconBlock Icon="Pen"
														  Foreground="{ StaticResource ResourceKey=Neutral800 }"/>
										</WrapPanel>
									</Button.Content>
								</Button>
								<!--#endregion-->
							</WrapPanel>
						</Grid>
					</StackPanel>
					<!--#endregion-->
				</Grid>
			</ScrollViewer>
		</Border>
		<!--#endregion-->

		<!--#region REGISTRO-->
		<Border Grid.Row="4"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarRegistro, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, FallbackValue='False', Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>

			<ScrollViewer Padding="10 20"
						  VerticalScrollBarVisibility="Auto">
				<Grid Margin="20 10">
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition/>
					</Grid.RowDefinitions>

					<!--#region PUESTO DOCENTE: ALTAS, BAJAS Y MODIFICACIONES-->
					<StackPanel Grid.Row="0"
								Margin="0 0 0 10">
						<local:PuestoDocenteView DataContext="{ Binding Path=PuestoDocente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												 Validation.ErrorTemplate="{ x:Null }"/>
					</StackPanel>
					<!--#endregion-->

					<StackPanel Grid.Row="1"
								Margin="0 10 0 0">
						<!--#region COMMANDs-->
						<WrapPanel HorizontalAlignment="Right">
							<!--#region CancelarCommand: Nuevo-->
							<Button Command="{ Binding Path=CancelarCommandAsync, IsAsync=True }"
									CommandParameter="Nuevo"
									Content="Cancelar"
									Margin="0 0 5 0"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, FallbackValue='False', Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
									Style="{ StaticResource ResourceKey=Secondary }"/>
							<!--#endregion-->
							<!--#region GuardarCommand: Nuevo-->
							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Upsert"
									Content="Guardar"
									Margin="5 0 0 0"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, FallbackValue='False', Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
									Style="{ StaticResource ResourceKey=Primary }"/>
							<!--#endregion-->
						</WrapPanel>
						<!--#endregion-->
					</StackPanel>
				</Grid>
			</ScrollViewer>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>
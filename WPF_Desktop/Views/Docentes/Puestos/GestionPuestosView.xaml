<UserControl x:Class="WPF_Desktop.Views.Docentes.Puestos.GestionPuestosView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Puestos"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		PUESTOS DEL DOCENTE.

		El encabezado de la tarjeta armaba "Puestos docentes de {0}" con un MultiBinding de un
		solo Binding —un MultiBinding con una sola fuente es un Binding con pasos de más— y
		ponía legajo y documento en 12px cursiva a la derecha. Ahora el nombre es el título de
		la ficha y los dos identificadores van en monoespaciada, como en el resto de la app.

		La grilla viene agrupada por estado desde el ViewModel (ListCollectionView con
		PropertyGroupDescription "Estado"), así que el estado es el rótulo del grupo y deja de
		necesitar columna. Antes el grupo era un Expander sin estilo, con la flecha de Aero;
		ahora es la misma banda que usa el índice de cursos.

		El conversor de la columna "¿Es eventual?" decía "Si" sin tilde.
	-->
	<UserControl.Resources>
		<converters:PosicionConverter x:Key="posicionConverter"/>
		<local:BooleanToStringConverter x:Key="siNoConverter" TrueValue="Sí" FalseValue="No"/>
	</UserControl.Resources>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarPuestosCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="Puestos docentes"
							   Subtitle="Posiciones del docente, con su período y su estado"/>

			<Button Grid.Column="1"
					Command="{ Binding Path=RegistrarCommand }"
					Style="{ StaticResource ResourceKey=Btn.Primario }"
					ToolTip="Agregar un puesto al docente"
					VerticalAlignment="Center"
					Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
				<StackPanel Orientation="Horizontal">
					<fa:IconBlock FontSize="11"
								  Icon="Plus"
								  Margin="0 0 8 0"
								  VerticalAlignment="Center"/>
					<TextBlock Text="Agregar puesto" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>
		<!--#endregion-->

		<!--#region AVISO-->
		<Border Grid.Row="1"
				IsEnabled="{ Binding Path=HabilitarMensaje, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=Mensaje, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					   TextWrapping="Wrap"/>
		</Border>
		<!--#endregion-->

		<!--#region LISTADO-->
		<Border Grid.Row="2"
				IsEnabled="{ Binding Path=HabilitarListadoPuestos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--#region FICHA DEL DOCENTE-->
				<Grid Grid.Row="0" Margin="0 0 0 16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Orientation="Horizontal">
						<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
								   Margin="0 2 14 2"
								   VerticalAlignment="Stretch"
								   Width="3"/>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
									   Text="PUESTOS DE"/>
							<TextBlock Margin="0 2 0 0"
									   Style="{ StaticResource ResourceKey=Txt.Titulo }"
									   Text="{ Binding Path=NombreCompleto, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos' }"/>
						</StackPanel>
					</StackPanel>

					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock HorizontalAlignment="Right"
								   Style="{ StaticResource ResourceKey=Txt.Dato }"
								   Text="{ Binding Path=Legajo, Mode=OneWay, StringFormat={}Legajo {0}, FallbackValue='Sin legajo', TargetNullValue='Sin legajo' }"/>
						<TextBlock HorizontalAlignment="Right"
								   Margin="0 2 0 0"
								   Style="{ StaticResource ResourceKey=Txt.Dato }"
								   Text="{ Binding Path=Documento, Mode=OneWay, StringFormat={}DNI {0}, FallbackValue='Sin documento', TargetNullValue='Sin documento' }"/>
					</StackPanel>
				</Grid>
				<!--#endregion-->

				<DataGrid x:Name="DataGrid_Puestos"
						  Grid.Row="1"
						  ItemsSource="{ Binding Path=PuestosDocente, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  SelectedItem="{ Binding Path=PuestoDocente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						  Loaded="DataGrid_Puestos_Loaded"
						  MinHeight="160"
						  Style="{ StaticResource ResourceKey=Grilla }"
						  Tag="Este docente todavía no tiene puestos. Empezá con &#x201C;Agregar puesto&#x201D;.">
					<DataGrid.Columns>
						<DataGridTextColumn Binding="{ Binding Path=Posicion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=posicionConverter } }"
											Header="POSICIÓN"
											Width="2*"/>
						<DataGridTextColumn Binding="{ Binding Path=EsEventual, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=siNoConverter } }"
											Header="EVENTUAL"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:d}, ConverterCulture='es-AR', FallbackValue='Sin datos', TargetNullValue='Sin especificar' }"
											Header="DESDE"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:d}, ConverterCulture='es-AR', FallbackValue='Sin datos', TargetNullValue='Sin especificar' }"
											Header="HASTA"
											Width="*"/>
					</DataGrid.Columns>

					<!-- El grupo es el estado del puesto: lo agrupa el ViewModel. -->
					<DataGrid.GroupStyle>
						<GroupStyle>
							<GroupStyle.ContainerStyle>
								<Style TargetType="{ x:Type GroupItem }">
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="{ x:Type GroupItem }">
												<StackPanel>
													<Border Background="{ StaticResource ResourceKey=Tiza }"
															BorderBrush="{ StaticResource ResourceKey=Linea }"
															BorderThickness="0 1 0 1"
															Padding="12 6"
															SnapsToDevicePixels="True">
														<StackPanel Orientation="Horizontal">
															<TextBlock Style="{ StaticResource ResourceKey=Txt.Seccion }"
																	   Text="{ Binding Path=Name }"/>
															<TextBlock Margin="8 0 0 0"
																	   Style="{ StaticResource ResourceKey=Txt.Detalle }"
																	   Text="{ Binding Path=ItemCount, StringFormat={}({0}) }"/>
														</StackPanel>
													</Border>
													<ItemsPresenter/>
												</StackPanel>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</GroupStyle.ContainerStyle>
							<GroupStyle.Panel>
								<ItemsPanelTemplate>
									<DataGridRowsPresenter/>
								</ItemsPanelTemplate>
							</GroupStyle.Panel>
						</GroupStyle>
					</DataGrid.GroupStyle>
				</DataGrid>

				<HeaderedContentControl Grid.Row="2" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<StackPanel Orientation="Horizontal">
							<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
									CommandParameter="Eliminar"
									Content="Eliminar"
									Margin="0 0 8 0"
									Style="{ StaticResource ResourceKey=Btn.Peligro }"
									ToolTip="Eliminar el puesto seleccionado"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							<Button Command="{ Binding Path=EliminarCommandAsync, IsAsync=True }"
									CommandParameter="Revocar"
									Content="Revocar"
									Style="{ StaticResource ResourceKey=Btn.Secundario }"
									ToolTip="Dar de baja al docente del puesto"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						</StackPanel>
					</HeaderedContentControl.Header>

					<Button Command="{ Binding Path=EditarCommandAsync, IsAsync=True }"
							Content="Editar"
							Style="{ StaticResource ResourceKey=Btn.Terciario }"
							ToolTip="Editar el puesto seleccionado"
							Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region ALTA Y EDICIÓN-->
		<Border Grid.Row="3"
				IsEnabled="{ Binding Path=HabilitarRegistro, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 16 0 0"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
				<Grid Margin="20 18">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<local:PuestoDocenteView Grid.Row="0"
											 DataContext="{ Binding Path=PuestoDocente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
											 Validation.ErrorTemplate="{ x:Null }"/>

					<HeaderedContentControl Grid.Row="1" Style="{ StaticResource ResourceKey=Acciones }">
						<HeaderedContentControl.Header>
							<Button Command="{ Binding Path=CancelarCommandAsync, IsAsync=True }"
									CommandParameter="Nuevo"
									Content="Cancelar"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Descartar los cambios del puesto"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						</HeaderedContentControl.Header>

						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Upsert"
								Content="Guardar puesto"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Guardar el puesto"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
					</HeaderedContentControl>
				</Grid>
			</ScrollViewer>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

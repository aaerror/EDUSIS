<UserControl x:Class="WPF_Desktop.Views.Docentes.Puestos.PuestoDocenteView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Puestos"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:domain="clr-namespace:Domain.Docentes.Puestos;assembly=Domain"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region RESOURCES-->
	<UserControl.Resources>
		<!--#region CONVERTERS-->
		<BooleanToVisibilityConverter x:Key="booleanToVisibility"/>
		<converters:InvertBooleanConverter x:Key="invertBoolean"/>
		<converters:EstadoPuestoConverter x:Key="estadoConverter"/>
		<converters:PosicionConverter x:Key="posicionConverter"/>
		<!--#endregion-->

		<!--#region DATA PROVIDER-->
		<ObjectDataProvider x:Key="posiciones" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domain:Posicion"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<ObjectDataProvider x:Key="estados" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domain:EstadoPuesto"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<!--#endregion-->
	</UserControl.Resources>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<!--#region HEADER -->
		<StackPanel Grid.Row="0"
					Margin="0 0 0 2">
			<Label Style="{ StaticResource ResourceKey=Headline }">
				<Label.Content>
					<WrapPanel HorizontalAlignment="Center"
							   VerticalAlignment="Center">
						<fa:IconBlock Icon="ChalkboardTeacher"
									  Foreground="{ StaticResource ResourceKey=Neutral800 }"
									  Margin="0 0 2 0"/>
						<TextBlock Text="Puesto Docente"
								   Margin="2 0 0 3.5"/>
					</WrapPanel>
				</Label.Content>
			</Label>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
					   Height=".8"
					   Width="Auto"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region INPUTs-->
		<Grid Grid.Row="1"
			  Margin="0 2 0 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
			</Grid.RowDefinitions>
			<!--#region POSICIÓN ID-->
			<StackPanel Grid.ColumnSpan="2"
						Grid.Row="0"
						Visibility="Collapsed">
				<!--#region LABEL: Posicion ID-->
				<Label Content="Puesto ID"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: Posicion ID-->
				<TextBox Text="{ Binding Path=PuestoID, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->

			<!--#region POSICIÓN-->
			<StackPanel Grid.Column="0"
						Grid.Row="1"
						Margin="0 0 10 5">
				<!--#region LABEL: Posición-->
				<Label Content="Posición"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: Posición-->
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=posiciones } }"
						  SelectedValue="{ Binding Path=Posicion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=posicionConverter } }"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->
			
			<!--#region ESTADO-->
			<StackPanel Grid.Column="1"
						Grid.Row="1"
						Margin="10 0 0 5">
				<!--#region LABEL: Estado-->
				<Label Content="Estado"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: Estado-->
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=estados } }"
						  SelectedItem="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=estadoConverter } }"
						  IsEnabled="False"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->

			<!--#region FECHA INICIO-->
			<StackPanel Grid.Column="0"
						Grid.Row="2"
						Margin="0 5 10 5">
				<!--#region LABEL: Fecha Inicio-->
				<Label Content="Fecha de Inicio"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: Fecha Inicio-->
				<DatePicker x:Name="fechaInicio"
							SelectedDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDateStart="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							CalendarStyle="{ StaticResource ResourceKey=Calendar }"
							Style="{ StaticResource ResourceKey=DatePicker }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->

			<!--#region FECHA FIN-->
			<StackPanel Grid.Column="1"
						Grid.Row="2"
						IsEnabled="{ Binding Path=EsEventual, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						Margin="10 5 0 5"
						Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibility } }">
				<!--#region LABEL: Fecha Fin-->
				<Label Content="Fecha de Fin"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<!--#endregion-->
				<!--#region INPUT: Fecha Fin-->
				<DatePicker x:Name="fecha_fin"
							SelectedDate="{ Binding Path=FechaFin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDate="{ Binding Path=FechaFin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDateStart="{ Binding Path=SelectedDate, ElementName=fechaInicio, Mode=OneWay }"
							CalendarStyle="{ StaticResource ResourceKey=Calendar }"
							IsEnabled="{ Binding Path=IsChecked, ElementName=eventual, Mode=OneWay }"
							Style="{ StaticResource ResourceKey=DatePicker }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->

			<!--#region ¿ES EVENTUAL?-->
			<StackPanel Grid.ColumnSpan="2"
						Grid.Row="3"
						Margin="0 5 0 0">
				<!--#region INPUT: Es Eventual?-->
				<CheckBox x:Name="eventual"
						  Margin="4 0 0 0"
						  Content="¿Es eventual?"
						  IsChecked="{ Binding Path=EsEventual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						  Style="{ StaticResource ResourceKey=CheckBox }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->
	</Grid>
</UserControl>
<UserControl x:Class="WPF_Desktop.Views.Docentes.Puestos.PuestoDocenteView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Puestos"

			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domain="clr-namespace:Domain.Docentes.Puestos;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Se sacó el campo "Puesto ID": era un bloque con Visibility="Collapsed" fijo, igual que
		el PersonaID de la ficha personal. El enlace a PuestoID no lo usaba nadie más.

		Va junto al legajo en el mismo paso del alta de docente, así que comparte el idioma de
		sección en vez de traer su propio encabezado centrado con ícono.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="booleanToVisibility"/>
		<converters:EstadoPuestoConverter x:Key="estadoConverter"/>
		<converters:PosicionConverter x:Key="posicionConverter"/>

		<ObjectDataProvider x:Key="posiciones" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domain:Posicion"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<ObjectDataProvider x:Key="estados" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domain:EstadoPuesto"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<GroupBox Header="PUESTO DOCENTE" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<HeaderedContentControl Grid.Column="0" Grid.Row="0"
								   Header="Posición"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=posiciones } }"
						  SelectedValue="{ Binding Path=Posicion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=posicionConverter } }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="0"
								   Header="Estado"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<ComboBox IsEnabled="False"
						  ItemsSource="{ Binding Source={ StaticResource ResourceKey=estados } }"
						  SelectedItem="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=estadoConverter } }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="0" Grid.Row="1"
								   Header="Fecha de inicio"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<DatePicker x:Name="fechaInicio"
							DisplayDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDateStart="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							SelectedDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
			</HeaderedContentControl>

			<!-- La fecha de fin sólo existe si el puesto es eventual: se oculta, no se deshabilita. -->
			<HeaderedContentControl Grid.Column="1" Grid.Row="1"
								   Header="Fecha de fin"
								   IsEnabled="{ Binding Path=EsEventual, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }"
								   Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibility } }">
				<DatePicker x:Name="fecha_fin"
							DisplayDate="{ Binding Path=FechaFin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDateStart="{ Binding Path=SelectedDate, ElementName=fechaInicio, Mode=OneWay }"
							IsEnabled="{ Binding Path=IsChecked, ElementName=eventual, Mode=OneWay }"
							SelectedDate="{ Binding Path=FechaFin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
			</HeaderedContentControl>

			<CheckBox x:Name="eventual"
					  Grid.ColumnSpan="2" Grid.Row="2"
					  Content="El puesto es eventual"
					  IsChecked="{ Binding Path=EsEventual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
					  Style="{ StaticResource ResourceKey=Chk.Campo }"/>
		</Grid>
	</GroupBox>
</UserControl>

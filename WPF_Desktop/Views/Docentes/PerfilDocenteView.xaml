<UserControl x:Class="WPF_Desktop.Views.Docentes.PerfilDocenteView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"

			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!-- Mismo armado que el perfil del alumno: son la misma pantalla sobre otra entidad. -->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarPerfilCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<components:Header Grid.Row="0"
						   Margin="0 0 0 20"
						   Title="Perfil del docente"
						   Subtitle="Datos personales, contacto y domicilio. Cada bloque se edita por separado."/>

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28 4 28 24">
					<!--#region INFORMACIÓN PERSONAL-->
					<GroupBox Header="INFORMACIÓN PERSONAL" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel>
							<components:InfoPersonalComponent Apellido="{ Binding Path=Docente.InformacionPersonalDTO.Apellido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  Documento="{ Binding Path=Docente.InformacionPersonalDTO.DNI }"
															  EstaHabilitado="{ Binding Path=HabilitarEditarSexo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  FechaNacimiento="{ Binding Path=Docente.InformacionPersonalDTO.FechaNacimiento, StringFormat={}{0:D}, ConverterCulture='es_ES' }"
															  Nacionalidad="{ Binding Path=Docente.InformacionPersonalDTO.Nacionalidad }"
															  Nombre="{ Binding Path=Docente.InformacionPersonalDTO.Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  Sexo="{ Binding Path=Docente.InformacionPersonalDTO.Sexo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 4 0 0"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=EditarCommand }"
										CommandParameter="Sexo"
										Content="Editar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Editar los datos personales"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Sexo"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										Visibility="{ Binding Path=HabilitarEditarSexo, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Sexo"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										Visibility="{ Binding Path=HabilitarEditarSexo, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region CONTACTO-->
					<GroupBox Header="CONTACTO" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel>
							<components:InfoContactoComponent Email="{ Binding Path=Docente.ContactoDTO.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  EstaHabilitado="{ Binding Path=HabilitarEditarContacto, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  Telefono="{ Binding Path=Docente.ContactoDTO.Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 4 0 0"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=EditarCommand }"
										CommandParameter="Contacto"
										Content="Editar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Editar el teléfono y el correo"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Contacto"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										Visibility="{ Binding Path=HabilitarEditarContacto, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Contacto"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										Visibility="{ Binding Path=HabilitarEditarContacto, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region DOMICILIO-->
					<GroupBox Header="DOMICILIO" Style="{ StaticResource ResourceKey=Seccion }">
						<StackPanel>
							<components:InfoDireccionDomicilioComponent Altura="{ Binding Path=Docente.DomicilioDTO.Altura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Calle="{ Binding Path=Docente.DomicilioDTO.Calle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		EstaHabilitado="{ Binding Path=HabilitarEditarDomicilio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																		Observacion="{ Binding Path=Docente.DomicilioDTO.Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Vivienda="{ Binding Path=Docente.DomicilioDTO.Vivienda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<components:InfoUbicacionDomicilioComponent EstaHabilitado="{ Binding Path=HabilitarEditarDomicilio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																		Localidad="{ Binding Path=Docente.DomicilioDTO.Localidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Pais="{ Binding Path=Docente.DomicilioDTO.Pais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Provincia="{ Binding Path=Docente.DomicilioDTO.Provincia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 4 0 0"
										Orientation="Horizontal">
								<Button Command="{ Binding Path=EditarCommand }"
										CommandParameter="Domicilio"
										Content="Editar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Editar el domicilio"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Domicilio"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										Visibility="{ Binding Path=HabilitarEditarDomicilio, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Domicilio"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										Visibility="{ Binding Path=HabilitarEditarDomicilio, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Docentes.PerfilDocenteView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"

			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Mismo armado que el perfil del alumno: son la misma pantalla sobre otra entidad.

		Arriba, la ficha del índice de Docentes (regla verde, identificador y nombre): al entrar
		al perfil se seguía sin saber de quién era hasta leer los campos. Cada bloque se lee como
		dato (Txb.Dato) y se abre con el "Editar" de su renglón; el par cancelar/guardar sólo
		existe con el bloque abierto.

		El contenido tiene ancho máximo: en una ventana maximizada, tres columnas estiradas a
		todo lo ancho separaban el rótulo de su vecino más que de su propio valor.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarPerfilCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Perfil del docente"
									Subtitulo="Datos personales, contacto y domicilio. Cada bloque se edita por separado."/>

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<!--
					La columna acotada va a la izquierda y no centrada: un StackPanel con
					HorizontalAlignment=Left se mide al contenido y colapsa las columnas * de los
					componentes; uno estirado con MaxWidth se centra.
				-->
				<Grid HorizontalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="1016"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Margin="28 22 28 24">
					<!--#region FICHA-->
					<StackPanel Margin="0 0 0 22"
								Orientation="Horizontal"
								Visibility="{ Binding Path=Docente, Converter={ StaticResource ResourceKey=visibleSiHay } }">
						<Rectangle Fill="{ StaticResource ResourceKey=Primario }"
								   Margin="0 2 14 2"
								   VerticalAlignment="Stretch"
								   Width="3"/>
						<StackPanel>
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Identificador }"
									   Text="{ Binding Path=Docente.InformacionPersonalDTO.DNI, StringFormat='DNI {0}', TargetNullValue='SIN DOCUMENTO' }"/>
							<TextBlock Margin="0 2 0 0" Style="{ StaticResource ResourceKey=Txt.Titulo }">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0}, {1}">
										<Binding Path="Docente.InformacionPersonalDTO.Apellido"/>
										<Binding Path="Docente.InformacionPersonalDTO.Nombre"/>
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
					</StackPanel>
					<!--#endregion-->

					<!--#region DATOS PERSONALES-->
					<GroupBox Header="DATOS PERSONALES" Style="{ StaticResource ResourceKey=Seccion.ConAccion }">
						<GroupBox.Tag>
							<Button Command="{ Binding Path=EditarCommand }"
									CommandParameter="Sexo"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Editar apellido, nombre y sexo"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
								<StackPanel Orientation="Horizontal">
									<fa:IconBlock FontSize="11"
												  Icon="Pen"
												  Margin="0 0 8 0"
												  VerticalAlignment="Center"/>
									<TextBlock Text="Editar" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</GroupBox.Tag>

						<StackPanel>
							<components:InfoPersonalComponent Apellido="{ Binding Path=Docente.InformacionPersonalDTO.Apellido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  Documento="{ Binding Path=Docente.InformacionPersonalDTO.DNI }"
															  EstaHabilitado="{ Binding Path=HabilitarEditarSexo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  FechaNacimiento="{ Binding Path=Docente.InformacionPersonalDTO.FechaNacimiento, StringFormat={}{0:D}, ConverterCulture='es_ES' }"
															  Nacionalidad="{ Binding Path=Docente.InformacionPersonalDTO.Nacionalidad }"
															  Nombre="{ Binding Path=Docente.InformacionPersonalDTO.Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  Sexo="{ Binding Path=Docente.InformacionPersonalDTO.Sexo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 0 0 8"
										Orientation="Horizontal"
										Visibility="{ Binding Path=HabilitarEditarSexo, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }">
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Sexo"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Sexo"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region CONTACTO-->
					<GroupBox Header="CONTACTO" Style="{ StaticResource ResourceKey=Seccion.ConAccion }">
						<GroupBox.Tag>
							<Button Command="{ Binding Path=EditarCommand }"
									CommandParameter="Contacto"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Editar el teléfono y el correo"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
								<StackPanel Orientation="Horizontal">
									<fa:IconBlock FontSize="11"
												  Icon="Pen"
												  Margin="0 0 8 0"
												  VerticalAlignment="Center"/>
									<TextBlock Text="Editar" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</GroupBox.Tag>

						<StackPanel>
							<components:InfoContactoComponent Email="{ Binding Path=Docente.ContactoDTO.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															  EstaHabilitado="{ Binding Path=HabilitarEditarContacto, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
															  Telefono="{ Binding Path=Docente.ContactoDTO.Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 0 0 8"
										Orientation="Horizontal"
										Visibility="{ Binding Path=HabilitarEditarContacto, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }">
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Contacto"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Contacto"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->

					<!--#region DOMICILIO-->
					<GroupBox Header="DOMICILIO" Style="{ StaticResource ResourceKey=Seccion.ConAccion }">
						<GroupBox.Tag>
							<Button Command="{ Binding Path=EditarCommand }"
									CommandParameter="Domicilio"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Editar el domicilio"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
								<StackPanel Orientation="Horizontal">
									<fa:IconBlock FontSize="11"
												  Icon="Pen"
												  Margin="0 0 8 0"
												  VerticalAlignment="Center"/>
									<TextBlock Text="Editar" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</GroupBox.Tag>

						<StackPanel>
							<components:InfoDireccionDomicilioComponent Altura="{ Binding Path=Docente.DomicilioDTO.Altura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Calle="{ Binding Path=Docente.DomicilioDTO.Calle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		EstaHabilitado="{ Binding Path=HabilitarEditarDomicilio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																		Observacion="{ Binding Path=Docente.DomicilioDTO.Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Vivienda="{ Binding Path=Docente.DomicilioDTO.Vivienda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<components:InfoUbicacionDomicilioComponent EstaHabilitado="{ Binding Path=HabilitarEditarDomicilio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
																		Localidad="{ Binding Path=Docente.DomicilioDTO.Localidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Pais="{ Binding Path=Docente.DomicilioDTO.Pais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
																		Provincia="{ Binding Path=Docente.DomicilioDTO.Provincia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<StackPanel HorizontalAlignment="Right"
										Margin="0 0 0 8"
										Orientation="Horizontal"
										Visibility="{ Binding Path=HabilitarEditarDomicilio, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidad } }">
								<Button Command="{ Binding Path=CancelarCommand }"
										CommandParameter="Domicilio"
										Content="Cancelar"
										Margin="0 0 8 0"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"/>
								<Button Command="{ Binding Path=GuardarCommand }"
										CommandParameter="Domicilio"
										Content="Guardar cambios"
										Style="{ StaticResource ResourceKey=Btn.Primario }"/>
							</StackPanel>
						</StackPanel>
					</GroupBox>
					<!--#endregion-->
				</StackPanel>
				</Grid>
			</ScrollViewer>

			<components:CargandoComponent EstaCargando="{ Binding Path=CargarPerfilCommandAsync.IsRunning }"
										  Leyenda="CARGANDO EL PERFIL"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>

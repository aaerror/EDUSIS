<UserControl x:Class="WPF_Desktop.Views.Docentes.RegistrarDocenteView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"

			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:shared="clr-namespace:WPF_Desktop.Views.Shared"
			 xmlns:vPuestos="clr-namespace:WPF_Desktop.Views.Docentes.Puestos"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Mismo recorrido de dos pasos que el alta de alumno, y a propósito: son el mismo trámite
		—primero la persona, después su lugar en la institución— y antes se veían distintos
		(acá el TabControl llevaba la sombra y el borde, allá los llevaba un Border de más).
	-->
	<Grid Margin="28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--
			El título decía "Docentes", el mismo que el índice del que se viene: dos pantallas
			distintas con el mismo nombre. Acá se da de alta, y eso es lo que dice ahora.
		-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Registrar docente"
									Subtitulo="Alta de un docente nuevo, en dos pasos: primero la persona, después su lugar en la institución"/>

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<Grid>
			<TabControl Margin="28 20 28 24"
						SelectedIndex="{ Binding Path=Tab, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						Style="{ StaticResource ResourceKey=Pestanas }">
				<!--#region PASO 01: DATOS PERSONALES-->
				<TabItem Header="DATOS PERSONALES"
						 IsEnabled="False"
						 Tag="01">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="28"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!--
								VALIDACIÓN A LA VISTA. Los tres bloques tenían
								Validation.ErrorTemplate="{x:Null}", que apaga el adorno de error
								de todo el sub-árbol: en el único formulario largo de la
								aplicación, el campo mal cargado no se marcaba y el problema
								recién aparecía al apretar "Continuar", en un cartel que además
								borraba lo escrito. Las reglas ya estaban en los ViewModels.
							-->
							<shared:InformacionPersonalView Grid.Column="0" Grid.Row="0"
															DataContext="{ Binding Path=InformacionPersonal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
															VerticalAlignment="Top"/>

							<shared:DomicilioView Grid.Column="2" Grid.Row="0"
												  DataContext="{ Binding Path=Domicilio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												  VerticalAlignment="Top"/>

							<shared:ContactoView Grid.ColumnSpan="3" Grid.Row="1"
												 DataContext="{ Binding Path=Contacto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<Border Grid.ColumnSpan="3" Grid.Row="2"
									Style="{ StaticResource ResourceKey=Superficie.Seccion }">
								<Button Command="{ Binding Path=ContinuarCommand }"
										Content="Continuar"
										HorizontalAlignment="Right"
										Style="{ StaticResource ResourceKey=Btn.Primario }"
										ToolTip="Guardar los datos personales y pasar al legajo"/>
							</Border>
						</Grid>
					</ScrollViewer>
				</TabItem>
				<!--#endregion-->

				<!--#region PASO 02: INSTITUCIÓN-->
				<TabItem Header="INSTITUCIÓN"
						 IsEnabled="False"
						 Tag="02">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<local:LegajoDocenteView DataContext="{ Binding Path=LegajoDocente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<vPuestos:PuestoDocenteView DataContext="{ Binding Path=PuestoDocente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>

							<Border Style="{ StaticResource ResourceKey=Superficie.Seccion }">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Button Grid.Column="0"
											Command="{ Binding Path=AtrasCommand }"
											Content="Atrás"
											Style="{ StaticResource ResourceKey=Btn.Terciario }"
											ToolTip="Volver a los datos personales"/>

									<Button Grid.Column="1"
											Command="{ Binding Path=GuardarCommand }"
											Content="Registrar docente"
											HorizontalAlignment="Right"
											Style="{ StaticResource ResourceKey=Btn.Primario }"
											ToolTip="Dar de alta el docente con este legajo y puesto"/>
								</Grid>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</TabItem>
				<!--#endregion-->
			</TabControl>

			<components:CargandoComponent EstaCargando="{ Binding Path=GuardarCommand.IsRunning }"
										  Leyenda="REGISTRANDO EL DOCENTE"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>

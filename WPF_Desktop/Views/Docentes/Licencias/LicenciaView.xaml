<UserControl x:Class="WPF_Desktop.Views.Docentes.Licencias.LicenciaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainLicencias="clr-namespace:Domain.Licencias;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		LICENCIA — subformulario de alta y edición.

		El estado y la fecha de fin los decide el sistema (el estado arranca pendiente; la fecha
		de fin sale de la fecha de inicio más los días): van como Dato, sin caja, porque lo que
		no se edita no se dibuja como un control de entrada.

		El estado se enlaza directo, sin el LicenciaEstadoConverter: ese conversor existe para
		que un ComboBox de valores de enum acepte una cadena, y acá no hay ComboBox.

		El rótulo de la sección es un Txt.Seccion suelto y no el GroupBox "Seccion": este
		formulario es lo único que hay en su tarjeta, y la regla superior del GroupBox quedaba
		dibujada contra el propio borde de la tarjeta, como una línea huérfana. Es el mismo
		rótulo que encabeza el listado de la pantalla.

		LA CASILLA VA ANTES QUE LO QUE DECIDE, igual que en el puesto: estaba en la tercera fila,
		sola en la columna izquierda, frente al campo de días que ella misma esconde. Ahora el
		formulario se lee en el orden en que se decide: qué artículo, si tiene fin, y recién
		entonces el período.

		El período es una cuenta y se lee como tal: inicio, días, fin, en una misma fila de tres
		columnas. Si la licencia es indefinida no hay días ni fin que mostrar —el fin decía "Sin
		fecha de fin", repitiendo la casilla—, así que los dos se ocultan juntos y la fila queda
		con la fecha de inicio sola, sin un hueco en el medio.
	-->
	<UserControl.Resources>
		<converters:ArticuloConverter x:Key="articuloConverter"/>

		<ObjectDataProvider x:Key="articulos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainLicencias:Articulo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.ColumnSpan="3" Grid.Row="0"
				   Margin="0 0 0 16"
				   Style="{ StaticResource ResourceKey=Txt.Seccion }"
				   Text="DATOS DE LA LICENCIA"/>

		<HeaderedContentControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
								Header="Artículo"
								Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=articulos } }"
					  SelectedItem="{ Binding Path=Articulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=articuloConverter } }"
					  Style="{ StaticResource ResourceKey=Cmb.Campo }"
					  Tag="Elegí el artículo de la licencia"/>
		</HeaderedContentControl>

		<!--
			El estado lo decide el circuito de aprobación, no quien carga la licencia. Va como
			insignia, la misma que en el listado, para que se lea como estado y no como texto suelto.
		-->
		<HeaderedContentControl Grid.Column="2" Grid.Row="1"
								Header="Estado"
								Style="{ StaticResource ResourceKey=Dato.Derecha }">
			<Border HorizontalAlignment="Left" Style="{ StaticResource ResourceKey=Insignia.Licencia }">
				<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
						   Text="{ Binding Path=Estado, Mode=OneWay, FallbackValue='Pendiente', TargetNullValue='Pendiente' }"/>
			</Border>
		</HeaderedContentControl>

		<CheckBox x:Name="esIndefinida"
				  Grid.ColumnSpan="3" Grid.Row="2"
				  Content="La licencia es indefinida, sin fecha de fin"
				  IsChecked="{ Binding Path=EsIndefinida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
				  HorizontalAlignment="Left"
				  Margin="0 0 0 16"
				  Style="{ StaticResource ResourceKey=Chk.Campo }"/>

		<HeaderedContentControl Grid.Column="0" Grid.Row="3"
								Header="Fecha de inicio"
								Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<DatePicker DisplayDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
						DisplayDateEnd="{ x:Static sys:DateTime.Today }"
						DisplayDateStart="01/01/1900"
						SelectedDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
						Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
		</HeaderedContentControl>

		<!-- Los días no existen si la licencia es indefinida: se oculta, no se deshabilita. -->
		<HeaderedContentControl Grid.Column="1" Grid.Row="3"
								Header="Días"
								IsEnabled="{ Binding Path=IsChecked, ElementName=esIndefinida, Mode=OneWay, Converter={ StaticResource ResourceKey=negar } }"
								Style="{ StaticResource ResourceKey=Campo.Centro }"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBox MaxLength="3"
					 Tag="30"
					 Text="{ Binding Path=Dias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<!--
			La calcula el sistema: fecha de inicio + días. Mismo interruptor que los días; el
			TextBlock propio lleva el centrado porque el estilo implícito de Dato sólo alcanza al
			que genera el ContentPresenter, y sin él el valor quedaba pegado al rótulo, más arriba
			que el texto de los campos vecinos.
		-->
		<HeaderedContentControl Grid.Column="2" Grid.Row="3"
								Header="Fecha de finalización"
								IsEnabled="{ Binding Path=IsChecked, ElementName=esIndefinida, Mode=OneWay, Converter={ StaticResource ResourceKey=negar } }"
								Style="{ StaticResource ResourceKey=Dato.Derecha }"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=FechaFin, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}, FallbackValue='—', TargetNullValue='—' }"
					   Typography.NumeralAlignment="Tabular"
					   VerticalAlignment="Center"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.ColumnSpan="3" Grid.Row="4"
								Header="Observaciones"
								Margin="0"
								Style="{ StaticResource ResourceKey=Campo }">
			<TextBox MaxLength="250"
					 Tag="motivo, certificado presentado, quién autoriza&#x2026;"
					 Text="{ Binding Path=Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
					 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
		</HeaderedContentControl>
	</Grid>
</UserControl>

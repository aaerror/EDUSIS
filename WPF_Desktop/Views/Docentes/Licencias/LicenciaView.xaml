<UserControl x:Class="WPF_Desktop.Views.Docentes.Licencias.LicenciaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"
			 xmlns:domainLicencias="clr-namespace:Domain.Licencias;assembly=Domain"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region RESOURCES-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
		<converters:InvertBooleanConverter x:Key="invertBooleanConverter"/>
		<converters:ArticuloConverter x:Key="articuloConverter"/>
		<converters:LicenciaEstadoConverter x:Key="estadoConverter"/>

		<ObjectDataProvider x:Key="articulos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainLicencias:Articulo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<ObjectDataProvider x:Key="estados" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainLicencias:Estado"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<!--#region TITLE-->
		<StackPanel Grid.Row="0"
					Margin="0 0 0 2">
			<Label Content="Datos de Licencia"
				   Style="{ StaticResource ResourceKey=Headline }"/>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
					   Height=".8"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region INPUTs-->
		<Grid Grid.Row="1"
			  Margin="0 2 0 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
			</Grid.RowDefinitions>
			<!--#region LICENCIA ID-->
			<StackPanel Grid.Column="0"
						Grid.Row="0"
						IsEnabled="False"
						Margin="0 5 0 5"
						Visibility="Collapsed">
				<Label Content="LicenciaID"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=LicenciaID, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						 Tag="####"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region ARTÍCULO-->
			<StackPanel Grid.Column="0"
						Grid.Row="1"
						Margin="0 5 10 5">
				<Label Content="Artículo"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=articulos } }"
						  SelectedItem="{ Binding Path=Articulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=articuloConverter } }"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region ESTADO-->
			<StackPanel Grid.Column="1"
						Grid.Row="1"
						Margin="10 5 0 5">
				<Label Content="Estado"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=estados } }"
						  SelectedItem="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=estadoConverter } }"
						  IsEnabled="False"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region FECHAS INICIO-->
			<StackPanel Grid.Column="0"
						Grid.Row="2"
						Margin="0 5 10 5">
				<Label Content="Fecha de Inicio"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<DatePicker SelectedDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							DisplayDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							DisplayDateStart="01/01/1900"
							DisplayDateEnd="{ x:Static sys:DateTime.Today }"
							CalendarStyle="{ StaticResource ResourceKey=Calendar }"
							Style="{ StaticResource ResourceKey=DatePicker }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region FECHAS FINALIZACIÓN-->
			<StackPanel Grid.Column="1"
						Grid.Row="2"
						Margin="10 5 0 5">
				<Label Content="Fecha de Finalización"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<DatePicker SelectedDate="{ Binding Path=FechaFin, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							DisplayDateStart="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							CalendarStyle="{ StaticResource ResourceKey=Calendar }"
							IsEnabled="False"
							Style="{ StaticResource ResourceKey=DatePicker }"/>
			</StackPanel>
			<!--#endregion-->

			<StackPanel Grid.ColumnSpan="2"
						Grid.Row="3"
						Margin="0 5 0 5">
				<!--#region ES INDEFINIDA?-->
				<StackPanel Margin="4 0 0 2"
							VerticalAlignment="Center">
					<CheckBox x:Name="esIndefinida"
							  Content="¿Es licencia indefinida?"
							  IsChecked="{ Binding Path=EsIndefinida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							  Style="{ StaticResource ResourceKey=CheckBox }"/>
				</StackPanel>
				<!--#endregion-->
				<!--#region DÍAS-->
				<StackPanel Margin="0 2 0 0"
							IsEnabled="{ Binding Path=IsChecked, ElementName=esIndefinida, Mode=OneWay, Converter={ StaticResource ResourceKey=invertBooleanConverter } }"
							Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanToVisibilityConverter } }"
							VerticalAlignment="Center">
					<Label Content="Días"
						   Margin="4 0 0 0"
						   Style="{ StaticResource ResourceKey=Form }"/>
					<TextBox Text="{ Binding Path=Dias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							 MaxLength="3"
							 Tag="####"
							 Style="{ StaticResource ResourceKey=TextBox }"/>
				</StackPanel>
				<!--#endregion-->
			</StackPanel>

			<!--#region OBSERVACIÓN-->
			<StackPanel Grid.ColumnSpan="2"
						Grid.Row="4"
						Margin="0 5 0 0">
				<Label Content="Observaciones"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='Sin observaciones', ValidatesOnDataErrors=True }"
						 MaxLength="250"
						 Tag="observaciones&#x2026;"
						 Style="{ StaticResource ResourceKey=TextBox }" Cursor="IBeam"/>
			</StackPanel>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->
	</Grid>
</UserControl>
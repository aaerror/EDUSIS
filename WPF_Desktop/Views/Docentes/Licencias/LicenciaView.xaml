<UserControl x:Class="WPF_Desktop.Views.Docentes.Licencias.LicenciaView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainLicencias="clr-namespace:Domain.Licencias;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		LICENCIA — subformulario de alta y edición.

		Dos de los cinco controles no se podían usar: el estado y la fecha de fin venían con
		IsEnabled="False" porque los decide el sistema (el estado arranca pendiente; la fecha
		de fin sale de la fecha de inicio más los días). Pasan a Dato: lo que no se edita no
		se dibuja como un control de entrada.

		El estado se enlaza directo, sin el LicenciaEstadoConverter: ese conversor existe para
		que un ComboBox de valores de enum acepte una cadena, y acá ya no hay ComboBox.

		Se sacó el bloque LicenciaID, que tenía Visibility="Collapsed" fija. Los textos guía
		eran "####": ahora dicen qué se espera.
	-->
	<UserControl.Resources>
		<converters:ArticuloConverter x:Key="articuloConverter"/>

		<ObjectDataProvider x:Key="articulos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainLicencias:Articulo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<GroupBox Header="DATOS DE LA LICENCIA" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<HeaderedContentControl Grid.Column="0" Grid.Row="0"
									Header="Artículo"
									Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=articulos } }"
						  SelectedItem="{ Binding Path=Articulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=articuloConverter } }"
						  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
			</HeaderedContentControl>

			<!-- El estado lo decide el circuito de aprobación, no quien carga la licencia. -->
			<HeaderedContentControl Grid.Column="1" Grid.Row="0"
									Content="{ Binding Path=Estado, Mode=OneWay, FallbackValue='Pendiente', TargetNullValue='Pendiente' }"
									Header="Estado"
									Style="{ StaticResource ResourceKey=Dato.Derecha }"/>

			<HeaderedContentControl Grid.Column="0" Grid.Row="1"
									Header="Fecha de inicio"
									Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<DatePicker DisplayDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							DisplayDateEnd="{ x:Static sys:DateTime.Today }"
							DisplayDateStart="01/01/1900"
							SelectedDate="{ Binding Path=FechaInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
							Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
			</HeaderedContentControl>

			<!-- La calcula el sistema: fecha de inicio + días, o nada si es indefinida. -->
			<HeaderedContentControl Grid.Column="1" Grid.Row="1"
									Header="Fecha de finalización"
									Style="{ StaticResource ResourceKey=Dato.Derecha }">
				<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
						   Text="{ Binding Path=FechaFin, Mode=OneWay, StringFormat={}{0:d}, ConverterCulture='es-AR', FallbackValue='Sin fecha de fin', TargetNullValue='Sin fecha de fin' }"/>
			</HeaderedContentControl>

			<CheckBox x:Name="esIndefinida"
					  Grid.Column="0" Grid.Row="2"
					  Content="La licencia es indefinida"
					  IsChecked="{ Binding Path=EsIndefinida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
					  Style="{ StaticResource ResourceKey=Chk.Campo.Alineada }"/>

			<!-- Los días no existen si la licencia es indefinida: se oculta, no se deshabilita. -->
			<HeaderedContentControl Grid.Column="1" Grid.Row="2"
									Header="Días"
									IsEnabled="{ Binding Path=IsChecked, ElementName=esIndefinida, Mode=OneWay, Converter={ StaticResource ResourceKey=negar } }"
									Style="{ StaticResource ResourceKey=Campo.Derecha }"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
				<TextBox MaxLength="3"
						 Tag="30"
						 Text="{ Binding Path=Dias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.ColumnSpan="2" Grid.Row="3"
									Header="Observaciones"
									Style="{ StaticResource ResourceKey=Campo }">
				<TextBox MaxLength="250"
						 Tag="motivo, certificado presentado, quién autoriza&#x2026;"
						 Text="{ Binding Path=Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
			</HeaderedContentControl>
		</Grid>
	</GroupBox>
</UserControl>

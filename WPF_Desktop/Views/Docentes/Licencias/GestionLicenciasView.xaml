<UserControl x:Class="WPF_Desktop.Views.Docentes.Licencias.GestionLicenciasView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:vLicencias="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		LICENCIAS DEL DOCENTE.

		Eran tres tarjetas blancas apiladas —aviso, listado, alta— cada una con la misma
		DropShadowEffect y cada una apareciendo y desapareciendo por su cuenta. Ahora el
		listado es UNA tarjeta y el alta otra: son dos modos distintos, no dos secciones.

		El aviso dejó de ser una tarjeta con título "Licencias" y un mensaje adentro: es una
		nota en línea sobre el listado, que es a lo que se refiere.

		Se conserva el idioma de visibilidad de la app: cada botón enlaza su propia
		Visibility a su IsEnabled, y el IsEnabled lo decide el CanExecute del comando, que
		discrimina por CommandParameter ("Aprobar", "Cancelar", "Editar", "Nueva",
		"Eliminar"). Por eso los dos pares Cancelar/Guardar pueden convivir en el pie: nunca
		hay más de uno habilitado a la vez.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarLicenciasCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<Grid Grid.Row="0" Margin="0 0 0 20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<components:Header Grid.Column="0"
							   Title="Licencias"
							   Subtitle="Licencias del docente, con su artículo, sus días y su estado"/>

			<Button Grid.Column="1"
					Command="{ Binding Path=RegistrarCommand }"
					CommandParameter="Nueva"
					Style="{ StaticResource ResourceKey=Btn.Primario }"
					ToolTip="Registrar una licencia nueva"
					VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<fa:IconBlock FontSize="11"
								  Icon="Plus"
								  Margin="0 0 8 0"
								  VerticalAlignment="Center"/>
					<TextBlock Text="Registrar licencia" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>
		<!--#endregion-->

		<!--#region AVISO-->
		<Border Grid.Row="1"
				IsEnabled="{ Binding Path=HabilitarMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					   TextWrapping="Wrap"/>
		</Border>
		<!--#endregion-->

		<!--#region LISTADO-->
		<Border Grid.Row="2"
				IsEnabled="{ Binding Path=HabilitarDetalleLicencias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
						   Margin="0 0 0 12"
						   Style="{ StaticResource ResourceKey=Txt.Seccion }"
						   Text="LICENCIAS REGISTRADAS"/>

				<DataGrid x:Name="DataGrid_Licencias"
						  Grid.Row="1"
						  ItemsSource="{ Binding Path=Licencias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  SelectedItem="{ Binding Path=LicenciaSeleccionada, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged }"
						  IsSynchronizedWithCurrentItem="True"
						  Loaded="DataGridLicencias_Loaded"
						  MinHeight="160"
						  Style="{ StaticResource ResourceKey=Grilla }"
						  Tag="Este docente todavía no tiene licencias. Empezá con &#x201C;Registrar licencia&#x201D;."
						  d:ItemsSource="{ d:SampleData ItemCount=5 }">
					<DataGrid.Columns>
						<DataGridTextColumn Binding="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
											Header="ESTADO"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=Articulo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
											Header="ARTÍCULO"
											Width="2*"/>
						<DataGridTextColumn Binding="{ Binding Path=Dias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
											Header="DÍAS"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:d}, ConverterCulture='es-AR' }"
											Header="DESDE"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:d}, ConverterCulture='es-AR', FallbackValue='Indefinida', TargetNullValue='Indefinida' }"
											Header="HASTA"
											Width="*"/>
					</DataGrid.Columns>
				</DataGrid>

				<!--
					Aprobar y rechazar son las dos caras de la misma decisión y van juntas a
					la derecha; eliminar la licencia no es lo mismo que rechazarla, así que va
					del otro lado del pie.
				-->
				<HeaderedContentControl Grid.Row="2" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Eliminar"
								Content="Eliminar"
								Style="{ StaticResource ResourceKey=Btn.Peligro }"
								ToolTip="Eliminar la licencia seleccionada"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<Button Command="{ Binding Path=EditarCommand }"
								CommandParameter="Editar"
								Content="Editar"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Terciario }"
								ToolTip="Editar la licencia seleccionada"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Cancelar"
								Content="Rechazar"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Rechazar la licencia pendiente"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Aprobar"
								Content="Aprobar"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Conceder la licencia pendiente"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region ALTA Y EDICIÓN-->
		<Border Grid.Row="3"
				IsEnabled="{ Binding Path=HabilitarUpsert, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 16 0 0"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
				<Grid Margin="20 18">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<vLicencias:LicenciaView Grid.Row="0"
											 DataContext="{ Binding Path=LicenciaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"/>

					<HeaderedContentControl Grid.Row="1" Style="{ StaticResource ResourceKey=Acciones }">
						<HeaderedContentControl.Header>
							<StackPanel Orientation="Horizontal">
								<Button Command="{ Binding Path=CancelarCommandAsync }"
										CommandParameter="Nueva"
										Content="Cancelar"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Descartar la licencia nueva"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
								<Button Command="{ Binding Path=CancelarCommandAsync, IsAsync=True }"
										CommandParameter="Editar"
										Content="Cancelar"
										Style="{ StaticResource ResourceKey=Btn.Terciario }"
										ToolTip="Descartar los cambios"
										Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							</StackPanel>
						</HeaderedContentControl.Header>

						<StackPanel Orientation="Horizontal">
							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Nueva"
									Content="Registrar licencia"
									Style="{ StaticResource ResourceKey=Btn.Primario }"
									ToolTip="Registrar la licencia"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Editar"
									Content="Guardar cambios"
									Style="{ StaticResource ResourceKey=Btn.Primario }"
									ToolTip="Guardar los cambios de la licencia"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						</StackPanel>
					</HeaderedContentControl>
				</Grid>
			</ScrollViewer>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>

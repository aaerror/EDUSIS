<UserControl x:Class="WPF_Desktop.Views.Docentes.Licencias.GestionLicenciasView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:vLicencias="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		LICENCIAS DEL DOCENTE.

		Eran tres tarjetas blancas apiladas —aviso, listado, alta— cada una con la misma
		DropShadowEffect y cada una apareciendo y desapareciendo por su cuenta. Ahora el
		listado es UNA tarjeta y el alta otra: son dos modos distintos, no dos secciones.

		El aviso dejó de ser una tarjeta con título "Licencias" y un mensaje adentro: es una
		nota en línea sobre el listado, que es a lo que se refiere.

		Se conserva el idioma de visibilidad de la app: cada botón enlaza su propia
		Visibility a su IsEnabled, y el IsEnabled lo decide el CanExecute del comando, que
		discrimina por CommandParameter ("Aprobar", "Rechazar", "Editar", "Nueva",
		"Eliminar", y los del panel de licencia en curso: "Finalizar", "Prorrogar", "FijarFin",
		"Indefinida"). Por eso los dos pares Cancelar/Guardar pueden convivir en el pie: nunca
		hay más de uno habilitado a la vez. Vale también para "Registrar licencia" del
		encabezado: con el formulario abierto se oculta, como "Agregar puesto", en lugar de
		quedar gris arriba a la derecha.

		Listado y formulario comparten la fila estirable porque nunca se ven a la vez. El
		formulario iba en una fila Auto DEBAJO de la estirable vacía, así que se apoyaba contra
		el borde inferior de la pantalla con un hueco enorme arriba; y su ScrollViewer con
		MaxHeight fijo envolvía también el pie, de modo que los botones de guardar quedaban
		fuera de la vista, detrás de una barra de scroll. Ahora la tarjeta cuelga de arriba,
		crece con su contenido hasta el alto disponible, sólo los campos scrollean y el pie
		queda siempre visible.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarLicenciasCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region ENCABEZADO-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Ruta="{ Binding Path=Ruta }"
									Titulo="Licencias"
									Subtitulo="Licencias del docente, con su artículo, sus días y su estado">
			<components:PaginaComponent.Accion>
				<Button Command="{ Binding Path=RegistrarCommand }"
						CommandParameter="Nueva"
						Style="{ StaticResource ResourceKey=Btn.Primario }"
						ToolTip="Registrar una licencia nueva"
						Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
					<StackPanel Orientation="Horizontal">
						<fa:IconBlock FontSize="11"
									  Icon="Plus"
									  Margin="0 0 8 0"
									  VerticalAlignment="Center"/>
						<TextBlock Text="Registrar licencia" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</components:PaginaComponent.Accion>
		</components:PaginaComponent>
		<!--#endregion-->

		<!--#region AVISO-->
		<Border Grid.Row="1"
				IsEnabled="{ Binding Path=HabilitarMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="{ Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					   TextWrapping="Wrap"/>
		</Border>
		<!--#endregion-->

		<!--#region LISTADO-->
		<Border Grid.Row="2"
				IsEnabled="{ Binding Path=HabilitarDetalleLicencias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid Margin="20 18">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
						   Margin="0 0 0 12"
						   Style="{ StaticResource ResourceKey=Txt.Seccion }"
						   Text="LICENCIAS REGISTRADAS"/>

				<DataGrid x:Name="DataGrid_Licencias"
						  Grid.Row="1"
						  ItemsSource="{ Binding Path=Licencias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  SelectedItem="{ Binding Path=LicenciaSeleccionada, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged }"
						  IsSynchronizedWithCurrentItem="True"
						  Loaded="DataGridLicencias_Loaded"
						  MinHeight="160"
						  Style="{ StaticResource ResourceKey=Grilla }"
						  Tag="Este docente todavía no tiene licencias. Empezá con &#x201C;Registrar licencia&#x201D;."
						  d:ItemsSource="{ d:SampleData ItemCount=5 }">
					<!--
						El estado es lo que decide qué se puede hacer con la fila (sólo una
						pendiente se aprueba, rechaza, edita o elimina), así que va primero y como
						insignia, igual que en el formulario. Las cifras —días y fechas— llevan
						Celda.Numero para que se comparen en columna.
					-->
					<DataGrid.Columns>
						<DataGridTemplateColumn Header="ESTADO" MinWidth="120" Width="Auto">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border HorizontalAlignment="Left" Style="{ StaticResource ResourceKey=Insignia.Licencia }">
										<TextBlock Style="{ StaticResource ResourceKey=Txt.Insignia }"
												   Text="{ Binding Path=EtiquetaEstado, Mode=OneWay }"/>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Binding="{ Binding Path=Denominacion, Mode=OneWay }"
											ElementStyle="{ StaticResource ResourceKey=Celda.Texto }"
											Header="ARTÍCULO"
											Width="2*"/>
						<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"
											ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
											Header="DESDE"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy}, FallbackValue='Indefinida', TargetNullValue='Indefinida' }"
											ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
											Header="HASTA"
											Width="*"/>
						<DataGridTextColumn Binding="{ Binding Path=Dias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
											ElementStyle="{ StaticResource ResourceKey=Celda.Numero }"
											Header="DÍAS"
											Width="80"/>
					</DataGrid.Columns>
				</DataGrid>

				<!--
					LICENCIA EN CURSO: lo que se hace con una aprobada que todavía no se finalizó.
					Aparece sólo con una así seleccionada y si la sesión la puede resolver. Cada
					campo va con su botón y se muestra sólo si el dominio admite esa operación para
					la licencia elegida (VM: PuedeProrrogar, PuedeFijarFechaDeFin,
					PuedeDeclararIndefinida); el botón, además, se apaga mientras el dato no sirve.
					El reintegro es el cierre y va a la derecha, como la acción principal del panel.
				-->
				<Border Grid.Row="2"
						Margin="0 16 0 0"
						Style="{ StaticResource ResourceKey=Superficie.Seccion }"
						Visibility="{ Binding Path=MostrarLicenciaEnCurso, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<TextBlock Grid.ColumnSpan="2" Grid.Row="0"
								   Margin="0 0 0 12"
								   Style="{ StaticResource ResourceKey=Txt.Seccion }"
								   Text="LICENCIA EN CURSO"/>

						<WrapPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
							<StackPanel Margin="0 0 24 0"
										Orientation="Horizontal"
										Visibility="{ Binding Path=PuedeProrrogar, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
								<HeaderedContentControl Header="Días de prórroga"
														Margin="0 0 8 0"
														Style="{ StaticResource ResourceKey=Campo }">
									<TextBox MaxLength="3"
											 Tag="5"
											 Text="{ Binding Path=DiasDeProrroga, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
											 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
								</HeaderedContentControl>
								<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
										CommandParameter="Prorrogar"
										Content="Prorrogar"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Sumarle días a la fecha de fin de la licencia"
										VerticalAlignment="Center"/>
							</StackPanel>

							<StackPanel Margin="0 0 24 0"
										Orientation="Horizontal"
										Visibility="{ Binding Path=PuedeFijarFechaDeFin, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }">
								<HeaderedContentControl Header="Último día de licencia"
														Margin="0 0 8 0"
														Style="{ StaticResource ResourceKey=Campo }">
									<DatePicker SelectedDate="{ Binding Path=FechaDeFin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
												Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
								</HeaderedContentControl>
								<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
										CommandParameter="FijarFin"
										Content="Fijar fecha de fin"
										Style="{ StaticResource ResourceKey=Btn.Secundario }"
										ToolTip="Ponerle término a la licencia indefinida (una fecha posterior a hoy)"
										VerticalAlignment="Center"/>
							</StackPanel>

							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Indefinida"
									Content="Declarar indefinida"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Quitarle la fecha de fin: sólo los artículos sin plazo legal"
									VerticalAlignment="Center"
									Visibility="{ Binding Path=PuedeDeclararIndefinida, Mode=OneWay, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						</WrapPanel>

						<Button Grid.Column="1" Grid.Row="1"
								Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Finalizar"
								Content="Registrar reintegro"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Finalizar la licencia: el docente vuelve a sus funciones"
								VerticalAlignment="Center"/>
					</Grid>
				</Border>

				<!--
					Aprobar y rechazar son las dos caras de la misma decisión y van juntas a
					la derecha; eliminar la licencia no es lo mismo que rechazarla, así que va
					del otro lado del pie.
				-->
				<HeaderedContentControl Grid.Row="3" Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Eliminar"
								Content="Eliminar"
								Style="{ StaticResource ResourceKey=Btn.Peligro }"
								ToolTip="Eliminar la licencia seleccionada"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<!--
							"Editar" abre el formulario de abajo; es la misma acción que en los
							dos perfiles, y ahí ya era Btn.Secundario. Acá estaba en terciario,
							el mismo peso que "Cancelar".
						-->
						<Button Command="{ Binding Path=EditarCommand }"
								CommandParameter="Editar"
								Content="Editar"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Editar la licencia seleccionada"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Rechazar"
								Content="Rechazar"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								ToolTip="Rechazar la licencia pendiente"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Aprobar"
								Content="Aprobar"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Conceder la licencia pendiente"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region ALTA Y EDICIÓN-->
		<Border Grid.Row="2"
				IsEnabled="{ Binding Path=HabilitarUpsert, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Style="{ StaticResource ResourceKey=Superficie.Tarjeta }"
				VerticalAlignment="Top"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--
					El margen va en el contenido y no en el ScrollViewer: así la barra, si
					aparece, corre pegada al borde de la tarjeta y no encima de los campos.
				-->
				<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
					<vLicencias:LicenciaView Margin="20 18 20 0"
											 DataContext="{ Binding Path=LicenciaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"/>
				</ScrollViewer>

				<HeaderedContentControl Grid.Row="1"
										Margin="20 20 20 18"
										Style="{ StaticResource ResourceKey=Acciones }">
					<HeaderedContentControl.Header>
						<StackPanel Orientation="Horizontal">
							<Button Command="{ Binding Path=CancelarCommandAsync }"
									CommandParameter="Nueva"
									Content="Cancelar"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Descartar la licencia nueva"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
							<Button Command="{ Binding Path=CancelarCommandAsync, IsAsync=True }"
									CommandParameter="Editar"
									Content="Cancelar"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Descartar los cambios"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						</StackPanel>
					</HeaderedContentControl.Header>

					<StackPanel Orientation="Horizontal">
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Nueva"
								Content="Registrar licencia"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Registrar la licencia"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Editar"
								Content="Guardar cambios"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								ToolTip="Guardar los cambios de la licencia"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=visibilidad } }"/>
					</StackPanel>
				</HeaderedContentControl>
			</Grid>
		</Border>
		<!--#endregion-->

		<components:CargandoComponent Grid.Row="0"
									  Grid.RowSpan="3"
									  EstaCargando="{ Binding Path=CargarLicenciasCommandAsync.IsRunning }"
									  Leyenda="CARGANDO LAS LICENCIAS"/>
	</Grid>
</UserControl>

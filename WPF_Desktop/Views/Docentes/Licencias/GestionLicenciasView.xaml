<UserControl x:Class="WPF_Desktop.Views.Docentes.Licencias.GestionLicenciasView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"
			 xmlns:vLicencias="clr-namespace:WPF_Desktop.Views.Docentes.Licencias"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:ext="clr-namespace:WPF_Desktop.Shared.Extensions"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 xmlns:domainLicencias="clr-namespace:Domain.Licencias;assembly=Domain"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region	RESOURCES-->
	<UserControl.Resources>
		<converters:InvertBooleanConverter x:Key="invertBooleanConverter"/>
		<BooleanToVisibilityConverter x:Key="booleanConverter"/>
		<ObjectDataProvider x:Key="articulos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainLicencias:Articulo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<ObjectDataProvider x:Key="estados" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainLicencias:Estado"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>
	<!--#endregion-->
	<!--#region EVENTS: Loaded-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<!-- <behaviors:CallMethodAction MethodName="CargarPerfilDocenteAsync" TargetObject="{Binding}"/> -->
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarLicenciasCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<!--#endregion-->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<!--#region TITTLE AND SUBTITLE-->
		<components:Header Grid.Row="0"
						   Title="Gestión de Docentes"
						   Subtitle="Administración y Gestión de Licencias"/>
		<!--#endregion-->

		<!--#region COMMANDs-->
		<Grid Grid.Row="1"
			  Margin="20 10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<WrapPanel Grid.Column="0"
					   HorizontalAlignment="Left">
				<!--#region RegistrarCommand: Nueva-->
				<Button Command="{ Binding Path=RegistrarCommand }"
						CommandParameter="Nueva"
						ToolTip="Registrar licencia"
						Style="{ StaticResource ResourceKey=Secondary }">
					<Button.Content>
						<WrapPanel>
							<fa:IconBlock Icon="Plus"
										  Foreground="{ StaticResource ResourceKey=Neutral800 }"
										  FontSize="12"
										  Margin="0 0 1 0"/>
							<Label Content="Registrar"
								   Margin="1 0 0 2"/>
						</WrapPanel>
					</Button.Content>
				</Button>
				<!--#endregion-->
			</WrapPanel>
		</Grid>
		<!--#endregion-->

		<!--#region MESSAGE-->
		<Border Grid.Row="2"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Padding="10"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>
			<Grid Margin="20 10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0"
							Margin="0 0 0 5">
					<Label Content="Licencias"
						   Style="{ StaticResource ResourceKey=Headline }"/>
					<Separator Background="{ StaticResource ResourceKey=Gray400 }"
							   Height=".8"
							   Width="Auto"/>
				</StackPanel>

				<!--#region MESSAGE-->
				<StackPanel Grid.Row="1"
							Margin="0 5 0 0">
					<Label Content="{ Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						   Style="{ StaticResource ResourceKey=Body }"/>
				</StackPanel>
				<!--#endregion-->
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region DETAILS-->
		<Border Grid.Row="3"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarDetalleLicencias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
								  Color="#373737"
								  ShadowDepth="5"
								  Opacity=".3"/>
			</Border.Effect>
			<ScrollViewer VerticalScrollBarVisibility="Auto"
						  Padding="10 20">
				<Grid Margin="20 10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<!--#region TITTLE-->
					<StackPanel Grid.Row="0"
								Margin="0 0 0 5">
						<Label Content="Detalle de las licencias"
							   Style="{ StaticResource ResourceKey=Headline }"/>
						<Separator Background="{ StaticResource ResourceKey=Gray400 }"
								   Height=".8"
								   Width="Auto"/>
					</StackPanel>
					<!--#endregion-->

					<!--#region DATAGRID-->
					<StackPanel Grid.Row="1"
								Margin="0 5 0 10">
						<DataGrid x:Name="DataGrid_Licencias"
								  Grid.Row="0"
								  ItemsSource="{ Binding Path=Licencias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
								  SelectedItem="{ Binding Path=LicenciaSeleccionada, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged }"
								  AutoGenerateColumns="False"
								  HorizontalContentAlignment="Center"
								  IsSynchronizedWithCurrentItem="True"
								  CanUserAddRows="False"
								  Loaded="DataGridLicencias_Loaded"
								  d:ItemsSource="{ d:SampleData ItemCount=5 }"
								  Style="{ StaticResource ResourceKey=DataGrid }">
							<DataGrid.Columns>
								<DataGridTextColumn Binding="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
													Header="Estado"
													Width="*"/>
								<DataGridTextColumn Binding="{ Binding Path=Articulo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
													Header="Artículo"
													Width="2*"/>
								<DataGridTextColumn Binding="{ Binding Path=Dias, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
													Header="Cantidad de Días"
													Width="*"/>
								<DataGridTextColumn Binding="{ Binding Path=FechaInicio, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}, ConverterCulture='es-Es' }"
													Header="Fecha de Inicio"
													Width="2*"/>
								<DataGridTextColumn Binding="{ Binding Path=FechaFin, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Sin datos', UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}, ConverterCulture='es-Es' }"
													Header="Fecha de finalización"
													Width="2*"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
					<!--#endregion-->

					<!--#region LICENCIA-->
					<!--
					<StackPanel Grid.Row="2"
								Margin="0 10 0 10"
								IsEnabled="{ Binding Path=HabilitarLicenciaViewModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }">
						<vLicencias:LicenciaView DataContext="{ Binding Path=Licencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>
					</StackPanel>
					-->
					<!--#endregion-->

					<!--#region COMMANDS-->
					<Grid Grid.Column="2"
						  Grid.Row="3"
						  Margin="0 10 0 0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>
						<!--#region COMMANDs-->
						<WrapPanel Grid.Column="0">
							<!--#region GuardarCommand: Aprobar-->
							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Aprobar"
									Margin="0 0 5 0"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
									ToolTip="Aprobar Licencia"
									Style="{ StaticResource ResourceKey=Primary }">
								<Button.Content>
									<WrapPanel>
										<fa:IconBlock Icon="Check"
													  Foreground="White"
													  FontSize="12"
													  Margin="0 0 1 0"/>
										<Label Content="Aprobar"
											   Foreground="White"
											   Margin="1 0 0 2"/>
									</WrapPanel>
								</Button.Content>
							</Button>
							<!--#endregion-->
							<!--#region GuardarCommand: Cancelar-->
							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Cancelar"
									Background="{ StaticResource ResourceKey=Red500 }"
									Margin="5 0 0 0"
									ToolTip="Rechazar licencia"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
									Style="{ StaticResource ResourceKey=Tertiary }">
								<Button.Content>
									<WrapPanel>
										<fa:IconBlock Icon="X"
													  Foreground="White"
													  FontSize="12"
													  Margin="0 0 1 0"/>
										<Label Content="Rechazar"
											   Foreground="White"
											   Margin="1 0 0 2"/>
									</WrapPanel>
								</Button.Content>
							</Button>
							<!--#endregion-->
						</WrapPanel>
						<!--#endregion-->
						<!--#region COMMANDs-->
						<WrapPanel Grid.Column="1"
								   HorizontalAlignment="Right">
							<!--#region GuardarCommand: Eliminar-->
							<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
									CommandParameter="Eliminar"
									Background="{ StaticResource ResourceKey=Red500 }"
									Margin="0 0 5 0"
									ToolTip="Eliminar licencia"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
									Style="{ StaticResource ResourceKey=Tertiary }">
								<Button.Content>
									<WrapPanel>
										<fa:IconBlock Icon="Trash"
													  Foreground="White"
													  FontSize="12"/>
									</WrapPanel>
								</Button.Content>
							</Button>
							<!--#endregion-->
							<!--#region EditarCommand: Editar-->
							<Button Command="{ Binding Path=EditarCommand }"
									CommandParameter="Editar"
									Margin="5 0 0 0"
									ToolTip="Editar licencia"
									Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
									Style="{ StaticResource ResourceKey=Secondary }">
								<Button.Content>
									<WrapPanel>
										<fa:IconBlock Icon="Pen"
													  Foreground="{ StaticResource ResourceKey=Neutral800 }"
													  FontSize="12"
													  Margin="0 0 0 0"/>
									</WrapPanel>
								</Button.Content>
							</Button>
							<!--#endregion-->
						</WrapPanel>
						<!--#endregion-->
					</Grid>
					<!--#endregion-->
				</Grid>
			</ScrollViewer>
		</Border>
		<!--#endregion-->

		<!--#region REGISTRAR LICENCIA-->
		<Border Grid.Row="4"
				Background="#FFFFFF"
				BorderBrush="{ StaticResource ResourceKey=Gray200 }"
				BorderThickness="1"
				CornerRadius="4"
				IsEnabled="{ Binding Path=HabilitarUpsert, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
				Margin="20 10"
				Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15"
						  Color="#373737"
						  ShadowDepth="5"
						  Opacity=".3"/>
			</Border.Effect>
			<ScrollViewer VerticalScrollBarVisibility="Auto"
						  Padding="10 20">
				<Grid Margin="20 10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<!--#region LICENCIA-->
					<vLicencias:LicenciaView Grid.Row="0"
											 DataContext="{ Binding Path=LicenciaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
											 Margin="0 0 0 10"/>
					<!-- Validation.ErrorTemplate="{ x:Null }" -->
					<!--#endregion-->

					<!--#region COMMANDs-->
					<WrapPanel Grid.Row="1"
							   HorizontalAlignment="Right"
							   Margin="0 10 0 0">
						<!--#region CancelarCommand: Nueva-->
						<Button Command="{ Binding Path=CancelarCommandAsync }"
								CommandParameter="Nueva"
								Content="Cancelar"
								Margin="0 0 5 0"
								ToolTip="Cancelar"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
								Style="{ StaticResource ResourceKey=Tertiary }"/>
						<!--#endregion-->
						<!--#region GuardarCommand: Nueva-->
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Nueva"
								Margin="5 0 0 0"
								ToolTip="Guardar"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
								Style="{ StaticResource ResourceKey=Primary }">
							<Button.Content>
								<WrapPanel>
									<fa:IconBlock Icon="FloppyDisk"
											  Foreground="White"
											  FontSize="14"
											  Margin="0 0 1 0"/>
									<Label Content="Guardar"
									   Foreground="White"
									   Margin="1 0 0 2"/>
								</WrapPanel>
							</Button.Content>
						</Button>
						<!--#endregion-->

						<!--#region CancelarCommand: Editar-->
						<Button Command="{ Binding Path=CancelarCommandAsync, IsAsync=True }"
								CommandParameter="Editar"
								Content="Cancelar"
								Margin="0 0 5 0"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
								Style="{ StaticResource ResourceKey=Tertiary }"/>
						<!--#endregion-->
						<!--#region GuardarCommand: Editar-->
						<Button Command="{ Binding Path=GuardarCommandAsync, IsAsync=True }"
								CommandParameter="Editar"
								Margin="5 0 0 0"
								Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }"
								Style="{ StaticResource ResourceKey=Primary }">
							<Button.Content>
								<WrapPanel>
									<fa:IconBlock Icon="FloppyDisk"
												  Foreground="White"
												  FontSize="14"
												  Margin="0 0 1 0"/>
									<Label Content="Guardar"
										   Foreground="White"
										   Margin="1 0 0 2"/>
								</WrapPanel>
							</Button.Content>
						</Button>
						<!--#endregion-->
					</WrapPanel>
					<!--#endregion-->
				</Grid>
			</ScrollViewer>
		</Border>
		<!--#endregion-->
	</Grid>
</UserControl>
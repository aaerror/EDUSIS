<UserControl x:Class="WPF_Desktop.Views.Docentes.LegajoDocenteView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"

			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		"Apellido y nombre" se deshabilita: su enlace ya era Mode=OneWay, así que se veía como
		un campo editable y lo que se escribiera no iba a ninguna parte. El mismo criterio que
		el D.N.I. de adentro del CUIL y que la fecha de baja, que ya estaban deshabilitados.
	-->
	<GroupBox Header="LEGAJO DOCENTE" Style="{ StaticResource ResourceKey=Seccion }">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<HeaderedContentControl Grid.Column="0" Grid.Row="0"
								   Header="Apellido y nombre"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox IsEnabled="False"
						 Text="{ Binding Path=NombreCompleto, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Nombre completo sin especificar', UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="0"
								   Header="Legajo"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<TextBox Text="{ Binding Path=Legajo, FallbackValue='Sin datos', TargetNullValue='Legajo sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<!--
				El CUIL son tres campos que forman un número: el del medio es el documento y
				no se edita acá. Los guiones van en la tipografía de dato, igual que las
				columnas numéricas de los listados.
			-->
			<HeaderedContentControl Grid.Column="0" Grid.Row="1"
								   Header="CUIL"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBox Grid.Column="0"
							 HorizontalContentAlignment="Center"
							 MaxLength="2"
							 Tag="20"
							 Text="{ Binding Path=PrefijoCuil, FallbackValue='00', TargetNullValue='Prefijo sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							 Style="{ StaticResource ResourceKey=Txb.Campo }"
							 Width="48"/>

					<TextBlock Grid.Column="1"
							   Margin="8 0"
							   Style="{ StaticResource ResourceKey=Txt.Dato }"
							   Text="–"
							   VerticalAlignment="Center"/>

					<TextBox Grid.Column="2"
							 HorizontalContentAlignment="Center"
							 IsEnabled="False"
							 Text="{ Binding Path=DocumentoNacionalIdentidad, FallbackValue='Sin datos', TargetNullValue='D.N.I. sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							 Style="{ StaticResource ResourceKey=Txb.Campo }"/>

					<TextBlock Grid.Column="3"
							   Margin="8 0"
							   Style="{ StaticResource ResourceKey=Txt.Dato }"
							   Text="–"
							   VerticalAlignment="Center"/>

					<TextBox Grid.Column="4"
							 HorizontalContentAlignment="Center"
							 MaxLength="1"
							 Tag="3"
							 Text="{ Binding Path=PosfijoCuil, FallbackValue=0, TargetNullValue='Posfijo sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							 Style="{ StaticResource ResourceKey=Txb.Campo }"
							 Width="40"/>
				</Grid>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="1" Grid.Row="1"
								   Header="Fecha de alta"
								   Style="{ StaticResource ResourceKey=Campo.Derecha }">
				<DatePicker DisplayDate="{ Binding Path=FechaAlta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDateEnd="{ x:Static sys:DateTime.Now }"
							DisplayDateStart="01/01/1900"
							SelectedDate="{ Binding Path=FechaAlta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							Style="{ StaticResource ResourceKey=Dtp.Campo }"/>
			</HeaderedContentControl>

			<HeaderedContentControl Grid.Column="0" Grid.Row="2"
								   Header="Fecha de baja"
								   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
				<TextBox IsEnabled="False"
						 Text="{ Binding Path=FechaBaja, Mode=OneWay, StringFormat={}{0:D}, ConverterCulture='es-Es' }"
						 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
			</HeaderedContentControl>

			<CheckBox Grid.ColumnSpan="2" Grid.Row="3"
					  Content="Se encuentra en actividad"
					  IsChecked="{ Binding Path=EstaActivo, Mode=OneWay }"
					  IsEnabled="False"
					  Style="{ StaticResource ResourceKey=Chk.Campo }"/>
		</Grid>
	</GroupBox>
</UserControl>

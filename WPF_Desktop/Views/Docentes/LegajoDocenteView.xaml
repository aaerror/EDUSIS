<UserControl x:Class="WPF_Desktop.Views.Docentes.LegajoDocenteView"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Docentes"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<StackPanel Grid.Row="0"
					Margin="0 0 0 5">
			<Label Style="{ StaticResource ResourceKey=Headline }">
				<Label.Content>
					<WrapPanel HorizontalAlignment="Center"
							   VerticalAlignment="Center">
						<fa:IconBlock Icon="FolderOpen"
									  Foreground="{ StaticResource ResourceKey=Neutral800 }"
									  Margin="0 0 2 0"/>
						<TextBlock Text="Legajo Docente"
								   Margin="2 0 0 2"/>
					</WrapPanel>
				</Label.Content>
			</Label>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
					   Height=".8"
					   Width="Auto"/>
		</StackPanel>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
				<RowDefinition/>
			</Grid.RowDefinitions>

			<!-- NOMBRE_COMPLETO -->
			<StackPanel Grid.Column="0"
						Grid.Row="0"
						Margin="0 0 10 5">
				<Label Content="Apellido y Nombre"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=NombreCompleto, Mode=OneWay, FallbackValue='Sin datos', TargetNullValue='Nombre completo sin especificar', UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>

			<!-- LEGAJO -->
			<StackPanel Grid.Column="0"
						Grid.Row="1"
						Margin="0 5 10 5">
				<Label Content="Legajo"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=Legajo, FallbackValue='Sin datos', TargetNullValue='Legajo sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Tag="ingresar legajo docente&#x2026;"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>

			<!-- CUIL -->
			<StackPanel Grid.Column="1"
						Grid.Row="1"
						Margin="10 5 0 5">
				<Label Content="CUIL"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBox Grid.Column="0"
							 Text="{ Binding Path=PrefijoCuil, FallbackValue='00', TargetNullValue='Prefijo sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							 HorizontalContentAlignment="Center"
							 Margin="0 0 5 0"
							 MaxLength="2"
							 Style="{ StaticResource ResourceKey=TextBox }"/>
					<Label Grid.Column="1"
						   Content="-"
						   Margin="5 0"
						   Style="{ StaticResource ResourceKey=Body }"/>
					<TextBox Grid.Column="2"
							 Text="{ Binding Path=DocumentoNacionalIdentidad, FallbackValue='Sin datos', TargetNullValue='D.N.I. sin especificar', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
							 HorizontalContentAlignment="Center"
							 Margin="5 0"
							 IsEnabled="False"
							 Style="{ StaticResource ResourceKey=TextBox }"/>
					<Label Grid.Column="3"
						   Content="-"
						   Margin="5 0"
						   Style="{ StaticResource ResourceKey=Body }"/>
					<TextBox Grid.Column="4"
							 Text="{ Binding Path=PosfijoCuil, FallbackValue=0, TargetNullValue='Posfijo sin especificar', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							 HorizontalContentAlignment="Center"
							 Margin="5 0 0 0"
							 MaxLength="1"
							 Style="{ StaticResource ResourceKey=TextBox }"/>
				</Grid>
			</StackPanel>

			<!-- FECHA ALTA -->
			<StackPanel Grid.Column="0"
						Grid.Row="2"
						Margin="0 5 10 5">
				<Label Content="Fecha Alta"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<DatePicker SelectedDate="{ Binding Path=FechaAlta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDate="{ Binding Path=FechaAlta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
							DisplayDateStart="01/01/1900"
							DisplayDateEnd="{ x:Static sys:DateTime.Now }"
							CalendarStyle="{ StaticResource ResourceKey=Calendar }"
							Style="{ StaticResource ResourceKey=DatePicker }"/>
			</StackPanel>

			<!-- FECHA BAJA -->
			<StackPanel Grid.Column="1"
						Grid.Row="2"
						Margin="10 5 0 5">
				<Label Content="Fecha Baja"
					   Margin="4 0 0 0"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=FechaBaja, Mode=OneWay, StringFormat={}{0:D}, ConverterCulture='es-Es' }"
						 IsEnabled="False"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>

			<!-- EN ACTIVIDAD? -->
			<StackPanel Grid.ColumnSpan="2"
						Grid.Row="3"
						Margin="0 5 0 0">
				<CheckBox Content="¿Se encuentra en actividad?"
						  Margin="4 0 0 0"
						  IsChecked="{ Binding Path=EstaActivo, Mode=OneWay }"
						  IsEnabled="False"
						  Style="{ StaticResource ResourceKey=CheckBox }"/>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>

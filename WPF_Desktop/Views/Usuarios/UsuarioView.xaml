<UserControl x:Class="WPF_Desktop.Views.Usuarios.UsuarioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Usuarios"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--#region EVENT-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarUsuarioCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<!--#endregion-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="booleanConverter"/>
	</UserControl.Resources>
	<Grid>
		<Grid.Background>
			<LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
				<GradientStop Color="#FEFEFA" Offset=".25"/>
				<GradientStop Color="#FEFEFB" Offset=".5"/>
				<GradientStop Color="#FEFEFC" Offset=".75"/>
			</LinearGradientBrush>
		</Grid.Background>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<StackPanel Grid.ColumnSpan="2"
					Grid.Row="0"
					Margin="0 0 0 2">
			<TextBlock Text="{ Binding Path=NombreCompleto, FallbackValue='Sin datos', TargetNullValue='Usuario sin autenticarse', Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat=¡Bienvenido {0}! }"
					   FontSize="16"
					   Style="{ StaticResource ResourceKey=TextBlock_Body }"/>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
					   Height=".8"/>
		</StackPanel>

		<fa:IconBlock Grid.Column="0"
					  Grid.Row="1"
					  Icon="User"
					  Margin="5 2 2 5"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Center"/>
		<Label Grid.Column="1"
			   Grid.Row="1"
			   Content="{ Binding Path=Username,  FallbackValue='Sin datos', TargetNullValue='Usuario no conectado', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
			   Margin="2 2 5 5"
			   Style="{ StaticResource ResourceKey=Caption }"/>

		<fa:IconBlock Grid.Column="0"
					  Grid.Row="3"
					  Icon="Fingerprint"
					  Margin="5 5 2 5"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Center"/>
		<Label Grid.Column="1"
			   Grid.Row="3"
			   Content="{ Binding Path=Username, FallbackValue='Sin datos', TargetNullValue='Sin datos', Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
			   Margin="2 5 5 5"
			   Style="{ StaticResource ResourceKey=Caption }"/>

		<fa:IconBlock Grid.Column="0"
					  Grid.Row="4"
					  Icon="Plug"
					  Margin="5 5 2 5"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Center"/>
		<Label Grid.Column="1"
			   Grid.Row="4"
			   Content="{ Binding Path=Estado, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
			   Margin="2 5 5 5"
			   Style="{ StaticResource ResourceKey=Caption }"/>
	</Grid>
</UserControl>
<UserControl x:Class="WPF_Desktop.Views.Usuarios.UsuarioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Usuarios"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		CREDENCIAL DEL RAIL.

		Vive sobre el campo Pizarra, así que todo acá va en blanco a distintos niveles de
		énfasis, no en Tinta.

		La versión anterior mostraba el mismo binding —Username— en dos filas distintas, una
		rotulada con un icono de usuario y otra con uno de huella digital, más una tercera con
		"Conectado" junto a un enchufe. Tres filas para dos datos, uno repetido, y un estado
		que siempre dice lo mismo: si la credencial está visible, hay sesión.
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarUsuarioCommandAsync }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Iniciales en lugar de un icono genérico: distinguen una sesión de otra. -->
		<Border Grid.Column="0"
				Background="{ StaticResource ResourceKey=Primario }"
				CornerRadius="3"
				Height="34"
				VerticalAlignment="Top"
				Width="34">
			<!--
				Era la única vista que fijaba familia, tamaño, peso y color a mano en cada
				TextBlock. Ahora usa los tres estilos del rail, que viven en el tema junto al
				resto de la escala tipográfica.
			-->
			<TextBlock Style="{ StaticResource ResourceKey=Txt.SobrePizarra.Inicial }"
					   Text="{ Binding Path=Iniciales, FallbackValue=— }"/>
		</Border>

		<StackPanel Grid.Column="1"
					Margin="11 0 0 0"
					VerticalAlignment="Center">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.SobrePizarra }"
					   Text="{ Binding Path=NombreCompleto, FallbackValue='Sesión sin iniciar', TargetNullValue='Sesión sin iniciar' }"
					   TextTrimming="CharacterEllipsis"
					   ToolTip="{ Binding Path=NombreCompleto }"/>
			<TextBlock Margin="0 2 0 0"
					   Style="{ StaticResource ResourceKey=Txt.SobrePizarra.Dato }"
					   Text="{ Binding Path=Username, FallbackValue='—', TargetNullValue='—' }"
					   TextTrimming="CharacterEllipsis"
					   ToolTip="{ Binding Path=Username }"/>

			<!--
				TERCERA LÍNEA: el rol. No repite el defecto que esta vista vino a cerrar —tres
				filas para dos datos, con una repetida—: el rol es información nueva, y es la que
				explica por qué el menú se ve como se ve. Sin él, el usuario lee "las secciones que
				tu rol no habilita aparecen apagadas" sin tener dónde averiguar cuál es su rol.

				El converter es el mismo de la pantalla de Usuarios, así que una cuenta sin roles
				dice acá lo mismo que allá: "Sin roles".

				Lleva el mismo tono que el usuario —SobrePizarraMedia, el que trae el estilo— y no
				el tenue que separaría mejor las tres líneas: SobrePizarraTenue es blanco al 34%,
				que compuesto sobre Pizarra da 2,9:1 y queda debajo del 4,5:1 de WCAG AA. Ese tono
				es para un rótulo de sección como "GESTIÓN", no para un dato que hay que leer. La
				jerarquía acá la dan el orden y la forma del texto, no el contraste.
			-->
			<TextBlock Margin="0 3 0 0"
					   Style="{ StaticResource ResourceKey=Txt.SobrePizarra.Dato }"
					   Text="{ Binding Path=RolesIDs, Converter={ StaticResource ResourceKey=roles }, FallbackValue='—', Mode=OneWay }"
					   TextTrimming="CharacterEllipsis"
					   ToolTip="{ Binding Path=RolesIDs, Converter={ StaticResource ResourceKey=roles }, Mode=OneWay }"/>
		</StackPanel>
	</Grid>
</UserControl>

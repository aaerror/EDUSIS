<UserControl x:Class="WPF_Desktop.Views.Usuarios.RegistrarUsuarioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Usuarios"

			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Comparte el panel de arranque con el ingreso, así que se arma igual: campos apilados y
		el botón de acción al pie, a la altura del campo. Las dos filas en * estiraban los
		campos hasta repartirse el panel entero.

		Se agregó el aviso de "no hay docentes en actividad": los dos campos se deshabilitan
		con ExistenDocentesActivos y antes no había nada que dijera por qué. Un control muerto
		sin explicación enseña a desconfiar del resto.

		Se sacó el bloque comentado del título "Solicitar usuario".
	-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=UpdateListaDocentesAsyncCommand }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<StackPanel>
		<Border Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Aviso }"
				Visibility="{ Binding Path=ExistenDocentesActivos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={ StaticResource ResourceKey=visibilidadInversa } }">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
					   Text="No hay docentes en actividad. Un usuario se solicita sobre un legajo docente activo, así que primero hay que dar de alta el docente."
					   TextWrapping="Wrap"/>
		</Border>

		<HeaderedContentControl Header="Docente" Style="{ StaticResource ResourceKey=Campo }">
			<ComboBox IsEnabled="{ Binding Path=ExistenDocentesActivos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					  ItemsSource="{ Binding Path=Docentes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					  SelectedItem="{ Binding Path=Docente, Mode=OneWayToSource }"
					  Style="{ StaticResource ResourceKey=Cmb.Campo }">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{ Binding Path=NombreCompleto }"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</HeaderedContentControl>

		<HeaderedContentControl Header="Legajo docente" Style="{ StaticResource ResourceKey=Campo }">
			<TextBox IsEnabled="{ Binding Path=ExistenDocentesActivos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
					 Text="{ Binding Path=Legajo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<Button Command="{ Binding Path=RegistrarAsyncCommand }"
				Content="Solicitar usuario"
				Height="40"
				IsDefault="True"
				Margin="0 4 0 0"
				Style="{ StaticResource ResourceKey=Btn.Primario }"/>
	</StackPanel>
</UserControl>

<UserControl x:Class="WPF_Desktop.Views.Usuarios.RegistrarUsuarioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Usuarios"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=UpdateListaDocentesAsyncCommand }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	
	<Grid Background="Transparent">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
<!--
		<StackPanel Grid.Row="0">
			<Label Content="Solicitar usuario"
				   Style="{ StaticResource ResourceKey=Headline }"/>
			<Separator Background="{ StaticResource ResourceKey=Gray400 }"
					   Height=".8"
					   Width="Auto"/>
		</StackPanel>
		-->

		<StackPanel Grid.Row="0"
					Margin="0 0 0 5">
			<StackPanel Margin="0 0 0 0">
				<Label Content="Docente"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<ComboBox ItemsSource="{ Binding Path=Docentes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  IsEnabled="{ Binding Path=ExistenDocentesActivos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						  SelectedItem="{ Binding Path=Docente, Mode=OneWayToSource }"
						  Style="{ StaticResource ResourceKey=ComboBoxStyle }">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel>
								<TextBlock Text="{ Binding Path=NombreCompleto }"/>
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>
			<StackPanel Margin="0 0 0 0">
				<Label Content="Legajo docente"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Text="{ Binding Path=Legajo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 IsEnabled="{ Binding Path=ExistenDocentesActivos, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>
		</StackPanel>

		<StackPanel Grid.Row="1"
					Margin="0 5 0 0">
			<WrapPanel HorizontalAlignment="Right">
				<Button Command="{ Binding Path=RegistrarAsyncCommand }"
						Content="Registrarse"
						Style="{ StaticResource ResourceKey=Primary }"/>
			</WrapPanel>
		</StackPanel>
	</Grid>
</UserControl>
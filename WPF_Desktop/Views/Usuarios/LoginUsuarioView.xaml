<UserControl x:Class="WPF_Desktop.Views.Usuarios.LoginUsuarioView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Usuarios"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<!--
		Se sacó el botón "¿Olvidaste la contraseña?": estaba enlazado a RegistrarCommand, que
		no existe en LoginUsuarioViewModel —el único comando es RegistrarCommandAsync—, así
		que el enlace fallaba en silencio y el botón no hacía absolutamente nada. El caso de
		recuperar acceso está comentado en el ViewModel. Un control que no responde enseña a
		desconfiar de todos los demás.
	-->
	<StackPanel>
		<!--#region ENCABEZADO
			Las dos pantallas del acceso no tenían título: se entraba a un formulario de dos
			campos sin una línea que dijera qué hace. No llevan el componente Pagina —no hay
			ruta ni acciones de encabezado dentro de una ventana de 430px— pero sí la misma voz
			tipográfica que el resto de la aplicación.
		-->
		<StackPanel Margin="0 0 0 20">
			<TextBlock Style="{ StaticResource ResourceKey=Txt.Titulo }"
					   Text="Entrar"/>
			<TextBlock Margin="0 2 0 0"
					   Style="{ StaticResource ResourceKey=Txt.Detalle }"
					   Text="Usá el usuario y la contraseña de tu legajo."
					   TextWrapping="Wrap"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region USUARIO-->
		<StackPanel Margin="0 0 0 16">
			<Label Content="Usuario"
				   Style="{ StaticResource ResourceKey=Lbl.Campo }"
				   Target="{ Binding ElementName=CampoUsuario }"/>
			<TextBox x:Name="CampoUsuario"
					 Tag="nombre@edu.ar"
					 Text="{ Binding Path=Usuario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region CONTRASEÑA-->
		<StackPanel Margin="0 0 0 20">
			<Label Content="Contraseña"
				   Style="{ StaticResource ResourceKey=Lbl.Campo }"/>
			<components:PasswordComponent Clave="{ Binding Path=Clave, ValidatesOnNotifyDataErrors=True }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region ERROR
			El mensaje aparece pegado al formulario, no en un MessageBox: quien se equivocó de
			contraseña tiene que poder leer el motivo y corregir sin cerrar nada antes.
		-->
		<Border Margin="0 0 0 16"
				Style="{ StaticResource ResourceKey=Superficie.Error }"
				Visibility="{ Binding Path=HasErrors, Converter={ StaticResource ResourceKey=visibilidad }, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }">
			<!-- Txt.Error.Campo: el texto de error del sistema, en lugar de teñir a mano un Txt.Cuerpo. -->
			<TextBlock Margin="0"
					   Style="{ StaticResource ResourceKey=Txt.Error.Campo }"
					   Text="{ Binding Path=MensajeError, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"/>
		</Border>
		<!--#endregion-->

		<!--#region INGRESAR-->
		<Button Command="{ Binding Path=RegistrarCommandAsync }"
				CommandParameter="Login"
				Content="Ingresar"
				Height="40"
				IsDefault="True"
				Style="{ StaticResource ResourceKey=Btn.Primario }"/>
		<!--#endregion-->
	</StackPanel>
</UserControl>

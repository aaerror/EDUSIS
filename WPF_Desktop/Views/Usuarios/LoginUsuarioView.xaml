<UserControl x:Class="WPF_Desktop.Views.Usuarios.LoginUsuarioView"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Usuarios"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="booleanConverter"/>
	</UserControl.Resources>

	<Grid Background="Transparent">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- FORM -->
		<StackPanel Grid.Row="0"
					Margin="0 0 0 5">
			<!-- INPUT USUARIO -->
			<StackPanel Margin="0 0 0 5">
				<Label Content="Usuario"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<TextBox Tag="ingresar el usuario"
						 Text="{ Binding Path=Usuario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
						 Style="{ StaticResource ResourceKey=TextBox }"/>
			</StackPanel>

			<!-- INPUT CONTRASEÑA -->
			<StackPanel Margin="0 5 0 0">
				<Label Content="Contraseña"
					   Style="{ StaticResource ResourceKey=Form }"/>
				<components:PasswordComponent Clave="{ Binding Path=Clave, ValidatesOnDataErrors=True }"/>
			</StackPanel>

			<!-- BOTÓN RESTABLECER CONTRASEÑA -->
			<StackPanel Margin="0 0 0 0">
				<Button Command="{ Binding Path=RegistrarCommand, ValidatesOnExceptions=True }"
						CommandParameter="RecuperarAcceso"
						Content="¿Olvidaste la contraseña?"
						FontSize="12"
						Style="{ StaticResource ResourceKey=Tertiary }"/>
			</StackPanel>
		</StackPanel>

		<!-- MENSAJES DE ERROR -->
		<StackPanel Grid.Row="1"
					IsEnabled="{ Binding Path=HasErrors, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }">
			<StackPanel Visibility="{ Binding Path=IsEnabled, RelativeSource={ RelativeSource Mode=Self }, Converter={ StaticResource ResourceKey=booleanConverter } }">
				<TextBlock Text="{ Binding Path=MensajeError, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
						   TextWrapping="Wrap"
						   Foreground="{ StaticResource ResourceKey=Red600 }"
						   Style="{ StaticResource ResourceKey=TextBlock }"/>
			</StackPanel>
			<!-- Content="" -->
		</StackPanel>

		<!-- COMMANDs -->
		<StackPanel Grid.Row="2"
					Margin="0 10 0 0">
			<WrapPanel HorizontalAlignment="Right">
				<Button Command="{ Binding Path=RegistrarCommandAsync, ValidatesOnExceptions=True }"
						CommandParameter="Login"
						Content="Ingresar"
						IsDefault="True"
						Style="{ StaticResource ResourceKey=Primary }" />
			</WrapPanel>
		</StackPanel>
	</Grid>
</UserControl>

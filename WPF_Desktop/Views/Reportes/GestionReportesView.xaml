<UserControl x:Class="WPF_Desktop.Views.Reportes.GestionReportesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Views.Reportes"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:components="clr-namespace:WPF_Desktop.Components"
			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d">
	<UserControl.Resources>

		<!--
			Una "pieza" es cada cosa emitible: título, qué contiene y el botón. Las cinco se
			separan con la misma regla fina, así que el estilo vive acá y no repetido cinco veces.
		-->
		<Style x:Key="Pieza" TargetType="{ x:Type Border }" BasedOn="{ StaticResource ResourceKey=Superficie.Seccion }">
			<Setter Property="Margin" Value="0 0 0 16"/>
		</Style>

		<!-- Mismo peso visual para los cinco: ninguno es "el" reporte, no hay acción por omisión. -->
		<Style x:Key="Btn.Emitir" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Secundario }">
			<Setter Property="MinWidth" Value="130"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="Pieza.Titulo" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.CuerpoFuerte }">
			<Setter Property="Margin" Value="8 0 0 0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="Pieza.Detalle" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Detalle }">
			<Setter Property="Margin" Value="0 4 0 0"/>
			<Setter Property="MaxWidth" Value="620"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</UserControl.Resources>

	<!--
		ALCANCE PRIMERO, REPORTE DESPUÉS.

		Los cinco reportes comparten el mismo alcance —ciclo lectivo y, si se quiere, una
		división—, así que se fija una vez arriba y vale para todos. Sin curso y división
		elegidos el reporte abarca la institución completa, que es el caso habitual; el botón
		"Quitar filtro" está para volver a eso sin tener que adivinar cómo deseleccionar.

		La franja de alcance compone en vivo lo que va a abarcar el PDF. No es decoración: el
		request sólo lleva período y división, así que es el único lugar donde se ve que elegir
		un curso SIN división no acota nada.

		El rango de fechas vive con el reporte de asistencias porque es el único que lo usa.
	-->
	<Grid Margin="28 24 28 24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--#region EVENTS-->
		<behaviors:Interaction.Triggers>
			<behaviors:EventTrigger EventName="Loaded">
				<behaviors:InvokeCommandAction Command="{ Binding Path=CargarCommandAsync }"/>
			</behaviors:EventTrigger>
		</behaviors:Interaction.Triggers>
		<!--#endregion-->

		<!--#region ENCABEZADO-->
		<components:PaginaComponent Grid.Row="0"
									Margin="0 0 0 20"
									Titulo="Reportes"
									Subtitulo="Matrículas, asistencias, calificaciones, materias pendientes y trayectorias, en PDF"/>
		<!--#endregion-->

		<Border Grid.Row="1" Style="{ StaticResource ResourceKey=Superficie.Tarjeta }">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto">
				<Grid Margin="28 24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!--#region ALCANCE-->
					<StackPanel Grid.Row="0">
						<TextBlock Margin="0 0 0 10"
								   Style="{ StaticResource ResourceKey=Txt.Seccion }"
								   Text="ALCANCE"/>

						<StackPanel Orientation="Horizontal">
							<StackPanel Margin="0 0 20 0">
								<Label Content="Ciclo lectivo"
									   Style="{ StaticResource ResourceKey=Lbl.Campo }"
									   Target="{ Binding ElementName=CampoCiclo }"/>
								<ComboBox x:Name="CampoCiclo"
										  ItemsSource="{ Binding Path=CiclosLectivos, Mode=OneWay }"
										  SelectedItem="{ Binding Path=CicloLectivo, Mode=TwoWay }"
										  Style="{ StaticResource ResourceKey=ComboBoxStyle }"
										  ToolTip="Períodos habilitados en la base"
										  Width="110"/>
							</StackPanel>

							<StackPanel Margin="0 0 20 0">
								<Label Content="Curso (opcional)"
									   Style="{ StaticResource ResourceKey=Lbl.Campo }"
									   Target="{ Binding ElementName=CampoCurso }"/>
								<ComboBox x:Name="CampoCurso"
										  ItemsSource="{ Binding Path=Cursos, Mode=OneWay }"
										  SelectedItem="{ Binding Path=Curso, Mode=TwoWay }"
										  Style="{ StaticResource ResourceKey=ComboBoxStyle }"
										  Width="190">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock>
												<Run Text="{ Binding Path=Grado, Converter={ StaticResource ResourceKey=grado }, Mode=OneWay }"/><Run Text=" · "/><Run Text="{ Binding Path=NivelEducativo, Mode=OneWay }"/>
											</TextBlock>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>

							<StackPanel Margin="0 0 20 0">
								<Label Content="División (opcional)"
									   Style="{ StaticResource ResourceKey=Lbl.Campo }"
									   Target="{ Binding ElementName=CampoDivision }"/>
								<ComboBox x:Name="CampoDivision"
										  DisplayMemberPath="Descripcion"
										  ItemsSource="{ Binding Path=Divisiones, Mode=OneWay }"
										  SelectedItem="{ Binding Path=Division, Mode=TwoWay }"
										  Style="{ StaticResource ResourceKey=ComboBoxStyle }"
										  Width="120"/>
							</StackPanel>

							<Button Command="{ Binding Path=QuitarFiltroCommand }"
									Content="Quitar filtro"
									Style="{ StaticResource ResourceKey=Btn.Terciario }"
									ToolTip="Volver al alcance de institución completa"
									VerticalAlignment="Bottom"/>
						</StackPanel>

						<!-- La franja: lo que va a decir el encabezado del PDF, armado en vivo. -->
						<Border HorizontalAlignment="Left"
								Margin="0 16 0 0"
								Padding="12 8"
								Style="{ StaticResource ResourceKey=Insignia.Activa }">
							<StackPanel Orientation="Horizontal">
								<fa:IconBlock FontSize="13"
											  Foreground="{ StaticResource ResourceKey=Primario }"
											  Icon="FilePdf"
											  Margin="0 0 10 0"
											  VerticalAlignment="Center"/>
								<TextBlock Style="{ StaticResource ResourceKey=Txt.DatoFuerte }"
										   Text="{ Binding Path=Alcance, Mode=OneWay }"
										   VerticalAlignment="Center"/>
							</StackPanel>
						</Border>

						<TextBlock Margin="0 8 0 0"
								   MaxWidth="700"
								   HorizontalAlignment="Left"
								   Style="{ StaticResource ResourceKey=Txt.Detalle }"
								   Text="Elegí también una división para acotar: con el curso solo, el reporte sigue abarcando la institución completa."
								   TextWrapping="Wrap"
								   Visibility="{ Binding Path=CursoSinDivision, Converter={ StaticResource ResourceKey=visibilidad }, Mode=OneWay }"/>
					</StackPanel>
					<!--#endregion-->

					<Rectangle Grid.Row="1"
							   Margin="0 22"
							   Style="{ StaticResource ResourceKey=Regla }"/>

					<!--#region REPORTES-->
					<StackPanel Grid.Row="2">
						<TextBlock Margin="0 0 0 12"
								   Style="{ StaticResource ResourceKey=Txt.Seccion }"
								   Text="EMITIR"/>

						<!--#region MATRÍCULAS-->
						<Border Style="{ StaticResource ResourceKey=Pieza }">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0 0 24 0">
									<StackPanel Orientation="Horizontal">
										<fa:IconBlock FontSize="12" Icon="Users" VerticalAlignment="Center"/>
										<TextBlock Style="{ StaticResource ResourceKey=Pieza.Titulo }"
												   Text="Reporte de matrículas"/>
									</StackPanel>
									<TextBlock Style="{ StaticResource ResourceKey=Pieza.Detalle }"
											   Text="Nómina de inscriptos: nivel, curso, división, legajo, documento, fecha de inscripción y condición."/>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{ Binding Path=MatriculasCommandAsync }"
										Content="Emitir"
										Style="{ StaticResource ResourceKey=Btn.Emitir }"/>
							</Grid>
						</Border>
						<!--#endregion-->

						<!--#region CALIFICACIONES-->
						<Border Style="{ StaticResource ResourceKey=Pieza }">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0 0 24 0">
									<StackPanel Orientation="Horizontal">
										<fa:IconBlock FontSize="12" Icon="TableList" VerticalAlignment="Center"/>
										<TextBlock Style="{ StaticResource ResourceKey=Pieza.Titulo }"
												   Text="Reporte de calificaciones"/>
									</StackPanel>
									<TextBlock Style="{ StaticResource ResourceKey=Pieza.Detalle }"
											   Text="Una fila por alumno y materia, con parcial, recuperatorio y condición."/>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{ Binding Path=CalificacionesCommandAsync }"
										Content="Emitir"
										Style="{ StaticResource ResourceKey=Btn.Emitir }"/>
							</Grid>
						</Border>
						<!--#endregion-->

						<!--#region MATERIAS PENDIENTES-->
						<Border Style="{ StaticResource ResourceKey=Pieza }">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0 0 24 0">
									<StackPanel Orientation="Horizontal">
										<fa:IconBlock FontSize="12" Icon="ListUl" VerticalAlignment="Center"/>
										<TextBlock Style="{ StaticResource ResourceKey=Pieza.Titulo }"
												   Text="Reporte de materias pendientes"/>
									</StackPanel>
									<TextBlock Style="{ StaticResource ResourceKey=Pieza.Detalle }"
											   Text="Espacios curriculares sin aprobar, agrupados por alumno."/>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{ Binding Path=MateriasPendientesCommandAsync }"
										Content="Emitir"
										Style="{ StaticResource ResourceKey=Btn.Emitir }"/>
							</Grid>
						</Border>
						<!--#endregion-->

						<!--#region TRAYECTORIAS-->
						<Border Style="{ StaticResource ResourceKey=Pieza }">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0 0 24 0">
									<StackPanel Orientation="Horizontal">
										<fa:IconBlock FontSize="12" Icon="ChartLine" VerticalAlignment="Center"/>
										<TextBlock Style="{ StaticResource ResourceKey=Pieza.Titulo }"
												   Text="Reporte de trayectorias académicas"/>
									</StackPanel>
									<TextBlock Style="{ StaticResource ResourceKey=Pieza.Detalle }"
											   Text="Materias aprobadas, pendientes y avance de cada alumno."/>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{ Binding Path=TrayectoriasCommandAsync }"
										Content="Emitir"
										Style="{ StaticResource ResourceKey=Btn.Emitir }"/>
							</Grid>
						</Border>
						<!--#endregion-->

						<!--#region ASISTENCIAS
							La única pieza con rango de fechas. Va abajo y con los campos adentro
							para que no se lea como si los cinco reportes se emitieran por período.
						-->
						<Border Style="{ StaticResource ResourceKey=Pieza }">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0 0 24 0">
									<StackPanel Orientation="Horizontal">
										<fa:IconBlock FontSize="12" Icon="CalendarCheck" VerticalAlignment="Center"/>
										<TextBlock Style="{ StaticResource ResourceKey=Pieza.Titulo }"
												   Text="Reporte de asistencias"/>
									</StackPanel>
									<TextBlock Style="{ StaticResource ResourceKey=Pieza.Detalle }"
											   Text="Computa las planillas del rango: presentes, ausencias, inasistencias, tardanzas y porcentaje de asistencia. La tardanza cuenta como concurrencia."/>

									<StackPanel Margin="0 12 0 0" Orientation="Horizontal">
										<StackPanel Margin="0 0 16 0">
											<Label Content="Desde"
												   Style="{ StaticResource ResourceKey=Lbl.Campo }"
												   Target="{ Binding ElementName=CampoDesde }"/>
											<DatePicker x:Name="CampoDesde"
														CalendarStyle="{ StaticResource ResourceKey=Calendar }"
														DisplayDateEnd="{ x:Static sys:DateTime.Today }"
														SelectedDate="{ Binding Path=Desde, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
														Style="{ StaticResource ResourceKey=DatePicker }"
														Width="160"/>
										</StackPanel>

										<StackPanel>
											<Label Content="Hasta"
												   Style="{ StaticResource ResourceKey=Lbl.Campo }"
												   Target="{ Binding ElementName=CampoHasta }"/>
											<DatePicker x:Name="CampoHasta"
														CalendarStyle="{ StaticResource ResourceKey=Calendar }"
														DisplayDateEnd="{ x:Static sys:DateTime.Today }"
														SelectedDate="{ Binding Path=Hasta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
														Style="{ StaticResource ResourceKey=DatePicker }"
														Width="160"/>
										</StackPanel>
									</StackPanel>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{ Binding Path=AsistenciasCommandAsync }"
										Content="Emitir"
										Style="{ StaticResource ResourceKey=Btn.Emitir }"/>
							</Grid>
						</Border>
						<!--#endregion-->
					</StackPanel>
					<!--#endregion-->

					<!--#region ESTADO
						Una sola línea al pie: o se está generando, o se cuenta en qué terminó la
						última emisión. Los errores siguen yendo por IDialogService.
					-->
					<Grid Grid.Row="3" Margin="0 6 0 0">
						<Border HorizontalAlignment="Left"
								Style="{ StaticResource ResourceKey=Superficie.Aviso }"
								Visibility="{ Binding Path=Emitiendo, Converter={ StaticResource ResourceKey=visibilidad }, Mode=OneWay }">
							<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
									   Text="Generando el documento…"/>
						</Border>

						<Border HorizontalAlignment="Left"
								Style="{ StaticResource ResourceKey=Superficie.Aviso }"
								Visibility="{ Binding Path=Emitiendo, Converter={ StaticResource ResourceKey=visibilidadInversa }, Mode=OneWay }">
							<TextBlock MaxWidth="700"
									   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
									   Text="{ Binding Path=Mensaje }"
									   TextWrapping="Wrap"/>
						</Border>
					</Grid>
					<!--#endregion-->
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>

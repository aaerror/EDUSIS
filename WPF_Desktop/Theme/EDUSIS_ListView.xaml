<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		EL ÍNDICE — la lista es la pantalla, no un accesorio del formulario.

		Filas de 38px separadas por una regla de 1px, como un libro rayado. La selección se
		marca con una regla verde a la izquierda más un fondo tenue: el color solo no alcanza,
		y un fondo verde saturado a lo ancho de la fila tapa el texto.

		Vacío: el mensaje lo pone cada pantalla en el Tag del ListView. La plantilla anterior
		traía un ListView anidado con una columna fija llamada "Materias", así que cualquier
		lista vacía —docentes, cursos, licencias— mostraba esa columna fantasma.
	-->

	<!--#region ENCABEZADO DE COLUMNA-->
	<Style TargetType="{ x:Type GridViewColumnHeader }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type GridViewColumnHeader }">
					<Border Background="{ TemplateBinding Background }"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"
							Height="32"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="{ TemplateBinding HorizontalContentAlignment }"
										  Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region FILA-->
	<Style x:Key="Lista.Fila" TargetType="{ x:Type ListViewItem }">
		<Setter Property="FocusVisualStyle" Value="{ x:Null }"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type ListViewItem }">
					<Border x:Name="Fila"
							Background="Transparent"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"
							SnapsToDevicePixels="True">
						<Grid Height="38">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="3"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Rectangle x:Name="Marca"
									   Grid.Column="0"
									   Fill="{ StaticResource ResourceKey=Primario }"
									   Opacity="0"/>
							<GridViewRowPresenter Grid.Column="1"
												  Content="{ TemplateBinding Content }"
												  Columns="{ TemplateBinding GridView.ColumnCollection }"
												  VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=TizaAlta }"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
							<Setter TargetName="Marca" Property="Opacity" Value="1"/>
						</Trigger>
						<!-- Foco de teclado sin selección: moverse con las flechas tiene que verse. -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsKeyboardFocusWithin" Value="True"/>
								<Condition Property="IsSelected" Value="False"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=TizaBaja }"/>
							<Setter TargetName="Marca" Property="Fill" Value="{ StaticResource ResourceKey=LineaFuerte }"/>
							<Setter TargetName="Marca" Property="Opacity" Value="1"/>
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region ÍNDICE-->
	<Style x:Key="Lista.Indice" TargetType="{ x:Type ListView }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="ItemContainerStyle" Value="{ StaticResource ResourceKey=Lista.Fila }"/>
		<Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
		<Setter Property="SelectionMode" Value="Single"/>
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
		<Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type ListView }">
					<Grid>
						<ScrollViewer Focusable="False"
									  Padding="0"
									  VerticalScrollBarVisibility="Auto">
							<ItemsPresenter/>
						</ScrollViewer>
						<!--
							Estado vacío. El mensaje viene del Tag de cada ListView, así que dice qué
							hacer en esa pantalla en vez de un "No se encontraron registros" universal.
						-->
						<Border x:Name="Vacio"
								Background="{ StaticResource ResourceKey=Papel }"
								Visibility="Collapsed">
							<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
									   FontFamily="{ StaticResource ResourceKey=Fuente.Cuerpo }"
									   FontSize="13"
									   HorizontalAlignment="Center"
									   Margin="32 40"
									   Text="{ TemplateBinding Tag }"
									   TextAlignment="Center"
									   TextWrapping="Wrap"
									   VerticalAlignment="Center"/>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="HasItems" Value="False">
							<Setter TargetName="Vacio" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region COMPATIBILIDAD-->
	<Style x:Key="ListViewStyle" TargetType="{ x:Type ListView }" BasedOn="{ StaticResource ResourceKey=Lista.Indice }"/>

	<!--
		LV_ScrollViewer quedó sin uso: el ListView nuevo no reimplementa el ScrollViewer, usa
		el estándar con las barras finas de EDUSIS_Surfaces.xaml. Se conserva la clave porque
		hay vistas que la nombran.
	-->
	<Style x:Key="LV_ScrollViewer" TargetType="{ x:Type ScrollViewer }">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
	</Style>
	<!--#endregion-->
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

    <!--#region CALENDARIO — el desplegable-->
    <Style x:Key="Dtp.Calendario" TargetType="{ x:Type Calendar }">
        <Setter Property="Background" Value="{ StaticResource TizaAlta }"/>
        <Setter Property="Foreground" Value="{ StaticResource Tinta }"/>
        <Setter Property="FontFamily" Value="{ StaticResource Fuente.Cuerpo }"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{ x:Type Calendar }">
                    <Grid x:Name="PART_Root"
                          HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{ TemplateBinding Background }"
                                      BorderBrush="{ StaticResource Linea }"
                                      BorderThickness="1"
                                      Margin="0 5 0 0"
                                      Style="{ TemplateBinding CalendarItemStyle }"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region CAMPO DE FECHA-->
    <Style x:Key="Dtp.Campo" TargetType="{ x:Type DatePicker }">
        <!--
            El estilo del desplegable se declara ACÁ, no en cada vista. Las vistas venían
            repitiendo CalendarStyle="{ StaticResource Calendar }" en cada campo de fecha, y la
            que se lo olvidaba caía en el calendario por omisión de WPF, con el día elegido en
            celeste Aero.
        -->
        <Setter Property="CalendarStyle" Value="{ StaticResource Dtp.Calendario }"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ StaticResource Tinta }"/>
        <Setter Property="FontFamily" Value="{ StaticResource Fuente.Cuerpo }"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MaxHeight" Value="34"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
        <!--
            Short, no Long: "martes, 17 de octubre de 2026" no entra en un campo de 34px y se
            cortaba con puntos suspensivos, que es la peor forma de mostrar una fecha.
        -->
        <Setter Property="SelectedDateFormat" Value="Short"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- CONTROL_TEMPLATE -->
                <ControlTemplate TargetType="{ x:Type DatePicker }">
                    <Border x:Name="Border"
                            Background="{ StaticResource Papel }"
                            BorderBrush="{ StaticResource LineaFuerte }"
                            BorderThickness="1"
                            CornerRadius="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="4 0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_DisabledVisual"
                                                         Storyboard.TargetProperty="Opacity"
                                                         Duration="0"
                                                         To="1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- PART_Root -->
                        <Grid x:Name="PART_Root"
                              HorizontalAlignment="{ TemplateBinding HorizontalAlignment }"
                              VerticalAlignment="{ TemplateBinding VerticalAlignment }">
                            <Grid.Resources>
                                <!--
                                    BOTÓN DEL CALENDARIO.

                                    Lo que había acá eran las ~180 líneas del Aero original de
                                    WPF: un degradé celeste sobre #FF1F3B53, el realce #FF45D6FA
                                    y el azul #FF448DCA al apuntarlo. Era el último resto de
                                    Aero en la app, y estaba adentro de cada campo de fecha.

                                    El glifo se dibuja con rectángulos —cuerpo, dos anillas y el
                                    renglón del encabezado— en vez de una fuente de iconos, por
                                    lo mismo que el tilde de la casilla: no depende de que
                                    FontAwesome esté cargado.
                                -->
                                <ControlTemplate x:Key="DropDownButtonTemplate" TargetType="{ x:Type Button }">
                                    <Border x:Name="Area"
                                            Background="Transparent"
                                            CornerRadius="3"
                                            Height="26"
                                            SnapsToDevicePixels="True"
                                            Width="26">
                                        <Grid Height="15"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="15">
                                            <Rectangle x:Name="Cuerpo"
                                                       Margin="0 2 0 0"
                                                       RadiusX="2"
                                                       RadiusY="2"
                                                       Stroke="{ StaticResource TintaSuave }"
                                                       StrokeThickness="1.3"/>
                                            <Rectangle x:Name="Renglon"
                                                       Fill="{ StaticResource TintaSuave }"
                                                       Height="1.3"
                                                       Margin="2 6 2 0"
                                                       VerticalAlignment="Top"/>
                                            <Rectangle x:Name="AnillaIzquierda"
                                                       Fill="{ StaticResource TintaSuave }"
                                                       Height="4"
                                                       HorizontalAlignment="Left"
                                                       Margin="3 0 0 0"
                                                       VerticalAlignment="Top"
                                                       Width="1.3"/>
                                            <Rectangle x:Name="AnillaDerecha"
                                                       Fill="{ StaticResource TintaSuave }"
                                                       Height="4"
                                                       HorizontalAlignment="Right"
                                                       Margin="0 0 3 0"
                                                       VerticalAlignment="Top"
                                                       Width="1.3"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Area" Property="Background" Value="{ StaticResource PrimarioSuave }"/>
                                            <Setter TargetName="AnillaDerecha" Property="Fill" Value="{ StaticResource Primario }"/>
                                            <Setter TargetName="AnillaIzquierda" Property="Fill" Value="{ StaticResource Primario }"/>
                                            <Setter TargetName="Cuerpo" Property="Stroke" Value="{ StaticResource Primario }"/>
                                            <Setter TargetName="Renglon" Property="Fill" Value="{ StaticResource Primario }"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- TEXTBOX -->
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Grid.Row="0"
                                               Background="Transparent"
                                               BorderBrush="Transparent"
                                               BorderThickness="0"
                                               Focusable="{ TemplateBinding Focusable }"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center"/>
                            <!-- CALENDARIO ICON-->
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Foreground="{ TemplateBinding Foreground }"
                                    Template="{ StaticResource DropDownButtonTemplate }"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="5 0 5 0"
                                    Width="20"/>
                            <!-- CALENDARIO -->
                            <Grid x:Name="PART_DisabledVisual"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Grid.Row="0"
                                  IsHitTestVisible="False"
                                  Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!--
                                    El velo de deshabilitado era blanco al 65% SOBRE un campo
                                    blanco: no se veía, así que un DatePicker deshabilitado
                                    quedaba idéntico a uno activo. Ahora el estado lo marca el
                                    disparador IsEnabled de más abajo, con el mismo fondo Tiza
                                    que usan Txb.Campo y Cmb.Campo. Los rectángulos quedan
                                    transparentes porque PART_Popup vive adentro de este Grid y
                                    el DatePicker lo busca por nombre.
                                -->
                                <Rectangle Grid.Column="0"
                                           Grid.Row="0"
                                           Fill="Transparent"/>
                                <Rectangle Grid.Column="1"
                                           Grid.Row="0"
                                           Fill="Transparent"
                                           Height="18"
                                           Margin="3 0 3 0"
                                           Width="19"/>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       HorizontalOffset="-158"
                                       Placement="Bottom"
                                       PlacementTarget="{ Binding ElementName=PART_Button }"
                                       PopupAnimation="Scroll"
                                       StaysOpen="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!--
                        MISMO ORDEN Y MISMOS ESTADOS QUE Txb.Campo, porque el campo de fecha se
                        lee en la misma columna que los de texto. Apuntar iba DESPUÉS de
                        enfocar, así que pasar el mouse por encima del campo enfocado le borraba
                        el borde verde; el foco además sólo engrosaba el borde de abajo. Ahora el
                        borde entero pasa a 2px, que es lo que hace el campo de texto.
                    -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource TintaTenue }"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource Primario }"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{ StaticResource Tiza }"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource Linea }"/>
                            <Setter Property="Foreground" Value="{ StaticResource TintaSuave }"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource Alerta }"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            <Setter Property="ToolTip" Value="{ Binding RelativeSource={ RelativeSource Self }, Path=(Validation.Errors)[0].ErrorContent }"/>
                        </Trigger>
                        <DataTrigger Binding="{ Binding Source={ x:Static SystemParameters.HighContrast } }" Value="false">
                            <Setter Property="Foreground" TargetName="PART_TextBox" Value="{ Binding Foreground, RelativeSource={ RelativeSource Mode=TemplatedParent } }"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--
        DÍAS DEL CALENDARIO.

        Sin estos dos estilos, el desplegable cae en la plantilla por omisión de WPF, donde el
        día elegido se pinta del celeste Aero #BADDE9: el único azul que quedaba en la app
        aparecía justo al elegir una fecha. Se redefinen con disparadores sobre las
        propiedades de CalendarDayButton en vez de estados visuales, que es lo que permite
        mantener el estilo corto.

        "Hoy" se marca con BORDE, no con relleno, para que no compita con el día elegido: dos
        rellenos verdes en la misma grilla son dos selecciones.
    -->
    <Style TargetType="{ x:Type CalendarDayButton }">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{ StaticResource Fuente.Dato }"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ StaticResource Tinta }"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{ x:Type CalendarDayButton }">
                    <Border x:Name="Fondo"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{ StaticResource TintaTenue }"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{ StaticResource PrimarioBorde }"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{ StaticResource TizaBaja }"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{ StaticResource Primario }"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{ StaticResource TintaTenue }"/>
                            <Setter Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Meses y años, al desplegar el encabezado del calendario. -->
    <Style TargetType="{ x:Type CalendarButton }">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{ StaticResource Fuente.Cuerpo }"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ StaticResource Tinta }"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{ x:Type CalendarButton }">
                    <Border x:Name="Fondo"
                            Background="Transparent"
                            CornerRadius="3"
                            Padding="8 6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{ StaticResource TizaBaja }"/>
                        </Trigger>
                        <!-- CalendarButton no tiene IsSelected: el mes o año con días elegidos es HasSelectedDays. -->
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{ StaticResource Primario }"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{ StaticResource TintaTenue }"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region COMPATIBILIDAD-->
    <Style x:Key="DatePicker" TargetType="{ x:Type DatePicker }" BasedOn="{ StaticResource Dtp.Campo }"/>
    <Style x:Key="Calendar" TargetType="{ x:Type Calendar }" BasedOn="{ StaticResource Dtp.Calendario }"/>
    <!--#endregion-->
</ResourceDictionary>
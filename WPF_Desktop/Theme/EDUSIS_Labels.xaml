<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		Capa de compatibilidad: los nombres viejos de la escala de Label, apuntando al sistema
		de EDUSIS_Typography.xaml. Se mantienen porque las vistas todavía no reescritas los
		referencian; así adoptan la tipografía nueva sin tocarlas una por una.

		En código nuevo usar Lbl.* directamente. La escala vieja tenía ocho niveles con saltos
		de 42/34/28/22/20/16/14/12: demasiados escalones para distinguirse entre sí. Varios
		colapsan acá al mismo destino, que es lo que corresponde.
	-->
	<Style x:Key="Display" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Display }"/>
	<Style x:Key="Header" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Display }"/>
	<Style x:Key="Title" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Titulo }"/>
	<Style x:Key="Subtitle" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Subtitulo }"/>
	<Style x:Key="Headline" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Subtitulo }"/>
	<Style x:Key="Form" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Campo }"/>
	<Style x:Key="Body" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Cuerpo }"/>
	<Style x:Key="Caption" TargetType="{ x:Type Label }" BasedOn="{ StaticResource ResourceKey=Lbl.Detalle }"/>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		BOTONES — una sola acción primaria por pantalla.

		La jerarquía anterior estaba invertida: "Registrar" (crear un docente, la acción
		principal de la pantalla) era Secondary blanco, mientras tres navegaciones laterales
		eran Primary verde cada una. Tres primarios al lado no son tres primarios: no son
		ninguno.

		Radio 3px en todo: el registro es de reglas rectas, no de píldoras. Alturas 34/28 para
		una app que se usa ocho horas por día — 36px de alto con 16px de texto desperdicia una
		fila cada tres.
	-->

	<!--#region FOCO DE TECLADO
		El FocusVisualStyle por omisión de WPF es un rectángulo punteado de 1px que sobre
		fondos de color directamente no se ve. Acá se reemplaza por un anillo sólido afuera
		del control. Dos variantes: Pizarra para superficies claras (y también sobre el verde
		primario, porque es mucho más oscuro), blanco para el rail.
	-->
	<Style x:Key="Foco.Visual">
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate>
					<Rectangle Margin="-3"
							   RadiusX="5"
							   RadiusY="5"
							   SnapsToDevicePixels="True"
							   Stroke="{ StaticResource ResourceKey=Pizarra }"
							   StrokeThickness="2"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Foco.Visual.Claro">
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate>
					<Rectangle Margin="-2"
							   RadiusX="4"
							   RadiusY="4"
							   SnapsToDevicePixels="True"
							   Stroke="#FFFFFF"
							   StrokeThickness="2"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--
		EL TOOLTIP SE VE TAMBIÉN CUANDO EL BOTÓN ESTÁ APAGADO.

		ToolTipService.ShowOnDisabled vale False por omisión en WPF, así que un control
		deshabilitado se traga su propio ToolTip. La aplicación tiene unos ciento sesenta ToolTip
		repartidos en veintisiete vistas, casi todos en botones que se apagan por CanExecute: o
		sea que el texto que explica una acción desaparecía exactamente cuando hacía falta, que es
		cuando el botón está gris y no se sabe por qué.

		El caso más visible era el rail: MainWindow documenta que una sección sin permiso "queda
		visible pero apagada, con el motivo en el ToolTip", y docs/ui.md lo declara decisión
		deliberada. No funcionaba en ninguna de las siete entradas.

		Va en los estilos base; Btn.Peligro y Btn.Terciario.Claro lo heredan por BasedOn. Los dos
		de ventana quedan afuera a propósito: minimizar, maximizar y cerrar nunca se apagan.
	-->

	<!--#region PRIMARIO — la acción de la pantalla-->
	<Style x:Key="Btn.Primario" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="MinWidth" Value="88"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ StaticResource ResourceKey=Primario }"
							CornerRadius="3"
							Padding="16 0"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PrimarioHover }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PrimarioPress }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=TizaBaja }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region SECUNDARIO — acciones de igual peso entre sí-->
	<Style x:Key="Btn.Secundario" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="MinWidth" Value="88"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ StaticResource ResourceKey=Papel }"
							BorderBrush="{ StaticResource ResourceKey=LineaFuerte }"
							BorderThickness="1"
							CornerRadius="3"
							Padding="16 0"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=TizaAlta }"/>
							<Setter TargetName="Fondo" Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=Tiza }"/>
							<Setter TargetName="Fondo" Property="BorderBrush" Value="{ StaticResource ResourceKey=Linea }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region TERCIARIO — acción liviana, sin caja hasta que se la toca-->
	<Style x:Key="Btn.Terciario" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="MinWidth" Value="64"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<!--
						El Background va por TemplateBinding a propósito: hay vistas que todavía
						pintan este estilo con un pincel local para improvisar un botón destructivo.
						Lo correcto es Btn.Peligro, pero mientras tanto no se rompen.
					-->
					<Border x:Name="Fondo"
							Background="{ TemplateBinding Background }"
							CornerRadius="3"
							Padding="12 0"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=TizaBaja }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=PrimarioPress }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--
		Variante del terciario para el campo Pizarra. No alcanza con cambiar el Foreground
		inicial: el disparador de IsMouseOver del terciario lo lleva a Tinta, que sobre verde
		oscuro es invisible. Los estados hay que redefinirlos, no sólo el reposo.
	-->
	<Style x:Key="Btn.Terciario.Claro" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Terciario }">
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual.Claro }"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarraMedia }"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ TemplateBinding Background }"
							CornerRadius="3"
							Padding="12 0"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PizarraAlta }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarra }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PizarraBaja }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarraTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--#region PELIGRO — borrar, quitar, revocar-->
	<Style x:Key="Btn.Peligro" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Secundario }">
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Alerta }"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ StaticResource ResourceKey=Papel }"
							BorderBrush="{ StaticResource ResourceKey=Alerta }"
							BorderThickness="1"
							CornerRadius="3"
							Padding="16 0"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=Alerta }"/>
							<Setter Property="Foreground" Value="#FFFFFF"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=AlertaHover }"/>
							<Setter Property="Foreground" Value="#FFFFFF"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=Tiza }"/>
							<Setter TargetName="Fondo" Property="BorderBrush" Value="{ StaticResource ResourceKey=Linea }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region PESTAÑA
		El subrayado se pinta con BorderBrush, de modo que la vista pueda marcar la pestaña
		activa con un DataTrigger contra el estado del ViewModel sin redefinir la plantilla.
	-->
	<Style x:Key="Btn.Pestana" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="Height" Value="38"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Grid Background="Transparent">
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="2"/>
						</Grid.RowDefinitions>
						<ContentPresenter Grid.Row="0"
										  HorizontalAlignment="Center"
										  Margin="14 0"
										  VerticalAlignment="Center"/>
						<Rectangle Grid.Row="1"
								   Fill="{ TemplateBinding BorderBrush }"
								   SnapsToDevicePixels="True"/>
					</Grid>
					<ControlTemplate.Triggers>
						<!--
							PESTAÑA ABIERTA. La vista enlaza Tag contra el estado del ViewModel
							con el converter esIgualA; acá sólo se lee el booleano que sale de
							ahí. Es el mismo mecanismo con el que Btn.Menu marca la sección del
							rail: dos conmutadores de la aplicación contestando "dónde estoy" con
							el mismo recurso, en lugar de un estilo repetido por pestaña.

							Va PRIMERO para que el hover y el clic se sigan viendo sobre la
							pestaña abierta: el subrayado es suyo y nadie más lo escribe.
						-->
						<DataTrigger Binding="{ Binding Path=Tag, RelativeSource={ RelativeSource Self } }" Value="True">
							<Setter Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
						</DataTrigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
						</Trigger>
						<!--
							Faltaban los dos estados de abajo: la pestaña se aclaraba al apuntarla
							y después no acusaba el clic ni se apagaba cuando el paso estaba
							cerrado. Una pestaña deshabilitada con el mismo color que una
							disponible invita a un clic que no hace nada.
						-->
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=PrimarioPress }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Cursor" Value="Arrow"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region MIGA — un tramo de la ruta, en el encabezado de cada pantalla
		Es un enlace, no un botón: sin caja, sin alto fijo y subrayado al apuntarlo, porque lo
		que hace es ir a otro lugar y no ejecutar algo sobre esta pantalla. Va en condensada
		mayúscula, la misma voz que los rótulos de sección (Txt.Seccion), así que la ruta se lee
		como una etiqueta de ubicación y no compite con el título que tiene debajo.
	-->
	<Style x:Key="Btn.Miga" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Grid Background="Transparent">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="1"/>
						</Grid.RowDefinitions>
						<ContentPresenter Grid.Row="0" VerticalAlignment="Center"/>
						<Rectangle x:Name="Subrayado"
								   Grid.Row="1"
								   Fill="{ StaticResource ResourceKey=Primario }"
								   SnapsToDevicePixels="True"
								   Visibility="Hidden"/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Primario }"/>
							<Setter TargetName="Subrayado" Property="Visibility" Value="Visible"/>
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Primario }"/>
							<Setter TargetName="Subrayado" Property="Visibility" Value="Visible"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=PrimarioPress }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Cursor" Value="Arrow"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region ICONO — cuadrado, sin texto. Siempre con ToolTip.-->
	<Style x:Key="Btn.Icono" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="Width" Value="32"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ TemplateBinding Background }"
							CornerRadius="3"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=TizaBaja }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=PrimarioPress }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
							<Setter TargetName="Fondo" Property="Background" Value="Transparent"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region MENÚ DEL RAIL
		Sobre el campo Pizarra. La entrada activa o apuntada se marca con una REGLA VERDE a la
		izquierda, no con un fondo: el rail queda tranquilo y la marca se lee de un vistazo.
		(El estilo anterior tenía hover violeta #8214B2 sobre el verde institucional.)

		Deshabilitado = sin permiso para esa sección. Se mantiene legible, no se apaga del
		todo: una entrada invisible no enseña que la sección existe.
	-->
	<Style x:Key="Btn.Menu" TargetType="{ x:Type Button }">
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual.Claro }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarraMedia }"/>
		<Setter Property="Height" Value="42"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Grid Background="{ TemplateBinding Background }">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<Rectangle x:Name="Marca"
								   Grid.Column="0"
								   Fill="{ StaticResource ResourceKey=Primario }"
								   Opacity="0"/>
						<ContentPresenter Grid.Column="1"
										  HorizontalAlignment="Left"
										  Margin="17 0 12 0"
										  VerticalAlignment="Center"/>
						<!--
							CANDADO. Una entrada apagada no se distingue de una rota ni de una
							que todavía está cargando: las tres se ven grises. El candado dice
							cuál de las tres es.

							Va en la plantilla y no como un ToolTip con el motivo porque es el
							único lugar donde puede ir: en la precedencia de WPF, un Setter de
							estilo —aunque esté adentro de un Trigger— pierde contra el valor
							local, y las siete entradas del rail escriben su propio ToolTip. Lo
							que el estilo sí puede hacer es dibujar.

							Segoe MDL2 Assets es la fuente que ya usan los botones de ventana de
							esta misma aplicación: no entra una dependencia nueva.
						-->
						<TextBlock x:Name="Candado"
								   Grid.Column="2"
								   FontFamily="Segoe MDL2 Assets"
								   FontSize="10"
								   Foreground="{ StaticResource ResourceKey=SobrePizarraTenue }"
								   Margin="0 0 18 0"
								   Opacity="0"
								   Text="&#xE72E;"
								   VerticalAlignment="Center"/>
					</Grid>
					<ControlTemplate.Triggers>
						<!--
							SECCIÓN ABIERTA. La vista enlaza Tag contra SeccionActual con el
							converter esIgualA; acá sólo se lee el booleano que sale de ahí.

							Hasta acá el rail no tenía estado seleccionado: la regla verde se
							encendía sólo con IsMouseOver, así que la marca decía dónde estaba el
							MOUSE y no dónde estaba parado el usuario. El único "dónde estoy" era
							un texto de 12px en la barra de título.

							La abierta se marca con la regla y el texto en blanco, SIN fondo; el
							hover agrega el fondo PizarraAlta. Así los dos estados no se
							confunden: uno es un baño de fondo, el otro es una regla al margen.
						-->
						<DataTrigger Binding="{ Binding Path=Tag, RelativeSource={ RelativeSource Self } }" Value="True">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarra }"/>
							<Setter TargetName="Marca" Property="Opacity" Value="1"/>
						</DataTrigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{ StaticResource ResourceKey=PizarraAlta }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarra }"/>
							<Setter TargetName="Marca" Property="Opacity" Value="1"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" Value="{ StaticResource ResourceKey=PizarraBaja }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Cursor" Value="No"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=SobrePizarraTenue }"/>
							<Setter TargetName="Candado" Property="Opacity" Value="1"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region BOTONES DE VENTANA — minimizar / maximizar / cerrar-->
	<Style x:Key="Btn.Ventana" TargetType="{ x:Type Button }">
		<Setter Property="Background" Value="Transparent"/>
		<!--
			Antes: FocusVisualStyle="{x:Null}". La barra de título quedaba fuera del alcance del
			teclado en la práctica —se la podía tabular, pero sin ninguna señal de dónde estaba
			el foco—, así que cerrar la aplicación sin mouse era adivinar. El anillo acá va por
			dentro (Foco.Visual sobresale 3px y estos botones pegan al borde de la ventana), con
			lo cual se dibuja en la plantilla y no con FocusVisualStyle.
		-->
		<Setter Property="FocusVisualStyle" Value="{ x:Null }"/>
		<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="Height" Value="38"/>
		<Setter Property="Width" Value="46"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ TemplateBinding Background }"
							BorderBrush="Transparent"
							BorderThickness="2"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=TizaBaja }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Fondo" Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=LineaFuerte }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Btn.Ventana.Cerrar" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Ventana }">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border x:Name="Fondo"
							Background="{ TemplateBinding Background }"
							BorderBrush="Transparent"
							BorderThickness="2"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=Alerta }"/>
							<Setter Property="Foreground" Value="#FFFFFF"/>
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Fondo" Property="BorderBrush" Value="{ StaticResource ResourceKey=Alerta }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=AlertaHover }"/>
							<Setter Property="Foreground" Value="#FFFFFF"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region COMPATIBILIDAD
		Nombres viejos del tema, usados por las vistas todavía no reescritas.
	-->
	<Style x:Key="Primary" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Primario }"/>
	<Style x:Key="Secondary" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Secundario }"/>
	<Style x:Key="Tertiary" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Terciario }"/>
	<Style x:Key="Icon" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Icono }"/>
	<Style x:Key="MenuButton" TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Menu }"/>
	<!--#endregion-->
</ResourceDictionary>

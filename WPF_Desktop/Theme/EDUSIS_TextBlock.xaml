<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		Capa de compatibilidad de la escala de TextBlock, apuntando a EDUSIS_Typography.xaml.
		En código nuevo usar Txt.* directamente.

		La clave "TextBlock" a secas existe porque LoginUsuarioView la pedía y no estaba
		definida en ningún lado: el acceso reventaba al construirse con "Se produjo una
		excepción al proporcionar un valor en StaticResourceExtension". Un StaticResource
		inexistente no es error de compilación —el BAML no valida claves—, así que el fallo
		aparecía recién al instanciar la vista.
	-->
	<Style x:Key="TextBlock" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Cuerpo }"/>

	<Style x:Key="TextBlock_Display" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Display }"/>
	<Style x:Key="TextBlock_Header" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Display }"/>
	<Style x:Key="TextBlock_Title" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Titulo }"/>
	<Style x:Key="TextBlock_Subtitle" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Subtitulo }"/>
	<Style x:Key="TextBlock_Headline" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Subtitulo }"/>
	<Style x:Key="TextBlock_Form" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Detalle }"/>
	<Style x:Key="TextBlock_Body" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Cuerpo }"/>
	<Style x:Key="TextBlock_Caption" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Detalle }"/>
</ResourceDictionary>

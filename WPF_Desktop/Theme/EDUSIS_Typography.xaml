<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		TIPOGRAFÍA "REGISTRO" — tres voces, un trabajo cada una.

		DISPLAY   Bahnschrift SemiCondensed. Es el DIN que viene con Windows: señalética,
		          formularios, registro institucional. Expone pesos REALES (Light/Regular/
		          SemiBold/Bold) en tres anchos, así que no hay negritas sintéticas.
		CUERPO    Segoe UI. La cara nativa del escritorio, la más legible a 13px.
		DATO      Consolas. Legajos, DNI, fechas y notas son números que se comparan en
		          columna: van tabulares. Es la única razón por la que hay una monoespaciada
		          acá, y por eso no se usa para texto corrido.

		WPF no tiene letter-spacing. El aire de los rótulos de sección se consigue con el
		ancho condensado y la mayúscula, no con tracking.
	-->
	<FontFamily x:Key="Fuente.Display">Bahnschrift, Segoe UI</FontFamily>
	<FontFamily x:Key="Fuente.Cuerpo">Segoe UI</FontFamily>
	<FontFamily x:Key="Fuente.Dato">Consolas, Courier New</FontFamily>

	<!--#region ESCALA — TextBlock-->
	<Style x:Key="Txt.Display" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="32"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
	</Style>

	<Style x:Key="Txt.Titulo" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="22"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
	</Style>

	<Style x:Key="Txt.Subtitulo" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="17"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
	</Style>

	<!-- Rótulo de sección: mayúscula, condensado, chico. Ordena sin ocupar lugar. -->
	<Style x:Key="Txt.Seccion" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
	</Style>

	<Style x:Key="Txt.Cuerpo" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
	</Style>

	<Style x:Key="Txt.CuerpoFuerte" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Cuerpo }">
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<Style x:Key="Txt.Detalle" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
	</Style>

	<!-- Identificador: el overline mono verde de la ficha. -->
	<Style x:Key="Txt.Identificador" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Dato }"/>
		<Setter Property="FontSize" Value="12.5"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Primario }"/>
	</Style>

	<Style x:Key="Txt.Dato" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Dato }"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
	</Style>

	<Style x:Key="Txt.DatoFuerte" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Txt.Dato }">
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
	</Style>
	<!--#endregion-->

	<!--#region ESCALA — Label
		Mismos tamaños que los TextBlock. Label mete 5px de padding por omisión y rompe toda
		alineación con el vecino: se anula acá una vez y no en cada vista.
	-->
	<Style x:Key="Lbl.Display" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="32"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="Lbl.Titulo" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="22"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="Lbl.Subtitulo" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="SemiCondensed"/>
		<Setter Property="FontSize" Value="17"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="Lbl.Seccion" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="Lbl.Cuerpo" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="Lbl.Detalle" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<!-- Etiqueta de campo de formulario. -->
	<Style x:Key="Lbl.Campo" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="Padding" Value="0 0 0 4"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
	</Style>

	<Style x:Key="Lbl.Dato" TargetType="{ x:Type Label }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Dato }"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<!--#endregion-->
</ResourceDictionary>

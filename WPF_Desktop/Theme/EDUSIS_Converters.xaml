<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:conv="clr-namespace:WPF_Desktop.Shared.Converters">
	<!--
		Conversores compartidos. Hasta ahora cada vista declaraba su propio
		BooleanToVisibilityConverter en UserControl.Resources —cincuenta y nueve veces, con
		tres nombres distintos para el mismo objeto: booleanConverter,
		booleanToVisibilityConverter y Converter—. Son instancias sin estado: alcanza con una.
	-->
	<BooleanToVisibilityConverter x:Key="visibilidad"/>
	<conv:BooleanToVisibilityInverseConverter x:Key="visibilidadInversa"/>
	<conv:InvertBooleanConverter x:Key="negar"/>
	<conv:NullToBooleanConverter x:Key="noEsNulo"/>
	<conv:NullToVisibilityConverter x:Key="visibleSiHay"/>
	<conv:TextoAVisibilidadConverter x:Key="visibleSiHayTexto"/>
	<conv:IgualdadConverter x:Key="esIgualA"/>

	<!--
		El grado también: tres vistas lo formateaban con StringFormat={}{0}° Año sobre el NOMBRE
		del miembro del enum, que es "Primero", así que en pantalla decía "Primero° Año". Acá
		arriba para que ninguna vuelva a armar ese texto a mano.
	-->
	<conv:GradoConverter x:Key="grado"/>
</ResourceDictionary>

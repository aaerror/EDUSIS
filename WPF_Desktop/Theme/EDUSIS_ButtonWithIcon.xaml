<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
	<!--#region EDIT-->
	<Style x:Key="Edit" TargetType="{ x:Type TypeName=Button }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Neutral800 }"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type TypeName=Button }">
					<!--#region BORDER-->
					<Border x:Name="Border"
							Background="White"
							BorderBrush="Transparent"
							BorderThickness="1"
							CornerRadius="8"
							Padding="4"
							SnapsToDevicePixels="True">
						<StackPanel HorizontalAlignment="Center"
									Margin="4"
									VerticalAlignment="Center">
							<!--#region ICON-->
							<fa:IconBlock x:Name="Icon"
										  Icon="PenToSquare"
										  Foreground="{ TemplateBinding Property=Foreground }"/>
							<!--#endregion-->
						</StackPanel>
					</Border>
					<!--#endregion-->
					<!--#region TRIGGER-->
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Border" Property="Background" Value="{ StaticResource ResourceKey=Neutral100 }"/>
							<Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource ResourceKey=Neutral200 }"/>
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Neutral400 }"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Border" Property="Background" Value="{ StaticResource ResourceKey=Gray100 }"/>
							<Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource ResourceKey=Gray400 }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Border" Property="Background" Value="{ StaticResource ResourceKey=Gray200 }"/>
							<Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource ResourceKey=Gray500 }"/>
							<!-- Animation 
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" To=".8" Duration="0:0:0"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
							-->
						</Trigger>
					</ControlTemplate.Triggers>
					<!--#endregion-->
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region DELETE-->
	<Style x:Key="Delete" TargetType="{ x:Type TypeName=Button }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type TypeName=Button }">
					<!--#region BORDER-->
					<Border x:Name="Border"
							Background="{ StaticResource ResourceKey=Red500 }"
							BorderBrush="Transparent"
							BorderThickness="1"
							CornerRadius="8"
							Padding="4"
							SnapsToDevicePixels="True">
						<StackPanel HorizontalAlignment="Center"
									Margin="4"
									VerticalAlignment="Center">
							<!--#region ICON-->
							<fa:IconBlock x:Name="Icon"
										  Icon="Trash"
										  Foreground="{ TemplateBinding Property=Foreground }"/>
							<!--#endregion-->
						</StackPanel>
					</Border>
					<!--#endregion-->
					<!--#region TRIGGER-->
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Neutral400 }"/>
							<Setter TargetName="Border" Property="Background" Value="{ StaticResource ResourceKey=Neutral100 }"/>
							<Setter TargetName="Border" Property="BorderBrush" Value="{ StaticResource ResourceKey=Neutral200 }"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="#FFFFFF"/>
							<Setter TargetName="Border" Property="Background" Value="{ StaticResource ResourceKey=Red500 }"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Foreground" Value="#FFFFFF"/>
							<Setter TargetName="Border" Property="Background" Value="{ StaticResource ResourceKey=Red700 }"/>
							<!-- Animation 
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" To=".8" Duration="0:0:0"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
							-->
						</Trigger>
					</ControlTemplate.Triggers>
					<!--#endregion-->
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->
	<!-- ASIGNAR ALUMNO A CURSO-->
	<Style x:Key="AsignarCurso" TargetType="{ x:Type Button }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="Height" Value="44"/>
		<Setter Property="Padding" Value="5"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<!-- BORDER -->
					<Border x:Name="ButtonBorder"
							Background="#9b1197"
							BorderBrush="Transparent"
							BorderThickness="1"
							CornerRadius="12"
							Padding="16 0">
						<Grid HorizontalAlignment="Center"
							  VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="25"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- ICON -->
							<fa:IconBlock Grid.Column="0"
										  Foreground="{ TemplateBinding Foreground }"
										  Icon="Chalkboard"
										  Margin="0 0 2 0"/>

							<!-- CONTENT -->
							<ContentPresenter Grid.Column="1"
											  Content="{ TemplateBinding Content }"
											  HorizontalAlignment="Center"
											  Margin="2 0 0 0"
											  VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<!-- TRIGGER -->
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="#FFFFFF"/>
							<Setter TargetName="ButtonBorder" Property="Background" Value="#8214B2"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Foreground" Value="#FFFFFF"/>
							<Setter TargetName="ButtonBorder" Property="Background" Value="#72119C"/>
							<!-- Animation 
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" To=".8" Duration="0:0:0"/>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
				-->
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
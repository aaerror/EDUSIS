<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_ButtonStyle.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		SELECTOR — mismo lenguaje visual que el campo de texto.

		Reemplaza la plantilla Aero de Windows 7 que venía pegada tal cual: degradados
		verticales, borde #ACACAC y azul #7EB4EA al apuntar. En una app cuyo color
		institucional es verde, el estado "apuntado" de todos los selectores era azul.

		Agrega algo que no existía: un TEXTO GUÍA cuando no hay nada elegido. Un selector en
		blanco no dice si está vacío porque no se eligió o porque no hay opciones. El texto
		sale del Tag, igual que en el TextBox.
	-->

	<!--#region ÍTEM-->
	<Style x:Key="Cmb.Item" TargetType="{ x:Type ComboBoxItem }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type ComboBoxItem }">
					<Border x:Name="Fondo"
							Background="Transparent"
							Height="32"
							SnapsToDevicePixels="True">
						<ContentPresenter Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=TizaAlta }"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Fondo" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region BOTÓN DE DESPLIEGUE
		Cubre todo el control y es el que dibuja la caja: así el clic en cualquier parte
		abre la lista, no sólo en la flechita de 16px.
	-->
	<Style x:Key="ComboBoxToggleButton" TargetType="{ x:Type ToggleButton }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="ClickMode" Value="Press"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type ToggleButton }">
					<Border x:Name="Caja"
							Background="{ StaticResource ResourceKey=Papel }"
							BorderBrush="{ StaticResource ResourceKey=LineaFuerte }"
							BorderThickness="1"
							CornerRadius="3"
							SnapsToDevicePixels="True">
						<Path x:Name="Flecha"
							  Data="M 0 0 L 4.5 5 L 9 0"
							  HorizontalAlignment="Right"
							  Margin="0 0 12 0"
							  Stroke="{ StaticResource ResourceKey=TintaSuave }"
							  StrokeThickness="1.6"
							  StrokeEndLineCap="Round"
							  StrokeStartLineCap="Round"
							  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Caja" Property="BorderBrush" Value="{ StaticResource ResourceKey=TintaTenue }"/>
							<Setter TargetName="Flecha" Property="Stroke" Value="{ StaticResource ResourceKey=Tinta }"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Caja" Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
							<Setter TargetName="Flecha" Property="Stroke" Value="{ StaticResource ResourceKey=Primario }"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Caja" Property="Background" Value="{ StaticResource ResourceKey=Tiza }"/>
							<Setter TargetName="Caja" Property="BorderBrush" Value="{ StaticResource ResourceKey=Linea }"/>
							<Setter TargetName="Flecha" Property="Stroke" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region SELECTOR-->
	<Style x:Key="Cmb.Campo" TargetType="{ x:Type ComboBox }">
		<Setter Property="FocusVisualStyle" Value="{ StaticResource ResourceKey=Foco.Visual }"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="ItemContainerStyle" Value="{ StaticResource ResourceKey=Cmb.Item }"/>
		<Setter Property="MinWidth" Value="120"/>
		<Setter Property="Padding" Value="12 0 32 0"/>
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type ComboBox }">
					<Grid>
						<ToggleButton x:Name="Desplegar"
									  IsChecked="{ Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={ RelativeSource TemplatedParent } }"
									  Style="{ StaticResource ResourceKey=ComboBoxToggleButton }"/>

						<ContentPresenter x:Name="Seleccion"
										  Content="{ TemplateBinding SelectionBoxItem }"
										  ContentTemplate="{ TemplateBinding SelectionBoxItemTemplate }"
										  ContentStringFormat="{ TemplateBinding SelectionBoxItemStringFormat }"
										  HorizontalAlignment="Left"
										  IsHitTestVisible="False"
										  Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>

						<TextBlock x:Name="Guia"
								   Foreground="{ StaticResource ResourceKey=TintaTenue }"
								   FontStyle="Italic"
								   IsHitTestVisible="False"
								   Margin="{ TemplateBinding Padding }"
								   Text="{ TemplateBinding Tag }"
								   VerticalAlignment="Center"
								   Visibility="Collapsed"/>

						<TextBox x:Name="PART_EditableTextBox"
								 Focusable="True"
								 IsReadOnly="{ TemplateBinding IsReadOnly }"
								 Margin="{ TemplateBinding Padding }"
								 VerticalAlignment="Center"
								 Visibility="Collapsed"/>

						<Popup x:Name="PART_Popup"
							   AllowsTransparency="True"
							   Focusable="False"
							   IsOpen="{ TemplateBinding IsDropDownOpen }"
							   Placement="Bottom"
							   PopupAnimation="Fade">
							<Border Background="{ StaticResource ResourceKey=Papel }"
									BorderBrush="{ StaticResource ResourceKey=LineaFuerte }"
									BorderThickness="1"
									CornerRadius="3"
									Margin="0 2 0 0"
									MaxHeight="{ TemplateBinding MaxDropDownHeight }"
									MinWidth="{ Binding Path=ActualWidth, ElementName=Desplegar }"
									SnapsToDevicePixels="True">
								<ScrollViewer Padding="0 4">
									<ItemsPresenter/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaTenue }"/>
						</Trigger>
						<Trigger Property="IsEditable" Value="True">
							<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
							<Setter TargetName="Seleccion" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<!-- Sin elección: se muestra el texto guía del Tag. -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="SelectedItem" Value="{ x:Null }"/>
								<Condition Property="IsEditable" Value="False"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="Guia" Property="Visibility" Value="Visible"/>
						</MultiTrigger>
						<Trigger Property="Validation.HasError" Value="True">
							<Setter Property="ToolTip" Value="{ Binding Path=(Validation.Errors)[0].ErrorContent, RelativeSource={ RelativeSource Self } }"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Validation.ErrorTemplate">
			<Setter.Value>
				<ControlTemplate>
					<Grid>
						<AdornedElementPlaceholder/>
						<Border BorderBrush="{ StaticResource ResourceKey=Alerta }"
								BorderThickness="1"
								CornerRadius="3"
								SnapsToDevicePixels="True"/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region COMPATIBILIDAD-->
	<Style x:Key="ComboBoxStyle" TargetType="{ x:Type ComboBox }" BasedOn="{ StaticResource ResourceKey=Cmb.Campo }"/>
	<!--#endregion-->
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		GRILLA — mismo libro rayado que el índice.

		Sin líneas verticales: con filas separadas por una regla y columnas bien espaciadas,
		la cuadrícula completa sólo agrega ruido. Es la diferencia entre una planilla y una
		jaula.
	-->

	<!--#region ENCABEZADO-->
	<Style TargetType="{ x:Type DataGridColumnHeader }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGridColumnHeader }">
					<Border Background="{ TemplateBinding Background }"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"
							Height="32"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="{ TemplateBinding HorizontalContentAlignment }"
										  Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="{ ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={ x:Type DataGrid } }"
		   TargetType="{ x:Type Button }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border Background="Transparent"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region CELDA Y FILA-->
	<Style TargetType="{ x:Type DataGridCell }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="FocusVisualStyle" Value="{ x:Null }"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGridCell }">
					<Border Background="{ TemplateBinding Background }"
							SnapsToDevicePixels="True">
						<ContentPresenter Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style TargetType="{ x:Type DataGridRow }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="MinHeight" Value="38"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGridRow }">
					<Border x:Name="Fila"
							Background="{ TemplateBinding Background }"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"
							SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="3"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Rectangle x:Name="Marca"
									   Grid.Column="0"
									   Fill="{ StaticResource ResourceKey=Primario }"
									   Opacity="0"/>
							<DataGridCellsPresenter Grid.Column="1" VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=TizaAlta }"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
							<Setter TargetName="Marca" Property="Opacity" Value="1"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region GRILLA-->
	<Style x:Key="Grilla" TargetType="{ x:Type DataGrid }">
		<Setter Property="AutoGenerateColumns" Value="False"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CanUserAddRows" Value="False"/>
		<Setter Property="CanUserDeleteRows" Value="False"/>
		<Setter Property="CanUserResizeRows" Value="False"/>
		<Setter Property="ColumnHeaderHeight" Value="32"/>
		<Setter Property="GridLinesVisibility" Value="None"/>
		<Setter Property="HeadersVisibility" Value="Column"/>
		<Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
		<Setter Property="RowHeaderWidth" Value="0"/>
		<Setter Property="SelectionMode" Value="Single"/>
		<Setter Property="SelectionUnit" Value="FullRow"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGrid }">
					<Grid>
						<ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
							<ScrollViewer.Template>
								<ControlTemplate TargetType="{ x:Type ScrollViewer }">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
																		Grid.Column="0"
																		Grid.Row="0"
																		Visibility="{ Binding Path=HeadersVisibility, ConverterParameter={ x:Static DataGridHeadersVisibility.Column }, Converter={ x:Static DataGrid.HeadersVisibilityConverter }, RelativeSource={ RelativeSource AncestorType={ x:Type DataGrid } } }"/>

										<ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
																Grid.Column="0"
																Grid.Row="1"
																CanContentScroll="{ TemplateBinding CanContentScroll }"/>

										<ScrollBar x:Name="PART_VerticalScrollBar"
												   Grid.Column="1"
												   Grid.Row="1"
												   Maximum="{ TemplateBinding ScrollableHeight }"
												   Orientation="Vertical"
												   ViewportSize="{ TemplateBinding ViewportHeight }"
												   Value="{ Binding Path=VerticalOffset, Mode=OneWay, RelativeSource={ RelativeSource TemplatedParent } }"
												   Visibility="{ TemplateBinding ComputedVerticalScrollBarVisibility }"/>

										<ScrollBar x:Name="PART_HorizontalScrollBar"
												   Grid.Column="0"
												   Grid.Row="2"
												   Maximum="{ TemplateBinding ScrollableWidth }"
												   Orientation="Horizontal"
												   ViewportSize="{ TemplateBinding ViewportWidth }"
												   Value="{ Binding Path=HorizontalOffset, Mode=OneWay, RelativeSource={ RelativeSource TemplatedParent } }"
												   Visibility="{ TemplateBinding ComputedHorizontalScrollBarVisibility }"/>
									</Grid>
								</ControlTemplate>
							</ScrollViewer.Template>
							<ItemsPresenter/>
						</ScrollViewer>

						<!--
							Estado vacío, igual que en Lista.Indice: el mensaje viene del Tag
							de cada grilla, así que dice qué falta hacer en ESA pantalla en
							lugar de un "no hay registros" universal. Una grilla sin filas
							mostraba sólo los encabezados y nada más.

							Los encabezados quedan a la vista —dicen qué se va a listar—, así
							que el aviso arranca debajo: 32px de encabezado + su regla.
						-->
						<Border x:Name="Vacio"
								Margin="0 33 0 0"
								Visibility="Collapsed">
							<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
									   FontFamily="{ StaticResource ResourceKey=Fuente.Cuerpo }"
									   FontSize="13"
									   HorizontalAlignment="Center"
									   Margin="32 36"
									   Text="{ TemplateBinding Tag }"
									   TextAlignment="Center"
									   TextWrapping="Wrap"
									   VerticalAlignment="Top"/>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="HasItems" Value="False">
							<Setter TargetName="Vacio" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region COMPATIBILIDAD-->
	<Style x:Key="DataGrid" TargetType="{ x:Type DataGrid }" BasedOn="{ StaticResource ResourceKey=Grilla }"/>
	<!--#endregion-->
</ResourceDictionary>

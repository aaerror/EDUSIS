<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
					xmlns:shared="clr-namespace:WPF_Desktop.Shared">
	<!--
		Dependencias EXPLICITAS. Un StaticResource escrito dentro de un ResourceDictionary
		que se carga por Source se resuelve en el ambito de ESE diccionario, no en el del
		padre que lo fusiona: los diccionarios hermanos de App.xaml no se ven entre si. Con
		BasedOn el fallo es silencioso hasta que alguien construye la vista que lo usa.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		GRILLA — mismo libro rayado que el índice.

		Sin líneas verticales: con filas separadas por una regla y columnas bien espaciadas,
		la cuadrícula completa sólo agrega ruido. Es la diferencia entre una planilla y una
		jaula.
	-->

	<!--#region ENCABEZADO-->
	<Style TargetType="{ x:Type DataGridColumnHeader }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGridColumnHeader }">
					<Border Background="{ TemplateBinding Background }"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"
							Height="32"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="{ TemplateBinding HorizontalContentAlignment }"
										  Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="{ ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={ x:Type DataGrid } }"
		   TargetType="{ x:Type Button }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type Button }">
					<Border Background="Transparent"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region CELDA Y FILA-->
	<Style TargetType="{ x:Type DataGridCell }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="FocusVisualStyle" Value="{ x:Null }"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="Padding" Value="12 0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGridCell }">
					<Border Background="{ TemplateBinding Background }"
							SnapsToDevicePixels="True">
						<ContentPresenter Margin="{ TemplateBinding Padding }"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style TargetType="{ x:Type DataGridRow }">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="MinHeight" Value="38"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGridRow }">
					<Border x:Name="Fila"
							Background="{ TemplateBinding Background }"
							BorderBrush="{ StaticResource ResourceKey=Linea }"
							BorderThickness="0 0 0 1"
							SnapsToDevicePixels="True">
						<!--
							LA MARCA NO OCUPA LUGAR EN LA FILA. Estaba en una columna propia de
							3px con las celdas en la columna 1, así que TODA celda arrancaba 3px
							más a la derecha que su encabezado, estuviera la fila seleccionada o
							no: la marca siempre ocupaba su columna y lo único que cambiaba era
							su opacidad. El encabezado no tiene esa columna, de modo que la
							desalineación se veía en todas las grillas de la aplicación.

							Superpuesta, las celdas vuelven a empezar donde empieza el
							encabezado. Los 3px caen dentro del Padding de la celda, que es 12,
							así que la marca no toca el texto.
						-->
						<Grid>
							<DataGridCellsPresenter VerticalAlignment="Center"/>
							<Rectangle x:Name="Marca"
									   Fill="{ StaticResource ResourceKey=Primario }"
									   HorizontalAlignment="Left"
									   Opacity="0"
									   Width="3"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=TizaAlta }"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Fila" Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
							<Setter TargetName="Marca" Property="Opacity" Value="1"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region CELDA — el texto adentro de una columna
		Dos estilos para el ElementStyle de las columnas, porque una grilla tenía dos defectos
		que ninguna vista podía arreglar sola.

		El texto se CORTABA EN SECO. El TextBlock que genera DataGridTextColumn no trunca: la
		observación de una calificación o un apellido largo se cortaban al ancho de la celda sin
		elipsis, así que nada avisaba que el texto seguía. Con la elipsis el corte se ve, y el
		valor entero se alcanza por la ficha o por el campo de edición de abajo.

		Las COLUMNAS NUMÉRICAS no alineaban sus cifras. La fila hereda Fuente.Cuerpo —Segoe UI,
		cifras proporcionales—, así que un documento, una nota o un ciclo lectivo no se podían
		comparar de un vistazo contra el de la fila de arriba. NumeralAlignment=Tabular le pide
		a la fuente el ancho fijo que ya trae, sin cambiar de tipografía: la columna se lee en
		bloque y el rótulo sigue siendo texto, no dato monoespaciado.
	-->
	<Style x:Key="Celda.Texto" TargetType="{ x:Type TextBlock }">
		<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="Celda.Numero" TargetType="{ x:Type TextBlock }" BasedOn="{ StaticResource ResourceKey=Celda.Texto }">
		<Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
	</Style>

	<!--
		EL SÍ Y EL NO DE UNA FILA, que es lo que antes dibujaba DataGridCheckBoxColumn.

		Esas columnas llevaban IsReadOnly=True: una casilla que no se puede tildar. Un control
		de entrada que no acepta entrada miente sobre lo que permite, y encima reservaba el
		ancho de una casilla más su rótulo. Un glifo no simula ser interactivo y ocupa menos.

		LA FORMA DISTINGUE LOS DOS ESTADOS, no el color: tilde contra raya. El color sólo
		refuerza, igual que en las insignias. La raya es Minus y no un vacío a propósito —una
		celda en blanco se lee como "falta el dato", no como "no"—.

		El valor entra por el Tag, que es como Grilla recibe su estado vacío y Txb.Campo su
		texto de guía: el dato que un estilo necesita viaja por Tag en toda la aplicación.

		AutomationProperties.Name cambia con el estado porque un glifo no tiene texto que leer:
		sin esto, un lector de pantalla anuncia la celda vacía.
	-->
	<Style x:Key="Celda.Booleana" TargetType="{ x:Type fa:IconBlock }">
		<Setter Property="AutomationProperties.Name" Value="No"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=LineaFuerte }"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="Icon" Value="Minus"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Style.Triggers>
			<DataTrigger Binding="{ Binding Path=Tag, RelativeSource={ RelativeSource Self } }" Value="True">
				<Setter Property="AutomationProperties.Name" Value="Sí"/>
				<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Primario }"/>
				<Setter Property="Icon" Value="Check"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<!--#endregion-->

	<!--#region GRILLA-->
	<Style x:Key="Grilla" TargetType="{ x:Type DataGrid }">
		<Setter Property="AutoGenerateColumns" Value="False"/>
		<!--
			LA RUEDA VUELVE AL CONTENEDOR DE ARRIBA cuando esta grilla no tiene más que
			scrollear. El ScrollViewer de la plantilla marca el evento como manejado aunque no
			haya desplazamiento que consumir, así que una grilla de dos filas adentro de una
			página con scroll dejaba la rueda muerta sobre toda su superficie. Ver RuedaDelMouse.
		-->
		<Setter Property="shared:RuedaDelMouse.Burbujea" Value="True"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CanUserAddRows" Value="False"/>
		<Setter Property="CanUserDeleteRows" Value="False"/>
		<Setter Property="CanUserResizeRows" Value="False"/>
		<Setter Property="ColumnHeaderHeight" Value="32"/>
		<Setter Property="GridLinesVisibility" Value="None"/>
		<Setter Property="HeadersVisibility" Value="Column"/>
		<Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
		<Setter Property="RowHeaderWidth" Value="0"/>
		<Setter Property="SelectionMode" Value="Single"/>
		<Setter Property="SelectionUnit" Value="FullRow"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type DataGrid }">
					<Grid>
						<ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
							<ScrollViewer.Template>
								<ControlTemplate TargetType="{ x:Type ScrollViewer }">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
																		Grid.Column="0"
																		Grid.Row="0"
																		Visibility="{ Binding Path=HeadersVisibility, ConverterParameter={ x:Static DataGridHeadersVisibility.Column }, Converter={ x:Static DataGrid.HeadersVisibilityConverter }, RelativeSource={ RelativeSource AncestorType={ x:Type DataGrid } } }"/>

										<ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
																Grid.Column="0"
																Grid.Row="1"
																CanContentScroll="{ TemplateBinding CanContentScroll }"/>

										<ScrollBar x:Name="PART_VerticalScrollBar"
												   Grid.Column="1"
												   Grid.Row="1"
												   Maximum="{ TemplateBinding ScrollableHeight }"
												   Orientation="Vertical"
												   ViewportSize="{ TemplateBinding ViewportHeight }"
												   Value="{ Binding Path=VerticalOffset, Mode=OneWay, RelativeSource={ RelativeSource TemplatedParent } }"
												   Visibility="{ TemplateBinding ComputedVerticalScrollBarVisibility }"/>

										<ScrollBar x:Name="PART_HorizontalScrollBar"
												   Grid.Column="0"
												   Grid.Row="2"
												   Maximum="{ TemplateBinding ScrollableWidth }"
												   Orientation="Horizontal"
												   ViewportSize="{ TemplateBinding ViewportWidth }"
												   Value="{ Binding Path=HorizontalOffset, Mode=OneWay, RelativeSource={ RelativeSource TemplatedParent } }"
												   Visibility="{ TemplateBinding ComputedHorizontalScrollBarVisibility }"/>
									</Grid>
								</ControlTemplate>
							</ScrollViewer.Template>
							<ItemsPresenter/>
						</ScrollViewer>

						<!--
							Estado vacío, igual que en Lista.Indice: el mensaje viene del Tag
							de cada grilla, así que dice qué falta hacer en ESA pantalla en
							lugar de un "no hay registros" universal. Una grilla sin filas
							mostraba sólo los encabezados y nada más.

							Los encabezados quedan a la vista —dicen qué se va a listar—, así
							que el aviso arranca debajo: 32px de encabezado + su regla.
						-->
						<Border x:Name="Vacio"
								Margin="0 33 0 0"
								Visibility="Collapsed">
							<TextBlock Foreground="{ StaticResource ResourceKey=TintaSuave }"
									   FontFamily="{ StaticResource ResourceKey=Fuente.Cuerpo }"
									   FontSize="13"
									   HorizontalAlignment="Center"
									   Margin="32 36"
									   Text="{ TemplateBinding Tag }"
									   TextAlignment="Center"
									   TextWrapping="Wrap"
									   VerticalAlignment="Top"/>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="HasItems" Value="False">
							<Setter TargetName="Vacio" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region COMPATIBILIDAD-->
	<Style x:Key="DataGrid" TargetType="{ x:Type DataGrid }" BasedOn="{ StaticResource ResourceKey=Grilla }"/>
	<!--#endregion-->
</ResourceDictionary>

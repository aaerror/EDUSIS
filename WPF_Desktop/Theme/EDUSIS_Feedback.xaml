<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:w="clr-namespace:System.Windows;assembly=PresentationFramework">
	<!--
		Dependencias EXPLICITAS, igual que el resto del tema: un StaticResource escrito dentro
		de un ResourceDictionary cargado por Source se resuelve en el ambito de ESE diccionario.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Brushes.xaml"/>
		<ResourceDictionary Source="/WPF_Desktop;component/Theme/EDUSIS_Typography.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!--
		RESPUESTA DE LA APLICACIÓN — lo que pasa mientras algo pasa, y lo que queda después.

		Antes de este diccionario la aplicación no tenía ninguna de las dos cosas: ni un
		indicador de que algo está cargando (había UNA bandera "Cargando", en Docentes, y se
		veía sólo como una palabra dentro de un resumen, con quince cargas asíncronas repartidas
		por las pantallas), ni una forma de confirmar que una operación salió bien sin
		interrumpir: los éxitos salían por MessageBox nativo, que tapa la pantalla y hay que
		despachar a mano. Para quien marca treinta asistencias seguidas eso son treinta
		interrupciones.

		La división es la misma que usa cualquier interfaz que respeta el tiempo de quien la usa:
		lo que sólo informa no interrumpe (aviso al pie, se va solo), y lo que exige una decisión
		o no se puede perder de vista sí interrumpe (diálogo con acuse).

		Sin colores nuevos: éxito es la familia Primario, advertencia Aviso, error Alerta. El
		verde ya significa acción en toda la aplicación, y un éxito ES el resultado de una acción.
	-->

	<!--#region AVISO AL PIE
		La tarjeta del aviso no bloqueante. Papel sobre el contenido, con la barra de color del
		tipo a la izquierda: el mismo recurso de las superficies en línea (Aviso/Error), para que
		un éxito al pie y un aviso dentro de un formulario se lean como la misma familia.
	-->
	<Style x:Key="Aviso.Tarjeta" TargetType="{ x:Type Border }">
		<Setter Property="Background" Value="{ StaticResource ResourceKey=Papel }"/>
		<Setter Property="BorderBrush" Value="{ StaticResource ResourceKey=LineaFuerte }"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Width" Value="360"/>
	</Style>

	<Style x:Key="Txt.Aviso.Titulo" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>

	<Style x:Key="Txt.Aviso.Cuerpo" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaMedia }"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>
	<!--#endregion-->

	<!--#region SUPERFICIE DE ÉXITO
		El tercer par de Superficie.Aviso / Superficie.Error, que faltaba. Misma anatomía: fondo
		suave y barra de 3px a la izquierda.
	-->
	<Style x:Key="Superficie.Exito" TargetType="{ x:Type Border }">
		<Setter Property="Background" Value="{ StaticResource ResourceKey=PrimarioSuave }"/>
		<Setter Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
		<Setter Property="BorderThickness" Value="3 0 0 0"/>
		<Setter Property="Padding" Value="12 10"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
	</Style>

	<!-- La tercera insignia: los tokens Aviso/AvisoSuave ya existían y no tenían par. -->
	<Style x:Key="Insignia.Aviso" TargetType="{ x:Type Border }">
		<Setter Property="Background" Value="{ StaticResource ResourceKey=AvisoSuave }"/>
		<Setter Property="CornerRadius" Value="2"/>
		<Setter Property="Padding" Value="7 2 7 3"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<!--#endregion-->

	<!--#region ERROR DE CAMPO
		El tema ya marcaba el campo con error —borde Alerta y el mensaje en el ToolTip—, pero un
		mensaje que sólo vive en un ToolTip exige apuntar el campo para leerlo y no existe para
		quien navega con teclado. Esto es el texto visible debajo del campo.
	-->
	<Style x:Key="Txt.Error.Campo" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Cuerpo }"/>
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Alerta }"/>
		<Setter Property="Margin" Value="0 3 0 0"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>
	<!--#endregion-->

	<!--#region CARGANDO
		Velo sobre la tarjeta mientras se espera. Papel al 72%: deja ver la silueta de lo que
		había —así no parece que la pantalla se vació— pero lo saca de foco.
	-->
	<SolidColorBrush x:Key="VeloPapel" Color="{ StaticResource ResourceKey=Color.Papel }" Opacity="0.72"/>

	<Style x:Key="Superficie.Cargando" TargetType="{ x:Type Border }">
		<Setter Property="Background" Value="{ StaticResource ResourceKey=VeloPapel }"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
	</Style>

	<Style x:Key="Txt.Cargando" TargetType="{ x:Type TextBlock }">
		<Setter Property="FontFamily" Value="{ StaticResource ResourceKey=Fuente.Display }"/>
		<Setter Property="FontStretch" Value="Condensed"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=TintaSuave }"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>

	<!--
		LA REGLA DE TIZA — el único movimiento de la aplicación.

		Un trazo de 66px que barre un carril de 220px, ida y vuelta. Ancho fijo a propósito: una
		animación indeterminada relativa al ancho del contenedor obliga a recalcular la
		animación en cada cambio de tamaño, y acá el carril siempre mide lo mismo.

		RESPETA LA CONFIGURACIÓN DEL SISTEMA. SystemParameters.ClientAreaAnimation es el
		"mostrar animaciones en Windows" del panel de accesibilidad. Si está apagado, el trazo
		queda quieto en lugar de barrer: sigue habiendo una marca de que algo está en curso, sin
		movimiento.
	-->
	<Style x:Key="Progreso.Tiza" TargetType="{ x:Type ProgressBar }">
		<Setter Property="Background" Value="{ StaticResource ResourceKey=TizaBaja }"/>
		<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Primario }"/>
		<Setter Property="Height" Value="2"/>
		<Setter Property="IsIndeterminate" Value="True"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Width" Value="220"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{ x:Type ProgressBar }">
					<Grid ClipToBounds="True">
						<Rectangle Fill="{ TemplateBinding Background }"/>
						<Rectangle x:Name="Trazo"
								   Fill="{ TemplateBinding Foreground }"
								   HorizontalAlignment="Left"
								   Width="66">
							<Rectangle.RenderTransform>
								<TranslateTransform x:Name="Barrido" X="0"/>
							</Rectangle.RenderTransform>
						</Rectangle>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{ Binding Source={ x:Static w:SystemParameters.ClientAreaAnimation } }" Value="True">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard RepeatBehavior="Forever" AutoReverse="True">
										<DoubleAnimation Storyboard.TargetName="Barrido"
														 Storyboard.TargetProperty="X"
														 From="0"
														 To="154"
														 Duration="0:0:1.1">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseInOut"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--#endregion-->

	<!--#region DIÁLOGO
		La ventana de confirmación y de error. Hereda de las superficies: Papel, regla de 1px,
		radio 4. El velo que la rodea es el mismo Velo del modal de búsqueda.
	-->
	<Style x:Key="Dialogo.Consecuencia" TargetType="{ x:Type Border }">
		<Setter Property="Background" Value="{ StaticResource ResourceKey=TizaAlta }"/>
		<Setter Property="BorderBrush" Value="{ StaticResource ResourceKey=Linea }"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="3"/>
		<Setter Property="Padding" Value="12 10"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
	</Style>
	<!--#endregion-->
</ResourceDictionary>

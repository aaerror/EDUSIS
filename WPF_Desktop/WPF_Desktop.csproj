<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net7.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>

		<!--
			El TFM sigue siendo net7.0-windows, pero en esta máquina sólo está el runtime
			.NET 10 (de WindowsDesktop no hay ningún 7.x ni 8.x). El build rollforwardea
			solo; la EJECUCIÓN no, por defecto: la política por defecto es Minor, que no
			cruza de major. Sin esta propiedad, `dotnet run` y `dotnet ef` (que arranca el
			entry point de este proyecto para obtener el IHost) cortan con
			"You must install or update .NET to run this application".
			Mismo criterio que tests/Directory.Build.props.
		-->
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="bell-ring-icon.png" />
	</ItemGroup>

	<!-- Permite restaurar y compilar este proyecto desde Linux/macOS (no ejecutarlo). En Windows es inocuo. -->
	<PropertyGroup>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\Domain\Domain.csproj" />
		<ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WPF_Desktop.UnitTests" />
		<!-- Castle DynamicProxy genera los dobles de NSubstitute en este ensamblado: sin esta línea no se puede doblar una interfaz internal como IDialogService. -->
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="bell-ring-icon.png" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Navigation\NavigationServices\Alumnos\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
</Project>
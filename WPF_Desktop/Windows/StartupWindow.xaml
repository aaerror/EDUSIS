<Window x:Class="WPF_Desktop.Windows.StartupWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:WPF_Desktop.Windows"
		xmlns:components="clr-namespace:WPF_Desktop.Components"
		xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		mc:Ignorable="d"
		Background="{ StaticResource ResourceKey=Papel }"
		Height="600"
		Icon="../bell-ring-icon.png"
		ResizeMode="NoResize"
		Title="Acceso a EDUSIS"
		Width="430"
		WindowStartupLocation="CenterScreen"
		WindowStyle="None">
	<!--
		Misma decisión que en MainWindow: marco propio sobre WindowChrome, no
		AllowsTransparency. Acá importa sobre todo por el botón de cierre: antes la ventana no
		tenía ninguno, así que quien abría la app y no quería o no podía entrar sólo salía con
		Alt+F4. El App.OnStartup ya contempla ese camino (si se cierra sin sesión, Shutdown),
		pero no había manera de recorrerlo con el mouse.
	-->
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="42"
							CornerRadius="0"
							GlassFrameThickness="0"
							NonClientFrameEdges="None"
							ResizeBorderThickness="0"
							UseAeroCaptionButtons="False"/>
	</shell:WindowChrome.WindowChrome>

	<Window.Visibility>
		<Binding Path="IsWindowVisible"
				 Mode="TwoWay"
				 Converter="{ StaticResource ResourceKey=visibilidad }"/>
	</Window.Visibility>

	<Border BorderBrush="{ StaticResource ResourceKey=Linea }"
			BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!--#region CIERRE-->
			<Button Grid.Row="0"
					Click="Cerrar_Click"
					Content="&#xE8BB;"
					HorizontalAlignment="Right"
					Style="{ StaticResource ResourceKey=Btn.Ventana.Cerrar }"
					ToolTip="Salir"
					shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
			<!--#endregion-->

			<!--#region MARCA
				El timbre al lado del nombre: acá es donde la marca se presenta, y a 38px es el
				único lugar de la aplicación donde se lo ve con detalle. En el rail va a 28px y en
				la barra de tareas, como icono de ventana, al tamaño que Windows decida.
			-->
			<StackPanel Grid.Row="1"
						Margin="40 14 40 0">
				<StackPanel Orientation="Horizontal">
					<components:TimbreComponent Foreground="{ StaticResource ResourceKey=Primario }"
												Height="38"
												Margin="0 0 14 0"
												VerticalAlignment="Center"/>
					<TextBlock FontFamily="{ StaticResource ResourceKey=Fuente.Display }"
							   FontSize="34"
							   FontStretch="SemiCondensed"
							   FontWeight="Bold"
							   Foreground="{ StaticResource ResourceKey=Tinta }"
							   Text="EDUSIS"
							   VerticalAlignment="Center"/>
				</StackPanel>
				<!-- 38 del timbre + 14 de separación: la bajada arranca donde arranca el wordmark. -->
				<TextBlock Margin="52 4 0 0"
						   Style="{ StaticResource ResourceKey=Txt.Detalle }"
						   Text="Sistema de gestión escolar"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region PESTAÑAS-->
			<Border Grid.Row="2"
					BorderBrush="{ StaticResource ResourceKey=Linea }"
					BorderThickness="0 0 0 1"
					Margin="40 30 40 0">
				<StackPanel Orientation="Horizontal">
					<Button Command="{ Binding Path=NavigationCommand }"
							CommandParameter="Login"
							Content="Acceso">
						<Button.Style>
							<Style TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Pestana }">
								<Style.Triggers>
									<DataTrigger Binding="{ Binding Path=SeccionActiva }" Value="Login">
										<Setter Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
										<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>

					<Button Command="{ Binding Path=NavigationCommand }"
							CommandParameter="Registrar"
							Content="Nuevo usuario">
						<Button.Style>
							<Style TargetType="{ x:Type Button }" BasedOn="{ StaticResource ResourceKey=Btn.Pestana }">
								<Style.Triggers>
									<DataTrigger Binding="{ Binding Path=SeccionActiva }" Value="Registrar">
										<Setter Property="BorderBrush" Value="{ StaticResource ResourceKey=Primario }"/>
										<Setter Property="Foreground" Value="{ StaticResource ResourceKey=Tinta }"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
				</StackPanel>
			</Border>
			<!--#endregion-->

			<!--#region FORMULARIO-->
			<ContentControl Grid.Row="3"
							Content="{ Binding Path=ViewModel, UpdateSourceTrigger=PropertyChanged }"
							Margin="40 24 40 0"
							Validation.ErrorTemplate="{ x:Null }"
							VerticalAlignment="Top"/>
			<!--#endregion-->

			<!--#region PIE-->
			<StackPanel Grid.Row="4"
						Margin="40 0 40 22">
				<Rectangle Margin="0 0 0 14" Style="{ StaticResource ResourceKey=Regla }"/>
				<TextBlock Foreground="{ StaticResource ResourceKey=TintaTenue }"
						   Style="{ StaticResource ResourceKey=Txt.Detalle }">
					<Run Text="EDUSIS"/>
					<Run Text="{ Binding Path=Year, Mode=OneWay }"/>
					<Run Text="· Argañín Agustín &amp; Heredia Mariano"/>
				</TextBlock>
			</StackPanel>
			<!--#endregion-->
		</Grid>
	</Border>
</Window>

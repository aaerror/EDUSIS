<Window x:Class="WPF_Desktop.Windows.StartupWindow"
		xmlns:local="clr-namespace:WPF_Desktop.Windows"
		xmlns:components="clr-namespace:WPF_Desktop.Components"
		xmlns:usuarios="clr-namespace:WPF_Desktop.ViewModels.Usuarios"
		xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
		mc:Ignorable="d"
		Title="Login" Height="550" Width="400"
		HorizontalAlignment="Center"
		ResizeMode="NoResize"
		UseLayoutRounding="False"
		VerticalAlignment="Center"
		WindowStartupLocation="CenterScreen"
		WindowStyle="None">
	<!--#region RESOURCES-->
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="booleanConverter"/>
	</Window.Resources>
	<!--#endregion-->
	<Window.Visibility>
		<Binding Path="IsWindowVisible"
				 Mode="TwoWay"
				 Converter="{ StaticResource ResourceKey=booleanConverter }"/>
	</Window.Visibility>
	<!--#region MAIN-->
	<Border Grid.Column="1"
			Background="#F8FAFC"
			BorderBrush="{ StaticResource ResourceKey=Gray200 }"
			BorderThickness="0 1 1 1"
			CornerRadius="0 8 8 0"
			Padding="10">
		<!-- PANEL INTERIOR -->
		<Grid Margin="40 10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<!--#region HEADER-->
			<StackPanel Grid.Row="0"
						Margin="0 0 0 10">
				<!--#region DISPLAY-->
				<Label Content="EDUSIS"
					   Foreground="{ StaticResource ResourceKey=PrimaryColor }"
					   HorizontalAlignment="Center"
					   Style="{ StaticResource ResourceKey=Display }"/>
				<Separator Background="{ StaticResource ResourceKey=Gray400 }"
						   Height=".7"
						   Width="250">
					<Separator.Effect>
						<BlurEffect Radius="1.5"/>
					</Separator.Effect>
				</Separator>

				<Label Content="Acceso"
					   HorizontalAlignment="Center"
					   Style="{ StaticResource ResourceKey=Header }"/>
				<!--#endregion-->
			</StackPanel>
			<!--#endregion-->

			<!--#region COMMANDS-->
			<StackPanel Grid.Row="1"
						Margin="0 10 0 5">
				<WrapPanel HorizontalAlignment="Center">
					<!--#region NAV: Login-->
					<Button Command="{ Binding Path=NavigationCommand }"
							CommandParameter="Login"
							FontSize="14"
							Foreground="{ StaticResource ResourceKey=Neutral800 }"
							Margin="0 0 5 0"
							Style="{ StaticResource ResourceKey=Tertiary }">
						<Button.Content>
							<WrapPanel>
								<fa:IconBlock Icon="SignIn"
											  Margin="0 0 1 0"/>
								<Label Content="Login"
									   Foreground="{ StaticResource ResourceKey=Neutral800 }"
									   Margin="1 0 0 2"/>
							</WrapPanel>
						</Button.Content>
					</Button>
					<!--#endregion-->
					<!--#region NAV: Nuevo Usuario-->
					<Button Command="{ Binding Path=NavigationCommand }"
							CommandParameter="Registrar"
							Foreground="{ StaticResource ResourceKey=Neutral800 }"
							FontSize="14"
							Margin="5 0 0 0"
							Style="{ StaticResource ResourceKey=Tertiary }">
						<Button.Content>
							<WrapPanel>
								<fa:IconBlock Icon="UserPlus"
											  Margin="0 0 1 0"/>
								<Label Content="Nuevo usuario"
									   Foreground="{ StaticResource ResourceKey=Neutral800 }"
									   Margin="1 0 0 2"/>
							</WrapPanel>
						</Button.Content>
					</Button>
					<!--#endregion-->
				</WrapPanel>
			</StackPanel>
			<!--#endregion-->

			<!--#region VIEW MODELS-->
			<StackPanel Grid.Row="2"
						Margin="0 5 0 10">
				<ContentControl Content="{ Binding Path=ViewModel, UpdateSourceTrigger=PropertyChanged }"
								Validation.ErrorTemplate="{ x:Null }"/>
			</StackPanel>
			<!--#endregion-->

			<!--#region FOOTER-->
			<StackPanel Grid.Row="3"
						Margin="0 10 0 0">
				<WrapPanel HorizontalAlignment="Center">
					<Label Content="EDUSIS INC® -"
						   Margin="0 0 2 0"
						   Style="{ StaticResource ResourceKey=Caption }"/>
					<Label Content="{ Binding Path=Year }"
						   Margin="2 0 0 0"
						   Style="{ StaticResource ResourceKey=Caption }"/>
				</WrapPanel>
				<Label Content="Argañin Agustín &amp; Heredia Mariano"
					   HorizontalAlignment="Center"
					   Style="{ StaticResource ResourceKey=Caption }"/>
			</StackPanel>
			<!--#endregion-->
		</Grid>
	</Border>
	<!--#endregion-->
</Window>
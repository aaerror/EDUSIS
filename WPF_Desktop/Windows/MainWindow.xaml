<Window x:Class="WPF_Desktop.Windows.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:WPF_Desktop.Windows"
		xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
		xmlns:components="clr-namespace:WPF_Desktop.Components"
		xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
		xmlns:usuarioView="clr-namespace:WPF_Desktop.Views.Usuarios"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		mc:Ignorable="d"
		Background="{ StaticResource ResourceKey=Tiza }"
		Height="800"
		Icon="../bell-ring-icon.png"
		MinHeight="620"
		MinWidth="1040"
		ResizeMode="CanResize"
		Title="EDUSIS"
		Width="1320"
		WindowStartupLocation="CenterScreen"
		WindowStyle="None">
	<!--
		MARCO DE VENTANA PROPIO, PERO CON COMPORTAMIENTO NATIVO.

		Antes: WindowStyle="None" + AllowsTransparency="True" + ResizeMode="NoResize" y ningún
		botón de cierre en todo el XAML. La ventana no se podía mover, redimensionar, minimizar,
		maximizar ni cerrar: la única salida era Alt+F4.

		WindowChrome es la respuesta de WPF a esto. Conserva el marco real del sistema —y con él
		el redimensionado desde los bordes, el acoplado con Win+flechas, el doble clic para
		maximizar y el respeto por la barra de tareas— mientras deja dibujar la barra de título.
		AllowsTransparency tiene que quedar en False: con transparencia se pierde el marco real
		y vuelven todos esos problemas, además de forzar render por software.

		CaptionHeight define la franja arrastrable; lo que tiene que seguir siendo clickeable
		adentro de esa franja se marca con WindowChrome.IsHitTestVisibleInChrome="True".
	-->
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="38"
							CornerRadius="0"
							GlassFrameThickness="0"
							NonClientFrameEdges="None"
							ResizeBorderThickness="6"
							UseAeroCaptionButtons="False"/>
	</shell:WindowChrome.WindowChrome>

	<!--#region EVENTS-->
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="Loaded">
			<behaviors:InvokeCommandAction Command="{ Binding Path=CargarUsuarioAsyncCommand }"/>
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<!--#endregion-->

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="248"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!--#region RAIL
			Campo Pizarra continuo de arriba a abajo, incluida la franja de título: la
			identidad institucional ocupa una columna, no una barra decorativa.
		-->
		<Border Grid.Column="0"
				Background="{ StaticResource ResourceKey=Pizarra }">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--#region MARCA-->
				<StackPanel Grid.Row="0"
							Margin="20 26 20 30">
					<!--
						El timbre ocupa el lugar que tenía la regla verde. La regla no desaparece
						del sistema: sigue encabezando cada ficha, donde significa "acá empieza un
						registro"; lo que deja de hacer es también de marca, que es un trabajo para
						el que un acento genérico no alcanzaba. El verde ahora viene del timbre.
					-->
					<!--
						En blanco y no en Primario, que es lo primero que se probó. El rail tiene su
						propia regla, escrita en UsuarioView: sobre el campo Pizarra todo va en
						blanco a distintos niveles de énfasis. Medido, además: Primario sobre
						Pizarra da 3,48:1 y a 28px el anillo, el badajo y el brazo se funden en una
						mancha verde; en blanco da 12,78:1 y el dibujo se lee. El verde de la marca
						se ve donde tiene fondo claro —la ventana de acceso—, y acá queda reservado
						para una sola cosa: la sección abierta.
					-->
					<StackPanel Orientation="Horizontal">
						<components:TimbreComponent Foreground="{ StaticResource ResourceKey=SobrePizarra }"
													Height="28"
													Margin="0 0 12 0"
													VerticalAlignment="Center"/>
						<TextBlock FontFamily="{ StaticResource ResourceKey=Fuente.Display }"
								   FontSize="25"
								   FontStretch="SemiCondensed"
								   FontWeight="Bold"
								   Foreground="#FFFFFF"
								   Text="EDUSIS"
								   VerticalAlignment="Center"/>
					</StackPanel>
					<!-- El margen izquierdo alinea la bajada con el wordmark: 28 del timbre + 12 de separación. -->
					<TextBlock Foreground="{ StaticResource ResourceKey=SobrePizarraMedia }"
							   Margin="40 3 0 0"
							   Style="{ StaticResource ResourceKey=Txt.Detalle }"
							   Text="Gestión escolar"/>
				</StackPanel>
				<!--#endregion-->

				<!--#region SECCIONES
					Las entradas se habilitan por permiso. Una sección sin permiso queda
					visible pero apagada, con el motivo en el ToolTip: esconderla haría que
					nadie sepa que existe, y que un docente y un directivo vean dos apps
					distintas sin explicación.
				-->
				<StackPanel Grid.Row="1">
					<TextBlock Foreground="{ StaticResource ResourceKey=SobrePizarraTenue }"
							   Margin="20 0 20 10"
							   Style="{ StaticResource ResourceKey=Txt.Seccion }"
							   Text="GESTIÓN"/>

					<Button Command="{ Binding Path=GestionDocentesCommand }"
							Content="Docentes"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Docentes }"
							ToolTip="Legajos, puestos y licencias del personal docente"/>

					<Button Command="{ Binding Path=GestionAlumnosCommand }"
							Content="Alumnos"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Alumnos }"
							ToolTip="Legajos de alumnos e inscripciones"/>

					<Button Command="{ Binding Path=GestionCursosCommand }"
							Content="Cursos"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Cursos }"
							ToolTip="Cursos, divisiones, currículas y cátedras"/>

					<!--
						La asistencia también se alcanza bajando por Cursos → Divisiones, pero
						ese camino exige GestionarCursos. Esta entrada existe para Preceptoría,
						cuyos permisos no habilitaban ninguna sección.
					-->
					<Button Command="{ Binding Path=AsistenciasCommand }"
							Content="Asistencias"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Asistencias }"
							ToolTip="Planillas de asistencia por división"/>

					<TextBlock Foreground="{ StaticResource ResourceKey=SobrePizarraTenue }"
							   Margin="20 18 20 10"
							   Style="{ StaticResource ResourceKey=Txt.Seccion }"
							   Text="EMISIÓN"/>

					<Button Command="{ Binding Path=GestionDocumentacionCommand }"
							Content="Documentación"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Documentación }"
							ToolTip="Certificados, constancias y boletín de un alumno"/>

					<Button Command="{ Binding Path=GestionReportesCommand }"
							Content="Reportes"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Reportes }"
							ToolTip="Matrículas, asistencias, calificaciones, materias pendientes y trayectorias"/>

					<TextBlock Foreground="{ StaticResource ResourceKey=SobrePizarraTenue }"
							   Margin="20 18 20 10"
							   Style="{ StaticResource ResourceKey=Txt.Seccion }"
							   Text="ADMINISTRACIÓN"/>

					<!--
						Sección propia y al final: es la única que no administra datos académicos
						sino el acceso al sistema. AdministrarUsuarios lo tiene un solo rol.
					-->
					<Button Command="{ Binding Path=GestionUsuariosCommand }"
							Content="Usuarios"
							Style="{ StaticResource ResourceKey=Btn.Menu }"
							Tag="{ Binding Path=SeccionActual, Converter={ StaticResource ResourceKey=esIgualA }, ConverterParameter=Usuarios }"
							ToolTip="Cuentas del sistema y sus roles"/>
				</StackPanel>
				<!--#endregion-->

				<!--#region USUARIO-->
				<Border Grid.Row="3"
						BorderBrush="{ StaticResource ResourceKey=PizarraAlta }"
						BorderThickness="0 1 0 0"
						Padding="20 16">
				<StackPanel>
					<usuarioView:UsuarioView DataContext="{ Binding Path=UsuarioViewModel, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"/>

					<!--
						Las dos salidas, en este orden: cerrar la sesión es la frecuente —el cambio
						de turno en la misma máquina— y salir es la del fin de la jornada. Van en
						una fila porque son la misma clase de acción sobre la misma cosa, la sesión,
						y leerlas juntas es lo que deja clara la diferencia entre las dos.
					-->
					<StackPanel Margin="-12 10 0 0"
								Orientation="Horizontal">
						<Button Command="{ Binding Path=CerrarSesionCommand }"
								Content="Cerrar sesión"
								FontSize="12"
								Height="30"
								Style="{ StaticResource ResourceKey=Btn.Terciario.Claro }"
								ToolTip="Volver a la pantalla de acceso para que entre otro usuario, sin cerrar EDUSIS"/>
						<Button Command="{ Binding Path=SalirCommand }"
								Content="Salir"
								FontSize="12"
								Height="30"
								Style="{ StaticResource ResourceKey=Btn.Terciario.Claro }"
								ToolTip="Cerrar la sesión y salir de EDUSIS"/>
					</StackPanel>
				</StackPanel>
				</Border>
				<!--#endregion-->
			</Grid>
		</Border>
		<!--#endregion-->

		<!--#region LADO DE CONTENIDO-->
		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="38"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!--#region BARRA DE TÍTULO-->
			<Border Grid.Row="0"
					Background="{ StaticResource ResourceKey=Papel }"
					BorderBrush="{ StaticResource ResourceKey=Linea }"
					BorderThickness="0 0 0 1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0"
							   Margin="20 0"
							   Style="{ StaticResource ResourceKey=Txt.Detalle }"
							   Text="{ Binding Path=SeccionActual }"
							   VerticalAlignment="Center"/>

					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<Button Click="Minimizar_Click"
								Content="&#xE921;"
								Style="{ StaticResource ResourceKey=Btn.Ventana }"
								ToolTip="Minimizar"/>
						<Button x:Name="BotonMaximizar"
								Click="Maximizar_Click"
								Content="&#xE922;"
								Style="{ StaticResource ResourceKey=Btn.Ventana }"
								ToolTip="Maximizar"/>
						<Button Click="Cerrar_Click"
								Content="&#xE8BB;"
								Style="{ StaticResource ResourceKey=Btn.Ventana.Cerrar }"
								ToolTip="Cerrar EDUSIS"/>
					</StackPanel>
				</Grid>
			</Border>
			<!--#endregion-->

			<!--#region CONTENIDO-->
			<Grid Grid.Row="1">
				<ContentControl Content="{ Binding Path=ViewModelActual }"
								Validation.ErrorTemplate="{ x:Null }"/>

				<!--
					Estado inicial. Antes el área arrancaba en blanco sin ninguna indicación:
					una pantalla vacía es una invitación a actuar sólo si dice qué hacer.
				-->
				<StackPanel HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Visibility="{ Binding Path=HayContenido, Converter={ StaticResource ResourceKey=visibilidadInversa } }">
					<TextBlock HorizontalAlignment="Center"
							   Style="{ StaticResource ResourceKey=Txt.Titulo }"
							   Text="Elegí una sección"/>
					<TextBlock HorizontalAlignment="Center"
							   Margin="0 6 0 0"
							   MaxWidth="340"
							   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
							   Text="Las secciones de gestión, emisión y administración están en el menú de la izquierda. Las que tu rol no habilita aparecen apagadas y con un candado."
							   TextAlignment="Center"
							   TextWrapping="Wrap"/>
				</StackPanel>

				<!--#region AVISOS
					Viven acá y no en cada pantalla por una razón concreta: la navegación
					reemplaza el ViewModel de contenido, así que un aviso dibujado por la
					pantalla se iría con ella. El éxito de "Cursante dado de baja" tiene que
					sobrevivir a la recarga que viene justo después.

					Debajo del modal en ZIndex: mientras hay un modal abierto, lo que importa es
					la decisión que el modal pide.
				-->
				<components:AvisosComponent Panel.ZIndex="5"
											Avisos="{ Binding Path=Avisos }"/>
				<!--#endregion-->

				<!--#region MODAL-->
				<components:ModalComponent Panel.ZIndex="10"
										   EstaAbierto="{ Binding Path=ModalEstaAbierto, UpdateSourceTrigger=PropertyChanged }">
					<ContentControl Content="{ Binding Path=ModalViewModelActual, UpdateSourceTrigger=PropertyChanged }"/>
				</components:ModalComponent>
				<!--#endregion-->
			</Grid>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->
	</Grid>
</Window>

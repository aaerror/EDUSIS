<Window x:Class="WPF_Desktop.Windows.ConfirmacionWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:WPF_Desktop.Windows"
		xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		mc:Ignorable="d"
		Background="{ StaticResource ResourceKey=Papel }"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		SizeToContent="Height"
		Title="EDUSIS"
		Width="480"
		WindowStartupLocation="CenterOwner"
		WindowStyle="None">
	<!--
		EL DIÁLOGO DE LA APLICACIÓN.

		Reemplaza al MessageBox nativo de Windows en los dos casos donde interrumpir está
		justificado: hay que decidir algo (confirmar), o algo falló y no puede pasar
		desapercibido (error). Todo lo demás —los éxitos— pasó a los avisos al pie.

		Por qué no alcanzaba el MessageBox: no se puede tematizar, su botonera es "Sí/No" (que
		no dice a qué se le dice sí) y no tiene lugar para la consecuencia. Acá el botón lleva el
		mismo verbo que el botón que abrió el diálogo, y la consecuencia tiene su propio bloque.

		Mismo criterio de marco que MainWindow y StartupWindow: WindowChrome, no
		AllowsTransparency. La franja de 34px de arriba es arrastrable, así que el diálogo se
		puede mover si tapa justo lo que el usuario necesita leer para decidir.
	-->
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="34"
							CornerRadius="0"
							GlassFrameThickness="0"
							NonClientFrameEdges="None"
							ResizeBorderThickness="0"
							UseAeroCaptionButtons="False"/>
	</shell:WindowChrome.WindowChrome>

	<Border BorderBrush="{ StaticResource ResourceKey=LineaFuerte }"
			BorderThickness="1">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!--
				EL ACENTO. La misma regla vertical que encabeza cada ficha de la aplicación; acá
				el color dice de qué clase de diálogo se trata, y el rótulo de al lado lo dice
				con palabras. Nunca sólo con color.
			-->
			<Rectangle Grid.Column="0" Width="4">
				<Rectangle.Style>
					<Style TargetType="{ x:Type Rectangle }">
						<Setter Property="Fill" Value="{ StaticResource ResourceKey=Primario }"/>
						<Style.Triggers>
							<DataTrigger Binding="{ Binding Path=EsAlerta }" Value="True">
								<Setter Property="Fill" Value="{ StaticResource ResourceKey=Alerta }"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Rectangle.Style>
			</Rectangle>

			<Grid Grid.Column="1" Margin="24 22 24 20">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--#region ENCABEZADO-->
				<TextBlock Grid.Row="0"
						   Style="{ StaticResource ResourceKey=Txt.Seccion }"
						   Text="{ Binding Path=Encabezado }"/>

				<TextBlock Grid.Row="1"
						   Margin="0 4 0 0"
						   Style="{ StaticResource ResourceKey=Txt.Titulo }"
						   Text="{ Binding Path=Titulo }"
						   TextWrapping="Wrap"/>
				<!--#endregion-->

				<TextBlock Grid.Row="2"
						   Margin="0 10 0 0"
						   Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
						   Text="{ Binding Path=Mensaje }"
						   TextWrapping="Wrap"
						   Visibility="{ Binding Path=Mensaje, Converter={ StaticResource ResourceKey=visibleSiHayTexto } }"/>

				<!--#region CONSECUENCIA
					Lo que se pierde, en su propia caja. Separado del mensaje a propósito: es lo
					único que el usuario no puede deducir de la pantalla que tiene detrás.
				-->
				<Border Grid.Row="3"
						Margin="0 14 0 0"
						Style="{ StaticResource ResourceKey=Dialogo.Consecuencia }"
						Visibility="{ Binding Path=Consecuencia, Converter={ StaticResource ResourceKey=visibleSiHayTexto } }">
					<TextBlock Style="{ StaticResource ResourceKey=Txt.Cuerpo }"
							   Text="{ Binding Path=Consecuencia }"
							   TextWrapping="Wrap"/>
				</Border>
				<!--#endregion-->

				<!--#region ACCIONES
					Dos botones de acción y no uno con el estilo cambiante: la propiedad Style no
					se puede asignar desde un Setter de Style, así que un DataTrigger no puede
					alternar entre Btn.Peligro y Btn.Primario sobre el mismo botón.
				-->
				<Grid Grid.Row="4" Margin="0 20 0 0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Rectangle Grid.Row="0" Style="{ StaticResource ResourceKey=Regla }"/>

					<StackPanel Grid.Row="1"
								HorizontalAlignment="Right"
								Margin="0 16 0 0"
								Orientation="Horizontal">
						<Button x:Name="BotonCancelar"
								Click="Cancelar_Click"
								Content="Cancelar"
								IsCancel="True"
								Margin="0 0 8 0"
								Style="{ StaticResource ResourceKey=Btn.Secundario }"
								Visibility="{ Binding Path=TieneCancelar, Converter={ StaticResource ResourceKey=visibilidad } }"/>

						<Button x:Name="BotonPeligro"
								Click="Aceptar_Click"
								Content="{ Binding Path=VerboDeAccion }"
								Style="{ StaticResource ResourceKey=Btn.Peligro }"
								Visibility="{ Binding Path=EsDestructiva, Converter={ StaticResource ResourceKey=visibilidad } }"/>

						<Button x:Name="BotonAceptar"
								Click="Aceptar_Click"
								Content="{ Binding Path=VerboDeAccion }"
								Style="{ StaticResource ResourceKey=Btn.Primario }"
								Visibility="{ Binding Path=EsDestructiva, Converter={ StaticResource ResourceKey=visibilidadInversa } }"/>
					</StackPanel>
				</Grid>
				<!--#endregion-->
			</Grid>
		</Grid>
	</Border>
</Window>

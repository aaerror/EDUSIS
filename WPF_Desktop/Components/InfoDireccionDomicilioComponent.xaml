<UserControl x:Class="WPF_Desktop.Components.InfoDireccionDomicilioComponent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Components"
			 x:Name="direccionData"

			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainDomicilios="clr-namespace:Domain.Personas.Domicilios;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Tres columnas, las mismas que usa el bloque de ubicación que va justo abajo en el
		perfil: así los campos de las dos mitades del domicilio caen en la misma retícula en
		lugar de quedar corridos entre sí.
	-->
	<UserControl.Resources>
		<converters:ViviendaConverter x:Key="viviendaConverter"/>
		<ObjectDataProvider x:Key="vivienda" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainDomicilios:Vivienda"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<HeaderedContentControl Grid.Column="0" Grid.Row="0"
							   Header="Calle"
							   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=direccionData }"
					 Text="{ Binding Path=Calle, ElementName=direccionData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="1" Grid.Row="0"
							   Header="Altura"
							   Style="{ StaticResource ResourceKey=Campo.Centro }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=direccionData }"
					 Tag="1234"
					 Text="{ Binding Path=Altura, ElementName=direccionData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="2" Grid.Row="0"
							   Header="Vivienda"
							   Style="{ StaticResource ResourceKey=Campo.Derecha }">
			<ComboBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=direccionData }"
					  ItemsSource="{ Binding Source={ StaticResource ResourceKey=vivienda } }"
					  SelectedItem="{ Binding Path=Vivienda, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ElementName=direccionData, Converter={ StaticResource ResourceKey=viviendaConverter } }"
					  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.ColumnSpan="3" Grid.Row="1"
							   Header="Observaciones"
							   Style="{ StaticResource ResourceKey=Campo }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=direccionData }"
					 Text="{ Binding Path=Observacion, ElementName=direccionData }"
					 Style="{ StaticResource ResourceKey=Txb.Nota }"/>
		</HeaderedContentControl>
	</Grid>
</UserControl>

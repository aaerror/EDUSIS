<UserControl x:Class="WPF_Desktop.Components.InfoUbicacionDomicilioComponent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Components"
			 x:Name="ubicacionData"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Localidad, provincia y país en una sola fila de tres, alineada con calle / altura /
		vivienda. Antes país colgaba solo en una cuarta fila ocupando dos columnas, con lo que
		quedaba más ancho que los otros dos campos de la misma clase de dato.
	-->
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<HeaderedContentControl Grid.Column="0"
							   Header="Localidad"
							   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=ubicacionData }"
					 Text="{ Binding Path=Localidad, ElementName=ubicacionData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="1"
							   Header="Provincia"
							   Style="{ StaticResource ResourceKey=Campo.Centro }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=ubicacionData }"
					 Text="{ Binding Path=Provincia, ElementName=ubicacionData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="2"
							   Header="País"
							   Style="{ StaticResource ResourceKey=Campo.Derecha }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=ubicacionData }"
					 Text="{ Binding Path=Pais, ElementName=ubicacionData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>
	</Grid>
</UserControl>

<UserControl x:Class="WPF_Desktop.Components.InfoPersonalComponent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Components"
			 x:Name="personaData"

			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainPersonas="clr-namespace:Domain.Personas;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<!--
		Se sacó el campo PersonaID: era un StackPanel con Visibility="Collapsed" fijo, así que
		no se mostraba nunca y ninguna de las dos pantallas de perfil le pasaba la propiedad.
		La propiedad sigue declarada en el code-behind.

		Documento, fecha de nacimiento y nacionalidad van deshabilitados a propósito: son datos
		de identidad que no se editan desde el perfil. El fondo Tiza del campo deshabilitado es
		lo que distingue "no se toca" de "escribí acá", que es la regla del sistema.
	-->
	<UserControl.Resources>
		<converters:SexoConverter x:Key="sexoConverter"/>
		<ObjectDataProvider x:Key="sexos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainPersonas:Sexo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<HeaderedContentControl Grid.Column="0" Grid.Row="0"
							   Header="Apellido"
							   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=personaData }"
					 Text="{ Binding Path=Apellido, ElementName=personaData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="1" Grid.Row="0"
							   Header="Nombre"
							   Style="{ StaticResource ResourceKey=Campo.Derecha }">
			<TextBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=personaData }"
					 Text="{ Binding Path=Nombre, ElementName=personaData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="0" Grid.Row="1"
							   Header="Documento"
							   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<TextBox IsEnabled="False"
					 Text="{ Binding Path=Documento, ElementName=personaData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="1" Grid.Row="1"
							   Header="Sexo"
							   Style="{ StaticResource ResourceKey=Campo.Derecha }">
			<ComboBox IsEnabled="{ Binding Path=EstaHabilitado, ElementName=personaData }"
					  ItemsSource="{ Binding Source={ StaticResource ResourceKey=sexos } }"
					  SelectedItem="{ Binding Path=Sexo, ElementName=personaData, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={ StaticResource ResourceKey=sexoConverter } }"
					  Style="{ StaticResource ResourceKey=Cmb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="0" Grid.Row="2"
							   Header="Fecha de nacimiento"
							   Style="{ StaticResource ResourceKey=Campo.Izquierda }">
			<TextBox IsEnabled="False"
					 Text="{ Binding Path=FechaNacimiento, ElementName=personaData, StringFormat=D }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>

		<HeaderedContentControl Grid.Column="1" Grid.Row="2"
							   Header="Nacionalidad"
							   Style="{ StaticResource ResourceKey=Campo.Derecha }">
			<TextBox IsEnabled="False"
					 Text="{ Binding Path=Nacionalidad, ElementName=personaData }"
					 Style="{ StaticResource ResourceKey=Txb.Campo }"/>
		</HeaderedContentControl>
	</Grid>
</UserControl>

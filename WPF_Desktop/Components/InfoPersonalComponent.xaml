<UserControl x:Class="WPF_Desktop.Components.InfoPersonalComponent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:WPF_Desktop.Components"
			 x:Name="personaData"

			 xmlns:converters="clr-namespace:WPF_Desktop.Shared.Converters"
			 xmlns:domainPersonas="clr-namespace:Domain.Personas;assembly=Domain"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"

			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<ContentControl.Resources>
		<converters:SexoConverter x:Key="sexoConverter"/>
		<ObjectDataProvider x:Key="sexos" MethodName="GetValues" ObjectType="{ x:Type sys:Enum }">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domainPersonas:Sexo"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</ContentControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1*"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--#region PersonaID-->
		<StackPanel Grid.ColumnSpan="2"
					Grid.Row="0"
					Margin="0 0 0 10"
					Visibility="Collapsed">
			<Label Content="PersonaID"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=PersonaID, ElementName=personaData }"
					 IsEnabled="False"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->
		
		<!--#region Apellido-->
		<StackPanel Grid.Column="0"
					Grid.Row="1"
					Margin="0 0 10 5">
			<Label Content="Apellido"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=Apellido, ElementName=personaData }"
					 IsEnabled="{ Binding Path=EstaHabilitado, ElementName=personaData }"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region Nombre-->
		<StackPanel Grid.Column="1"
					Grid.Row="1"
					Margin="10 0 0 5">
			<Label Content="Nombre"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=Nombre, ElementName=personaData }"
					 IsEnabled="{ Binding Path=EstaHabilitado, ElementName=personaData }"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region Documento-->
		<StackPanel Grid.Column="0"
					Grid.Row="2"
					Margin="0 5 10 5">
			<Label Content="Documento"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=Documento, ElementName=personaData }"
					 IsEnabled="False"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region Sexo-->
		<StackPanel Grid.Column="1"
					Grid.Row="2"
					Margin="10 5 0 10">
			<Label Content="Sexo"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<ComboBox ItemsSource="{ Binding Source={ StaticResource ResourceKey=sexos } }"
					  SelectedItem="{ Binding Path=Sexo, ElementName=personaData, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={ StaticResource ResourceKey=sexoConverter } }"
					  IsEnabled="{ Binding Path=EstaHabilitado, ElementName=personaData }"
					  Style="{ StaticResource ResourceKey=ComboBoxStyle }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region Fecha de Nacimiento-->
		<StackPanel Grid.Column="0"
					Grid.Row="3"
					Margin="0 5 10 0">
			<Label Content="Fecha de Nacimiento"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=FechaNacimiento, ElementName=personaData, StringFormat=D }"
					 IsEnabled="False"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->

		<!--#region Nacionalidad-->
		<StackPanel Grid.Column="1"
					Grid.Row="3"
					Margin="10 5 0 0">
			<Label Content="Nacionalidad"
				   Margin="4 0 0 0"
				   HorizontalContentAlignment="Left"
				   VerticalContentAlignment="Center"
				   Style="{ StaticResource ResourceKey=Form }"/>
			<TextBox Text="{ Binding Path=Nacionalidad, ElementName=personaData }"
					 IsEnabled="False"
					 Style="{ StaticResource ResourceKey=TextBox }"/>
		</StackPanel>
		<!--#endregion-->
	</Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<!--
			Datos del establecimiento que emite la documentación. Los leía antes el cuerpo de cada
			certificado, escritos a mano; acá hay una sola fuente y cambiar de establecimiento es
			editar este bloque.
		-->
		<section name="institucion"
				 type="Infrastructure.Documentos.Configuracion.InstitucionSection, Infrastructure"/>
	</configSections>

	<institucion nombre="I.P.E.T. Nº 416"
				 cue="1405675"
				 cueAnexo="140567500"
				 direccion="CALLE PUBLICA CIUDAD DE MIS SUEÑOS RUTA 9 KM 690"
				 localidad="Córdoba"
				 codigoPostal="5000"
				 departamento="Capital"
				 jurisdiccion="Córdoba"
				 telefono="(0351) 4349835"
				 sector="Estatal"
				 ambito="Urbano"
				 modalidad="Educación común"
				 nivelesEnsenanza="Secundaria, Secundaria Técnica (INET)"/>
	<connectionStrings>
		<add name="WPF_Desktop.Properties.Settings.SQLServerConection"
			 connectionString="Data Source=localhost;Initial Catalog=EdusisDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>